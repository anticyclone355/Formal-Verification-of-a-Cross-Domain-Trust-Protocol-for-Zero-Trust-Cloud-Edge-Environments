lemma w1_o_pce_only_key_secrecy:
  all-traces
  "All I R e x k #send #accept #check #rev0.
     W1Sent(I,R,e,x,k) @send
   & W1Accepted(I,R,e,x,k) @accept
   & #send < #accept
   & #accept < #check
   & (All kind principal epoch #lt. W1LtkReveal(kind,principal,epoch) @lt & #lt < #check
       ==> (#accept < #lt & ((kind = 'pce' & principal = 'requester' & epoch = %1))))
   & W1LtkReveal('pce','requester',%1) @rev0 & #accept < #rev0 & #rev0 < #check
   & not (Ex role handle secret #dk. W1SessionKeyReveal(role,handle,secret) @dk & #dk < #check)
   & K(k) @check
