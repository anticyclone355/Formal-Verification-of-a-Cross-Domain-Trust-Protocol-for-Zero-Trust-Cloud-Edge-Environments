   & #accept < #check
   & (All kind principal epoch #lt. W1LtkReveal(kind,principal,epoch) @lt & #lt < #check
       ==> (#accept < #lt & ((kind = 'identity' & principal = 'requester' & epoch = %1) | (kind = 'pce' & principal = 'requester' & epoch = %1))))
   & W1LtkReveal('identity','requester',%1) @rev0 & #accept < #rev0 & #rev0 < #check
