#ifdef AFTER_EPOCH
lemma w1_o_historical_pce_after_epoch_reachable:
  exists-trace
  "Ex I R e x k #send #accept #check #advance #rev0.
     W1Sent(I,R,e,x,k) @send
   & W1Accepted(I,R,e,x,k) @accept
   & #send < #accept
   & #accept < #check
   & W1EpochAdvanced(%1,%1 %+ %1) @advance
   & #accept < #advance
   & #advance < #check
   & (All kind principal epoch #lt. W1LtkReveal(kind,principal,epoch) @lt & #lt < #check
       ==> (#advance < #lt & ((kind = 'pce' & principal = 'requester' & epoch = %1))))
   & W1LtkReveal('pce','requester',%1) @rev0 & #advance < #rev0 & #rev0 < #check
   & not (Ex role handle secret #dk. W1SessionKeyReveal(role,handle,secret) @dk & #dk < #check)
   & W1Probe() @check"

lemma w1_o_historical_pce_after_epoch_plaintext_secrecy:
  all-traces
  "All I R e x k #send #accept #check #advance #rev0.
     W1Sent(I,R,e,x,k) @send
   & W1Accepted(I,R,e,x,k) @accept
   & #send < #accept
   & #accept < #check
   & W1EpochAdvanced(%1,%1 %+ %1) @advance
   & #accept < #advance
   & #advance < #check
   & (All kind principal epoch #lt. W1LtkReveal(kind,principal,epoch) @lt & #lt < #check
       ==> (#advance < #lt & ((kind = 'pce' & principal = 'requester' & epoch = %1))))
   & W1LtkReveal('pce','requester',%1) @rev0 & #advance < #rev0 & #rev0 < #check
   & not (Ex role handle secret #dk. W1SessionKeyReveal(role,handle,secret) @dk & #dk < #check)
   & K(x) @check
   ==> F"

lemma w1_o_historical_pce_after_epoch_key_secrecy:
  all-traces
  "All I R e x k #send #accept #check #advance #rev0.
     W1Sent(I,R,e,x,k) @send
   & W1Accepted(I,R,e,x,k) @accept
   & #send < #accept
   & #accept < #check
   & W1EpochAdvanced(%1,%1 %+ %1) @advance
   & #accept < #advance
   & #advance < #check
   & (All kind principal epoch #lt. W1LtkReveal(kind,principal,epoch) @lt & #lt < #check
       ==> (#advance < #lt & ((kind = 'pce' & principal = 'requester' & epoch = %1))))
   & W1LtkReveal('pce','requester',%1) @rev0 & #advance < #rev0 & #rev0 < #check
   & not (Ex role handle secret #dk. W1SessionKeyReveal(role,handle,secret) @dk & #dk < #check)
   & K(k) @check
   ==> F"

lemma w1_o_historical_pce_after_epoch_record_decrypt:
  exists-trace
  "Ex I R e x k #send #accept #check #advance #rev0 #key.
     W1Sent(I,R,e,x,k) @send
   & W1Accepted(I,R,e,x,k) @accept
   & #send < #accept
   & #accept < #check
   & W1EpochAdvanced(%1,%1 %+ %1) @advance
   & #accept < #advance
   & #advance < #check
   & (All kind principal epoch #lt. W1LtkReveal(kind,principal,epoch) @lt & #lt < #check
       ==> (#advance < #lt & ((kind = 'pce' & principal = 'requester' & epoch = %1))))
   & W1LtkReveal('pce','requester',%1) @rev0 & #advance < #rev0 & #rev0 < #check
   & not (Ex role handle secret #dk. W1SessionKeyReveal(role,handle,secret) @dk & #dk < #check)
   & K(x) @check
   & K(k) @key
   & #rev0 < #key & #key < #check"

#endif

#ifdef AFTER_EPOCH
lemma w1_o_successor_only_reachable:
  exists-trace
  "Ex I R e x k #send #accept #check #advance #rev0 #rev1.
     W1Sent(I,R,e,x,k) @send
   & W1Accepted(I,R,e,x,k) @accept
   & #send < #accept
   & #accept < #check
   & W1EpochAdvanced(%1,%1 %+ %1) @advance
   & #accept < #advance
   & #advance < #check
   & (All kind principal epoch #lt. W1LtkReveal(kind,principal,epoch) @lt & #lt < #check
       ==> (#advance < #lt & ((kind = 'identity' & principal = 'requester' & epoch = %1 %+ %1) | (kind = 'pce' & principal = 'requester' & epoch = %1 %+ %1))))
   & W1LtkReveal('identity','requester',%1 %+ %1) @rev0 & #advance < #rev0 & #rev0 < #check
   & W1LtkReveal('pce','requester',%1 %+ %1) @rev1 & #advance < #rev1 & #rev1 < #check
   & not (Ex role handle secret #dk. W1SessionKeyReveal(role,handle,secret) @dk & #dk < #check)
   & W1Probe() @check"

lemma w1_o_successor_only_plaintext_secrecy:
  all-traces
  "All I R e x k #send #accept #check #advance #rev0 #rev1.
     W1Sent(I,R,e,x,k) @send
   & W1Accepted(I,R,e,x,k) @accept
   & #send < #accept
   & #accept < #check
   & W1EpochAdvanced(%1,%1 %+ %1) @advance
   & #accept < #advance
   & #advance < #check
   & (All kind principal epoch #lt. W1LtkReveal(kind,principal,epoch) @lt & #lt < #check
       ==> (#advance < #lt & ((kind = 'identity' & principal = 'requester' & epoch = %1 %+ %1) | (kind = 'pce' & principal = 'requester' & epoch = %1 %+ %1))))
   & W1LtkReveal('identity','requester',%1 %+ %1) @rev0 & #advance < #rev0 & #rev0 < #check
   & W1LtkReveal('pce','requester',%1 %+ %1) @rev1 & #advance < #rev1 & #rev1 < #check
   & not (Ex role handle secret #dk. W1SessionKeyReveal(role,handle,secret) @dk & #dk < #check)
   & K(x) @check
   ==> F"

lemma w1_o_successor_only_key_secrecy:
  all-traces
  "All I R e x k #send #accept #check #advance #rev0 #rev1.
     W1Sent(I,R,e,x,k) @send
   & W1Accepted(I,R,e,x,k) @accept
   & #send < #accept
   & #accept < #check
   & W1EpochAdvanced(%1,%1 %+ %1) @advance
   & #accept < #advance
   & #advance < #check
   & (All kind principal epoch #lt. W1LtkReveal(kind,principal,epoch) @lt & #lt < #check
       ==> (#advance < #lt & ((kind = 'identity' & principal = 'requester' & epoch = %1 %+ %1) | (kind = 'pce' & principal = 'requester' & epoch = %1 %+ %1))))
   & W1LtkReveal('identity','requester',%1 %+ %1) @rev0 & #advance < #rev0 & #rev0 < #check
   & W1LtkReveal('pce','requester',%1 %+ %1) @rev1 & #advance < #rev1 & #rev1 < #check
   & not (Ex role handle secret #dk. W1SessionKeyReveal(role,handle,secret) @dk & #dk < #check)
   & K(k) @check
   ==> F"

#endif

lemma w1_o_session_key_disclosure_reachable:
  exists-trace
  "Ex I R e x k #send #reveal #accept #learn.
     W1Sent(I,R,e,x,k) @send
   & W1SessionKeyReveal('sender',x,k) @reveal
   & W1Accepted(I,R,e,x,k) @accept
   & K(x) @learn
   & #send < #reveal & #reveal < #accept & #accept < #learn
   & not (Ex kind principal epoch #lt. W1LtkReveal(kind,principal,epoch) @lt)"

end
