lemma w1_o_pce_only_record_decrypt:
  exists-trace
  "Ex I R e x k #send #accept #check #rev0 #key.
     W1Sent(I,R,e,x,k) @send
   & W1Accepted(I,R,e,x,k) @accept
   & #send < #accept
   & #accept < #check
   & (All kind principal epoch #lt. W1LtkReveal(kind,principal,epoch) @lt & #lt < #check
       ==> (#accept < #lt & ((kind = 'pce' & principal = 'requester' & epoch = %1))))
   & W1LtkReveal('pce','requester',%1) @rev0 & #accept < #rev0 & #rev0 < #check
   & not (Ex role handle secret #dk. W1SessionKeyReveal(role,handle,secret) @dk & #dk < #check)
   & K(x) @check
   & K(k) @key
   & #rev0 < #key & #key < #check"

lemma w1_o_combined_reachable:
  exists-trace
  "Ex I R e x k #send #accept #check #rev0 #rev1.
     W1Sent(I,R,e,x,k) @send
   & W1Accepted(I,R,e,x,k) @accept
   & #send < #accept
   & #accept < #check
   & (All kind principal epoch #lt. W1LtkReveal(kind,principal,epoch) @lt & #lt < #check
       ==> (#accept < #lt & ((kind = 'identity' & principal = 'requester' & epoch = %1) | (kind = 'pce' & principal = 'requester' & epoch = %1))))
   & W1LtkReveal('identity','requester',%1) @rev0 & #accept < #rev0 & #rev0 < #check
   & W1LtkReveal('pce','requester',%1) @rev1 & #accept < #rev1 & #rev1 < #check
   & not (Ex role handle secret #dk. W1SessionKeyReveal(role,handle,secret) @dk & #dk < #check)
   & W1Probe() @check"

lemma w1_o_combined_plaintext_secrecy:
  all-traces
  "All I R e x k #send #accept #check #rev0 #rev1.
     W1Sent(I,R,e,x,k) @send
   & W1Accepted(I,R,e,x,k) @accept
   & #send < #accept
   & #accept < #check
   & (All kind principal epoch #lt. W1LtkReveal(kind,principal,epoch) @lt & #lt < #check
       ==> (#accept < #lt & ((kind = 'identity' & principal = 'requester' & epoch = %1) | (kind = 'pce' & principal = 'requester' & epoch = %1))))
   & W1LtkReveal('identity','requester',%1) @rev0 & #accept < #rev0 & #rev0 < #check
   & W1LtkReveal('pce','requester',%1) @rev1 & #accept < #rev1 & #rev1 < #check
   & not (Ex role handle secret #dk. W1SessionKeyReveal(role,handle,secret) @dk & #dk < #check)
   & K(x) @check
   ==> F"

