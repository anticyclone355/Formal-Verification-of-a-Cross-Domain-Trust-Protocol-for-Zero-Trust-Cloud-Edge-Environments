lemma w1_r_initiator_ephemeral_control_reachable:
  exists-trace
  "Ex I R e sid x k T #send #accept #erase #reveal #learn.
     W1Sent(I,R,e,sid,x,k,T) @send
   & W1Accepted(I,R,e,sid,x,k,T) @accept
   & SessionErased(I,R,e,sid) @erase
   & W1EphemeralReveal('initiator',sid) @reveal
   & K(x) @learn
   & #send < #accept & #accept < #erase & #reveal < #erase & #erase < #learn
   & not (Ex kind principal epoch #lt. W1LtkReveal(kind,principal,epoch) @lt)
   & not (Ex role handle secret #dk. W1SessionKeyReveal(role,handle,secret) @dk)
   & not (Ex #other. W1EphemeralReveal('responder',sid) @other)"

lemma w1_r_responder_ephemeral_control_reachable:
  exists-trace
  "Ex I R e sid x k T #send #accept #erase #reveal #learn.
     W1Sent(I,R,e,sid,x,k,T) @send
   & W1Accepted(I,R,e,sid,x,k,T) @accept
   & SessionErased(I,R,e,sid) @erase
   & W1EphemeralReveal('responder',sid) @reveal
   & K(x) @learn
   & #send < #accept & #accept < #erase & #reveal < #erase & #erase < #learn
   & not (Ex kind principal epoch #lt. W1LtkReveal(kind,principal,epoch) @lt)
   & not (Ex role handle secret #dk. W1SessionKeyReveal(role,handle,secret) @dk)
   & not (Ex #other. W1EphemeralReveal('initiator',sid) @other)"

lemma w1_r_initiator_session_key_control_reachable:
  exists-trace
  "Ex I R e sid x k T #send #accept #erase #reveal #learn.
     W1Sent(I,R,e,sid,x,k,T) @send
   & W1Accepted(I,R,e,sid,x,k,T) @accept
   & SessionErased(I,R,e,sid) @erase
   & W1SessionKeyReveal('initiator',sid,k) @reveal
   & K(x) @learn
   & #send < #accept & #accept < #erase & #reveal < #erase & #erase < #learn
   & not (Ex kind principal epoch #lt. W1LtkReveal(kind,principal,epoch) @lt)
   & not (Ex role handle #ep. W1EphemeralReveal(role,handle) @ep)
   & not (Ex secret #other. W1SessionKeyReveal('responder',sid,secret) @other)"

lemma w1_r_responder_session_key_control_reachable:
  exists-trace
  "Ex I R e sid x k T #send #accept #erase #reveal #learn.
     W1Sent(I,R,e,sid,x,k,T) @send
   & W1Accepted(I,R,e,sid,x,k,T) @accept
   & SessionErased(I,R,e,sid) @erase
   & W1SessionKeyReveal('responder',sid,k) @reveal
   & K(x) @learn
   & #send < #accept & #accept < #erase & #reveal < #erase & #erase < #learn
   & not (Ex kind principal epoch #lt. W1LtkReveal(kind,principal,epoch) @lt)
   & not (Ex role handle #ep. W1EphemeralReveal(role,handle) @ep)
   & not (Ex secret #other. W1SessionKeyReveal('initiator',sid,secret) @other)"

lemma w1_r_key_disclosure_after_erasure_unreachable:
  all-traces
  "All I R e sid role k #erase #reveal.
     SessionErased(I,R,e,sid) @erase
   & W1SessionKeyReveal(role,sid,k) @reveal
   & #erase < #reveal
   ==> F"

lemma w1_r_ephemeral_disclosure_after_erasure_unreachable:
  all-traces
  "All I R e sid role #erase #reveal.
     SessionErased(I,R,e,sid) @erase
   & W1EphemeralReveal(role,sid) @reveal
   & #erase < #reveal
   ==> F"

lemma w1_r_kci_reachable:
  exists-trace
  "Ex I R e sid x k T #request #accept #compromise.
     W1Request(I,R,e,sid) @request
   & W1Accepted(I,R,e,sid,x,k,T) @accept
   & W1LtkReveal('identity',I,e) @compromise
   & #compromise < #request & #request < #accept
   & (All kind principal epoch #lt. W1LtkReveal(kind,principal,epoch) @lt & #lt < #accept ==> (kind = 'identity' & principal = I & epoch = e))
   & not (Ex role handle #ep. W1EphemeralReveal(role,handle) @ep & #ep < #accept)
   & not (Ex role handle secret #dk. W1SessionKeyReveal(role,handle,secret) @dk & #dk < #accept)"

lemma w1_r_kci_responder_origin:
  all-traces
  "All I R e sid x k T #request #accept #compromise.
     W1Request(I,R,e,sid) @request
   & W1Accepted(I,R,e,sid,x,k,T) @accept
   & W1LtkReveal('identity',I,e) @compromise
   & #compromise < #request & #request < #accept
   & (All kind principal epoch #lt. W1LtkReveal(kind,principal,epoch) @lt & #lt < #accept ==> (kind = 'identity' & principal = I & epoch = e))
   & not (Ex role handle #ep. W1EphemeralReveal(role,handle) @ep & #ep < #accept)
   & not (Ex role handle secret #dk. W1SessionKeyReveal(role,handle,secret) @dk & #dk < #accept)
   ==> (Ex A B #running. RunningResponder(R,I,A,B,e,sid,x,k,T) @running & #running < #accept)"

end
