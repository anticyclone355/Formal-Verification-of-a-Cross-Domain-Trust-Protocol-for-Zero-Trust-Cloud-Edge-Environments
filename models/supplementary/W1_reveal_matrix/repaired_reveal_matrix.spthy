lemma w1_r_pce_only_key_secrecy:
  all-traces
  "All I R e sid x k T #send #accept #erase #check #rev0.
     W1Sent(I,R,e,sid,x,k,T) @send
   & W1Accepted(I,R,e,sid,x,k,T) @accept
   & #send < #accept
   & SessionErased(I,R,e,sid) @erase
   & #accept < #erase
   & #erase < #check
   & (All kind principal epoch #lt. W1LtkReveal(kind,principal,epoch) @lt & #lt < #check
