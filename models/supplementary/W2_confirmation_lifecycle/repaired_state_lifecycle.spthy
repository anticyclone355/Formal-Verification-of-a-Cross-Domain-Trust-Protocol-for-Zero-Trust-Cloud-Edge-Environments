   & not (Ex r handle #ep. W2EphemeralReveal(r,handle) @ep)
   & not (Ex secret #dk. W2SessionKeyReveal('responder',sid,secret) @dk)
   & not (Ex r p q epoch handle secret #ck. RevealConfirmationKey(r,p,q,epoch,handle,secret) @ck)"

