/* W2: responder-to-initiator confirmation and symbolic state lifecycle.
   Parent: W1 repaired fixed-epoch slice; original source: AECDHE-v0.
   Bounded: one request/session, two registered subjects, two domains.
   kConf is explicitly retained alongside kData until local erasure.
   Public data-path messages/checks are unchanged.
*/
theory W2_AECDHE_State_Lifecycle
begin

builtins: hashing, signing, symmetric-encryption, diffie-hellman, natural-numbers
functions: PEnc/3, PDec/2, ppk/1, kdf_data/2, kdf_conf/2
equations: PDec(psk,PEnc(ppk(psk),k,r)) = k

restriction Equality:
  "All x y #i. Eq(x,y) @i ==> x = y"

/* An explicit bounded experiment, not an injective-agreement assumption. */
restriction W2_OneSetup:
  "All #i #j. W2Init() @i & W2Init() @j ==> #i = #j"


/* Conditional interface: two registered subjects, two domains, one allow policy.
   Real public certificates are output. Only initialization is bounded globally. */
rule W2_Setup:
  [ Fr(~si), Fr(~pi), Fr(~sr), Fr(~pr), Fr(~da), Fr(~db) ]
  --[ W2Init() ]->
  [ !Subject('requester','domain_A',%1,~si,~pi,pk(~si),ppk(~pi))
  , !Subject('owner','domain_B',%1,~sr,~pr,pk(~sr),ppk(~pr))
  , !Domain('domain_A',%1,~da,pk(~da))
  , !Domain('domain_B',%1,~db,pk(~db))
  , !Policy('domain_A','domain_B',%1,'requester','owner','1')
  , W2_RequestReady('requester','owner','domain_A','domain_B',%1)
  , W2_IdAvailable('requester',%1), W2_PceAvailable('requester',%1)
  , W2_IdAvailable('owner',%1), W2_PceAvailable('owner',%1)
  , W2_DomainAvailable('domain_A',%1), W2_DomainAvailable('domain_B',%1)
  , W2_ProbeReady()
  , Out(<pk(~si),ppk(~pi),%1,'Subject Pk'>)
  , Out(<pk(~sr),ppk(~pr),%1,'Subject Pk'>)
  , Out(<<pk(~si),ppk(~pi),%1>,sign(<pk(~si),ppk(~pi),%1>,~da),pk(~da),'SubjectCert'>)
  , Out(<<pk(~sr),ppk(~pr),%1>,sign(<pk(~sr),ppk(~pr),%1>,~db),pk(~db),'SubjectCert'>)
  ]

/* An independent observable endpoint for non-vacuity witnesses. */

rule W2_Probe:
  [ W2_ProbeReady() ] --[ W2Probe() ]-> []

/* Each immutable credential may be revealed once, at any chosen time.
   Learning the same immutable key repeatedly adds no attacker capability. */

rule Reveal_IdentityKey:
  [ !Subject($S,$D,%n,sk,psk,pkS,ppkS), W2_IdAvailable($S,%n) ]
  --[ Reveal_IdentityKey($S,%n), W2LtkReveal('identity',$S,%n) ]->
  [ Out(sk) ]

rule Reveal_PCEKey:
  [ !Subject($S,$D,%n,sk,psk,pkS,ppkS), W2_PceAvailable($S,%n) ]
  --[ Reveal_PCEKey($S,%n), W2LtkReveal('pce',$S,%n) ]->
  [ Out(psk) ]

rule Reveal_DomainKey:
  [ !Domain($D,%n,sk,pkD), W2_DomainAvailable($D,%n) ]
  --[ Reveal_Domain($D,%n), W2LtkReveal('domain',$D,%n) ]->
  [ Out(sk) ]

/* Retained data path; additions are W2 observations and scenario tokens. */

rule Subject_Access_Request[role="Authentication_and_Data_Sharing"]:
    let
        CertA_Pro = <CertA, CertaSign, SignPk>
        X = 'g'^~ie
        AccessRa = <CertA_Pro, pkb, %n, ~sid, X>
    in
    [
        W2_RequestReady($S_a,$S_b,$A,$B,%n)
        , !Subject($S_a, $A, %n, pska, ppska, pka, ppka)
        , !Subject($S_b, $B, %n, pskb, ppskb, pkb, ppkb)
        , !Domain($A, %n, gskA, gpkA)
        , !Domain($B, %n, gskB, gpkB)
        , Fr(~sid)
        , Fr(~ie)
        , In(<CertA, CertaSign, SignPk, field>)
    ]
    --[
    EphemeralCreated('initiator',$S_a,$S_b,%n,~sid,~ie)
    , 
        Eq(field, 'SubjectCert')
        , Eq(SignPk,gpkA)
        , Eq(verify(CertaSign,CertA,gpkA),true)
        
        , Eq(fst(CertA), pka)
        , Eq(fst(snd(CertA)), ppka)
        , Eq(snd(snd(CertA)), %n)
        , AccessRequest($S_a, $S_b, %n, $A, $B, pska, pskb, gskA)
        , RepairAccessRequest($S_a,$S_b,$A,$B,%n,~sid,X)
        , W2Request($S_a,$S_b,%n,~sid)
    ]->
    [

        Out(<AccessRa,sign(AccessRa,pska),pka, 'AccessR_a_fs'>)
        , Access_send($S_a, $S_b, %n, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB, ppka)
        , St_Initiator_DH($S_a,$S_b,$A,$B,%n,~sid,~ie,X,pka,ppka,pkb,'clean')
    ]

rule Domain_Access_Verification[role="Authentication_and_Data_Sharing"]:
    let
        CertA_Pro = fst(AccessRa)
        pkbIn = fst(snd(AccessRa))
        Epoch_Access = fst(snd(snd(AccessRa)))
        sid = fst(snd(snd(snd(AccessRa))))
        X = snd(snd(snd(snd(AccessRa))))
        GrantBody = <pka, pkb, %n, sid, X>

    in
    [ 
        In(<AccessRa,AccesssSign,AccessPKa, field>)
        , Access_send($S_a, $S_b, %n, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB, ppka)
        , !Policy($A, $B, %n, $S_a, $S_b, bit)
        , !Subject($S_b, $B, %n, pskb, ppskb, pkb, ppkb)
    ]
    --[
        Eq(field, 'AccessR_a_fs')
        , Eq(pka,AccessPKa)
        , Eq(verify(AccesssSign, AccessRa, pka), true)
        , Eq(pkbIn,pkb)
        , Eq(Epoch_Access, %n)

        , Eq(bit, '1')
        , AccessGranted($S_a, $S_b, %n, pka, pkb, bit)                          
        , RepairAccessGranted($S_a,$S_b,$A,$B,%n,sid,X,h(GrantBody))
    ]->
    [ 
        Out(<h(GrantBody), sign(h(GrantBody), gskB), pk(gskB), sid, X,
             'AccessCert_ab_fs'>)    
        , AccessCert_send($S_a, $S_b, %n, pka, pkb, pskb, ppka, $A, $B, gpkA, gpkB)
    ]

rule Object_Data_Encryption[role="Authentication_and_Data_Sharing"]:
    let 
        GrantBody = <pka, pkb, %n, sid, X>
        Y = 'g'^~re
        Z = X^~re
        transcript = <'CDDS-AECDHE-full-v4',$S_a,$A,$S_b,$B,%n,
                      sid,pka,pkb,X,Y,h(Hash1)>
        kData = kdf_data(Z,transcript)
        kConf = kdf_conf(Z,transcript)
        d = <~msg, sign(<~msg,transcript>,pskb), pk(pskb)>
        beta = senc(d,kData)
        keyConfirm = h(<'key-confirm',kConf,transcript,h(beta)>)
    in
    [ 
        In(<Hash1,Hashsign,Hashpk,sid,X,field>)
        , AccessCert_send($S_a, $S_b, %n, pka, pkb, pskb, ppka, $A, $B, gpkA, gpkB)
        , !Subject($S_a, $A, %n, pska, ppska, pka, ppka)
        , !Subject($S_b, $B, %n, pskb, ppskb, pkb, ppkb)
        , Fr(~msg)                                                
        , Fr(~re)                                                
    ]
    --[
    EphemeralCreated('responder',$S_a,$S_b,%n,sid,~re)
    , EphemeralUse('responder',$S_a,$S_b,%n,sid,~re)
    , DerivedKeyCreated('responder',$S_a,$S_b,%n,sid,'data',kData)
    , DerivedKeyCreated('responder',$S_a,$S_b,%n,sid,'confirmation',kConf)
    , DerivedKeyUse('responder',$S_a,$S_b,%n,sid,'data',kData)
    , DerivedKeyUse('responder',$S_a,$S_b,%n,sid,'confirmation',kConf)
    , ConfirmationGenerated($S_a,$S_b,$A,$B,%n,sid,transcript,beta,kData,kConf,keyConfirm)
    , 
        Eq(field, 'AccessCert_ab_fs')
        , Eq(gpkB,Hashpk)
        , Eq(verify(Hashsign, Hash1, gpkB), true)
        , Eq(Hash1,h(GrantBody))
        , DataSent($S_b, $S_a, %n, pskb, ppka, pka, ~msg, kData)
        , RepairDataSent($S_b,$S_a,$A,$B,%n,sid,~msg,kData,transcript)
        , W2Sent($S_a,$S_b,%n,sid,~msg,kData,transcript)
        , RunningResponder($S_b,$S_a,$A,$B,%n,sid,~msg,kData,transcript)
        
        , Secret(~msg, %n)
        , SessionKey(kData, %n)
        , Honest($S_a, %n)
        , Honest($S_b, %n)

    ]->                                                     
    [ 
        Out(<sid,Y,beta,keyConfirm,Hash1,'data_fs'>)
        , St_Responder_PreErase($S_a,$S_b,$A,$B,%n,sid,~re,kData,kConf,~msg,transcript,'clean')
        , W2_KeyRevealAvailable('responder',sid)
        , W2_ConfRevealAvailable('responder',sid)

    ]

rule Subject_Data_Decryption[role="Authentication_and_Data_Sharing"]:
let 
    transcript = <'CDDS-AECDHE-full-v4',$S_a,$A,$S_b,$B,%n,
                  sid,pka,pkb,X,Y,h(Hash1)>
    Z = Y^ie
    k_in = kdf_data(Z,transcript)
    kConf = kdf_conf(Z,transcript)
    d_in = sdec(beta, k_in)
    x_in = fst(d_in)
    pk_in = snd(snd(d_in))
    sign_x = fst(snd(d_in))
    expectedConfirm = h(<'key-confirm',kConf,transcript,h(beta)>)
in
[
    In(<sid,Y,beta,keyConfirm,Hash1,field>)
    , St_Initiator_DH($S_a,$S_b,$A,$B,%n,sid,ie,X,pka,ppka,pkb,iExposure)

]
--[
    W2StateUse('initiator',$S_a,$S_b,%n,sid,'pending')
    , EphemeralUse('initiator',$S_a,$S_b,%n,sid,ie)
    , DerivedKeyCreated('initiator',$S_a,$S_b,%n,sid,'data',k_in)
    , DerivedKeyCreated('initiator',$S_a,$S_b,%n,sid,'confirmation',kConf)
    , DerivedKeyUse('initiator',$S_a,$S_b,%n,sid,'data',k_in)
    , DerivedKeyUse('initiator',$S_a,$S_b,%n,sid,'confirmation',kConf)
    , ConfirmationAccepted($S_a,$S_b,$A,$B,%n,sid,transcript,beta,k_in,kConf,keyConfirm)
    , 
    Eq(field, 'data_fs')
    , Eq(keyConfirm,expectedConfirm)
    , Eq(pk_in, pkb)
    , Eq(verify(sign_x, <x_in,transcript>, pkb), true)
    , DataReceive($S_b, $S_a, %n, Y, beta, ppka, pkb, k_in, x_in)
    , RepairDataAccepted($S_a,$S_b,$A,$B,%n,sid,x_in,k_in,transcript)
    , W2Accepted($S_a,$S_b,%n,sid,x_in,k_in,transcript)
    , CommitInitiator($S_a,$S_b,$A,$B,%n,sid,x_in,k_in,transcript)

]->
[
    !Plaintext(x_in)
    , St_Initiator_PreErase($S_a,$S_b,$A,$B,%n,sid,ie,k_in,kConf,x_in,transcript,iExposure)
    , W2_KeyRevealAvailable('initiator',sid)
        , W2_ConfRevealAvailable('initiator',sid)
]

rule Initiator_Erase_Ephemeral[role="Authentication_and_Data_Sharing"]:
[
    St_Initiator_PreErase($S_a,$S_b,$A,$B,%n,sid,ie,k,kc,msg,transcript,iExposure)
]
--[
    W2StateUse('initiator',$S_a,$S_b,%n,sid,'preerase')
    , EphemeralUse('initiator',$S_a,$S_b,%n,sid,ie)
    , DerivedKeyUse('initiator',$S_a,$S_b,%n,sid,'data',k)
    , DerivedKeyUse('initiator',$S_a,$S_b,%n,sid,'confirmation',kc)
    , LocalErased('initiator',$S_a,$S_b,%n,sid)
    , SecretsErased('initiator',$S_a,$S_b,%n,sid,ie,k,kc)
    , 
    InitiatorErased($S_a,$S_b,$A,$B,%n,sid)
]->
[
    InitErased($S_a,$S_b,%n,sid)
]

rule Responder_Erase_Ephemeral[role="Authentication_and_Data_Sharing"]:
[
    St_Responder_PreErase($S_a,$S_b,$A,$B,%n,sid,re,k,kc,msg,transcript,rExposure)
]
--[
    W2StateUse('responder',$S_a,$S_b,%n,sid,'preerase')
    , EphemeralUse('responder',$S_a,$S_b,%n,sid,re)
    , DerivedKeyUse('responder',$S_a,$S_b,%n,sid,'data',k)
    , DerivedKeyUse('responder',$S_a,$S_b,%n,sid,'confirmation',kc)
    , LocalErased('responder',$S_a,$S_b,%n,sid)
    , SecretsErased('responder',$S_a,$S_b,%n,sid,re,k,kc)
    , 
    ResponderErased($S_a,$S_b,$A,$B,%n,sid)
]->
[
    RespErased($S_a,$S_b,%n,sid)
]

rule Close_Repair_Session_After_Erasure[role="Authentication_and_Data_Sharing"]:
[
    InitErased($S_a,$S_b,%n,sid)
    , RespErased($S_a,$S_b,%n,sid)
]
--[
    SessionErased($S_a,$S_b,%n,sid)
]->
[]

rule Reveal_Initiator_Ephemeral_Pending[role="adversary"]:
[
    St_Initiator_DH($S_a,$S_b,$A,$B,%n,sid,ie,X,pka,ppka,pkb,'clean')
]
--[
    W2StateUse('initiator',$S_a,$S_b,%n,sid,'pending')
    , EphemeralUse('initiator',$S_a,$S_b,%n,sid,ie)
    , 
    RevealEphemeralI($S_a,$S_b,%n,sid,ie)
    , W2EphemeralReveal('initiator',sid)
]->
[
    St_Initiator_DH($S_a,$S_b,$A,$B,%n,sid,ie,X,pka,ppka,pkb,'revealed')
    , Out(ie)
]

rule Reveal_Initiator_Ephemeral_Accepted[role="adversary"]:
[
    St_Initiator_PreErase($S_a,$S_b,$A,$B,%n,sid,ie,k,kc,msg,transcript,'clean')
]
--[
    W2StateUse('initiator',$S_a,$S_b,%n,sid,'preerase')
    , EphemeralUse('initiator',$S_a,$S_b,%n,sid,ie)
    , DerivedKeyUse('initiator',$S_a,$S_b,%n,sid,'data',k)
    , DerivedKeyUse('initiator',$S_a,$S_b,%n,sid,'confirmation',kc)
    , 
    RevealEphemeralI($S_a,$S_b,%n,sid,ie)
    , W2EphemeralReveal('initiator',sid)
]->
[
    St_Initiator_PreErase($S_a,$S_b,$A,$B,%n,sid,ie,k,kc,msg,transcript,'revealed')
    , Out(ie)
]

rule Reveal_Responder_Ephemeral[role="adversary"]:
[
    St_Responder_PreErase($S_a,$S_b,$A,$B,%n,sid,re,k,kc,msg,transcript,'clean')
]
--[
    W2StateUse('responder',$S_a,$S_b,%n,sid,'preerase')
    , EphemeralUse('responder',$S_a,$S_b,%n,sid,re)
    , DerivedKeyUse('responder',$S_a,$S_b,%n,sid,'data',k)
    , DerivedKeyUse('responder',$S_a,$S_b,%n,sid,'confirmation',kc)
    , 
    RevealEphemeralR($S_a,$S_b,%n,sid,re)
    , W2EphemeralReveal('responder',sid)
]->
[
    St_Responder_PreErase($S_a,$S_b,$A,$B,%n,sid,re,k,kc,msg,transcript,'revealed')
    , Out(re)
]

/* Orthogonal to the existing clean/revealed ephemeral marker: key disclosure
   neither disables ephemeral disclosure nor consumes the protocol state. */

rule Reveal_Initiator_SessionKey:
  [ St_Initiator_PreErase($I,$R,$A,$B,%n,sid,ie,k,kc,msg,T,exposure)
  , W2_KeyRevealAvailable('initiator',sid) ]
  --[
    W2StateUse('initiator',$I,$R,%n,sid,'preerase')
    , EphemeralUse('initiator',$I,$R,%n,sid,ie)
    , DerivedKeyUse('initiator',$I,$R,%n,sid,'data',k)
    , DerivedKeyUse('initiator',$I,$R,%n,sid,'confirmation',kc)
    ,  W2SessionKeyReveal('initiator',sid,k) ]->
  [ St_Initiator_PreErase($I,$R,$A,$B,%n,sid,ie,k,kc,msg,T,exposure), Out(k) ]

rule Reveal_Responder_SessionKey:
  [ St_Responder_PreErase($I,$R,$A,$B,%n,sid,re,k,kc,msg,T,exposure)
  , W2_KeyRevealAvailable('responder',sid) ]
  --[
    W2StateUse('responder',$I,$R,%n,sid,'preerase')
    , EphemeralUse('responder',$I,$R,%n,sid,re)
    , DerivedKeyUse('responder',$I,$R,%n,sid,'data',k)
    , DerivedKeyUse('responder',$I,$R,%n,sid,'confirmation',kc)
    ,  W2SessionKeyReveal('responder',sid,k) ]->
  [ St_Responder_PreErase($I,$R,$A,$B,%n,sid,re,k,kc,msg,T,exposure), Out(k) ]

/* A stored confirmation key is readable only while this local state exists. */
rule Reveal_Initiator_ConfirmationKey:
  [ St_Initiator_PreErase($I,$R,$A,$B,%n,sid,ep,k,kc,msg,T,exposure)
  , W2_ConfRevealAvailable('initiator',sid) ]
  --[ RevealConfirmationKey('initiator',$I,$R,%n,sid,kc)
    , W2StateUse('initiator',$I,$R,%n,sid,'preerase')
    , EphemeralUse('initiator',$I,$R,%n,sid,ep)
    , DerivedKeyUse('initiator',$I,$R,%n,sid,'data',k)
    , DerivedKeyUse('initiator',$I,$R,%n,sid,'confirmation',kc) ]->
  [ St_Initiator_PreErase($I,$R,$A,$B,%n,sid,ep,k,kc,msg,T,exposure), Out(kc) ]

/* A stored confirmation key is readable only while this local state exists. */
rule Reveal_Responder_ConfirmationKey:
  [ St_Responder_PreErase($I,$R,$A,$B,%n,sid,ep,k,kc,msg,T,exposure)
  , W2_ConfRevealAvailable('responder',sid) ]
  --[ RevealConfirmationKey('responder',$I,$R,%n,sid,kc)
    , W2StateUse('responder',$I,$R,%n,sid,'preerase')
    , EphemeralUse('responder',$I,$R,%n,sid,ep)
    , DerivedKeyUse('responder',$I,$R,%n,sid,'data',k)
    , DerivedKeyUse('responder',$I,$R,%n,sid,'confirmation',kc) ]->
  [ St_Responder_PreErase($I,$R,$A,$B,%n,sid,ep,k,kc,msg,T,exposure), Out(kc) ]

lemma w2_normal_confirmation_and_erasure:
  exists-trace
  "Ex I R A B e sid T beta kd kc tag #generate #accept #erase.
     ConfirmationGenerated(I,R,A,B,e,sid,T,beta,kd,kc,tag) @generate
   & ConfirmationAccepted(I,R,A,B,e,sid,T,beta,kd,kc,tag) @accept
   & SessionErased(I,R,e,sid) @erase
   & #generate < #accept & #accept < #erase
   & not (Ex kind p epoch #lt. W2LtkReveal(kind,p,epoch) @lt)
   & not (Ex role handle #ep. W2EphemeralReveal(role,handle) @ep)
   & not (Ex role handle secret #dk. W2SessionKeyReveal(role,handle,secret) @dk)
   & not (Ex role p q epoch handle secret #ck. RevealConfirmationKey(role,p,q,epoch,handle,secret) @ck)"

lemma key_confirmation_origin:
  all-traces
  "All I R A B e sid T beta kd kc tag #accept.
     ConfirmationAccepted(I,R,A,B,e,sid,T,beta,kd,kc,tag) @accept
   & not (Ex kind p epoch #lt.
       W2LtkReveal(kind,p,epoch) @lt & #lt < #accept
       & ((kind = 'identity' & (p = I | p = R) & epoch = e)
          | (kind = 'domain' & (p = A | p = B) & epoch = e)))
   & not (Ex role #ep. W2EphemeralReveal(role,sid) @ep & #ep < #accept)
   & not (Ex role secret #dk. W2SessionKeyReveal(role,sid,secret) @dk & #dk < #accept)
   & not (Ex role secret #ck. RevealConfirmationKey(role,I,R,e,sid,secret) @ck & #ck < #accept)
   ==> (Ex A0 B0 T0 beta0 kd0 #generate.
       ConfirmationGenerated(I,R,A0,B0,e,sid,T0,beta0,kd0,kc,tag) @generate
       & #generate < #accept)"

lemma key_confirmation_agreement:
  all-traces
  "All I R A B e sid T beta kd kc tag #accept.
     ConfirmationAccepted(I,R,A,B,e,sid,T,beta,kd,kc,tag) @accept
   & not (Ex kind p epoch #lt.
       W2LtkReveal(kind,p,epoch) @lt & #lt < #accept
       & ((kind = 'identity' & (p = I | p = R) & epoch = e)
          | (kind = 'domain' & (p = A | p = B) & epoch = e)))
   & not (Ex role #ep. W2EphemeralReveal(role,sid) @ep & #ep < #accept)
   & not (Ex role secret #dk. W2SessionKeyReveal(role,sid,secret) @dk & #dk < #accept)
   & not (Ex role secret #ck. RevealConfirmationKey(role,I,R,e,sid,secret) @ck & #ck < #accept)
   ==> (Ex #generate. ConfirmationGenerated(I,R,A,B,e,sid,T,beta,kd,kc,tag) @generate & #generate < #accept)"

lemma w2_responder_erases_before_acceptance:
  exists-trace
  "Ex I R A B e sid T beta kd kc tag #generate #local #accept #erase.
     ConfirmationGenerated(I,R,A,B,e,sid,T,beta,kd,kc,tag) @generate
   & LocalErased('responder',I,R,e,sid) @local
   & ConfirmationAccepted(I,R,A,B,e,sid,T,beta,kd,kc,tag) @accept & SessionErased(I,R,e,sid) @erase
   & #generate < #local & #local < #accept & #accept < #erase
   & not (Ex kind p epoch #lt. W2LtkReveal(kind,p,epoch) @lt)
   & not (Ex role handle #ep. W2EphemeralReveal(role,handle) @ep)
   & not (Ex role handle secret #dk. W2SessionKeyReveal(role,handle,secret) @dk)
   & not (Ex role p q epoch handle secret #ck. RevealConfirmationKey(role,p,q,epoch,handle,secret) @ck)"

lemma ephemeral_state_lifetime:
  all-traces
  "All role I R e sid secret #use.
     EphemeralUse(role,I,R,e,sid,secret) @use
   ==> ((Ex #create. EphemeralCreated(role,I,R,e,sid,secret) @create
         & (#create < #use | #create = #use))
       & not (Ex #erase. LocalErased(role,I,R,e,sid) @erase & #erase < #use))"

lemma derived_key_lifetime:
  all-traces
  "All role I R e sid kind key #use.
     DerivedKeyUse(role,I,R,e,sid,kind,key) @use
   ==> ((Ex #create. DerivedKeyCreated(role,I,R,e,sid,kind,key) @create
         & (#create < #use | #create = #use))
       & not (Ex #erase. LocalErased(role,I,R,e,sid) @erase & #erase < #use))"

lemma pre_erasure_state_non_reuse:
  all-traces
  "All role I R e sid #erase #use.
     LocalErased(role,I,R,e,sid) @erase
   & W2StateUse(role,I,R,e,sid,'preerase') @use
   & #erase < #use ==> F"

lemma pending_state_non_reuse_after_erasure:
  all-traces
  "All I R e sid #erase #use.
     LocalErased('initiator',I,R,e,sid) @erase
   & W2StateUse('initiator',I,R,e,sid,'pending') @use
   & #erase < #use ==> F"

lemma erased_secrets_have_prior_creation:
  all-traces
  "All role I R e sid ep kd kc #erase.
     SecretsErased(role,I,R,e,sid,ep,kd,kc) @erase
   ==> (Ex #ecreate #data #conf.
       EphemeralCreated(role,I,R,e,sid,ep) @ecreate
       & DerivedKeyCreated(role,I,R,e,sid,'data',kd) @data
       & DerivedKeyCreated(role,I,R,e,sid,'confirmation',kc) @conf
       & #ecreate < #erase & #data < #erase & #conf < #erase)"

lemma session_erasure_requires_both_local_erasures:
  all-traces
  "All I R e sid #erase.
     SessionErased(I,R,e,sid) @erase
   ==> (Ex #i #r.
       LocalErased('initiator',I,R,e,sid) @i
       & LocalErased('responder',I,R,e,sid) @r
       & #i < #erase & #r < #erase)"

lemma ephemeral_unreadable_after_local_erasure:
  all-traces
  "All role I R e sid #erase #reveal.
     LocalErased(role,I,R,e,sid) @erase
   & W2EphemeralReveal(role,sid) @reveal & #erase < #reveal ==> F"

lemma data_key_unreadable_after_local_erasure:
  all-traces
  "All role I R e sid key #erase #reveal.
     LocalErased(role,I,R,e,sid) @erase
   & W2SessionKeyReveal(role,sid,key) @reveal & #erase < #reveal ==> F"

lemma confirmation_key_unreadable_after_local_erasure:
  all-traces
  "All role I R e sid key #erase #reveal.
     LocalErased(role,I,R,e,sid) @erase
   & RevealConfirmationKey(role,I,R,e,sid,key) @reveal & #erase < #reveal ==> F"

lemma w2_initiator_ephemeral_disclosure_reachable:
  exists-trace
  "Ex I R A B e sid T beta kd kc tag x #send #accept #reveal #local #erase #learn.
     W2Sent(I,R,e,sid,x,kd,T) @send
   & ConfirmationAccepted(I,R,A,B,e,sid,T,beta,kd,kc,tag) @accept
   & W2EphemeralReveal('initiator',sid) @reveal
   & LocalErased('initiator',I,R,e,sid) @local
   & SessionErased(I,R,e,sid) @erase & K(x) @learn
   & #send < #accept & #accept < #erase
   & #reveal < #local & #local < #erase & #erase < #learn
   & not (Ex kind p epoch #lt. W2LtkReveal(kind,p,epoch) @lt)
   & not (Ex #ep. W2EphemeralReveal('responder',sid) @ep)
   & not (Ex r handle secret #dk. W2SessionKeyReveal(r,handle,secret) @dk)
   & not (Ex r p q epoch handle secret #ck. RevealConfirmationKey(r,p,q,epoch,handle,secret) @ck)"

