   & ConfirmationAccepted(I,R,A,B,e,sid,T,beta,kd,kc,tag) @accept
   & W2SessionKeyReveal('initiator',sid,kd) @reveal
   & LocalErased('initiator',I,R,e,sid) @local
   & SessionErased(I,R,e,sid) @erase & K(x) @learn
