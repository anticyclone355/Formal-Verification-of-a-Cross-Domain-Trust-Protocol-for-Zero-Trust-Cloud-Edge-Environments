  all-traces
  "All I R A B e sid T beta kd kc tag x #send #accept #erase #learn.
     W2Sent(I,R,e,sid,x,kd,T) @send
   & ConfirmationAccepted(I,R,A,B,e,sid,T,beta,kd,kc,tag) @accept
   & SessionErased(I,R,e,sid) @erase
   & #send < #accept & #accept < #erase & #erase < #learn
   & (All kind p epoch #lt. W2LtkReveal(kind,p,epoch) @lt & #lt < #learn ==> #erase < #lt)
   & not (Ex role handle #ep. W2EphemeralReveal(role,handle) @ep & #ep < #learn)
   & not (Ex role handle secret #dk. W2SessionKeyReveal(role,handle,secret) @dk & #dk < #learn)
   & not (Ex role p q epoch handle secret #ck. RevealConfirmationKey(role,p,q,epoch,handle,secret) @ck & #ck < #learn)
   & K(kd) @learn ==> F"

lemma w2_post_erasure_all_longterm_disclosures_reachable:
  exists-trace
  "Ex I R A B e sid T beta kd kc tag x #send #accept #erase #learn #i #r #a #b.
     W2Sent(I,R,e,sid,x,kd,T) @send
   & ConfirmationAccepted(I,R,A,B,e,sid,T,beta,kd,kc,tag) @accept
   & SessionErased(I,R,e,sid) @erase
   & #send < #accept & #accept < #erase & #erase < #learn
   & (All kind p epoch #lt. W2LtkReveal(kind,p,epoch) @lt & #lt < #learn ==> #erase < #lt)
   & not (Ex role handle #ep. W2EphemeralReveal(role,handle) @ep & #ep < #learn)
   & not (Ex role handle secret #dk. W2SessionKeyReveal(role,handle,secret) @dk & #dk < #learn)
   & W2Probe() @learn
   & W2LtkReveal('identity',I,e) @i & #erase < #i & #i < #learn
   & W2LtkReveal('identity',R,e) @r & #erase < #r & #r < #learn
   & W2LtkReveal('domain',A,e) @a & #erase < #a & #a < #learn
   & W2LtkReveal('domain',B,e) @b & #erase < #b & #b < #learn
   & not (Ex role p q epoch handle secret #ck. RevealConfirmationKey(role,p,q,epoch,handle,secret) @ck & #ck < #learn)"

lemma w2_confirmation_key_exposure_reachable:
  exists-trace
  "Ex I R A B e sid T beta kd kc tag x #send #accept #erase #conf #observe.
     W2Sent(I,R,e,sid,x,kd,T) @send
   & ConfirmationAccepted(I,R,A,B,e,sid,T,beta,kd,kc,tag) @accept
   & RevealConfirmationKey('responder',I,R,e,sid,kc) @conf
   & SessionErased(I,R,e,sid) @erase & W2Probe() @observe
   & #send < #accept & #accept < #erase & #conf < #erase & #erase < #observe
   & not (Ex kind p epoch #lt. W2LtkReveal(kind,p,epoch) @lt)
   & not (Ex role handle #ep. W2EphemeralReveal(role,handle) @ep)
   & not (Ex role handle secret #dk. W2SessionKeyReveal(role,handle,secret) @dk)"

lemma w2_confirmation_key_exposure_plaintext_secrecy:
  all-traces
  "All I R A B e sid T beta kd kc tag x #send #accept #erase #learn role #conf.
     W2Sent(I,R,e,sid,x,kd,T) @send
