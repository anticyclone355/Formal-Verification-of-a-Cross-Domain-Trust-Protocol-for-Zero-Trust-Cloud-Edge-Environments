   & W2SessionKeyReveal('initiator',sid,kd) @data
   & RevealConfirmationKey('initiator',I,R,e,sid,kc) @conf
   & LocalErased('initiator',I,R,e,sid) @erase
   & #ep < #data & #data < #conf & #ep < #erase & #data < #erase & #conf < #erase"

