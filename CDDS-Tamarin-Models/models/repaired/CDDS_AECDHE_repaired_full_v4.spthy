/* 域B对a的访问请求进行验证*/
rule Domain_Access_Verification[role="Authentication_and_Data_Sharing"]:
    let
        CertA_Pro = fst(AccessRa)
        pkbIn = fst(snd(AccessRa))
        Epoch_Access = fst(snd(snd(AccessRa)))
        sid = fst(snd(snd(snd(AccessRa))))
        X = snd(snd(snd(snd(AccessRa))))
        GrantBody = <pka, pkb, %n, sid, X>
        // CertA = fst(CertA_Pro)
        // CertASign = fst(snd(CertA_Pro))
        // CertAPk = snd(snd(CertA_Pro))
    in
    [ 
        In(<AccessRa,AccesssSign,AccessPKa, field>)
        , Access_send($S_a, $S_b, %n, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB, ppka)
        , !Policy($A, $B, %n, $S_a, $S_b, bit)
        , !Subject($S_b, $B, %n, pskb, ppskb, pkb, ppkb)
    ]
    --[
        Eq(field, 'AccessR_a_fs')
        , Eq(pka,AccessPKa)//公钥一致性
        , Eq(verify(AccesssSign, AccessRa, pka), true)//对a的请求签名进行认证
        , Eq(pkbIn,pkb)//验证是否访问域内节点
        , Eq(Epoch_Access, %n)//是否在有效期内
        // , Eq(CertAPk, gpkA)
        // , Eq(verify(CertASign, CertA, gpkA),true)
        // , Eq(fst(CertA), pka)
        // , Eq(fst(snd(CertA)), ppka)
        // , Eq(snd(snd(CertA)), %n)
        // , Eq(CertA,<pka, ppka>)//对a的证书进行认证
        , Eq(bit, '1')
        , AccessGranted($S_a, $S_b, %n, pka, pkb, bit)                          //记录授权状态
        , RepairAccessGranted($S_a,$S_b,$A,$B,%n,sid,X,h(GrantBody))
    ]->
    [ 
        Out(<h(GrantBody), sign(h(GrantBody), gskB), pk(gskB), sid, X,
             'AccessCert_ab_fs'>)    //域B签名绑定epoch、sid和发起方临时公钥X
        , AccessCert_send($S_a, $S_b, %n, pka, pkb, pskb, ppka, $A, $B, gpkA, gpkB)
    ]

/*对象和对签名后对要发送的数据进行加密 */
rule Object_Data_Encryption[role="Authentication_and_Data_Sharing"]:
    let 
        GrantBody = <pka, pkb, %n, sid, X>
        Y = 'g'^~b
        Z = X^~b
        transcript = <'CDDS-AECDHE-full-v4',$S_a,$A,$S_b,$B,%n,
                      sid,pka,pkb,X,Y,h(Hash1)>
        kData = kdf_data(Z,transcript)
        kConf = kdf_conf(Z,transcript)
        d = <~x, sign(<~x,transcript>,pskb), pk(pskb)>
        beta = senc(d,kData)
        keyConfirm = h(<'key-confirm',kConf,transcript,h(beta)>)
    in
    [ 
        In(<Hash1,Hashsign,Hashpk,sid,X,field>)
        , AccessCert_send($S_a, $S_b, %n, pka, pkb, pskb, ppka, $A, $B, gpkA, gpkB)
        , !Subject($S_a, $A, %n, pska, ppska, pka, ppka)
        , !Subject($S_b, $B, %n, pskb, ppskb, pkb, ppkb)
        , Fr(~x)                                                // 要传输的数据x
        , Fr(~b)                                                // 响应方临时DH指数
    ]
    --[
        Eq(field, 'AccessCert_ab_fs')
        , Eq(gpkB,Hashpk)
        , Eq(verify(Hashsign, Hash1, gpkB), true)
        , Eq(Hash1,h(GrantBody))
        , DataSent($S_b, $S_a, %n, pskb, ppka, pka, ~x, kData)//保留原事件接口
        , RepairDataSent($S_b,$S_a,$A,$B,%n,sid,~x,kData,transcript)
        , RunningResponder($S_b,$S_a,$A,$B,%n,sid,~x,kData,transcript)
        // , Secret(~k)//密钥k
        , Secret(~x, %n)
        , SessionKey(kData, %n)
        , Honest($S_a, %n)
        , Honest($S_b, %n)

    ]->                                                     // Enc是对称加密，PEnc是明文可检查加密，用于安全封装对称密钥
    [ 
        Out(<sid,Y,beta,keyConfirm,Hash1,'data_fs'>)
        , St_Responder_PreErase($S_a,$S_b,$A,$B,%n,sid,~b,kData,~x,transcript,'clean')
        // , Data(~x)
        // , SessionKey(~k)//密钥k
    ]

rule Subject_Data_Decryption[role="Authentication_and_Data_Sharing"]:
let 
    transcript = <'CDDS-AECDHE-full-v4',$S_a,$A,$S_b,$B,%n,
                  sid,pka,pkb,X,Y,h(Hash1)>
    Z = Y^a
    k_in = kdf_data(Z,transcript)
    kConf = kdf_conf(Z,transcript)
    d_in = sdec(beta, k_in)
    x_in = fst(d_in)
    pk_in = snd(snd(d_in))
    sign_x = fst(snd(d_in))
    expectedConfirm = h(<'key-confirm',kConf,transcript,h(beta)>)
in
[
    In(<sid,Y,beta,keyConfirm,Hash1,field>)
    , St_Initiator_DH($S_a,$S_b,$A,$B,%n,sid,a,X,pka,ppka,pkb,iExposure)
    // , Data(x)
    // , SessionKey(k)//密钥k
]
--[
    Eq(field, 'data_fs')
    , Eq(keyConfirm,expectedConfirm)
    , Eq(pk_in, pkb)//公钥一致性
    , Eq(verify(sign_x, <x_in,transcript>, pkb), true)
    , DataReceive($S_b, $S_a, %n, Y, beta, ppka, pkb, k_in, x_in)
    , RepairDataAccepted($S_a,$S_b,$A,$B,%n,sid,x_in,k_in,transcript)
    , CommitInitiator($S_a,$S_b,$A,$B,%n,sid,x_in,k_in,transcript)
    // , Decryption_k(alpha,ppska)
    // , Decryption_d(beta,k)
    // , Ver_sign_x(sign_x, x, pkb)
]->
[
    !Plaintext(x_in)
    , St_Initiator_PreErase($S_a,$S_b,$A,$B,%n,sid,a,k_in,x_in,transcript,iExposure)
]

/* Minimal explicit erasure state.  Erased facts retain only public session
 * identifiers; the ephemeral exponents and derived key are consumed. */
rule Initiator_Erase_Ephemeral[role="Authentication_and_Data_Sharing"]:
[
    St_Initiator_PreErase($S_a,$S_b,$A,$B,%n,sid,a,k,x,transcript,iExposure)
]
--[
    InitiatorErased($S_a,$S_b,$A,$B,%n,sid)
]->
[
    InitErased($S_a,$S_b,%n,sid)
]

rule Responder_Erase_Ephemeral[role="Authentication_and_Data_Sharing"]:
[
    St_Responder_PreErase($S_a,$S_b,$A,$B,%n,sid,b,k,x,transcript,rExposure)
]
--[
    ResponderErased($S_a,$S_b,$A,$B,%n,sid)
]->
[
    RespErased($S_a,$S_b,%n,sid)
]

rule Close_Repair_Session_After_Erasure[role="Authentication_and_Data_Sharing"]:
[
    InitErased($S_a,$S_b,%n,sid)
    , RespErased($S_a,$S_b,%n,sid)
]
--[
    SessionErased($S_a,$S_b,%n,sid)
]->
[]

/* Ephemeral compromise is possible only while the corresponding linear
 * pre-erasure state still exists. */
rule Reveal_Initiator_Ephemeral_Pending[role="adversary"]:
[
    St_Initiator_DH($S_a,$S_b,$A,$B,%n,sid,a,X,pka,ppka,pkb,'clean')
]
--[
    RevealEphemeralI($S_a,$S_b,%n,sid,a)
]->
[
    St_Initiator_DH($S_a,$S_b,$A,$B,%n,sid,a,X,pka,ppka,pkb,'revealed')
    , Out(a)
]

rule Reveal_Initiator_Ephemeral_Accepted[role="adversary"]:
[
    St_Initiator_PreErase($S_a,$S_b,$A,$B,%n,sid,a,k,x,transcript,'clean')
]
--[
    RevealEphemeralI($S_a,$S_b,%n,sid,a)
]->
[
    St_Initiator_PreErase($S_a,$S_b,$A,$B,%n,sid,a,k,x,transcript,'revealed')
    , Out(a)
]

rule Reveal_Responder_Ephemeral[role="adversary"]:
[
    St_Responder_PreErase($S_a,$S_b,$A,$B,%n,sid,b,k,x,transcript,'clean')
]
--[
    RevealEphemeralR($S_a,$S_b,%n,sid,b)
]->
[
    St_Responder_PreErase($S_a,$S_b,$A,$B,%n,sid,b,k,x,transcript,'revealed')
    , Out(b)
]

/* ----------------------------攻击属性------------------------------------------- */
rule Reveal_Domain_sk[role="adversary"]:
[ !Domain($I, %n, gsk, pk(gsk)) ] --[ Reveal_Domain($I, %n) ]-> [ Out(gsk) ]
rule Reveal_Subject_psk[role="adversary"]:
[ !Subject($S, $I, %n, psk, ppsk, spk, sppk) ] --[ Reveal_Subject($S, %n) ]-> [ Out(<psk, ppsk, %n>) ]
// rule Reveal_Subject_ppsk:
// [ !Subject($S, $I, %n, psk, ppsk, spk, sppk) ] --[ Reveal_Subject_ppsk(A, %n) ]-> [ Out(ppsk) ]
/* ----------------------------对域重构的攻击------------------------------------------ */
//攻击思路1：信任链劫持攻击
rule Domain_Reconfig_be_adversary[role="adversary"]:
    [                                                   
        !Domain($domain_id, %epoch, old_gsk, pk(old_gsk))
        , !Epoch('epoch', %n)
        , Fr(~faker_gsk)
    ]
    --[ 
        Domain_Reconfig_adversary($domain_id, %epoch %+ %1)
        , DDomain($domain_id, %epoch)
        , Eq(%epoch %+ %1, %n)
        , Fakergsk_Reconfig_Broadcast($domain_id, %epoch %+ %1, ~faker_gsk)
     ]->  
     [
        !Domain($domain_id, %epoch %+ %1, ~faker_gsk, pk(~faker_gsk))
        , Out(<pk(~faker_gsk), sign(pk(~faker_gsk),old_gsk), pk(old_gsk), 'Update domain public key'>)//抢先使用旧密钥签名假公钥,并在合法重构前广播
        // , Out(<~faker_gsk, pk(~faker_gsk)>)//等同于泄露密钥
        // , Epoch('epoch', %n)
    ]

/* 引理1：信任链劫持攻击存在可行轨迹
   目标：证明存在轨迹满足“敌手窃取SK_e→伪造签名→其他域接收恶意PK”
*/
lemma Adversary_TrustChain_Hijack_Feasibility:
exists-trace  // 攻击只需存在一条成功轨迹即有效
" 
    (
        Ex A faker_gsk #i1 #i2 #i3 #i4 #i5 #i6.
        Epoch_init('epoch', %1)@ #i1
        & InitDomain(A, %1) @ #i2
        & Update_epoch('epoch', %1 %+ %1)@ #i3
        // 1. 敌手窃取域D的纪元e私钥SK_e
        & Domain_Reconfig_adversary(A, %1 %+ %1) @ #i4 & not(Ex #j.Domain_Reconfig_Event(A, %1 %+ %1)@ #j & #j < #i4)
        & Fakergsk_Reconfig_Broadcast(A, %1 %+ %1, faker_gsk) @ #i5 
        & Domain_Pk_Trust(A, %1 %+ %1, pk(faker_gsk)) @ #i6
        & #i1 < #i2
        & #i2 < #i3
        & #i3 < #i4
        & #i4 < #i6
        & #i5 < #i6
    )
"
/* 引理2：恶意PK被用于后续BFT决策（信任链彻底劫持）
   目标：证明其他域用恶意PK验证BFT签名，攻击产生实际危害
*/
