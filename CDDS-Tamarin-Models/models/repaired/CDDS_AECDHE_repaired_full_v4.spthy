lemma RegisteredSubjectAll:
exists-trace
    "
        Ex S I gpk #i1 #i2 #i3 #i4 #i5 #i6 #i7.
        Epoch_init('epoch', %1)@ #i1
        & InitDomain(I, %1) @ #i2
        & Update_epoch('epoch', %1 %+ %1)@ #i3
        & Domain_Reconfig_Event(I, %1 %+ %1)@ #i4
        & InitSubject(S, %1 %+ %1) @ #i5
        & Subject_Register(S, I, %1 %+ %1) @ #i6
        & IssueCert(I, S, %1 %+ %1, gpk) @ #i7
        & #i1 < #i2
        & #i2 < #i3
        & #i3 < #i4
        & #i4 < #i5
        & #i5 < #i6
        & #i6 < #i7
    "
// 注册先遣性
lemma Init_before_Register:
"
    All S n I #i.
    Subject_Register(S, I, n) @i & (%1 %+ %1 << n)
    ==>
    (Ex #j #k #m.InitSubject(S, n) @j & j<i 
    & InitDomain(I, %1) @k & k<i
    & Domain_Reconfig_Event(I, n)@#m & m<i)
"
lemma RegisteredSubjectAllab:
exists-trace
"
Ex S_a S_b A B gpkA gpkB #i1 #i2 #i3 #i4 #i5 #i6 #i7 #i8 #i9 #i10 #i11 #i12.
        Epoch_init('epoch', %1)@ #i1
        & InitDomain(A, %1) @ #i2
        & Update_epoch('epoch', %1 %+ %1)@ #i3////////////////
        & Domain_Reconfig_Event(A, %1 %+ %1)@ #i4
        & InitSubject(S_a, %1 %+ %1) @ #i5
        & Subject_Register(S_a, A, %1 %+ %1) @ #i6
        & IssueCert(A, S_a, %1 %+ %1, gpkA) @ #i7
        & #i1 < #i2
        & #i2 < #i3
        & #i3 < #i4
        & #i4 < #i5
        & #i5 < #i6
        & #i6 < #i7

        & InitDomain(B, %1) @ #i8

        & Domain_Reconfig_Event(B, %1 %+ %1)@ #i9
        & InitSubject(S_b, %1 %+ %1) @ #i10
        & Subject_Register(S_b, B, %1 %+ %1) @ #i11
        & IssueCert(B, S_b, %1 %+ %1, gpkB) @ #i12
        & #i1 < #i8
        & #i8 < #i3
        & #i3 < #i9
        & #i9 < #i10
        & #i10 < #i11
        & #i11 < #i12

        & not(A = B)
"

lemma PolicyRegisterRequest1:
exists-trace
"
    Ex S_a S_b bit A B #i.
    PolicyRegister(S_a, S_b, %1 %+ %1, bit, A, B) @ #i
"
lemma PolicyRegisterRequest2:
exists-trace
"
    Ex B A Pb mr_root new_mr_root #j.
    ProcessPolicy(A, B, %1 %+ %1, Pb, mr_root, new_mr_root) @ #j
"
lemma PolicyRegisterRequest3:
exists-trace
"
    Ex A B Pb mt_root new_mt_rootB #i.
    ProcessPolicyDomain(A, B, %1 %+ %1, Pb, mt_root, new_mt_rootB) @ #i
"

lemma Data_Accees1:
exists-trace
"
    Ex S_a S_b A B pska pskb gskA #i.
    AccessRequest(S_a, S_b, %1 %+ %1, A, B, pska, pskb, gskA) @ #i
    & not (S_a = S_b) & not(A = B)
"
lemma Data_Accees11:
exists-trace
"
    Ex S_a S_b A B pska pskb gskA pka pkb bit #i #j.
    AccessRequest(S_a, S_b, %1 %+ %1, A, B, pska, pskb, gskA) @ #i
    & not (S_a = S_b) & not(A = B)
    & AccessGranted(S_a, S_b, %1 %+ %1, pka, pkb, bit) @ #j
    & i < j
"
lemma Data_Accees2:
exists-trace
"
    Ex S_a S_b pka pkb bit #i.
    AccessGranted(S_a, S_b, %1 %+ %1, pka, pkb, bit) @ #i
    & not (S_a = S_b) 
"
lemma Data_Accees3:
exists-trace
"
    Ex S_a S_b pskb ppka pka x k #i.
    DataSent(S_b, S_a, %1 %+ %1, pskb, ppka, pka, x, k) @ #i
    & not (S_a = S_b)
"
lemma Data_Accees4:
exists-trace
"
    Ex S_a S_b alpha beta pska pkb k x #i.
    DataReceive(S_b, S_a, %1 %+ %1, alpha, beta, pska, pkb, k, x) @ #i
    & not (S_a = S_b)
"
/* ----------------------------最终可行性验证--------------------------------------- */
lemma Executable:
exists-trace
"
    Ex S_a S_b alpha beta pska pkb k x #i.
    DataReceive(S_b, S_a, %1 %+ %1, alpha, beta, pska, pkb, k, x) @ #i
    & not (S_a = S_b)
"
/* ----------------------------安全性证明------------------------------------------- */
lemma secrecy_session_key://会话密钥保密性引理
"All k n #i.
  SessionKey(k, n) @i ==>
  not (Ex #j. K(k)@j) | (Ex S_b #r. Reveal_Subject(S_b, n)@r & Honest(S_b, n) @i)"

lemma secrecy_x://数据保密性引理
"All x n #i.
Secret(x, n) @i ==>
not (Ex #j. K(x)@j)
| (Ex S_b #r. Reveal_Subject(S_b, n)@r & Honest(S_b, n) @i)"

lemma secrecy_subject_sk://主体私钥保密性引理
"All S I n psk ppsk spk sppk #i.
  Subject1(S, I, n, psk, ppsk, spk, sppk) @i ==>
  not (Ex #j. K(psk)@j) | (Ex #r. Reveal_Subject(S, n)@r)"

lemma secrecy_domain_sk://域私钥保密性引理
"All I n gsk #i.
  Domain1(I, n, gsk, pk(gsk)) @i ==>
  not (Ex #j. K(gsk)@j) | (Ex #r. Reveal_Domain(I, n)@r)"

lemma forward_secrecy_x://前向安全性
"All x n #i.
Secret(x, n) @i
& not (Ex S_a #j. Reveal_Subject(S_a, n)@j) ==>
not (Ex #j. K(x)@j)"

lemma authentication_registration://主体注册认证
"All I S n gsk #i.
    IssueCert(I, S, n, gsk) @i
    ==>
    (Ex #j. Subject_Register(S, I, n) @j & #j < #i)"

lemma authentication_access_grant://访问授权认证
"All S_a S_b n pka pkb bit #i.
    AccessGranted(S_a, S_b, n, pka, pkb, bit) @i
    ==>
    (Ex A B pska pskb gskA #j #k.
        AccessRequest(S_a, S_b, n, A, B, pska, pskb, gskA) @j &
        #j < #i &
        PolicyRegisterEnd(S_a, S_b, n, bit, A, B) @k 
        & k < i
    )"

lemma authentication_data_cert:// 发送数据资格认证
"All S_b S_a n pskb ppka ppska x k #i.
    DataSent(S_b, S_a, n, pskb, ppka, ppska, x, k) @i
    ==>
    (Ex pkb pka bit #j.
        AccessGranted(S_a, S_b, n, pka, pkb, bit) @j &
        #j < #i 
    )"

lemma authentication_data_origin:// 数据源认证
"All S_b S_a n alpha beta ppska pkb k x #i.
    DataReceive(S_b, S_a, n, alpha, beta, ppska, pkb, k, x) @i
    ==>
    (Ex pskb ppka pka #j.
        DataSent(S_b, S_a, n, pskb, ppka, pka, x, k) @j &
        #j < #i 
    )"

lemma Cross_Domain_Policy_Consistency://域策略一致性
    all-traces
    "
        All A B PbIn mt_root new_mt_root #i1 #i2 #i3.
        PolicyRegister(A, B, %1 %+ %1, '1', A, B) @ #i1
        & ProcessPolicy(A, B,  %1 %+ %1, PbIn, mt_root, new_mt_root) @ #i2
        & PolicyRegisterEnd(A, B,  %1 %+ %1, '1', A, B) @ #i3
        & #i1 < #i2
        & #i2 < #i3 
        & not(A = B)
        ==>
         (Ex new_mt_root_A new_mt_root_B #j1 #j2.
            New_MerkleRoot(A, B,  %1 %+ %1, new_mt_root_A) @ #j1
            & New_MerkleRoot(B, A, %1 %+ %1, new_mt_root_B) @ #j2
            // & #i3 < #j1
            // & #j1 < #j2
            & new_mt_root_A = new_mt_root_B
            & new_mt_root_A = new_mt_root
            )  // 策略的 Merkle 根节点保持一致
    "
//假设：
//假设在某一时刻，策略 P 被提交给域 A 和 B，并且在策略注册时，已经通过签名验证。
//假设域 A 和 B 都成功提交了策略，并且策略通过了验证。
//结论：在合理的时间内，策略会被所有域记录并生效。
// lemma Policy_Registration_Liveness:
//     exists-trace
//     "
//         Ex A B Pb mt_root #i1 #i2 #i3 #i4 #i5.
//         Epoch_init('epoch', %1) @ #i1
//         & InitDomain(A, %1) @ #i2
//         & InitDomain(B, %1) @ #i3
//         & Update_epoch('epoch', %1 %+ %1) @ #i4
//         & PolicyRegister(A, B, %1 %+ %1, '1', A, B) @ #i5
//         & PolicyRegisterEnd(A, B, %1 %+ %1, '1', A, B) @ #i6
//         & PolicyRegisterEnd(B, A, %1 %+ %1, '1', B, A) @ #i7
//         & #i1 < #i2 < #i3 < #i4 < #i5 < #i6 < #i7
//         & not(A = B)
//         & Eq(mt_root, h(<pka, pkb, %1>))
//     "

/* ------------------------------------------------------------------------- */
/* HCC v4 proof layer for the minimally repaired full CDDS model.            */
/* ------------------------------------------------------------------------- */

lemma reachable_repaired_running_commit:
  exists-trace
  "Ex S_a S_b A B n sid x k T #running #commit.
     RunningResponder(S_b,S_a,A,B,n,sid,x,k,T) @ #running
   & CommitInitiator(S_a,S_b,A,B,n,sid,x,k,T) @ #commit
   & #running < #commit"

lemma reachable_repaired_normal_transfer:
  exists-trace
  "Ex S_a S_b A B n sid x k T #send #accept #erase.
     RepairDataSent(S_b,S_a,A,B,n,sid,x,k,T) @ #send
   & RepairDataAccepted(S_a,S_b,A,B,n,sid,x,k,T) @ #accept
   & SessionErased(S_a,S_b,n,sid) @ #erase
   & #send < #accept
   & #accept < #erase"

lemma repaired_authorization_before_send:
  all-traces
  "All S_b S_a A B n sid x k T #send.
     RepairDataSent(S_b,S_a,A,B,n,sid,x,k,T) @ #send
     ==>
       (Ex X hGrant #grant.
          RepairAccessGranted(S_a,S_b,A,B,n,sid,X,hGrant) @ #grant
        & #grant < #send)"

lemma repaired_lowe_data_aliveness:
  all-traces
  "All S_a S_b A B n sid x k T #commit.
     CommitInitiator(S_a,S_b,A,B,n,sid,x,k,T) @ #commit
   & not (Ex #reveal.
            Reveal_Subject(S_b,n) @ #reveal
          & #reveal < #commit)
     ==>
       (Ex Peer A2 B2 n2 sid2 x2 k2 T2 #running.
          RunningResponder(S_b,Peer,A2,B2,n2,sid2,x2,k2,T2) @ #running
        & #running < #commit)"

lemma repaired_lowe_data_weak_agreement:
  all-traces
  "All S_a S_b A B n sid x k T #commit.
     CommitInitiator(S_a,S_b,A,B,n,sid,x,k,T) @ #commit
   & not (Ex #reveal.
            Reveal_Subject(S_b,n) @ #reveal
          & #reveal < #commit)
     ==>
       (Ex A2 B2 n2 sid2 x2 k2 T2 #running.
          RunningResponder(S_b,S_a,A2,B2,n2,sid2,x2,k2,T2) @ #running
        & #running < #commit)"

lemma repaired_lowe_data_noninjective_agreement:
  all-traces
  "All S_a S_b A B n sid x k T #commit.
     CommitInitiator(S_a,S_b,A,B,n,sid,x,k,T) @ #commit
   & not (Ex #reveal.
            Reveal_Subject(S_b,n) @ #reveal
          & #reveal < #commit)
     ==>
       (Ex #running.
          RunningResponder(S_b,S_a,A,B,n,sid,x,k,T) @ #running
        & #running < #commit)"

/* Injectivity is deliberately split from non-injective agreement to reduce
 * proof-search branching and to expose reliance on the original uniqueness
 * restrictions. */
lemma repaired_commit_is_single_use:
  all-traces
  "All S_a S_b A B n sid x1 k1 T1 x2 k2 T2 #i #j.
     CommitInitiator(S_a,S_b,A,B,n,sid,x1,k1,T1) @ #i
   & CommitInitiator(S_a,S_b,A,B,n,sid,x2,k2,T2) @ #j
   ==> #i = #j"

lemma reachable_repaired_ephemeral_compromise:
  exists-trace
  "Ex S_a S_b A B n sid x k T b #send #reveal #learn.
     RepairDataSent(S_b,S_a,A,B,n,sid,x,k,T) @ #send
   & RevealEphemeralR(S_a,S_b,n,sid,b) @ #reveal
   & K(x) @ #learn
   & #send < #reveal
   & #reveal < #learn"

lemma repaired_session_key_secrecy_after_erasure:
  all-traces
  "All S_a S_b A B n sid x k T #send #erase #learn.
     RepairDataSent(S_b,S_a,A,B,n,sid,x,k,T) @ #send
   & SessionErased(S_a,S_b,n,sid) @ #erase
   & K(k) @ #learn
   & #erase < #learn
   ==>
      ((Ex a #ri.
          RevealEphemeralI(S_a,S_b,n,sid,a) @ #ri
        & #ri < #learn)
       | (Ex b #rr.
          RevealEphemeralR(S_a,S_b,n,sid,b) @ #rr
        & #rr < #learn))"

lemma repaired_standard_forward_secrecy:
  all-traces
  "All S_a S_b A B n sid x k T #send #accept #erase #reveal.
     RepairDataSent(S_b,S_a,A,B,n,sid,x,k,T) @ #send
   & RepairDataAccepted(S_a,S_b,A,B,n,sid,x,k,T) @ #accept
   & SessionErased(S_a,S_b,n,sid) @ #erase
   & Reveal_Subject(S_a,n) @ #reveal
   & #send < #accept
   & #accept < #erase
   & #erase < #reveal
   ==>
     not (Ex #learn.
            K(x) @ #learn
          & #reveal < #learn
          & not (Ex a #ri.
                   RevealEphemeralI(S_a,S_b,n,sid,a) @ #ri
                 & #ri < #learn)
          & not (Ex b #rr.
                   RevealEphemeralR(S_a,S_b,n,sid,b) @ #rr
                 & #rr < #learn))"

lemma repaired_intra_epoch_compromise_resilience:
  all-traces
  "All S_a S_b A B n sid x k T #send #accept #erase #reveal.
     RepairDataSent(S_b,S_a,A,B,n,sid,x,k,T) @ #send
   & RepairDataAccepted(S_a,S_b,A,B,n,sid,x,k,T) @ #accept
   & SessionErased(S_a,S_b,n,sid) @ #erase
   & Reveal_Subject(S_a,n) @ #reveal
   & #send < #accept
   & #accept < #erase
   & #erase < #reveal
   ==>
     not (Ex #learn.
            K(x) @ #learn
          & #reveal < #learn
          & not (Ex nNext #transition.
                   Update_epoch('epoch',nNext) @ #transition
                 & #send < #transition
                 & #transition < #learn)
          & not (Ex a #ri.
                   RevealEphemeralI(S_a,S_b,n,sid,a) @ #ri
                 & #ri < #learn)
          & not (Ex b #rr.
                   RevealEphemeralR(S_a,S_b,n,sid,b) @ #rr
                 & #rr < #learn))"

lemma repaired_cross_epoch_key_compromise_isolation:
  all-traces
  "All S_a S_b A B n sid x k T #send #accept #erase #transition #revealNew.
     RepairDataSent(S_b,S_a,A,B,n,sid,x,k,T) @ #send
   & RepairDataAccepted(S_a,S_b,A,B,n,sid,x,k,T) @ #accept
   & SessionErased(S_a,S_b,n,sid) @ #erase
   & Update_epoch('epoch',n %+ %1) @ #transition
   & Reveal_Subject(S_a,n %+ %1) @ #revealNew
   & #send < #accept
   & #accept < #erase
   & #erase < #transition
   & #transition < #revealNew
   ==>
     not (Ex #learn.
            K(x) @ #learn
          & #revealNew < #learn
          & not (Ex a #ri.
                   RevealEphemeralI(S_a,S_b,n,sid,a) @ #ri
                 & #ri < #learn)
          & not (Ex b #rr.
                   RevealEphemeralR(S_a,S_b,n,sid,b) @ #rr
                 & #rr < #learn))"

end
