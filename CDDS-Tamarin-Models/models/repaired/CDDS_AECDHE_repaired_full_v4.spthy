/* Cross-Domain Access Control Protocol */
/* Full minimal-repair model for the HCC revision.                    */
/* Base: 2026 CSCWD/code/PT_CDDS.spthy.                               */
/* Registration, policy, Merkle, BFT, reconfiguration, and adversary */
/* rules are retained. Only the four M1/M2/M3 data-path rules are     */
/* changed to authenticate ephemeral DH and erase session secrets.    */
//以下的群私钥均是由域运行各自的BFT协议生成的，群私钥为抽象概念
//群公钥则为运行bft协议
//此版本为1后面一版，用于添加针对域重构环节的攻击
theory CDDS_AECDHE_repaired_full_v4
begin

/* Types and cryptographic primitives */
builtins: hashing, signing, symmetric-encryption, diffie-hellman, asymmetric-encryption, multiset, natural-numbers

/* Function symbols */
functions: 
  PEnc/3,     // PCE 加密函数（ppk, 明文, 随机数）
  PDec/2,     // PCE 解密函数（psk, 密文）
  ppk/1,      // Plaintext-Checkable Public Key（输入私钥，输出公钥）
  kdf_data/2, // session data-key derivation
  kdf_conf/2  // responder key-confirmation derivation

/* Equation for plaintext checkable encryption */
equations:
    PDec(ppsk, PEnc(ppk(ppsk), k, r)) = k  // 保证解密准确性
// equations:
//     Enc(k, Dec(k, x)) = x  // 保证解密准确性
restriction Equality:
"All x y #i. Eq(x,y) @#i ==> x = y"
restriction unique_InitEpoch://epoch初始化唯一性
"All  #i #j. Epoch_init('epoch', %1) @#i & Epoch_init('epoch', %1) @#j ==> #i = #j"
restriction unique_EpochUpdate://epoch更新唯一性
"All a b  #i #j. Update_epoch('epoch', a %+ %1) @#i & Update_epoch('epoch', b %+ %1) @#j & a = b ==> #i = #j"
restriction unique_InitDomain://域初始化的唯一性
"All x y #i #j. InitDomain(x,%1) @#i & InitDomain(y,%1) @#j &(x = y) ==> #i = #j"
restriction unique_Reconfig://域重配置唯一性
"All x y epoch #i #j. Domain_Reconfig_Event(x, epoch %+ %1) @#i & Domain_Reconfig_Event(y, epoch %+ %1) @#j &(x = y) ==> #i = #j"
restriction Reconfig_sequence://域重配置顺序
"All x epoch #i. Domain_Reconfig_Event(x, epoch) @#i  ==> not(Ex #j. Update_epoch('epoch', epoch %+ %1)@#j & #j < #i)"
restriction unique_Domain_Receive_Signature://域接受签名唯一性
"All x y epoch #i #j. Domain_Reconfig_Event(x, epoch %+ %1) @#i & Domain_Reconfig_Event(y, epoch %+ %1) @#j &(x = y) ==> #i = #j"
restriction merkle_onlyOnce1://merkle树初始化的唯一性
"All A B mt_root #i #j.
    Initial_mt_root_between_domain(A, B, mt_root) @#i & Initial_mt_root_between_domain(A, B, mt_root) @#j ==> #i = #j & not(A = B)"
restriction unique_InitSubject://主体初始化的唯一性
"All x y n #i #j. InitSubject(x, n) @#i & InitSubject(y, n) @#j &(x = y) ==> #i = #j"
restriction unique_SubjectKey://主体初始化密钥不能相等
"All x y n psk1 psk2 ppsk1 ppsk2 #i #j. SubjectKey(x, n, psk1, ppsk1) @#i & SubjectKey(y, n, psk2, ppsk2) @#j & not(x=y)==> ( (not(psk1 = psk2)) & (not(ppsk1 = ppsk2)))"
restriction unique_IssueCert://主体只能在一个域中注册
"All S A B n gskA gskB #i #j. IssueCert(A, S, n, gskA) @#i & IssueCert(B, S, n, gskB) @#j ==> (#i = #j & A = B & gskA = gskB)"
restriction Only_unregistered_can_submit://没注册过的主体才能在域中注册
"All S A n #i. Subject_Register(S,A,n) @#i ==> not (Ex B gsk #j.(IssueCert(B,S,n,gsk)@#j) & (not(A = B)) & (#j < #i))"//
restriction unique_Policy_register://策略一致（不能出现相互矛盾的策略）
"All S_a S_b n bit1 bit2 A B #i #j.
    PolicyRegister(S_a, S_b, n, bit1, A, B) @ #i & PolicyRegister(S_a, S_b, n, bit2, A, B) @ #j ==> (#i = #j & bit1 = bit2)"
restriction Subject_before_PolicyRegister://注册策略前主体已经在域中注册
"All S_a S_b n bit A B #i.
PolicyRegister(S_a, S_b, n, bit, A, B) @ #i 
==>(Ex gskA gskB #j #k. 
    IssueCert(A, S_a, n, gskA)@#j 
    & IssueCert(B, S_b, n, gskB)@#k 
    &(#j < #i) & (#k < #i)& not(A = B))"
restriction unique_ProcessPolicy://策略注册独特性
"All B A n Pb1 Pb2 mt1 mt2 new_mt_root_B1 new_mt_root_B2 #i #j.
    ProcessPolicy(A, B, n, Pb1, mt1, new_mt_root_B1) @ #i & ProcessPolicy(A, B, n, Pb2, mt2, new_mt_root_B2) @ #j &(Pb1 = Pb2)==> (#i = #j & mt1 = mt2 & new_mt_root_B1 = new_mt_root_B2)"

restriction 1://不能再次提出注册已有的策略请求
"All A B n S_a S_b bit #i.PolicyRegister(S_a, S_b, n, bit, A, B)@#i 
==>not(Ex #j. PolicyRegisterEnd(S_a, S_b, n, bit, A, B)@#j & #j < #i)"

restriction unique_AccessRequest:
"All S_a S_b n A B pska pskb gskA #i #j.
    AccessRequest(S_a, S_b, n, A, B, pska, pskb, gskA)@#i & AccessRequest(S_a, S_b, n, A, B, pska, pskb, gskA)@#j ==> #i = #j"

restriction unique_AccessGranted:
"All S_a S_b n pka pkb bit #i #j.
    AccessGranted(S_a, S_b, n, pka, pkb, bit) @#i & AccessGranted(S_a, S_b, n, pka, pkb, bit) @#j ==> #i = #j"

restriction unique_Datasend:
"All S_a S_b n1 n2 pskb ppka pka x k #i #j.
    DataSent(S_b, S_a, n1, pskb, ppka, pka, x, k) @#i & DataSent(S_b, S_a, n2, pskb, ppka, pka, x, k) @#j & n1 = n2 ==> #i = #j"
restriction unique_DataReceive: 
"All S_a S_b n1 n2 alpha beta pska pkb k x #i #j.
    DataReceive(S_b, S_a, n1, alpha, beta, pska, pkb, k, x) @#i & DataReceive(S_b, S_a, n2, alpha, beta, pska, pkb, k, x) @#j & n1 = n2 ==> #i = #j"
// 攻击限制:域重构被抢先注册之后无法在被注册（信任链被窃取）
restriction Domain_Reconfiguration_adversary1:
"All domain_id epoch #i.
    Domain_Reconfig_adversary(domain_id, epoch %+ %1) @#i  ==> not(Ex #j. Domain_Reconfig_Event(domain_id, epoch %+ %1) @#j)"
// restriction Adversary_Only_Once://攻击一次就够了
// "All domain_id epoch #i.Domain_Reconfig_adversary(domain_id, epoch %+ %1)@#i 
// ==>not(Ex #j. Domain_Reconfig_adversary(domain_id, epoch %+ %1)@#j & #j < #i)"

// restriction LessThan:
//   "All x y #i. LessThan(x,y)@#i ==> x ⊏ y"

/* ----------------------------第一部分：域以及主体初始化------------------------------------------- */
//生成初始计时器
rule epoch_Init:
    [  ]
    --[ Epoch_init('epoch', %1) ]->
    [ !Epoch('epoch', %1) ]
//计时器更新
rule epoch_update[role="epoch_update"]:
    [ !Epoch('epoch', %n) ]
    --[ Update_epoch('epoch', %n %+ %1) ]->
    [ !Epoch('epoch', %n %+ %1) ]

//生成初始树根值
rule initial_mt_root:
    [ Fr(~mt_root) ]
    --[  ]->
    [ !Initial_merkle_root(~mt_root) ]
// 域初始化
rule Domain_Init:
    [ 
        Fr(~gsk)//域私钥
    ]  
    --[ 
        InitDomain($I, %1) 
        , Domain1($I, %1, ~gsk, pk(~gsk))
    ]->
    [ 
        // MerkleRoot($I, mt_root)//初始化树
        !Domain($I, %1, ~gsk, pk(~gsk))
        , !Domain_id($I)
    ]

//初始化域间merkle树根节点
rule Initial_mt_root_between_domain:
    [ 
        !Domain_id($A)
        , !Domain_id($B)
        , !Initial_merkle_root(mt_root)
     ]
    --[ Initial_mt_root_between_domain($A, $B, mt_root) ]->
    [ 
        MerkleRoot($A, $B, mt_root)//A的merkle树
     ]

// 规则：域重配置（PT-CDDS文献3.3节“BFT-based Domain Reconfiguration”）
rule Domain_Reconfiguration[role="Reconfiguration"]:
    [ 
        !Domain($domain_id, %epoch, old_gsk, pk(old_gsk))
        , !Epoch('epoch', %n)
        , Fr(~new_gsk)
    ]
    --[ 
        Domain_Reconfig_Event($domain_id, %epoch %+ %1)
        , DDomain($domain_id, %epoch)
        , Eq(%epoch %+ %1, %n)
     ]->  // 记录重配置事件
    [ 
        // 右侧：生成新域状态（替代旧状态，实现旧态逻辑消去）
        !Domain($domain_id, %epoch %+ %1, ~new_gsk, pk(~new_gsk))
        , Out(<pk(~new_gsk), sign(pk(~new_gsk), old_gsk), pk(old_gsk), 'Update domain public key'>)//旧私钥加密新公钥
        // , Epoch('epoch', %n)
    ]
//其他域接收并验证签名
rule Domain_Reconfiguration_Receive_Signature[role="Reconfiguration"]:
    [ 
        In(<Pkin, Pksign, OldPk, field>)
        , !Domain($domain_id, %epoch, old_gsk, pk(old_gsk))
     ]
    --[ 
        Eq(field, 'Update domain public key')
        , Eq(verify(Pksign, Pkin, OldPk), true)//验证旧私钥签名新公钥
        , Eq(OldPk, pk(old_gsk))
        , Domain_Pk_Trust($domain_id, %epoch %+ %1, Pkin)//记录接受验证新公钥签名行为
     ]->
    [ 
        !Domain_Pk($domain_id, %epoch %+ %1, Pkin)//接受签名（不管是不是恶意）
     ]

lemma domain_initialization_feasibility:
  exists-trace
  "
    (/* 1. 纪元成功初始化 */
     Ex A B mt_root pk1  #i1 #i2 #i3 #i4 #i5 #i6 #i7. 
     Epoch_init('epoch', %1)@#i1
     /* 2. 至少两个域完成初始化 */
     & InitDomain(A, %1)@#i2 & #i1 < #i2 
     & InitDomain(B, %1)@#i3 & #i1 < #i3 & not(A = B)
     & Initial_mt_root_between_domain(A, B, mt_root)@#i4 & #i2 < #i4 & #i3 < #i4   /* 3. 初始Merkle树根生成（在域初始化之后） */
     & Update_epoch('epoch', %1 %+ %1) @#i5 & #i4 < #i5
     & Domain_Reconfig_Event(A, %1 %+ %1)@#i6 & #i5 < #i6 & not(Ex #x1. DDomain(A, %1 %+ %1) @#x1 & #x1 < #i6) 
     & Domain_Pk_Trust(A, %1 %+ %1, pk1) @#i7 
    )"


/* ---------------------------------------第二部分：主体在各自域内注册------------------------------------------- */

rule Subject_Init[role="Subject_Register"]:
    [ 
        Fr(~psk)
        , Fr(~ppsk)
        , !Epoch('epoch', %n)
    ]
    --[ 
        InitSubject($S, %n) 
        , SubjectKey($S, %n, ~psk, ~ppsk)
    ]->
    [ 
        Subject_NR($S, %n, ~psk, ~ppsk, pk(~psk),ppk(~ppsk))
        // Subject_NR($S, pk(~psk),pk(~ppsk))
        // , SubjectPrivateKey_NR($S, ~psk)
        , SubjectSKpari_NR($S, %n, ~psk, ~ppsk)
        , Out(<pk(~psk),ppk(~ppsk), %n, 'Subject Pk'>)
     ]

rule Subject_Register[role="Subject_Register"]:
    let
        info = 'user_info'
        CertR = < spk, sppk, %n >
    in
    [ 
        !Epoch('epoch', %n)
        , !Domain($I, %n, gsk, gpk)
        , Subject_NR($S, %n, psk, ppsk, spk, sppk)
     ]
    --[ 
        Subject_Register($S, $I, %n)
     ]->
    [ 
        Out(<CertR, sign(CertR, psk), 'Subject Register'>)//用主体私钥签名注册请求
        , Subject_Register_request($S, $I, %n)//主体注册请求
     ]

rule Domain_Register[role="Subject_Register"]:
    let
        // spk = fst(SPKpair)//主体公钥
        // sppk = fst(snd(SPKpair))
        // epochIn = snd(snd(SPKpair))
        SubjectCert = <spk, sppk, %n>
    in
    [ 
        In(<spk, sppk, epochIn, field1>)
        , In(<CertR, Sign_CertR, field2>)
        // , !DomainPublicKey($I, gpk)//gpkA
        // , !DomainPrivateKey($I, gsk)
        , !Domain($I, %n, gsk, gpk)
        , Subject_Register_request($S, $I, %n)
        , SubjectSKpari_NR($S, %n, psk, ppsk)
     ]
    --[ 
        Eq(field1, 'Subject Pk')
        , Eq(spk,pk(psk))
        , Eq(sppk, ppk(ppsk))
        , Eq(epochIn, %n)
        , Eq(field2, 'Subject Register')
        , Eq(verify(Sign_CertR, CertR, spk), true)    //验证主体证书
        , IssueCert($I, $S, %n, gsk)//记录域认证动作行为
        , Subject1($S, $I, %n, psk, ppsk, spk, sppk)
     ]->
    [ 
        Out(<SubjectCert, sign(SubjectCert, gsk), gpk, 'SubjectCert'>)//输出主体的证书，可信 SPKpair为主体的公钥对
        , !Subject($S, $I, %n, psk, ppsk, spk, sppk)
        // , !SubjectPrivateKey($S, psk, ppsk)
    ]



