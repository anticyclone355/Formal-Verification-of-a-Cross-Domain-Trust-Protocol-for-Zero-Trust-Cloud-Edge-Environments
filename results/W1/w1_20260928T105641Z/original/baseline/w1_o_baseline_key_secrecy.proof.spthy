*/
by sorry

lemma w1_o_baseline_key_secrecy:
  all-traces
  "∀ I R e x k #send #accept #check.
    (((((((W1Sent( I, R, e, x, k ) @ #send) ∧
          (W1Accepted( I, R, e, x, k ) @ #accept)) ∧
         (#send < #accept)) ∧
        (#accept < #check)) ∧
       (¬(∃ kind principal epoch #lt.
           (W1LtkReveal( kind, principal, epoch ) @ #lt) ∧ (#lt < #check)))) ∧
      (¬(∃ role handle secret #dk.
          (W1SessionKeyReveal( role, handle, secret ) @ #dk) ∧ (#dk < #check)))) ∧
     (K( k ) @ #check)) ⇒
    (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ I R e x k #send #accept #check.
  (W1Sent( I, R, e, x, k ) @ #send) ∧
  (W1Accepted( I, R, e, x, k ) @ #accept) ∧
  (K( k ) @ #check)
 ∧
  (#send < #accept) ∧
  (#accept < #check) ∧
  (∀ kind principal epoch #lt.
    (W1LtkReveal( kind, principal, epoch ) @ #lt) ⇒ ¬(#lt < #check)) ∧
  (∀ role handle secret #dk.
    (W1SessionKeyReveal( role, handle, secret ) @ #dk) ⇒ ¬(#dk < #check))"
*/
simplify
solve( AccessCert_send( $S_a, $S_b, %n, pka, pkb, pskb, ppka, $A, $B,
                        gpkA, pk(x)
       ) ▶₁ #send )
  case Domain_Access_Verification
  solve( !Subject( 'requester', 'domain_A', %1, pska.1, ppska.1, pk(~si),
                   ppk(~pi)
         ) ▶₂ #send )
    case W1_Setup
    solve( !Subject( 'owner', 'domain_B', %1, ~sr, ppskb.1, pk(~sr), ppkb
           ) ▶₃ #send )
      case W1_Setup
      solve( X_send( 'owner', 'requester', %1, pskb, pk(x.1), ppskb, pska,
                     ppska, <~data, sign(~data, x.1), pk(x.1)>, ~data, ~k
             ) ▶₁ #accept )
        case Object_Data_Encryption
        solve( !KU( ~k ) @ #vk.12 )
          case Object_Data_Encryption
          solve( !KU( ~pi ) @ #vk.33 )
            case Reveal_Original_SessionKey
            by contradiction /* from formulas */
          next
            case Reveal_PCEKey
            by contradiction /* from formulas */
          qed
        next
          case Reveal_Original_SessionKey
          by contradiction /* from formulas */
        qed
      next
        case Reveal_Original_SessionKey
        by contradiction /* from formulas */
      qed
    qed
  qed
qed

