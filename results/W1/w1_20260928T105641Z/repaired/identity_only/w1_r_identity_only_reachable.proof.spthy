theory W1_AECDHE_Reveal_Matrix begin

// Function signature and definition of the equational theory E

builtins: diffie-hellman, natural-numbers
functions: PDec/2, PEnc/3, fst/1, h/1, kdf_conf/2, kdf_data/2, pair/2,
           pk/1, ppk/1, sdec/2, senc/2, sign/2, snd/1, true/0, verify/3
equations:
    PDec(psk, PEnc(ppk(psk), k, r)) = k,
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true















restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction W1_OneSetup:
  "∀ #i #j. ((W1Init( ) @ #i) ∧ (W1Init( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

rule (modulo E) W1_Setup:
   [ Fr( ~si ), Fr( ~pi ), Fr( ~sr ), Fr( ~pr ), Fr( ~da ), Fr( ~db ) ]
  --[ W1Init( ) ]->
   [
   !Subject( 'requester', 'domain_A', %1, ~si, ~pi, pk(~si), ppk(~pi) ),
   !Subject( 'owner', 'domain_B', %1, ~sr, ~pr, pk(~sr), ppk(~pr) ),
   !Domain( 'domain_A', %1, ~da, pk(~da) ),
   !Domain( 'domain_B', %1, ~db, pk(~db) ),
   !Policy( 'domain_A', 'domain_B', %1, 'requester', 'owner', '1' ),
   W1_RequestReady( 'requester', 'owner', 'domain_A', 'domain_B', %1 ),
   W1_IdAvailable( 'requester', %1 ), W1_PceAvailable( 'requester', %1 ),
   W1_IdAvailable( 'owner', %1 ), W1_PceAvailable( 'owner', %1 ),
   W1_DomainAvailable( 'domain_A', %1 ),
   W1_DomainAvailable( 'domain_B', %1 ), W1_ProbeReady( ),
   Out( <pk(~si), ppk(~pi), %1, 'Subject Pk'> ),
   Out( <pk(~sr), ppk(~pr), %1, 'Subject Pk'> ),
   Out( <<pk(~si), ppk(~pi), %1>, sign(<pk(~si), ppk(~pi), %1>, ~da), 
         pk(~da), 'SubjectCert'>
   ),
   Out( <<pk(~sr), ppk(~pr), %1>, sign(<pk(~sr), ppk(~pr), %1>, ~db), 
         pk(~db), 'SubjectCert'>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) W1_Probe:
   [ W1_ProbeReady( ) ] --[ W1Probe( ) ]-> [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_IdentityKey:
   [ !Subject( $S, $D, %n, sk, psk, pkS, ppkS ), W1_IdAvailable( $S, %n ) ]
  --[ Reveal_IdentityKey( $S, %n ), W1LtkReveal( 'identity', $S, %n ) ]->
   [ Out( sk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_PCEKey:
   [ !Subject( $S, $D, %n, sk, psk, pkS, ppkS ), W1_PceAvailable( $S, %n ) ]
  --[ Reveal_PCEKey( $S, %n ), W1LtkReveal( 'pce', $S, %n ) ]->
   [ Out( psk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_DomainKey:
   [ !Domain( $D, %n, sk, pkD ), W1_DomainAvailable( $D, %n ) ]
  --[ Reveal_Domain( $D, %n ), W1LtkReveal( 'domain', $D, %n ) ]->
   [ Out( sk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Subject_Access_Request[role=Authentication_and_Data_Sharing]:
   [
   W1_RequestReady( $S_a, $S_b, $A, $B, %n ),
   !Subject( $S_a, $A, %n, pska, ppska, pka, ppka ),
   !Subject( $S_b, $B, %n, pskb, ppskb, pkb, ppkb ),
   !Domain( $A, %n, gskA, gpkA ), !Domain( $B, %n, gskB, gpkB ), Fr( ~sid ),
   Fr( ~ie ), In( <CertA, CertaSign, SignPk, field> )
   ]
  --[
  Eq( field, 'SubjectCert' ), Eq( SignPk, gpkA ),
  Eq( verify(CertaSign, CertA, gpkA), true ), Eq( fst(CertA), pka ),
  Eq( fst(snd(CertA)), ppka ), Eq( snd(snd(CertA)), %n ),
  AccessRequest( $S_a, $S_b, %n, $A, $B, pska, pskb, gskA ),
  RepairAccessRequest( $S_a, $S_b, $A, $B, %n, ~sid, 'g'^~ie ),
  W1Request( $S_a, $S_b, %n, ~sid )
  ]->
   [
   Out( <<<CertA, CertaSign, SignPk>, pkb, %n, ~sid, 'g'^~ie>, 
         sign(<<CertA, CertaSign, SignPk>, pkb, %n, ~sid, 'g'^~ie>, pska), pka, 
         'AccessR_a_fs'>
   ),
   Access_send( $S_a, $S_b, %n, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB,
                ppka
   ),
   St_Initiator_DH( $S_a, $S_b, $A, $B, %n, ~sid, ~ie, 'g'^~ie, pka, ppka,
                    pkb, 'clean'
   )
   ]

  /*
  rule (modulo AC) Subject_Access_Request[role=Authentication_and_Data_Sharing]:
     [
     W1_RequestReady( $S_a, $S_b, $A, $B, %n ),
     !Subject( $S_a, $A, %n, pska, ppska, pka, ppka ),
     !Subject( $S_b, $B, %n, pskb, ppskb, pkb, ppkb ),
     !Domain( $A, %n, gskA, gpkA ), !Domain( $B, %n, gskB, gpkB ), Fr( ~sid ),
     Fr( ~ie ), In( <CertA, CertaSign, SignPk, field> )
     ]
    --[
    Eq( field, 'SubjectCert' ), Eq( SignPk, gpkA ), Eq( z, true ),
    Eq( z.1, pka ), Eq( z.2, ppka ), Eq( z.3, %n ),
    AccessRequest( $S_a, $S_b, %n, $A, $B, pska, pskb, gskA ),
    RepairAccessRequest( $S_a, $S_b, $A, $B, %n, ~sid, 'g'^~ie ),
    W1Request( $S_a, $S_b, %n, ~sid )
    ]->
     [
     Out( <<<CertA, CertaSign, SignPk>, pkb, %n, ~sid, 'g'^~ie>, 
           sign(<<CertA, CertaSign, SignPk>, pkb, %n, ~sid, 'g'^~ie>, pska), pka, 
           'AccessR_a_fs'>
     ),
     Access_send( $S_a, $S_b, %n, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB,
                  ppka
     ),
     St_Initiator_DH( $S_a, $S_b, $A, $B, %n, ~sid, ~ie, 'g'^~ie, pka, ppka,
                      pkb, 'clean'
     )
     ]
    variants (modulo AC)
    1. CertA = CertA.37
       CertaSign
             = CertaSign.38
       gpkA  = gpkA.41
       z     = verify(CertaSign.38, CertA.37, gpkA.41)
       z.1   = fst(CertA.37)
       z.2   = fst(snd(CertA.37))
       z.3   = snd(snd(CertA.37))
    
    2. CertA = CertA.204
       CertaSign
             = sign(CertA.204, x.400)
       gpkA  = pk(x.400)
       z     = true
       z.1   = fst(CertA.204)
       z.2   = fst(snd(CertA.204))
       z.3   = snd(snd(CertA.204))
    
    3. CertA = <z.77, z.78, z.79>
       CertaSign
             = CertaSign.56
       gpkA  = gpkA.59
       z     = verify(CertaSign.56, <z.77, z.78, z.79>, gpkA.59)
       z.1   = z.77
       z.2   = z.78
       z.3   = z.79
    
    4. CertA = <z.161, x.291>
       CertaSign
             = sign(<z.161, x.291>, x.292)
       gpkA  = pk(x.292)
       z     = true
       z.1   = z.161
       z.2   = fst(x.291)
       z.3   = snd(x.291)
    
    5. CertA = <z.162, z.163, z.164>
       CertaSign
             = sign(<z.162, z.163, z.164>, x.294)
       gpkA  = pk(x.294)
       z     = true
       z.1   = z.162
       z.2   = z.163
       z.3   = z.164
    
    6. CertA = <z.223, x.395>
       CertaSign
             = CertaSign.202
       gpkA  = gpkA.205
       z     = verify(CertaSign.202, <z.223, x.395>, gpkA.205)
       z.1   = z.223
       z.2   = fst(x.395)
       z.3   = snd(x.395)
  */

rule (modulo E) Domain_Access_Verification[role=Authentication_and_Data_Sharing]:
   [
   In( <AccessRa, AccesssSign, AccessPKa, field> ),
   Access_send( $S_a, $S_b, %n, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB,
                ppka
   ),
   !Policy( $A, $B, %n, $S_a, $S_b, bit ),
   !Subject( $S_b, $B, %n, pskb, ppskb, pkb, ppkb )
   ]
  --[
  Eq( field, 'AccessR_a_fs' ), Eq( pka, AccessPKa ),
  Eq( verify(AccesssSign, AccessRa, pka), true ),
  Eq( fst(snd(AccessRa)), pkb ), Eq( fst(snd(snd(AccessRa))), %n ),
  Eq( bit, '1' ), AccessGranted( $S_a, $S_b, %n, pka, pkb, bit ),
  RepairAccessGranted( $S_a, $S_b, $A, $B, %n,
                       fst(snd(snd(snd(AccessRa)))), snd(snd(snd(snd(AccessRa)))),
                       h(<pka, pkb, %n, fst(snd(snd(snd(AccessRa)))), 
                          snd(snd(snd(snd(AccessRa))))>)
  )
  ]->
   [
   Out( <
         h(<pka, pkb, %n, fst(snd(snd(snd(AccessRa)))), 
            snd(snd(snd(snd(AccessRa))))>), 
         sign(h(<pka, pkb, %n, fst(snd(snd(snd(AccessRa)))), 
                 snd(snd(snd(snd(AccessRa))))>),
              gskB), 
         pk(gskB), fst(snd(snd(snd(AccessRa)))), snd(snd(snd(snd(AccessRa)))), 
         'AccessCert_ab_fs'>
   ),
   AccessCert_send( $S_a, $S_b, %n, pka, pkb, pskb, ppka, $A, $B, gpkA, gpkB
   )
   ]

  /*
  rule (modulo AC) Domain_Access_Verification[role=Authentication_and_Data_Sharing]:
     [
     In( <AccessRa, AccesssSign, AccessPKa, field> ),
     Access_send( $S_a, $S_b, %n, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB,
                  ppka
     ),
     !Policy( $A, $B, %n, $S_a, $S_b, bit ),
     !Subject( $S_b, $B, %n, pskb, ppskb, pkb, ppkb )
     ]
    --[
    Eq( field, 'AccessR_a_fs' ), Eq( pka, AccessPKa ), Eq( z.2, true ),
    Eq( z.3, pkb ), Eq( z.4, %n ), Eq( bit, '1' ),
    AccessGranted( $S_a, $S_b, %n, pka, pkb, bit ),
    RepairAccessGranted( $S_a, $S_b, $A, $B, %n, z, z.1,
                         h(<pka, pkb, %n, z, z.1>)
    )
    ]->
     [
     Out( <h(<pka, pkb, %n, z, z.1>), sign(h(<pka, pkb, %n, z, z.1>), gskB), 
           pk(gskB), z, z.1, 'AccessCert_ab_fs'>
     ),
     AccessCert_send( $S_a, $S_b, %n, pka, pkb, pskb, ppka, $A, $B, gpkA, gpkB
     )
     ]
    variants (modulo AC)
     1. AccessRa
              = AccessRa.37
        AccesssSign
              = AccesssSign.38
        pka   = pka.45
        z     = fst(snd(snd(snd(AccessRa.37))))
        z.1   = snd(snd(snd(snd(AccessRa.37))))
        z.2   = verify(AccesssSign.38, AccessRa.37, pka.45)
        z.3   = fst(snd(AccessRa.37))
        z.4   = fst(snd(snd(AccessRa.37)))
    
     2. AccessRa
              = AccessRa.76
        AccesssSign
              = sign(AccessRa.76, x.145)
        pka   = pk(x.145)
        z     = fst(snd(snd(snd(AccessRa.76))))
        z.1   = snd(snd(snd(snd(AccessRa.76))))
        z.2   = true
        z.3   = fst(snd(AccessRa.76))
        z.4   = fst(snd(snd(AccessRa.76)))
    
     3. AccessRa
              = <x.31, x.32>
        AccesssSign
              = sign(<x.31, x.32>, x.33)
        pka   = pk(x.33)
        z     = fst(snd(snd(x.32)))
        z.1   = snd(snd(snd(x.32)))
        z.2   = true
        z.3   = fst(x.32)
        z.4   = fst(snd(x.32))
    
     4. AccessRa
              = <x.46, z.38, x.48>
        AccesssSign
              = sign(<x.46, z.38, x.48>, x.49)
        pka   = pk(x.49)
        z     = fst(snd(x.48))
        z.1   = snd(snd(x.48))
        z.2   = true
        z.3   = z.38
        z.4   = fst(x.48)
    
     5. AccessRa
              = <x.47, z.39, z.40, x.50>
        AccesssSign
              = sign(<x.47, z.39, z.40, x.50>, x.51)
        pka   = pk(x.51)
        z     = fst(x.50)
        z.1   = snd(x.50)
        z.2   = true
        z.3   = z.39
        z.4   = z.40
    
     6. AccessRa
              = <x.73, z.55, z.56, z.50, z.51>
        AccesssSign
              = sign(<x.73, z.55, z.56, z.50, z.51>, x.78)
        pka   = pk(x.78)
        z     = z.50
        z.1   = z.51
        z.2   = true
        z.3   = z.55
        z.4   = z.56
    
     7. AccessRa
              = <x.138, z.92, z.93, z.87, z.88>
        AccesssSign
              = AccesssSign.73
        pka   = pka.80
        z     = z.87
        z.1   = z.88
        z.2   = verify(AccesssSign.73, <x.138, z.92, z.93, z.87, z.88>, pka.80)
        z.3   = z.92
        z.4   = z.93
    
     8. AccessRa
              = <x.139, x.140>
        AccesssSign
              = AccesssSign.74
        pka   = pka.81
        z     = fst(snd(snd(x.140)))
        z.1   = snd(snd(snd(x.140)))
        z.2   = verify(AccesssSign.74, <x.139, x.140>, pka.81)
        z.3   = fst(x.140)
        z.4   = fst(snd(x.140))
    
     9. AccessRa
              = <x.140, z.94, x.142>
        AccesssSign
              = AccesssSign.75
        pka   = pka.82
        z     = fst(snd(x.142))
        z.1   = snd(snd(x.142))
        z.2   = verify(AccesssSign.75, <x.140, z.94, x.142>, pka.82)
        z.3   = z.94
        z.4   = fst(x.142)
    
    10. AccessRa
              = <x.141, z.95, z.96, x.144>
        AccesssSign
              = AccesssSign.76
        pka   = pka.83
        z     = fst(x.144)
        z.1   = snd(x.144)
        z.2   = verify(AccesssSign.76, <x.141, z.95, z.96, x.144>, pka.83)
        z.3   = z.95
        z.4   = z.96
  */

rule (modulo E) Object_Data_Encryption[role=Authentication_and_Data_Sharing]:
   [
   In( <Hash1, Hashsign, Hashpk, sid, X, field> ),
   AccessCert_send( $S_a, $S_b, %n, pka, pkb, pskb, ppka, $A, $B, gpkA, gpkB
   ),
   !Subject( $S_a, $A, %n, pska, ppska, pka, ppka ),
   !Subject( $S_b, $B, %n, pskb, ppskb, pkb, ppkb ), Fr( ~data ), Fr( ~re )
   ]
  --[
  Eq( field, 'AccessCert_ab_fs' ), Eq( gpkB, Hashpk ),
  Eq( verify(Hashsign, Hash1, gpkB), true ),
  Eq( Hash1, h(<pka, pkb, %n, sid, X>) ),
  DataSent( $S_b, $S_a, %n, pskb, ppka, pka, ~data,
            kdf_data(X^~re,
                     <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                      'g'^~re, h(Hash1)>)
  ),
  RepairDataSent( $S_b, $S_a, $A, $B, %n, sid, ~data,
                  kdf_data(X^~re,
                           <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                            'g'^~re, h(Hash1)>),
                  <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                   'g'^~re, h(Hash1)>
  ),
  W1Sent( $S_a, $S_b, %n, sid, ~data,
          kdf_data(X^~re,
                   <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                    'g'^~re, h(Hash1)>),
          <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
           'g'^~re, h(Hash1)>
  ),
  RunningResponder( $S_b, $S_a, $A, $B, %n, sid, ~data,
                    kdf_data(X^~re,
                             <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                              'g'^~re, h(Hash1)>),
                    <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                     'g'^~re, h(Hash1)>
  ),
  Secret( ~data, %n ),
  SessionKey( kdf_data(X^~re,
                       <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                        'g'^~re, h(Hash1)>),
              %n
  ),
  Honest( $S_a, %n ), Honest( $S_b, %n )
  ]->
   [
   Out( <sid, 'g'^~re, 
         senc(<~data, 
               sign(<~data, 'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, 
                     pkb, X, 'g'^~re, h(Hash1)>,
                    pskb), 
               pk(pskb)>,
              kdf_data(X^~re,
                       <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                        'g'^~re, h(Hash1)>)), 
         h(<'key-confirm', 
            kdf_conf(X^~re,
                     <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                      'g'^~re, h(Hash1)>), 
            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
             'g'^~re, h(Hash1)>, 
            h(senc(<~data, 
                    sign(<~data, 'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, 
                          pkb, X, 'g'^~re, h(Hash1)>,
                         pskb), 
                    pk(pskb)>,
                   kdf_data(X^~re,
                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                             'g'^~re, h(Hash1)>)))
           >), 
         Hash1, 'data_fs'>
   ),
   St_Responder_PreErase( $S_a, $S_b, $A, $B, %n, sid, ~re,
                          kdf_data(X^~re,
                                   <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                                    'g'^~re, h(Hash1)>),
                          ~data,
                          <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                           'g'^~re, h(Hash1)>,
                          'clean'
   ),
   W1_KeyRevealAvailable( 'responder', sid )
   ]

  /*
  rule (modulo AC) Object_Data_Encryption[role=Authentication_and_Data_Sharing]:
     [
     In( <Hash1, Hashsign, Hashpk, sid, X, field> ),
     AccessCert_send( $S_a, $S_b, %n, pka, pkb, pskb, ppka, $A, $B, gpkA, gpkB
     ),
     !Subject( $S_a, $A, %n, pska, ppska, pka, ppka ),
     !Subject( $S_b, $B, %n, pskb, ppskb, pkb, ppkb ), Fr( ~data ), Fr( ~re )
     ]
    --[
    Eq( field, 'AccessCert_ab_fs' ), Eq( gpkB, Hashpk ), Eq( z.1, true ),
    Eq( Hash1, h(<pka, pkb, %n, sid, X>) ),
    DataSent( $S_b, $S_a, %n, pskb, ppka, pka, ~data,
              kdf_data(z,
                       <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                        'g'^~re, h(Hash1)>)
    ),
    RepairDataSent( $S_b, $S_a, $A, $B, %n, sid, ~data,
                    kdf_data(z,
                             <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                              'g'^~re, h(Hash1)>),
                    <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                     'g'^~re, h(Hash1)>
    ),
    W1Sent( $S_a, $S_b, %n, sid, ~data,
            kdf_data(z,
                     <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                      'g'^~re, h(Hash1)>),
            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
             'g'^~re, h(Hash1)>
    ),
    RunningResponder( $S_b, $S_a, $A, $B, %n, sid, ~data,
                      kdf_data(z,
                               <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                                'g'^~re, h(Hash1)>),
                      <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                       'g'^~re, h(Hash1)>
    ),
    Secret( ~data, %n ),
    SessionKey( kdf_data(z,
                         <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                          'g'^~re, h(Hash1)>),
                %n
    ),
    Honest( $S_a, %n ), Honest( $S_b, %n )
    ]->
     [
     Out( <sid, 'g'^~re, 
           senc(<~data, 
                 sign(<~data, 'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, 
                       pkb, X, 'g'^~re, h(Hash1)>,
                      pskb), 
                 pk(pskb)>,
                kdf_data(z,
                         <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                          'g'^~re, h(Hash1)>)), 
           h(<'key-confirm', 
              kdf_conf(z,
                       <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                        'g'^~re, h(Hash1)>), 
              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
               'g'^~re, h(Hash1)>, 
              h(senc(<~data, 
                      sign(<~data, 'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, 
                            pkb, X, 'g'^~re, h(Hash1)>,
                           pskb), 
                      pk(pskb)>,
                     kdf_data(z,
                              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                               'g'^~re, h(Hash1)>)))
             >), 
           Hash1, 'data_fs'>
     ),
     St_Responder_PreErase( $S_a, $S_b, $A, $B, %n, sid, ~re,
                            kdf_data(z,
                                     <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                                      'g'^~re, h(Hash1)>),
                            ~data,
                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                             'g'^~re, h(Hash1)>,
                            'clean'
     ),
     W1_KeyRevealAvailable( 'responder', sid )
     ]
    variants (modulo AC)
     1. ~re   = ~re.41
        Hash1 = Hash1.42
        Hashsign
              = Hashsign.44
        X     = X.45
        gpkB  = gpkB.48
        z     = X.45^~re.41
        z.1   = verify(Hashsign.44, Hash1.42, gpkB.48)
    
     2. ~re   = ~re.54
        Hash1 = Hash1.55
        Hashsign
              = Hashsign.57
        X     = z.74^inv(~re.54)
        gpkB  = gpkB.61
        z     = z.74
        z.1   = verify(Hashsign.57, Hash1.55, gpkB.61)
    
     3. ~re   = ~re.293
        Hash1 = Hash1.294
        Hashsign
              = Hashsign.296
        X     = x.578^x.579
        gpkB  = gpkB.300
        z     = x.578^(~re.293*x.579)
        z.1   = verify(Hashsign.296, Hash1.294, gpkB.300)
    
     4. ~re   = ~re.294
        Hash1 = Hash1.295
        Hashsign
              = sign(Hash1.295, x.581)
        X     = X.298
        gpkB  = pk(x.581)
        z     = X.298^~re.294
        z.1   = true
    
     5. ~re   = ~re.295
        Hash1 = Hash1.296
        Hashsign
              = sign(Hash1.296, x.583)
        X     = z.315^inv(~re.295)
        gpkB  = pk(x.583)
        z     = z.315
        z.1   = true
    
     6. ~re   = ~re.296
        Hash1 = Hash1.297
        Hashsign
              = sign(Hash1.297, x.583)
        X     = x.584^x.585
        gpkB  = pk(x.583)
        z     = x.584^(~re.296*x.585)
        z.1   = true
    
     7. ~re   = ~re.297
        Hash1 = Hash1.298
        Hashsign
              = Hashsign.300
        X     = x.586^inv((~re.297*x.587))
        gpkB  = gpkB.304
        z     = x.586^inv(x.587)
        z.1   = verify(Hashsign.300, Hash1.298, gpkB.304)
    
     8. ~re   = ~re.297
        Hash1 = Hash1.298
        Hashsign
              = Hashsign.300
        X     = x.586^(x.587*inv(~re.297))
        gpkB  = gpkB.304
        z     = x.586^x.587
        z.1   = verify(Hashsign.300, Hash1.298, gpkB.304)
    
     9. ~re   = ~re.297
