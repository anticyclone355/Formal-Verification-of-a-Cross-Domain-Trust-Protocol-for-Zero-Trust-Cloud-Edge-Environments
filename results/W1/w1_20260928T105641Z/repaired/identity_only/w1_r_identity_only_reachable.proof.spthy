              = sign(Hash1.289, x.570)
        X     = DH_neutral
        gpkB  = pk(x.570)
        z     = DH_neutral
        z.1   = true
  */

rule (modulo E) Subject_Data_Decryption[role=Authentication_and_Data_Sharing]:
   [
   In( <sid, Y, beta, keyConfirm, Hash1, field> ),
   St_Initiator_DH( $S_a, $S_b, $A, $B, %n, sid, ie, X, pka, ppka, pkb,
                    iExposure
   )
   ]
  --[
  Eq( field, 'data_fs' ),
  Eq( keyConfirm,
      h(<'key-confirm', 
         kdf_conf(Y^ie,
                  <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                   h(Hash1)>), 
         <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
          h(Hash1)>, 
         h(beta)>)
  ),
  Eq( snd(snd(sdec(beta,
                   kdf_data(Y^ie,
                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                             h(Hash1)>)))),
      pkb
  ),
  Eq( verify(fst(snd(sdec(beta,
                          kdf_data(Y^ie,
                                   <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                                    h(Hash1)>)))),
             <
              fst(sdec(beta,
                       kdf_data(Y^ie,
                                <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                                 h(Hash1)>))), 
              'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
              h(Hash1)>,
             pkb),
      true
  ),
  DataReceive( $S_b, $S_a, %n, Y, beta, ppka, pkb,
               kdf_data(Y^ie,
                        <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                         h(Hash1)>),
               fst(sdec(beta,
                        kdf_data(Y^ie,
                                 <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                                  h(Hash1)>)))
  ),
  RepairDataAccepted( $S_a, $S_b, $A, $B, %n, sid,
                      fst(sdec(beta,
                               kdf_data(Y^ie,
                                        <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                                         h(Hash1)>))),
                      kdf_data(Y^ie,
                               <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                                h(Hash1)>),
                      <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                       h(Hash1)>
  ),
  W1Accepted( $S_a, $S_b, %n, sid,
              fst(sdec(beta,
                       kdf_data(Y^ie,
                                <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                                 h(Hash1)>))),
              kdf_data(Y^ie,
                       <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                        h(Hash1)>),
              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
               h(Hash1)>
  ),
  CommitInitiator( $S_a, $S_b, $A, $B, %n, sid,
                   fst(sdec(beta,
                            kdf_data(Y^ie,
                                     <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                                      h(Hash1)>))),
                   kdf_data(Y^ie,
                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                             h(Hash1)>),
                   <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                    h(Hash1)>
  )
  ]->
   [
   !Plaintext( fst(sdec(beta,
                        kdf_data(Y^ie,
                                 <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                                  h(Hash1)>)))
   ),
   St_Initiator_PreErase( $S_a, $S_b, $A, $B, %n, sid, ie,
                          kdf_data(Y^ie,
                                   <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                                    h(Hash1)>),
                          fst(sdec(beta,
                                   kdf_data(Y^ie,
                                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                                             Y, h(Hash1)>))),
                          <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                           h(Hash1)>,
                          iExposure
   ),
   W1_KeyRevealAvailable( 'initiator', sid )
   ]

  /*
