lemma w1_r_identity_only_reachable:
  exists-trace
  "∃ I R e sid x k T #send #accept #erase #check #rev0.
    ((((((((((((W1Sent( I, R, e, sid, x, k, T ) @ #send) ∧
               (W1Accepted( I, R, e, sid, x, k, T ) @ #accept)) ∧
              (#send < #accept)) ∧
             (SessionErased( I, R, e, sid ) @ #erase)) ∧
            (#accept < #erase)) ∧
           (#erase < #check)) ∧
          (∀ kind principal epoch #lt.
            ((W1LtkReveal( kind, principal, epoch ) @ #lt) ∧ (#lt < #check)) ⇒
            ((#erase < #lt) ∧
             (((kind = 'identity') ∧ (principal = 'requester')) ∧ (epoch = %1))))) ∧
         (W1LtkReveal( 'identity', 'requester', %1 ) @ #rev0)) ∧
        (#erase < #rev0)) ∧
       (#rev0 < #check)) ∧
      (¬(∃ role handle secret #dk.
          (W1SessionKeyReveal( role, handle, secret ) @ #dk) ∧ (#dk < #check)))) ∧
     (¬(∃ role handle #ep.
         (W1EphemeralReveal( role, handle ) @ #ep) ∧ (#ep < #check)))) ∧
    (W1Probe( ) @ #check)"
/*
guarded formula characterizing all satisfying traces:
"∃ I R e sid x k T #send #accept #erase #check #rev0.
  (W1Sent( I, R, e, sid, x, k, T ) @ #send) ∧
  (W1Accepted( I, R, e, sid, x, k, T ) @ #accept) ∧
  (SessionErased( I, R, e, sid ) @ #erase) ∧
  (W1LtkReveal( 'identity', 'requester', %1 ) @ #rev0) ∧
  (W1Probe( ) @ #check)
 ∧
  (#send < #accept) ∧
  (#accept < #erase) ∧
  (#erase < #check) ∧
  (∀ kind principal epoch #lt.
    (W1LtkReveal( kind, principal, epoch ) @ #lt)
   ⇒
    ((¬(#lt < #check)) ∨
     ((#erase < #lt) ∧
      (kind = 'identity') ∧
      (principal = 'requester') ∧
      (epoch = %1)))) ∧
  (#erase < #rev0) ∧
  (#rev0 < #check) ∧
  (∀ role handle secret #dk.
    (W1SessionKeyReveal( role, handle, secret ) @ #dk) ⇒ ¬(#dk < #check)) ∧
  (∀ role handle #ep.
    (W1EphemeralReveal( role, handle ) @ #ep) ⇒ ¬(#ep < #check))"
*/
simplify
solve( AccessCert_send( $S_a, $S_b, %n, pka, pk(x), pskb, ppka, $A, $B,
                        gpkA, pk(x.1)
       ) ▶₁ #send )
  case Domain_Access_Verification
  solve( !Subject( 'requester', 'domain_A', %1, pska, ppska, pk(~si),
                   ppk(~pi)
         ) ▶₂ #send )
    case W1_Setup
    solve( !Subject( 'owner', 'domain_B', %1, ~sr, ppskb, pk(~sr), ppkb
           ) ▶₃ #send )
      case W1_Setup
      solve( St_Initiator_DH( 'requester', 'owner', 'domain_A', 'domain_B', %1,
                              sid, ie, X, pk(~si), ppka, pk(~sr), iExposure
             ) ▶₁ #accept )
        case Subject_Access_Request
        solve( InitErased( 'requester', 'owner', %1, ~sid ) ▶₀ #erase )
          case Initiator_Erase_Ephemeral_case_1
          solve( RespErased( 'requester', 'owner', %1, ~sid ) ▶₁ #erase )
            case Responder_Erase_Ephemeral_case_1
            solve( W1_ProbeReady( ) ▶₀ #check )
              case W1_Setup
              solve( W1LtkReveal( 'identity', 'requester', %1 ) @ #rev0 )
                case Reveal_IdentityKey
                solve( !Subject( 'requester', $D, %1, sk, psk, pkS, ppkS ) ▶₀ #rev0 )
                  case W1_Setup
                  solve( W1_IdAvailable( 'requester', %1 ) ▶₁ #rev0 )
                    case W1_Setup
                    solve( splitEqs(4) )
                      case split_case_1
                      solve( !KU( sign(h(<pk(~si), pk(~sr), %1, ~sid, 'g'^~ie>), ~db)
                             ) @ #vk.8 )
                        case Domain_Access_Verification
                        solve( !KU( sign(<x, pk(~sr), %1, ~sid, 'g'^~ie>, ~si) ) @ #vk.24 )
                          case Subject_Access_Request
                          solve( !KU( ~sid ) @ #vk.13 )
                            case Subject_Access_Request
                            solve( !KU( sign(<pk(~si), ppk(~pi), %1>, ~da) ) @ #vk.37 )
                              case W1_Setup
                              solve( !KU( h(<pk(~si), pk(~sr), %1, ~sid, 'g'^~ie>) ) @ #vk.11 )
                                case Domain_Access_Verification
                                solve( !KU( pk(~db) ) @ #vk.23 )
                                  case Domain_Access_Verification
                                  solve( !KU( 'g'^~re ) @ #vk.28 )
                                    case Object_Data_Encryption
                                    solve( !KU( senc(<~data, 
                                                      sign(<~data, 'CDDS-AECDHE-full-v4', 'requester', 
                                                            'domain_A', 'owner', 'domain_B', %1, ~sid, 
                                                            pk(~si), pk(~sr), 'g'^~ie, 'g'^~re, 
                                                            h(h(<pk(~si), pk(~sr), %1, ~sid, 'g'^~ie>))>,
                                                           ~sr), 
                                                      pk(~sr)>,
                                                     kdf_data('g'^(~ie*~re),
                                                              <'CDDS-AECDHE-full-v4', 'requester', 
                                                               'domain_A', 'owner', 'domain_B', %1, ~sid, 
                                                               pk(~si), pk(~sr), 'g'^~ie, 'g'^~re, 
                                                               h(h(<pk(~si), pk(~sr), %1, ~sid, 'g'^~ie>))>))
                                           ) @ #vk.29 )
                                      case Object_Data_Encryption
                                      solve( !KU( h(<'key-confirm', 
                                                     kdf_conf('g'^(~ie*~re),
                                                              <'CDDS-AECDHE-full-v4', 'requester', 
                                                               'domain_A', 'owner', 'domain_B', %1, ~sid, 
                                                               pk(~si), pk(~sr), 'g'^~ie, 'g'^~re, 
                                                               h(h(<pk(~si), pk(~sr), %1, ~sid, 'g'^~ie>))>), 
                                                     <'CDDS-AECDHE-full-v4', 'requester', 'domain_A', 
                                                      'owner', 'domain_B', %1, ~sid, pk(~si), pk(~sr), 
                                                      'g'^~ie, 'g'^~re, 
                                                      h(h(<pk(~si), pk(~sr), %1, ~sid, 'g'^~ie>))>, 
                                                     h(senc(<~data, 
                                                             sign(<~data, 'CDDS-AECDHE-full-v4', 'requester', 
                                                                   'domain_A', 'owner', 'domain_B', %1, ~sid, 
                                                                   pk(~si), pk(~sr), 'g'^~ie, 'g'^~re, 
                                                                   h(h(<pk(~si), pk(~sr), %1, ~sid, 'g'^~ie>))
                                                                  >,
                                                                  ~sr), 
                                                             pk(~sr)>,
                                                            kdf_data('g'^(~ie*~re),
                                                                     <'CDDS-AECDHE-full-v4', 'requester', 
                                                                      'domain_A', 'owner', 'domain_B', %1, 
                                                                      ~sid, pk(~si), pk(~sr), 'g'^~ie, 
                                                                      'g'^~re, 
                                                                      h(h(<pk(~si), pk(~sr), %1, ~sid, 'g'^~ie
                                                                          >))
                                                                     >)))
                                                    >)
                                             ) @ #vk.30 )
                                        case Object_Data_Encryption
                                        solve( !KU( pk(~si) ) @ #vk.33 )
                                          case W1_Setup_case_1
                                          solve( !KU( pk(~sr) ) @ #vk.36 )
                                            case Subject_Access_Request
                                            solve( !KU( pk(~da) ) @ #vk.40 )
                                              case W1_Setup
                                              solve( !KU( ppk(~pi) ) @ #vk.42 )
                                                case W1_Setup_case_1
                                                solve( !KU( 'g'^~ie ) @ #vk.36 )
                                                  case Subject_Access_Request
                                                  SOLVED // trace found
                                                qed
                                              qed
                                            qed
                                          qed
                                        qed
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma w1_r_identity_only_plaintext_secrecy:
  all-traces
  "∀ I R e sid x k T #send #accept #erase #check #rev0.
    (((((((((((((W1Sent( I, R, e, sid, x, k, T ) @ #send) ∧
                (W1Accepted( I, R, e, sid, x, k, T ) @ #accept)) ∧
               (#send < #accept)) ∧
              (SessionErased( I, R, e, sid ) @ #erase)) ∧
