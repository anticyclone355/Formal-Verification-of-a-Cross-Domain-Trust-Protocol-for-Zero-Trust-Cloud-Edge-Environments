  "∀ I R e sid x k T #send #accept #erase #check.
    ((((((((((W1Sent( I, R, e, sid, x, k, T ) @ #send) ∧
             (W1Accepted( I, R, e, sid, x, k, T ) @ #accept)) ∧
            (#send < #accept)) ∧
           (SessionErased( I, R, e, sid ) @ #erase)) ∧
          (#accept < #erase)) ∧
         (#erase < #check)) ∧
        (¬(∃ kind principal epoch #lt.
            (W1LtkReveal( kind, principal, epoch ) @ #lt) ∧ (#lt < #check)))) ∧
