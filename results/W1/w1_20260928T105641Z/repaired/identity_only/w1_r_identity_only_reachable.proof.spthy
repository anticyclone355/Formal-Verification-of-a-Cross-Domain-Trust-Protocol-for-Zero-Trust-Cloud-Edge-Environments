        Hash1 = Hash1.298
        Hashsign
              = sign(Hash1.298, x.585)
        X     = x.586^(x.587*inv(~re.297))
        gpkB  = pk(x.585)
        z     = x.586^x.587
        z.1   = true
    
    11. ~re   = ~re.298
        Hash1 = Hash1.299
        Hashsign
              = Hashsign.301
        X     = x.587^(x.588*inv((~re.298*x.589)))
        gpkB  = gpkB.305
        z     = x.587^(x.588*inv(x.589))
        z.1   = verify(Hashsign.301, Hash1.299, gpkB.305)
    
