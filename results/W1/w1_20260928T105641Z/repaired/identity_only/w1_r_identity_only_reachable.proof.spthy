                      kdf_data(x.225^(x.227*inv((x.229*x.236))),
                               <'CDDS-AECDHE-full-v4', $S_a.121, $A.119, $S_b.122, $B.120, %n.135, 
                                sid.134, pka.131, pk(x.234), X.124, 
                                x.225^(x.226*x.227*inv((x.228*x.229))), h(Hash1.123)>))
         ie    = (x.228*inv((x.226*x.236)))
         pka   = pka.131
         pkb   = pk(x.234)
         sid   = sid.134
         z     = z.136
         %n    = %n.135
         z.1   = x.225^(x.227*inv((x.229*x.236)))
         z.2   = z.142
         z.3   = true
    
