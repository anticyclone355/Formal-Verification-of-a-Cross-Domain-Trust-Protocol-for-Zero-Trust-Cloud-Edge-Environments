rule (modulo E) Initiator_Erase_Ephemeral[role=Authentication_and_Data_Sharing]:
   [
   St_Initiator_PreErase( $S_a, $S_b, $A, $B, %n, sid, ie, k, data,
                          transcript, iExposure
   )
   ]
  --[ InitiatorErased( $S_a, $S_b, $A, $B, %n, sid ) ]->
   [ InitErased( $S_a, $S_b, %n, sid ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Responder_Erase_Ephemeral[role=Authentication_and_Data_Sharing]:
   [
   St_Responder_PreErase( $S_a, $S_b, $A, $B, %n, sid, re, k, data,
                          transcript, rExposure
   )
   ]
  --[ ResponderErased( $S_a, $S_b, $A, $B, %n, sid ) ]->
   [ RespErased( $S_a, $S_b, %n, sid ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Close_Repair_Session_After_Erasure[role=Authentication_and_Data_Sharing]:
   [ InitErased( $S_a, $S_b, %n, sid ), RespErased( $S_a, $S_b, %n, sid ) ]
  --[ SessionErased( $S_a, $S_b, %n, sid ) ]->
   [ W1_Closed( ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_Initiator_Ephemeral_Pending[role=adversary]:
   [
   St_Initiator_DH( $S_a, $S_b, $A, $B, %n, sid, ie, X, pka, ppka, pkb,
                    'clean'
   )
   ]
  --[
  RevealEphemeralI( $S_a, $S_b, %n, sid, ie ),
  W1EphemeralReveal( 'initiator', sid )
  ]->
   [
   St_Initiator_DH( $S_a, $S_b, $A, $B, %n, sid, ie, X, pka, ppka, pkb,
                    'revealed'
   ),
   Out( ie )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_Initiator_Ephemeral_Accepted[role=adversary]:
   [
   St_Initiator_PreErase( $S_a, $S_b, $A, $B, %n, sid, ie, k, data,
                          transcript, 'clean'
   )
   ]
  --[
  RevealEphemeralI( $S_a, $S_b, %n, sid, ie ),
  W1EphemeralReveal( 'initiator', sid )
  ]->
   [
   St_Initiator_PreErase( $S_a, $S_b, $A, $B, %n, sid, ie, k, data,
                          transcript, 'revealed'
   ),
   Out( ie )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_Responder_Ephemeral[role=adversary]:
   [
   St_Responder_PreErase( $S_a, $S_b, $A, $B, %n, sid, re, k, data,
                          transcript, 'clean'
   )
   ]
  --[
  RevealEphemeralR( $S_a, $S_b, %n, sid, re ),
  W1EphemeralReveal( 'responder', sid )
  ]->
   [
   St_Responder_PreErase( $S_a, $S_b, $A, $B, %n, sid, re, k, data,
                          transcript, 'revealed'
   ),
   Out( re )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_Initiator_SessionKey:
   [
   St_Initiator_PreErase( $I, $R, $A, $B, %n, sid, ie, k, data, T, exposure
   ),
   W1_KeyRevealAvailable( 'initiator', sid )
   ]
  --[ W1SessionKeyReveal( 'initiator', sid, k ) ]->
   [
   St_Initiator_PreErase( $I, $R, $A, $B, %n, sid, ie, k, data, T, exposure
   ),
   Out( k )
   ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_Responder_SessionKey:
   [
   St_Responder_PreErase( $I, $R, $A, $B, %n, sid, re, k, data, T, exposure
   ),
   W1_KeyRevealAvailable( 'responder', sid )
   ]
  --[ W1SessionKeyReveal( 'responder', sid, k ) ]->
   [
   St_Responder_PreErase( $I, $R, $A, $B, %n, sid, re, k, data, T, exposure
   ),
   Out( k )
   ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

lemma w1_r_baseline_reachable:
  exists-trace
  "∃ I R e sid x k T #send #accept #erase #check.
    (((((((((W1Sent( I, R, e, sid, x, k, T ) @ #send) ∧
            (W1Accepted( I, R, e, sid, x, k, T ) @ #accept)) ∧
           (#send < #accept)) ∧
          (SessionErased( I, R, e, sid ) @ #erase)) ∧
         (#accept < #erase)) ∧
        (#erase < #check)) ∧
       (¬(∃ kind principal epoch #lt.
           (W1LtkReveal( kind, principal, epoch ) @ #lt) ∧ (#lt < #check)))) ∧
      (¬(∃ role handle secret #dk.
          (W1SessionKeyReveal( role, handle, secret ) @ #dk) ∧ (#dk < #check)))) ∧
     (¬(∃ role handle #ep.
         (W1EphemeralReveal( role, handle ) @ #ep) ∧ (#ep < #check)))) ∧
    (W1Probe( ) @ #check)"
/*
guarded formula characterizing all satisfying traces:
"∃ I R e sid x k T #send #accept #erase #check.
  (W1Sent( I, R, e, sid, x, k, T ) @ #send) ∧
  (W1Accepted( I, R, e, sid, x, k, T ) @ #accept) ∧
  (SessionErased( I, R, e, sid ) @ #erase) ∧
  (W1Probe( ) @ #check)
 ∧
  (#send < #accept) ∧
  (#accept < #erase) ∧
  (#erase < #check) ∧
  (∀ kind principal epoch #lt.
    (W1LtkReveal( kind, principal, epoch ) @ #lt) ⇒ ¬(#lt < #check)) ∧
  (∀ role handle secret #dk.
    (W1SessionKeyReveal( role, handle, secret ) @ #dk) ⇒ ¬(#dk < #check)) ∧
  (∀ role handle #ep.
    (W1EphemeralReveal( role, handle ) @ #ep) ⇒ ¬(#ep < #check))"
*/
by sorry

lemma w1_r_baseline_plaintext_secrecy:
  all-traces
  "∀ I R e sid x k T #send #accept #erase #check.
    ((((((((((W1Sent( I, R, e, sid, x, k, T ) @ #send) ∧
             (W1Accepted( I, R, e, sid, x, k, T ) @ #accept)) ∧
            (#send < #accept)) ∧
           (SessionErased( I, R, e, sid ) @ #erase)) ∧
          (#accept < #erase)) ∧
         (#erase < #check)) ∧
        (¬(∃ kind principal epoch #lt.
            (W1LtkReveal( kind, principal, epoch ) @ #lt) ∧ (#lt < #check)))) ∧
       (¬(∃ role handle secret #dk.
           (W1SessionKeyReveal( role, handle, secret ) @ #dk) ∧ (#dk < #check)))) ∧
      (¬(∃ role handle #ep.
          (W1EphemeralReveal( role, handle ) @ #ep) ∧ (#ep < #check)))) ∧
     (K( x ) @ #check)) ⇒
    (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ I R e sid x k T #send #accept #erase #check.
  (W1Sent( I, R, e, sid, x, k, T ) @ #send) ∧
  (W1Accepted( I, R, e, sid, x, k, T ) @ #accept) ∧
  (SessionErased( I, R, e, sid ) @ #erase) ∧
  (K( x ) @ #check)
 ∧
  (#send < #accept) ∧
  (#accept < #erase) ∧
  (#erase < #check) ∧
  (∀ kind principal epoch #lt.
    (W1LtkReveal( kind, principal, epoch ) @ #lt) ⇒ ¬(#lt < #check)) ∧
  (∀ role handle secret #dk.
    (W1SessionKeyReveal( role, handle, secret ) @ #dk) ⇒ ¬(#dk < #check)) ∧
  (∀ role handle #ep.
    (W1EphemeralReveal( role, handle ) @ #ep) ⇒ ¬(#ep < #check))"
*/
by sorry

