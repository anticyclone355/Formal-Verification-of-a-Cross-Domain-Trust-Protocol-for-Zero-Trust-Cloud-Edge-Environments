                                      h(Hash1)>),
                            z,
                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                             h(Hash1)>,
                            iExposure
     ),
     W1_KeyRevealAvailable( 'initiator', sid )
     ]
    variants (modulo AC)
      1. $A    = $A.43
         $B    = $B.44
         $S_a  = $S_a.45
         $S_b  = $S_b.46
         Hash1 = Hash1.47
         X     = X.48
         Y     = Y.49
         beta  = beta.50
         ie    = ie.53
         pka   = pka.55
