*/
by sorry

lemma domain_reconfiguration_agreement:
  all-traces
  "∀ D e ne op np1 np2 #a1 #a2.
    ((((((W5Accepted( D, e, ne, op, np1 ) @ #a1) ∧
         (W5Accepted( D, e, ne, op, np2 ) @ #a2)) ∧
        (¬(∃ D0 e0 pk0 #r. (W5KeyReveal( D0, e0, pk0 ) @ #r) ∧ (#r < #a1)))) ∧
       (¬(∃ D0 e0 e1 pk0 pk1 #s.
           (W5Transition( 'special', D0, e0, e1, pk0, pk1 ) @ #s) ∧ (#s < #a1)))) ∧
      (¬(∃ D0 e0 pk0 #r. (W5KeyReveal( D0, e0, pk0 ) @ #r) ∧ (#r < #a2)))) ∧
     (¬(∃ D0 e0 e1 pk0 pk1 #s.
         (W5Transition( 'special', D0, e0, e1, pk0, pk1 ) @ #s) ∧ (#s < #a2)))) ⇒
    ((np1 = np2) ∧
     (∃ #g.
       ((W5Transition( 'honest', D, e, ne, op, np1 ) @ #g) ∧ (#g < #a1)) ∧
       (#g < #a2)))"
/*
guarded formula characterizing all counter-examples:
"∃ D e ne op np1 np2 #a1 #a2.
  (W5Accepted( D, e, ne, op, np1 ) @ #a1) ∧
  (W5Accepted( D, e, ne, op, np2 ) @ #a2)
 ∧
  (∀ D0 e0 pk0 #r. (W5KeyReveal( D0, e0, pk0 ) @ #r) ⇒ ¬(#r < #a1)) ∧
  (∀ D0 e0 e1 pk0 pk1 #s.
    (W5Transition( 'special', D0, e0, e1, pk0, pk1 ) @ #s) ⇒ ¬(#s < #a1)) ∧
  (∀ D0 e0 pk0 #r. (W5KeyReveal( D0, e0, pk0 ) @ #r) ⇒ ¬(#r < #a2)) ∧
  (∀ D0 e0 e1 pk0 pk1 #s.
    (W5Transition( 'special', D0, e0, e1, pk0, pk1 ) @ #s) ⇒ ¬(#s < #a2)) ∧
  (((¬(np1 = np2)) ∨
    (∀ #g.
      (W5Transition( 'honest', D, e, ne, op, np1 ) @ #g)
     ⇒
      ((¬(#g < #a1)) ∨ (¬(#g < #a2))))))"
*/
by sorry

