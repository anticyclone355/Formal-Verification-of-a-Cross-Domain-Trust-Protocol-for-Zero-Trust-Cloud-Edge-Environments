lemma accepted_epoch_has_started_candidate:
  all-traces
  "∀ D e ne op np #a.
    (W5Accepted( D, e, ne, op, np ) @ #a) ⇒
    (∃ #u. (W5EpochAdvanced( e, ne ) @ #u) ∧ (#u < #a))"
/*
guarded formula characterizing all counter-examples:
"∃ D e ne op np #a.
  (W5Accepted( D, e, ne, op, np ) @ #a)
 ∧
  ∀ #u. (W5EpochAdvanced( e, ne ) @ #u) ⇒ ¬(#u < #a)"
*/
simplify
solve( !Domain( $domain_id, %epoch, old_gsk, pk(old_gsk) ) ▶₁ #a )
  case Domain_Init
  solve( !KU( sign(np, ~gsk) ) @ #vk.3 )
    case c_sign
    solve( !KU( ~gsk ) @ #vk.7 )
      case Reveal_Domain_sk
      solve( !KU( pk(~gsk) ) @ #vk.6 )
        case c_pk
        SOLVED // trace found
      qed
    qed
  qed
qed

