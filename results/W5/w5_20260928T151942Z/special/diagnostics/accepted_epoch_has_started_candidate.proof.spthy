  all-traces
  "∀ D e ne op np #a.
    (((W5Accepted( D, e, ne, op, np ) @ #a) ∧
      (¬(∃ D0 e0 pk0 #r. (W5KeyReveal( D0, e0, pk0 ) @ #r) ∧ (#r < #a)))) ∧
     (¬(∃ D0 e0 e1 pk0 pk1 #s.
         (W5Transition( 'special', D0, e0, e1, pk0, pk1 ) @ #s) ∧ (#s < #a)))) ⇒
