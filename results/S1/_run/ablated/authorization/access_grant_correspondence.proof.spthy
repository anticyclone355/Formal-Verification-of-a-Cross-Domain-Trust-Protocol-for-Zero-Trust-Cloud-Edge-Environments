lemma access_grant_correspondence:
  all-traces
  "∀ I R A B e pka pkb bit #g.
    (S1Granted( I, R, A, B, e, pka, pkb, bit ) @ #g) ⇒
    (∃ old ra rb #r #a.
      (((S1Requested( I, R, A, B, e, pka, pkb ) @ #r) ∧
        (S1Installed( I, R, A, B, e, <pka, pkb, bit, e>, old, ra, rb ) @ #a)) ∧
       (#r < #g)) ∧
      (#a < #g))"
/*
guarded formula characterizing all counter-examples:
"∃ I R A B e pka pkb bit #g.
  (S1Granted( I, R, A, B, e, pka, pkb, bit ) @ #g)
 ∧
  ∀ old ra rb #r #a.
   (S1Requested( I, R, A, B, e, pka, pkb ) @ #r) ∧
   (S1Installed( I, R, A, B, e, <pka, pkb, bit, e>, old, ra, rb ) @ #a)
  ⇒
   ((¬(#r < #g)) ∨ (¬(#a < #g)))"
*/
simplify
solve( Access_send( $S_a, $S_b, %n, pk(x.1), pkb, $A, $B, gskA, gskB,
                    gpkA, gpkB, ppka
       ) ▶₁ #g )
  case Subject_Access_Request_case_1
  solve( !Policy( 'domain_A', 'domain_A', %1, 'requester', 'owner', '1'
         ) ▶₂ #g )
    case DomainA_Receive_Policy
    solve( !Subject( 'owner', 'domain_A', %1, pskb, ppskb, pk(~psk), ppkb
           ) ▶₃ #g )
      case Domain_Register
      solve( !KU( sign(<x, pk(~psk), %1>, ~psk.1) ) @ #vk.3 )
        case DomainB_Policy_Processing
        solve( !KU( sign(CertR, ~psk.1) ) @ #vk.29 )
          case DomainB_Policy_Processing_case_1
          solve( !KU( sign(CertR, ~psk) ) @ #vk.35 )
            case DomainB_Policy_Processing_case_1
            by solve( Create_policy( 'domain_A', 'domain_A', gskB.1, pk(x.1),
                                     'requester', 'owner', %1, Pb.3, pka, pk(x.2), '1', mt_root.3
                      ) ▶₁ #vr.11 )
