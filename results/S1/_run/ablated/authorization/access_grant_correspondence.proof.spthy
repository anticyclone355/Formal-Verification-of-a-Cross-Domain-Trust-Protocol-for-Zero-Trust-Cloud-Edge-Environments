lemma subject_before_policy_full_candidate:
  all-traces
  "∀ S_a S_b n bit A B #i.
    (PolicyRegister( S_a, S_b, n, bit, A, B ) @ #i) ⇒
    (∃ gskA gskB #j #k.
      ((((IssueCert( A, S_a, n, gskA ) @ #j) ∧
         (IssueCert( B, S_b, n, gskB ) @ #k)) ∧
        (#j < #i)) ∧
       (#k < #i)) ∧
      (¬(A = B)))"
/*
guarded formula characterizing all counter-examples:
"∃ S_a S_b n bit A B #i.
  (PolicyRegister( S_a, S_b, n, bit, A, B ) @ #i)
 ∧
  ∀ gskA gskB #j #k.
   (IssueCert( A, S_a, n, gskA ) @ #j) ∧ (IssueCert( B, S_b, n, gskB ) @ #k)
  ⇒
   ((¬(#j < #i)) ∨ (¬(#k < #i)) ∨ (A = B))"
*/
by sorry

lemma registration_precedes_policy:
  all-traces
  "∀ I R e bit A B #p.
    (PolicyRegister( I, R, e, bit, A, B ) @ #p) ⇒
    (∃ skA skB #i #r.
      (((IssueCert( A, I, e, skA ) @ #i) ∧ (IssueCert( B, R, e, skB ) @ #r)) ∧
       (#i < #p)) ∧
      (#r < #p))"
/*
guarded formula characterizing all counter-examples:
"∃ I R e bit A B #p.
  (PolicyRegister( I, R, e, bit, A, B ) @ #p)
 ∧
  ∀ skA skB #i #r.
   (IssueCert( A, I, e, skA ) @ #i) ∧ (IssueCert( B, R, e, skB ) @ #r)
  ⇒
   ((¬(#i < #p)) ∨ (¬(#r < #p)))"
*/
by sorry

lemma policy_domains_distinct:
  all-traces
  "∀ I R e bit A B #p.
    (PolicyRegister( I, R, e, bit, A, B ) @ #p) ⇒ (¬(A = B))"
/*
guarded formula characterizing all counter-examples:
"∃ I R e bit A B #p. (PolicyRegister( I, R, e, bit, A, B ) @ #p) ∧ A = B"
*/
by sorry

lemma registration_issuance_correspondence:
  all-traces
  "∀ I A e pkS ppkS #c.
    (S1Registered( I, A, e, pkS, ppkS ) @ #c) ⇒
    (∃ skA #r.
