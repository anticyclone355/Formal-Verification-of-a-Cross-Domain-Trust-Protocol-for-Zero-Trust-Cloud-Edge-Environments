      (IssueCert( A, I, e, skA ) @ #c))"
/*
guarded formula characterizing all counter-examples:
"∃ I A e pkS ppkS #c.
  (S1Registered( I, A, e, pkS, ppkS ) @ #c)
 ∧
  ∀ skA #r.
   (Subject_Register( I, A, e ) @ #r) ∧ (IssueCert( A, I, e, skA ) @ #c)
  ⇒
   ¬(#r < #c)"
*/
by sorry

lemma policy_processing_source:
  all-traces
  "∀ A B e Pb old new #b.
    (ProcessPolicy( A, B, e, Pb, old, new ) @ #b) ⇒
    (∃ I R #p. (S1Proposed( I, R, A, B, e, Pb, old ) @ #p) ∧ (#p < #b))"
/*
guarded formula characterizing all counter-examples:
"∃ A B e Pb old new #b.
  (ProcessPolicy( A, B, e, Pb, old, new ) @ #b)
 ∧
  ∀ I R #p. (S1Proposed( I, R, A, B, e, Pb, old ) @ #p) ⇒ ¬(#p < #b)"
*/
by sorry

lemma policy_acceptance_source:
  all-traces
  "∀ A B e Pb old rb #a.
    (ProcessPolicyDomain( A, B, e, Pb, old, rb ) @ #a) ⇒
    (∃ #b. (ProcessPolicy( A, B, e, Pb, old, rb ) @ #b) ∧ (#b < #a))"
/*
guarded formula characterizing all counter-examples:
"∃ A B e Pb old rb #a.
  (ProcessPolicyDomain( A, B, e, Pb, old, rb ) @ #a)
 ∧
