                                     'requester', 'owner', %1, Pb.2, pka, pk(x.2), '1', mt_root.2
                      ) ▶₁ #vr.11 )
          next
            case c_sign
            solve( !KU( ~psk ) @ #vk.64 )
              case DomainB_Policy_Processing
              by solve( Create_policy( 'domain_A', 'domain_A', gskB.1, pk(x.1),
                                       'requester', 'owner', %1, Pb.2, pka, pk(x.2), '1', mt_root.2
                        ) ▶₁ #vr.11 )
            qed
          qed
        next
          case DomainB_Policy_Processing_case_2
          solve( !KU( sign(CertR.1, ~psk) ) @ #vk.35 )
            case DomainB_Policy_Processing_case_1
            by solve( Create_policy( 'domain_A', 'domain_A', gskB.2, pk(x.1),
                                     'requester', 'owner', %1, Pb.3, pka, pk(x.2), '1', mt_root.3
