lemma policy_context_root_agreement:
  all-traces
  "∀ I R A B e Pb old ra rb #a.
    (S1Installed( I, R, A, B, e, Pb, old, ra, rb ) @ #a) ⇒
    ((((ra = rb) ∧ (New_MerkleRoot( A, B, e, ra ) @ #a)) ∧
      (New_MerkleRoot( B, A, e, rb ) @ #a)) ∧
     (∃ #p #b.
       (((S1Proposed( I, R, A, B, e, Pb, old ) @ #p) ∧
         (ProcessPolicy( A, B, e, Pb, old, rb ) @ #b)) ∧
        (#p < #b)) ∧
       (#b < #a)))"
/*
guarded formula characterizing all counter-examples:
"∃ I R A B e Pb old ra rb #a.
  (S1Installed( I, R, A, B, e, Pb, old, ra, rb ) @ #a)
 ∧
  ((¬(ra = rb)) ∨
   (¬(New_MerkleRoot( A, B, e, ra ) @ #a)) ∨
   (¬(New_MerkleRoot( B, A, e, rb ) @ #a)) ∨
   (∀ #p #b.
     (S1Proposed( I, R, A, B, e, Pb, old ) @ #p) ∧
     (ProcessPolicy( A, B, e, Pb, old, rb ) @ #b)
    ⇒
     ((¬(#p < #b)) ∨ (¬(#b < #a)))))"
*/
by sorry

