                                                                 <TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#000000">H4</FONT></TD> <TD ALIGN="LEFT" VALIGN="TOP">=</TD> <TD ALIGN="LEFT" VALIGN="TOP">h(&lt;pk(~si), pk(~sr), %1, ~sid, 'g'^~ie&gt;)</TD></TR>
                                                                 <TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#000000">RE1</FONT></TD> <TD ALIGN="LEFT" VALIGN="TOP">=</TD> <TD ALIGN="LEFT" VALIGN="TOP">'requester'</TD></TR>
                                                                 <TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#000000">KD1</FONT></TD> <TD ALIGN="LEFT" VALIGN="TOP">=</TD> <TD ALIGN="LEFT" VALIGN="TOP">kdf_data(EX1,<BR ALIGN="LEFT"/> &#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&lt;CD1, RE1, DO2, 'owner', DO1, %1, ~sid.1, pk(~si), pk(~sr), <BR ALIGN="LEFT"/> &#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;'g'^~ie.1, 'g'^~re.1, h(H3)&gt;)</TD></TR>
                                                                 <TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#000000">KD2</FONT></TD> <TD ALIGN="LEFT" VALIGN="TOP">=</TD> <TD ALIGN="LEFT" VALIGN="TOP">kdf_data(EX2,<BR ALIGN="LEFT"/> &#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&lt;CD1, RE1, DO2, 'owner', DO1, %1, ~sid, pk(~si), pk(~sr), 'g'^~ie, <BR ALIGN="LEFT"/> &#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;'g'^~re, h(H4)&gt;)</TD></TR>
                                                                 <TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#000000">SE1</FONT></TD> <TD ALIGN="LEFT" VALIGN="TOP">=</TD> <TD ALIGN="LEFT" VALIGN="TOP">senc(&lt;~data.1, <BR ALIGN="LEFT"/> &#32;&#32;&#32;&#32;&#32;sign(&lt;~data.1, CD1, RE1, DO2, 'owner', DO1, %1, ~sid.1, pk(~si), <BR ALIGN="LEFT"/> &#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;pk(~sr), 'g'^~ie.1, 'g'^~re.1, h(H3)&gt;,<BR ALIGN="LEFT"/> &#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;~sr), <BR ALIGN="LEFT"/> &#32;&#32;&#32;&#32;&#32;pk(~sr)&gt;,<BR ALIGN="LEFT"/> &#32;&#32;&#32;&#32;KD1)</TD></TR>
                                                                 <TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#000000">H1</FONT></TD> <TD ALIGN="LEFT" VALIGN="TOP">=</TD> <TD ALIGN="LEFT" VALIGN="TOP">h(&lt;'key-confirm', <BR ALIGN="LEFT"/> &#32;&#32;kdf_conf(EX1,<BR ALIGN="LEFT"/> &#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&lt;CD1, RE1, DO2, 'owner', DO1, %1, ~sid.1, pk(~si), pk(~sr), <BR ALIGN="LEFT"/> &#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;'g'^~ie.1, 'g'^~re.1, h(H3)&gt;), <BR ALIGN="LEFT"/> &#32;&#32;&lt;CD1, RE1, DO2, 'owner', DO1, %1, ~sid.1, pk(~si), pk(~sr), <BR ALIGN="LEFT"/> &#32;&#32;&#32;'g'^~ie.1, 'g'^~re.1, h(H3)&gt;, <BR ALIGN="LEFT"/> &#32;&#32;h(SE1)&gt;)</TD></TR>
                                                                 <TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#000000">SE2</FONT></TD> <TD ALIGN="LEFT" VALIGN="TOP">=</TD> <TD ALIGN="LEFT" VALIGN="TOP">senc(&lt;~data, <BR ALIGN="LEFT"/> &#32;&#32;&#32;&#32;&#32;sign(&lt;~data, CD1, RE1, DO2, 'owner', DO1, %1, ~sid, pk(~si), <BR ALIGN="LEFT"/> &#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;pk(~sr), 'g'^~ie, 'g'^~re, h(H4)&gt;,<BR ALIGN="LEFT"/> &#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;~sr), <BR ALIGN="LEFT"/> &#32;&#32;&#32;&#32;&#32;pk(~sr)&gt;,<BR ALIGN="LEFT"/> &#32;&#32;&#32;&#32;KD2)</TD></TR>
                                                                 <TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#000000">H2</FONT></TD> <TD ALIGN="LEFT" VALIGN="TOP">=</TD> <TD ALIGN="LEFT" VALIGN="TOP">h(&lt;'key-confirm', <BR ALIGN="LEFT"/> &#32;&#32;kdf_conf(EX2,<BR ALIGN="LEFT"/> &#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&lt;CD1, RE1, DO2, 'owner', DO1, %1, ~sid, pk(~si), pk(~sr), 'g'^~ie, <BR ALIGN="LEFT"/> &#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;'g'^~re, h(H4)&gt;), <BR ALIGN="LEFT"/> &#32;&#32;&lt;CD1, RE1, DO2, 'owner', DO1, %1, ~sid, pk(~si), pk(~sr), 'g'^~ie, <BR ALIGN="LEFT"/> &#32;&#32;&#32;'g'^~re, h(H4)&gt;, <BR ALIGN="LEFT"/> &#32;&#32;h(SE2)&gt;)</TD></TR>
                                                                 <TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#000000">SI3</FONT></TD> <TD ALIGN="LEFT" VALIGN="TOP">=</TD> <TD ALIGN="LEFT" VALIGN="TOP">sign(&lt;pk(~si), ppk(~pi), %1&gt;, ~da)</TD></TR>
                                                                 <TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#000000">SI1</FONT></TD> <TD ALIGN="LEFT" VALIGN="TOP">=</TD> <TD ALIGN="LEFT" VALIGN="TOP">sign(&lt;&lt;&lt;pk(~si), ppk(~pi), %1&gt;, SI3, pk(~da)&gt;, pk(~sr), %1, <BR ALIGN="LEFT"/> &#32;&#32;&#32;&#32;&#32;~sid.1, 'g'^~ie.1&gt;,<BR ALIGN="LEFT"/> &#32;&#32;&#32;&#32;~si)</TD></TR>
                                                                 <TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#000000">SI2</FONT></TD> <TD ALIGN="LEFT" VALIGN="TOP">=</TD> <TD ALIGN="LEFT" VALIGN="TOP">sign(&lt;&lt;&lt;pk(~si), ppk(~pi), %1&gt;, SI3, pk(~da)&gt;, pk(~sr), %1, ~sid, <BR ALIGN="LEFT"/> &#32;&#32;&#32;&#32;&#32;'g'^~ie&gt;,<BR ALIGN="LEFT"/> &#32;&#32;&#32;&#32;~si)</TD></TR>
                                                                 <TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#000000">SI4</FONT></TD> <TD ALIGN="LEFT" VALIGN="TOP">=</TD> <TD ALIGN="LEFT" VALIGN="TOP">sign(H4, ~db)</TD></TR>
                                                                 <TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#000000">SI5</FONT></TD> <TD ALIGN="LEFT" VALIGN="TOP">=</TD> <TD ALIGN="LEFT" VALIGN="TOP">sign(H3, ~db)</TD></TR>
                                                                 <TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#000000">SU1</FONT></TD> <TD ALIGN="LEFT" VALIGN="TOP">=</TD> <TD ALIGN="LEFT" VALIGN="TOP">'SubjectCert'</TD></TR></TABLE>>];

}
n96:n95 -> n149[style="invis"];

}
