lemma reachable_two_distinct_contexts:
  exists-trace
  "∃ q1 q2 I1 I2 R1 R2 e #b1 #b2 #c1 #c2.
    (((((((((W3Begin( q1, I1, R1, e ) @ #b1) ∧
            (W3Begin( q2, I2, R2, e ) @ #b2)) ∧
           (W3End( q1, I1, R1, e ) @ #c1)) ∧
          (W3End( q2, I2, R2, e ) @ #c2)) ∧
         (¬(q1 = q2))) ∧
        ((¬(I1 = I2)) ∨ (¬(R1 = R2)))) ∧
       (#b1 < #b2)) ∧
      (#b2 < #c1)) ∧
     (#b2 < #c2)) ∧
    (¬(#c1 = #c2))"
/*
guarded formula characterizing all satisfying traces:
"∃ q1 q2 I1 I2 R1 R2 e #b1 #b2 #c1 #c2.
  (W3Begin( q1, I1, R1, e ) @ #b1) ∧
  (W3Begin( q2, I2, R2, e ) @ #b2) ∧
  (W3End( q1, I1, R1, e ) @ #c1) ∧
  (W3End( q2, I2, R2, e ) @ #c2)
 ∧
  (¬(q1 = q2)) ∧
  (((¬(I1 = I2)) ∨ (¬(R1 = R2)))) ∧
  (#b1 < #b2) ∧
  (#b2 < #c1) ∧
  (#b2 < #c2) ∧
  (¬(#c1 = #c2))"
*/
simplify
solve( W3Budget( )[+] ▶₁ #b1 )
  case W3_Setup_case_1
  solve( W3Budget( )[+] ▶₁ #b2 )
    case W3_Setup_case_2
    solve( St_LocalReceiver( $S_a, $S_b, %1, ppska.2, pk(x.2), ~rid
           )[+] ▶₁ #c1 )
      case Subject_Access_Request_case_1
      solve( St_LocalReceiver( $S_a, $S_b, %1, ppska.1, pk(x.1), ~rid.1
             )[+] ▶₁ #c2 )
        case Subject_Access_Request_case_2
        solve( (#c1 < #c2)  ∥ (#c2 < #c1) )
          case case_1
          solve( splitEqs(2) )
            case split_case_2
            solve( splitEqs(3) )
              case split_case_2
              solve( !KU( senc(<z.1, sign(z.1, ~sr), pk(~sr)>, z) ) @ #vk.10 )
                case Object_Data_Encryption
                solve( !KU( sign(<x.3, pk(~sr), %1>, ~si) ) @ #vk.32 )
                  case Subject_Access_Request
