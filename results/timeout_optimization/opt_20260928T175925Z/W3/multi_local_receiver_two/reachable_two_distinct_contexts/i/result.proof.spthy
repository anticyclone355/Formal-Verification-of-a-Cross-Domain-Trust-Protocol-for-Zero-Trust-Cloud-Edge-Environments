                    case Object_Data_Encryption
                    solve( !KU( sign(<x.4, pk(~sr2), %1>, ~si) ) @ #vk.45 )
                      case Subject_Access_Request
                      solve( !KU( PEnc(ppk(~pi), ~k, x) ) @ #vk.20 )
                        case Object_Data_Encryption
                        solve( !KU( PEnc(ppk(~pi), ~k.1, x.1) ) @ #vk.25 )
                          case Object_Data_Encryption
                          solve( !KU( sign(<pk(~si), ppk(~pi), %1>, ~da) ) @ #vk.20 )
                            case W3_Setup
                            solve( !KU( sign(h(<pk(~si), pk(~sr), %1>), ~db) ) @ #vk.36 )
                              case Domain_Access_Verification
