theory W3_original_Concurrent_Agreement begin

// Function signature and definition of the equational theory E

builtins: natural-numbers
functions: PDec/2, PEnc/3, fst/1, h/1, pair/2, pk/1, ppk/1, sdec/2,
           senc/2, sign/2, snd/1, true/0, verify/3
equations:
    PDec(psk, PEnc(ppk(psk), k, r)) = k,
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true













restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction W3_OneSetup:
  "∀ #i #j. ((W3Init( ) @ #i) ∧ (W3Init( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

rule (modulo E) W3_Setup:
   [
   Fr( ~si ), Fr( ~pi ), Fr( ~sr ), Fr( ~pr ), Fr( ~da ), Fr( ~db ),
   Fr( ~si2 ), Fr( ~pi2 ), Fr( ~sr2 ), Fr( ~pr2 )
   ]
  --[ W3Init( ) ]->
   [
   !Subject( 'requester', 'domain_A', %1, ~si, ~pi, pk(~si), ppk(~pi) ),
   !Subject( 'owner', 'domain_B', %1, ~sr, ~pr, pk(~sr), ppk(~pr) ),
   !Domain( 'domain_A', %1, ~da, pk(~da) ),
   !Domain( 'domain_B', %1, ~db, pk(~db) ),
   !Policy( 'domain_A', 'domain_B', %1, 'requester', 'owner', '1' ),
   !W3Ready( 'requester', 'owner', 'domain_A', 'domain_B', %1 ),
   !Subject( 'requester_2', 'domain_A', %1, ~si2, ~pi2, pk(~si2), ppk(~pi2)
   ),
   !Subject( 'owner_2', 'domain_B', %1, ~sr2, ~pr2, pk(~sr2), ppk(~pr2) ),
   !Policy( 'domain_A', 'domain_B', %1, 'requester', 'owner_2', '1' ),
   !Policy( 'domain_A', 'domain_B', %1, 'requester_2', 'owner', '1' ),
   !Policy( 'domain_A', 'domain_B', %1, 'requester_2', 'owner_2', '1' ),
   !W3Ready( 'requester', 'owner_2', 'domain_A', 'domain_B', %1 ),
   !W3Ready( 'requester_2', 'owner', 'domain_A', 'domain_B', %1 ),
   !W3Ready( 'requester_2', 'owner_2', 'domain_A', 'domain_B', %1 ),
   Out( <pk(~si2), ppk(~pi2), %1, 'Subject Pk'> ),
   Out( <pk(~sr2), ppk(~pr2), %1, 'Subject Pk'> ),
   Out( <<pk(~si2), ppk(~pi2), %1>, sign(<pk(~si2), ppk(~pi2), %1>, ~da), 
         pk(~da), 'SubjectCert'>
   ),
   Out( <<pk(~sr2), ppk(~pr2), %1>, sign(<pk(~sr2), ppk(~pr2), %1>, ~db), 
         pk(~db), 'SubjectCert'>
   ),
   W3Budget( ), W3Budget( ), Out( <pk(~si), ppk(~pi), %1, 'Subject Pk'> ),
   Out( <pk(~sr), ppk(~pr), %1, 'Subject Pk'> ),
   Out( <<pk(~si), ppk(~pi), %1>, sign(<pk(~si), ppk(~pi), %1>, ~da), 
         pk(~da), 'SubjectCert'>
   ),
   Out( <<pk(~sr), ppk(~pr), %1>, sign(<pk(~sr), ppk(~pr), %1>, ~db), 
         pk(~db), 'SubjectCert'>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Subject_Access_Request[role=Authentication_and_Data_Sharing]:
   [
   !W3Ready( $S_a, $S_b, $A, $B, %1 ), W3Budget( )[+], Fr( ~rid ),
   !Subject( $S_a, $A, %1, pska, ppska, pka, ppka ),
   !Subject( $S_b, $B, %1, pskb, ppskb, pkb, ppkb ),
   !Domain( $A, %1, gskA, gpkA ), !Domain( $B, %1, gskB, gpkB ),
   In( <CertA, CertaSign, SignPk, 'SubjectCert'> )
   ]
  --[
  Eq( 'SubjectCert', 'SubjectCert' ), Eq( SignPk, gpkA ),
  Eq( verify(CertaSign, CertA, gpkA), true ), Eq( fst(CertA), pka ),
  Eq( fst(snd(CertA)), ppka ), Eq( snd(snd(CertA)), %1 ),
  W3Begin( ~rid, $S_a, $S_b, %1 ),
  AccessRequest( $S_a, $S_b, %1, $A, $B, pska, pskb, gskA )
  ]->
   [
   Out( <<<CertA, CertaSign, SignPk>, pkb, %1>, 
         sign(<<CertA, CertaSign, SignPk>, pkb, %1>, pska), pka, 'AccessR_a'>
   ),
   Access_send( $S_a, $S_b, %1, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB,
                ppka, ~rid
   )
   ]

  /*
  rule (modulo AC) Subject_Access_Request[role=Authentication_and_Data_Sharing]:
     [
     !W3Ready( $S_a, $S_b, $A, $B, %1 ), W3Budget( )[+], Fr( ~rid ),
     !Subject( $S_a, $A, %1, pska, ppska, pka, ppka ),
     !Subject( $S_b, $B, %1, pskb, ppskb, pkb, ppkb ),
     !Domain( $A, %1, gskA, gpkA ), !Domain( $B, %1, gskB, gpkB ),
     In( <CertA, CertaSign, SignPk, 'SubjectCert'> )
     ]
    --[
    Eq( 'SubjectCert', 'SubjectCert' ), Eq( SignPk, gpkA ), Eq( z, true ),
    Eq( z.1, pka ), Eq( z.2, ppka ), Eq( z.3, %1 ),
    W3Begin( ~rid, $S_a, $S_b, %1 ),
    AccessRequest( $S_a, $S_b, %1, $A, $B, pska, pskb, gskA )
    ]->
     [
     Out( <<<CertA, CertaSign, SignPk>, pkb, %1>, 
           sign(<<CertA, CertaSign, SignPk>, pkb, %1>, pska), pka, 'AccessR_a'>
     ),
     Access_send( $S_a, $S_b, %1, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB,
                  ppka, ~rid
     )
     ]
    variants (modulo AC)
    1. CertA = CertA.31
       CertaSign
             = CertaSign.32
       gpkA  = gpkA.34
       z     = verify(CertaSign.32, CertA.31, gpkA.34)
       z.1   = fst(CertA.31)
       z.2   = fst(snd(CertA.31))
       z.3   = snd(snd(CertA.31))
    
    2. CertA = CertA.50
       CertaSign
             = sign(CertA.50, x.93)
       gpkA  = pk(x.93)
       z     = true
       z.1   = fst(CertA.50)
       z.2   = fst(snd(CertA.50))
       z.3   = snd(snd(CertA.50))
    
    3. CertA = <z.33, x.40>
       CertaSign
             = sign(<z.33, x.40>, x.41)
       gpkA  = pk(x.41)
       z     = true
       z.1   = z.33
       z.2   = fst(x.40)
       z.3   = snd(x.40)
    
    4. CertA = <z.34, z.35, z.36>
       CertaSign
             = sign(<z.34, z.35, z.36>, x.43)
       gpkA  = pk(x.43)
       z     = true
       z.1   = z.34
       z.2   = z.35
       z.3   = z.36
    
    5. CertA = <z.64, z.65, z.66>
       CertaSign
             = CertaSign.47
       gpkA  = gpkA.49
       z     = verify(CertaSign.47, <z.64, z.65, z.66>, gpkA.49)
       z.1   = z.64
       z.2   = z.65
       z.3   = z.66
    
    6. CertA = <z.66, x.90>
       CertaSign
             = CertaSign.49
       gpkA  = gpkA.51
       z     = verify(CertaSign.49, <z.66, x.90>, gpkA.51)
       z.1   = z.66
       z.2   = fst(x.90)
       z.3   = snd(x.90)
  */

rule (modulo E) Domain_Access_Verification[role=Authentication_and_Data_Sharing]:
   [
   In( <AccessRa, AccesssSign, AccessPKa, 'AccessR_a'> ),
   Access_send( $S_a, $S_b, %1, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB,
                ppka, rid
   )[+],
   !Policy( $A, $B, %1, $S_a, $S_b, bit ),
   !Subject( $S_b, $B, %1, pskb, ppskb, pkb, ppkb )
   ]
  --[
  Eq( 'AccessR_a', 'AccessR_a' ), Eq( pka, AccessPKa ),
  Eq( verify(AccesssSign, AccessRa, pka), true ),
  Eq( fst(snd(AccessRa)), pkb ), Eq( snd(snd(AccessRa)), %1 ),
  Eq( bit, '1' ), AccessGranted( $S_a, $S_b, %1, pka, pkb, bit )
  ]->
   [
   Out( <h(<pka, pkb, %1>), sign(h(<pka, pkb, %1>), gskB), pk(gskB), 
         'AccessCert_ab'>
   ),
   AccessCert_send( $S_a, $S_b, %1, pka, pkb, pskb, ppka, $A, $B, gpkA,
                    gpkB, rid
   )
   ]

  /*
  rule (modulo AC) Domain_Access_Verification[role=Authentication_and_Data_Sharing]:
     [
     In( <AccessRa, AccesssSign, AccessPKa, 'AccessR_a'> ),
     Access_send( $S_a, $S_b, %1, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB,
                  ppka, rid
     )[+],
     !Policy( $A, $B, %1, $S_a, $S_b, bit ),
     !Subject( $S_b, $B, %1, pskb, ppskb, pkb, ppkb )
     ]
    --[
    Eq( 'AccessR_a', 'AccessR_a' ), Eq( pka, AccessPKa ), Eq( z, true ),
    Eq( z.1, pkb ), Eq( z.2, %1 ), Eq( bit, '1' ),
    AccessGranted( $S_a, $S_b, %1, pka, pkb, bit )
    ]->
     [
     Out( <h(<pka, pkb, %1>), sign(h(<pka, pkb, %1>), gskB), pk(gskB), 
           'AccessCert_ab'>
     ),
     AccessCert_send( $S_a, $S_b, %1, pka, pkb, pskb, ppka, $A, $B, gpkA,
                      gpkB, rid
     )
     ]
    variants (modulo AC)
    1. AccessRa
             = AccessRa.33
       AccesssSign
             = AccesssSign.34
       pka   = pka.40
       z     = verify(AccesssSign.34, AccessRa.33, pka.40)
       z.1   = fst(snd(AccessRa.33))
       z.2   = snd(snd(AccessRa.33))
    
    2. AccessRa
             = AccessRa.67
       AccesssSign
             = sign(AccessRa.67, x.127)
       pka   = pk(x.127)
       z     = true
       z.1   = fst(snd(AccessRa.67))
       z.2   = snd(snd(AccessRa.67))
    
    3. AccessRa
             = <x.28, x.29>
       AccesssSign
             = sign(<x.28, x.29>, x.30)
       pka   = pk(x.30)
       z     = true
       z.1   = fst(x.29)
       z.2   = snd(x.29)
    
    4. AccessRa
             = <x.43, z.35, z.36>
       AccesssSign
             = sign(<x.43, z.35, z.36>, x.46)
       pka   = pk(x.46)
       z     = true
       z.1   = z.35
       z.2   = z.36
    
    5. AccessRa
             = <x.120, z.80, z.81>
       AccesssSign
             = AccesssSign.64
       pka   = pka.70
       z     = verify(AccesssSign.64, <x.120, z.80, z.81>, pka.70)
       z.1   = z.80
       z.2   = z.81
    
    6. AccessRa
             = <x.121, x.122>
       AccesssSign
             = AccesssSign.65
       pka   = pka.71
       z     = verify(AccesssSign.65, <x.121, x.122>, pka.71)
       z.1   = fst(x.122)
       z.2   = snd(x.122)
  */

rule (modulo E) Object_Data_Encryption[role=Authentication_and_Data_Sharing]:
   [
   In( <Hash1, Hashsign, Hashpk, 'AccessCert_ab'> ),
   AccessCert_send( $S_a, $S_b, %1, pka, pkb, pskb, ppka, $A, $B, gpkA,
                    gpkB, rid
   )[+],
   !Subject( $S_a, $A, %1, pska, ppska, pka, ppka ),
   !Subject( $S_b, $B, %1, pskb, ppskb, pkb, ppkb ), Fr( ~x ), Fr( ~k ),
   Fr( ~v )
   ]
  --[
  Eq( 'AccessCert_ab', 'AccessCert_ab' ), Eq( gpkB, Hashpk ),
  Eq( verify(Hashsign, Hash1, gpkB), true ),
  Eq( Hash1, h(<pka, pkb, %1>) ), W3Running( $S_a, $S_b, %1, ~x, ~k ),
  W3DataSent( $S_a, $S_b, %1, ~x, PEnc(ppka, ~k, ~v),
              senc(<~x, sign(~x, pskb), pk(pskb)>, ~k)
  ),
  DataSent( $S_b, $S_a, %1, pskb, ppka, pka, ~x, ~k ), Secret( ~x, %1 ),
  SessionKey( ~k, %1 ), Honest( $S_a, %1 ), Honest( $S_b, %1 )
  ]->
   [
   Out( <PEnc(ppka, ~k, ~v), senc(<~x, sign(~x, pskb), pk(pskb)>, ~k), 
         'data'>
   ),
   X_send( $S_b, $S_a, %1, pskb, pkb, ppskb, pska, ppska,
           <~x, sign(~x, pskb), pk(pskb)>, ~x, ~k, rid
   )
   ]

  /*
  rule (modulo AC) Object_Data_Encryption[role=Authentication_and_Data_Sharing]:
     [
     In( <Hash1, Hashsign, Hashpk, 'AccessCert_ab'> ),
     AccessCert_send( $S_a, $S_b, %1, pka, pkb, pskb, ppka, $A, $B, gpkA,
                      gpkB, rid
     )[+],
     !Subject( $S_a, $A, %1, pska, ppska, pka, ppka ),
     !Subject( $S_b, $B, %1, pskb, ppskb, pkb, ppkb ), Fr( ~x ), Fr( ~k ),
     Fr( ~v )
     ]
    --[
    Eq( 'AccessCert_ab', 'AccessCert_ab' ), Eq( gpkB, Hashpk ),
    Eq( z, true ), Eq( Hash1, h(<pka, pkb, %1>) ),
    W3Running( $S_a, $S_b, %1, ~x, ~k ),
    W3DataSent( $S_a, $S_b, %1, ~x, PEnc(ppka, ~k, ~v),
                senc(<~x, sign(~x, pskb), pk(pskb)>, ~k)
    ),
    DataSent( $S_b, $S_a, %1, pskb, ppka, pka, ~x, ~k ), Secret( ~x, %1 ),
    SessionKey( ~k, %1 ), Honest( $S_a, %1 ), Honest( $S_b, %1 )
    ]->
     [
     Out( <PEnc(ppka, ~k, ~v), senc(<~x, sign(~x, pskb), pk(pskb)>, ~k), 
           'data'>
     ),
     X_send( $S_b, $S_a, %1, pskb, pkb, ppskb, pska, ppska,
             <~x, sign(~x, pskb), pk(pskb)>, ~x, ~k, rid
     )
     ]
    variants (modulo AC)
    1. Hash1 = Hash1.30
       Hashsign
             = Hashsign.32
       gpkB  = gpkB.34
       z     = verify(Hashsign.32, Hash1.30, gpkB.34)
    
    2. Hash1 = Hash1.45
       Hashsign
             = sign(Hash1.45, x.81)
       gpkB  = pk(x.81)
       z     = true
  */

rule (modulo E) Subject_Data_Decryption[role=Authentication_and_Data_Sharing]:
   [
   In( <alpha, beta, 'data'> ),
   X_send( $S_b, $S_a, %1, pskb, pkb, ppskb, pska, ppska, d, x, k, rid )
   ]
  --[
  Eq( 'data', 'data' ), Eq( PDec(ppska, alpha), k ),
  Eq( sdec(beta, PDec(ppska, alpha)), d ),
  Eq( snd(snd(sdec(beta, PDec(ppska, alpha)))), pkb ),
  Eq( verify(fst(snd(sdec(beta, PDec(ppska, alpha)))),
             fst(sdec(beta, PDec(ppska, alpha))), pkb),
      true
  ),
  Eq( fst(sdec(beta, PDec(ppska, alpha))), x ),
  W3End( rid, $S_a, $S_b, %1 ), W3Commit( $S_a, $S_b, %1, x, k ),
  W3DataAccepted( $S_a, $S_b, %1, x, alpha, beta ),
  DataReceive( $S_b, $S_a, %1, alpha, beta, ppska, pkb, k, x )
  ]->
   [ ]

  /*
  rule (modulo AC) Subject_Data_Decryption[role=Authentication_and_Data_Sharing]:
     [
     In( <alpha, beta, 'data'> ),
     X_send( $S_b, $S_a, %1, pskb, pkb, ppskb, pska, ppska, d, x, k, rid )
     ]
    --[
    Eq( 'data', 'data' ), Eq( z, k ), Eq( z.1, d ), Eq( z.2, pkb ),
    Eq( z.3, true ), Eq( z.4, x ), W3End( rid, $S_a, $S_b, %1 ),
    W3Commit( $S_a, $S_b, %1, x, k ),
    W3DataAccepted( $S_a, $S_b, %1, x, alpha, beta ),
    DataReceive( $S_b, $S_a, %1, alpha, beta, ppska, pkb, k, x )
    ]->
     [ ]
    variants (modulo AC)
     1. alpha = alpha.21
        beta  = beta.22
        pkb   = pkb.25
        ppska = ppska.26
        z     = PDec(ppska.26, alpha.21)
        z.1   = sdec(beta.22, PDec(ppska.26, alpha.21))
        z.2   = snd(snd(sdec(beta.22, PDec(ppska.26, alpha.21))))
        z.3   = verify(fst(snd(sdec(beta.22, PDec(ppska.26, alpha.21)))),
                       fst(sdec(beta.22, PDec(ppska.26, alpha.21))), pkb.25)
        z.4   = fst(sdec(beta.22, PDec(ppska.26, alpha.21)))
    
     2. alpha = alpha.24
        beta  = senc(z.37, PDec(ppska.29, alpha.24))
        pkb   = pkb.28
        ppska = ppska.29
        z     = PDec(ppska.29, alpha.24)
        z.1   = z.37
        z.2   = snd(snd(z.37))
        z.3   = verify(fst(snd(z.37)), fst(z.37), pkb.28)
        z.4   = fst(z.37)
    
     3. alpha = alpha.25
        beta  = senc(<z.41, x.44>, PDec(ppska.30, alpha.25))
        pkb   = pkb.29
        ppska = ppska.30
        z     = PDec(ppska.30, alpha.25)
        z.1   = <z.41, x.44>
        z.2   = snd(x.44)
        z.3   = verify(fst(x.44), z.41, pkb.29)
        z.4   = z.41
    
     4. alpha = alpha.25
        beta  = senc(<z.41, sign(z.41, x.44), z.39>, PDec(ppska.30, alpha.25))
        pkb   = pk(x.44)
        ppska = ppska.30
        z     = PDec(ppska.30, alpha.25)
        z.1   = <z.41, sign(z.41, x.44), z.39>
        z.2   = z.39
        z.3   = true
        z.4   = z.41
    
     5. alpha = alpha.26
        beta  = senc(<z.42, x.45, z.40>, PDec(ppska.31, alpha.26))
        pkb   = pkb.30
        ppska = ppska.31
        z     = PDec(ppska.31, alpha.26)
        z.1   = <z.42, x.45, z.40>
        z.2   = z.40
        z.3   = verify(x.45, z.42, pkb.30)
        z.4   = z.42
    
     6. alpha = PEnc(ppk(ppska.26), z.33, x.40)
        beta  = senc(z.34, z.33)
        pkb   = pkb.25
        ppska = ppska.26
        z     = z.33
        z.1   = z.34
        z.2   = snd(snd(z.34))
        z.3   = verify(fst(snd(z.34)), fst(z.34), pkb.25)
        z.4   = fst(z.34)
    
     7. alpha = PEnc(ppk(ppska.26), z.33, x.40)
        beta  = senc(<z.37, sign(z.37, x.42), z.35>, z.33)
        pkb   = pk(x.42)
        ppska = ppska.26
        z     = z.33
        z.1   = <z.37, sign(z.37, x.42), z.35>
        z.2   = z.35
        z.3   = true
        z.4   = z.37
    
     8. alpha = PEnc(ppk(ppska.27), z.34, x.41)
        beta  = senc(<z.38, x.43>, z.34)
        pkb   = pkb.26
        ppska = ppska.27
        z     = z.34
        z.1   = <z.38, x.43>
        z.2   = snd(x.43)
        z.3   = verify(fst(x.43), z.38, pkb.26)
        z.4   = z.38
    
     9. alpha = PEnc(ppk(ppska.28), z.35, x.42)
        beta  = beta.24
        pkb   = pkb.27
        ppska = ppska.28
        z     = z.35
        z.1   = sdec(beta.24, z.35)
        z.2   = snd(snd(sdec(beta.24, z.35)))
        z.3   = verify(fst(snd(sdec(beta.24, z.35))), fst(sdec(beta.24, z.35)),
                       pkb.27)
        z.4   = fst(sdec(beta.24, z.35))
    
    10. alpha = PEnc(ppk(ppska.28), z.35, x.42)
        beta  = senc(<z.39, x.44, z.37>, z.35)
        pkb   = pkb.27
        ppska = ppska.28
        z     = z.35
        z.1   = <z.39, x.44, z.37>
        z.2   = z.37
        z.3   = verify(x.44, z.39, pkb.27)
        z.4   = z.39
  */

lemma reachable_session:
  exists-trace
  "∃ q I R e #b #c.
    ((W3Begin( q, I, R, e ) @ #b) ∧ (W3End( q, I, R, e ) @ #c)) ∧ (#b < #c)"
/*
guarded formula characterizing all satisfying traces:
"∃ q I R e #b #c.
  (W3Begin( q, I, R, e ) @ #b) ∧ (W3End( q, I, R, e ) @ #c) ∧ #b < #c"
*/
by sorry

lemma reachable_two_concurrent_sessions:
  exists-trace
  "∃ q1 q2 I R e #b1 #b2 #c1 #c2.
    ((((((((W3Begin( q1, I, R, e ) @ #b1) ∧ (W3Begin( q2, I, R, e ) @ #b2)) ∧
          (W3End( q1, I, R, e ) @ #c1)) ∧
         (W3End( q2, I, R, e ) @ #c2)) ∧
        (¬(q1 = q2))) ∧
       (#b1 < #b2)) ∧
      (#b2 < #c1)) ∧
     (#b2 < #c2)) ∧
    (¬(#c1 = #c2))"
/*
guarded formula characterizing all satisfying traces:
"∃ q1 q2 I R e #b1 #b2 #c1 #c2.
  (W3Begin( q1, I, R, e ) @ #b1) ∧
