/* Timeout optimization candidate, 2026-09-29. NOT Tamarin-verified.
   Derived from executed snapshot; see README.md and provenance.json. */


theory W3_original_Concurrent_Agreement

begin



builtins: hashing, signing, symmetric-encryption, natural-numbers

functions: PEnc/3, PDec/2, ppk/1

equations: PDec(psk,PEnc(ppk(psk),k,r)) = k



restriction Equality:

  "All x y #i. Eq(x,y) @i ==> x = y"





restriction W3_OneSetup:

  "All #i #j. W3Init() @i & W3Init() @j ==> #i = #j"













rule W3_Setup:

  [ Fr(~si), Fr(~pi), Fr(~sr), Fr(~pr), Fr(~da), Fr(~db), Fr(~si2), Fr(~pi2), Fr(~sr2), Fr(~pr2) ]
--[ W3Init() ]->
[ !Subject('requester','domain_A',%1,~si,~pi,pk(~si),ppk(~pi))

  , !Subject('owner','domain_B',%1,~sr,~pr,pk(~sr),ppk(~pr))

  , !Domain('domain_A',%1,~da,pk(~da))

  , !Domain('domain_B',%1,~db,pk(~db))

  , !Policy('domain_A','domain_B',%1,'requester','owner','1')

  , !W3Ready('requester','owner','domain_A','domain_B',%1)

  , !Subject('requester_2','domain_A',%1,~si2,~pi2,pk(~si2),ppk(~pi2))

  , !Subject('owner_2','domain_B',%1,~sr2,~pr2,pk(~sr2),ppk(~pr2))

  , !Policy('domain_A','domain_B',%1,'requester','owner_2','1')

  , !Policy('domain_A','domain_B',%1,'requester_2','owner','1')

  , !Policy('domain_A','domain_B',%1,'requester_2','owner_2','1')

  , !W3Ready('requester','owner_2','domain_A','domain_B',%1)

  , !W3Ready('requester_2','owner','domain_A','domain_B',%1)

  , !W3Ready('requester_2','owner_2','domain_A','domain_B',%1)

  , Out(<pk(~si2),ppk(~pi2),%1,'Subject Pk'>)

  , Out(<pk(~sr2),ppk(~pr2),%1,'Subject Pk'>)

  , Out(<<pk(~si2),ppk(~pi2),%1>,sign(<pk(~si2),ppk(~pi2),%1>,~da),pk(~da),'SubjectCert'>)

  , Out(<<pk(~sr2),ppk(~pr2),%1>,sign(<pk(~sr2),ppk(~pr2),%1>,~db),pk(~db),'SubjectCert'>)

  , W3Budget(), W3Budget()

  , Out(<pk(~si),ppk(~pi),%1,'Subject Pk'>)

  , Out(<pk(~sr),ppk(~pr),%1,'Subject Pk'>)

  , Out(<<pk(~si),ppk(~pi),%1>,sign(<pk(~si),ppk(~pi),%1>,~da),pk(~da),'SubjectCert'>)

  , Out(<<pk(~sr),ppk(~pr),%1>,sign(<pk(~sr),ppk(~pr),%1>,~db),pk(~db),'SubjectCert'>)

  ]

rule Subject_Access_Request[role="Authentication_and_Data_Sharing"]:

    let

        CertA_Pro = <CertA, CertaSign, SignPk>

        AccessRa = <CertA_Pro, pkb, %1>

    in

    [

        !W3Ready($S_a,$S_b,$A,$B,%1)

        , W3Budget()[+]

        , Fr(~rid)

        ,         !Subject($S_a, $A, %1, pska, ppska, pka, ppka)

        , !Subject($S_b, $B, %1, pskb, ppskb, pkb, ppkb)

        , !Domain($A, %1, gskA, gpkA)

        , !Domain($B, %1, gskB, gpkB)

        , In(<CertA, CertaSign, SignPk, 'SubjectCert'>)

    ]
--[

        Eq('SubjectCert', 'SubjectCert')

        , Eq(SignPk,gpkA)

        , Eq(verify(CertaSign,CertA,gpkA),true)



        , Eq(fst(CertA), pka)

        , Eq(fst(snd(CertA)), ppka)

        , Eq(snd(snd(CertA)), %1)

        , W3Begin(~rid,$S_a,$S_b,%1)

        , AccessRequest($S_a, $S_b, %1, $A, $B, pska, pskb, gskA)

    ]->
[



        Out(<AccessRa,sign(AccessRa,pska),pka, 'AccessR_a'>)

        , Access_send($S_a, $S_b, %1, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB, ppka,~rid)

    ]

rule Domain_Access_Verification[role="Authentication_and_Data_Sharing"]:

    let

        CertA_Pro = fst(AccessRa)

        pkbIn = fst(snd(AccessRa))

        Epoch_Access = snd(snd(AccessRa))



    in

    [

        In(<AccessRa,AccesssSign,AccessPKa, 'AccessR_a'>)

        , Access_send($S_a, $S_b, %1, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB, ppka,rid)[+]

        , !Policy($A, $B, %1, $S_a, $S_b, bit)

        , !Subject($S_b, $B, %1, pskb, ppskb, pkb, ppkb)

    ]
--[

        Eq('AccessR_a', 'AccessR_a')

        , Eq(pka,AccessPKa)

        , Eq(verify(AccesssSign, AccessRa, pka), true)

        , Eq(pkbIn,pkb)

        , Eq(Epoch_Access, %1)



        , Eq(bit, '1')

        , AccessGranted($S_a, $S_b, %1, pka, pkb, bit)

    ]->
[

        Out(<  <h(<pka, pkb, %1>)>, sign(h(<pka, pkb, %1>), gskB), pk(gskB) , 'AccessCert_ab' >)

        , AccessCert_send($S_a, $S_b, %1, pka, pkb, pskb, ppka, $A, $B, gpkA, gpkB,rid)

    ]

rule Object_Data_Encryption[role="Authentication_and_Data_Sharing"]:

    let

        d = < ~x, sign(~x,pskb),pk(pskb)>

        alpha = PEnc(ppka, ~k, ~v)



        beta = senc(d, ~k)

    in

    [

        In(<Hash1, Hashsign, Hashpk , 'AccessCert_ab'>)

        , AccessCert_send($S_a, $S_b, %1, pka, pkb, pskb, ppka, $A, $B, gpkA, gpkB,rid)[+]

        , !Subject($S_a, $A, %1, pska, ppska, pka, ppka)

        , !Subject($S_b, $B, %1, pskb, ppskb, pkb, ppkb)

        , Fr(~x)

        , Fr(~k)

        , Fr(~v)

    ]
--[

        Eq('AccessCert_ab', 'AccessCert_ab')

        , Eq(gpkB,Hashpk)

        , Eq(verify(Hashsign, Hash1, gpkB), true)

        , Eq(Hash1,h(<pka, pkb, %1>))

        , W3Running($S_a,$S_b,%1,~x,~k)

        , W3DataSent($S_a,$S_b,%1,~x,alpha,beta)

        , DataSent($S_b, $S_a, %1, pskb, ppka, pka, ~x, ~k)



        , Secret(~x, %1)

        , SessionKey(~k, %1)

        , Honest($S_a, %1)

        , Honest($S_b, %1)



    ]->
[

        Out(<alpha, beta, 'data'>)

        , X_send($S_b, $S_a, %1, pskb, pkb, ppskb, pska, ppska, d, ~x, ~k,rid)



    ]

rule Subject_Data_Decryption[role="Authentication_and_Data_Sharing"]:

let

    k_in = PDec(ppska, alpha)



    d_in = sdec(beta, k_in)

    x_in = fst(d_in)

    pk_in = snd(snd(d_in))

    sign_x = fst(snd(d_in))

in

[

    In(<alpha, beta, 'data'>)

    , X_send($S_b, $S_a, %1, pskb, pkb, ppskb, pska, ppska, d, x, k,rid)



]
--[

    Eq('data', 'data')

    , Eq(k_in, k)

    , Eq(d_in, d)

    , Eq(pk_in, pkb)

    , Eq(verify(sign_x, x_in, pkb), true)

    , Eq(x_in,x)

    , W3End(rid,$S_a,$S_b,%1)

    , W3Commit($S_a,$S_b,%1,x,k)

    , W3DataAccepted($S_a,$S_b,%1,x,alpha,beta)

    , DataReceive($S_b, $S_a, %1, alpha, beta, ppska, pkb, k, x)



]->
[



]

lemma reachable_session:

 exists-trace

 "Ex q I R e #b #c. W3Begin(q,I,R,e) @b & W3End(q,I,R,e) @c & #b < #c"



lemma reachable_two_concurrent_sessions:

 exists-trace

 "Ex q1 q2 I R e #b1 #b2 #c1 #c2.

 W3Begin(q1,I,R,e) @b1 & W3Begin(q2,I,R,e) @b2

 & W3End(q1,I,R,e) @c1 & W3End(q2,I,R,e) @c2

 & not(q1 = q2) & #b1 < #b2 & #b2 < #c1 & #b2 < #c2

 & not(#c1 = #c2)"



lemma initiator_aliveness:

 all-traces

 "All I R e x k #c. W3Commit(I,R,e,x,k) @c

 ==> (Ex I2 e2 x2 k2 #r. W3Running(I2,R,e2,x2,k2) @r & #r < #c)"



lemma initiator_weak_agreement:

 all-traces

 "All I R e x k #c. W3Commit(I,R,e,x,k) @c

 ==> (Ex e2 x2 k2 #r. W3Running(I,R,e2,x2,k2) @r & #r < #c)"



lemma initiator_noninjective_agreement:

 all-traces

 "All I R e x k #c. W3Commit(I,R,e,x,k) @c

 ==> (Ex #r. W3Running(I,R,e,x,k) @r & #r < #c)"



lemma initiator_injective_agreement:

 all-traces

 "All I R e x k #c. W3Commit(I,R,e,x,k) @c

 ==> (Ex #r. W3Running(I,R,e,x,k) @r & #r < #c

 & (All #c2. W3Commit(I,R,e,x,k) @c2 ==> #c2 = #c))"



lemma data_origin_authentication:

 all-traces

 "All I R e x a b #c. W3DataAccepted(I,R,e,x,a,b) @c

 ==> (Ex #s. W3DataSent(I,R,e,x,a,b) @s & #s < #c)"



lemma replay_acceptance_exclusion:

 all-traces

 "All I R e x a b #c1 #c2.

 W3DataAccepted(I,R,e,x,a,b) @c1 & W3DataAccepted(I,R,e,x,a,b) @c2

 ==> #c1 = #c2"



lemma reachable_two_distinct_contexts:

 exists-trace

 "Ex q1 q2 I1 I2 R1 R2 e #b1 #b2 #c1 #c2.

 W3Begin(q1,I1,R1,e) @b1 & W3Begin(q2,I2,R2,e) @b2

 & W3End(q1,I1,R1,e) @c1 & W3End(q2,I2,R2,e) @c2

 & not(q1 = q2) & (not(I1 = I2) | not(R1 = R2))

 & #b1 < #b2 & #b2 < #c1 & #b2 < #c2 & not(#c1 = #c2)"



lemma unknown_key_share_exclusion:

 all-traces

 "All I R e x k I2 R2 e2 x2 #c #s.

 W3Commit(I,R,e,x,k) @c & W3Running(I2,R2,e2,x2,k) @s

 ==> (I = I2 & R = R2 & e = e2)"





end

