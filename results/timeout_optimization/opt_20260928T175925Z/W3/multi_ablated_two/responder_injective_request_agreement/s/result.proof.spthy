lemma reachable_session:
  exists-trace
  "∃ q I R e #b #c.
    ((W3Begin( q, I, R, e ) @ #b) ∧ (W3End( q, I, R, e ) @ #c)) ∧ (#b < #c)"
/*
guarded formula characterizing all satisfying traces:
"∃ q I R e #b #c.
  (W3Begin( q, I, R, e ) @ #b) ∧ (W3End( q, I, R, e ) @ #c) ∧ #b < #c"
*/
by sorry

lemma reachable_two_concurrent_sessions:
  exists-trace
  "∃ q1 q2 I R e #b1 #b2 #c1 #c2.
    ((((((((W3Begin( q1, I, R, e ) @ #b1) ∧ (W3Begin( q2, I, R, e ) @ #b2)) ∧
          (W3End( q1, I, R, e ) @ #c1)) ∧
         (W3End( q2, I, R, e ) @ #c2)) ∧
        (¬(q1 = q2))) ∧
       (#b1 < #b2)) ∧
      (#b2 < #c1)) ∧
     (#b2 < #c2)) ∧
    (¬(#c1 = #c2))"
/*
guarded formula characterizing all satisfying traces:
"∃ q1 q2 I R e #b1 #b2 #c1 #c2.
  (W3Begin( q1, I, R, e ) @ #b1) ∧
  (W3Begin( q2, I, R, e ) @ #b2) ∧
  (W3End( q1, I, R, e ) @ #c1) ∧
  (W3End( q2, I, R, e ) @ #c2)
 ∧
  (¬(q1 = q2)) ∧ (#b1 < #b2) ∧ (#b2 < #c1) ∧ (#b2 < #c2) ∧ (¬(#c1 = #c2))"
*/
by sorry

lemma initiator_aliveness:
  all-traces
  "∀ I R A B e sid x k T #c.
    (CommitInitiator( I, R, A, B, e, sid, x, k, T ) @ #c) ⇒
    (∃ I2 A2 B2 e2 sid2 x2 k2 T2 #r.
      (RunningResponder( R, I2, A2, B2, e2, sid2, x2, k2, T2 ) @ #r) ∧
      (#r < #c))"
/*
guarded formula characterizing all counter-examples:
"∃ I R A B e sid x k T #c.
  (CommitInitiator( I, R, A, B, e, sid, x, k, T ) @ #c)
 ∧
  ∀ I2 A2 B2 e2 sid2 x2 k2 T2 #r.
   (RunningResponder( R, I2, A2, B2, e2, sid2, x2, k2, T2 ) @ #r)
  ⇒
   ¬(#r < #c)"
*/
by sorry

lemma initiator_weak_agreement:
  all-traces
  "∀ I R A B e sid x k T #c.
    (CommitInitiator( I, R, A, B, e, sid, x, k, T ) @ #c) ⇒
    (∃ A2 B2 e2 sid2 x2 k2 T2 #r.
      (RunningResponder( R, I, A2, B2, e2, sid2, x2, k2, T2 ) @ #r) ∧
      (#r < #c))"
/*
guarded formula characterizing all counter-examples:
"∃ I R A B e sid x k T #c.
  (CommitInitiator( I, R, A, B, e, sid, x, k, T ) @ #c)
 ∧
  ∀ A2 B2 e2 sid2 x2 k2 T2 #r.
   (RunningResponder( R, I, A2, B2, e2, sid2, x2, k2, T2 ) @ #r)
  ⇒
   ¬(#r < #c)"
*/
by sorry

lemma initiator_noninjective_agreement:
  all-traces
  "∀ I R A B e sid x k T #c.
    (CommitInitiator( I, R, A, B, e, sid, x, k, T ) @ #c) ⇒
    (∃ #r.
      (RunningResponder( R, I, A, B, e, sid, x, k, T ) @ #r) ∧ (#r < #c))"
/*
guarded formula characterizing all counter-examples:
"∃ I R A B e sid x k T #c.
  (CommitInitiator( I, R, A, B, e, sid, x, k, T ) @ #c)
 ∧
  ∀ #r.
   (RunningResponder( R, I, A, B, e, sid, x, k, T ) @ #r) ⇒ ¬(#r < #c)"
*/
by sorry

lemma initiator_injective_agreement:
  all-traces
  "∀ I R A B e sid x k T #c.
    (CommitInitiator( I, R, A, B, e, sid, x, k, T ) @ #c) ⇒
    (∃ #r.
      ((RunningResponder( R, I, A, B, e, sid, x, k, T ) @ #r) ∧ (#r < #c)) ∧
      (∀ #c2.
        (CommitInitiator( I, R, A, B, e, sid, x, k, T ) @ #c2) ⇒ (#c2 = #c)))"
/*
guarded formula characterizing all counter-examples:
"∃ I R A B e sid x k T #c.
  (CommitInitiator( I, R, A, B, e, sid, x, k, T ) @ #c)
 ∧
  ∀ #r.
   (RunningResponder( R, I, A, B, e, sid, x, k, T ) @ #r)
  ⇒
   ((¬(#r < #c)) ∨
    (∃ #c2.
      (CommitInitiator( I, R, A, B, e, sid, x, k, T ) @ #c2) ∧ ¬(#c2 = #c)))"
*/
by sorry

lemma responder_aliveness:
  all-traces
  "∀ I R A B e sid X ctx #c.
    (CommitResponderRequest( I, R, A, B, e, sid, X, ctx ) @ #c) ⇒
    (∃ R2 A2 B2 e2 sid2 X2 ctx2 #r.
      (RunningInitiatorRequest( I, R2, A2, B2, e2, sid2, X2, ctx2 ) @ #r) ∧
      (#r < #c))"
/*
guarded formula characterizing all counter-examples:
"∃ I R A B e sid X ctx #c.
  (CommitResponderRequest( I, R, A, B, e, sid, X, ctx ) @ #c)
 ∧
  ∀ R2 A2 B2 e2 sid2 X2 ctx2 #r.
   (RunningInitiatorRequest( I, R2, A2, B2, e2, sid2, X2, ctx2 ) @ #r)
  ⇒
   ¬(#r < #c)"
*/
by sorry

lemma responder_weak_agreement:
  all-traces
  "∀ I R A B e sid X ctx #c.
    (CommitResponderRequest( I, R, A, B, e, sid, X, ctx ) @ #c) ⇒
    (∃ A2 B2 e2 sid2 X2 ctx2 #r.
      (RunningInitiatorRequest( I, R, A2, B2, e2, sid2, X2, ctx2 ) @ #r) ∧
