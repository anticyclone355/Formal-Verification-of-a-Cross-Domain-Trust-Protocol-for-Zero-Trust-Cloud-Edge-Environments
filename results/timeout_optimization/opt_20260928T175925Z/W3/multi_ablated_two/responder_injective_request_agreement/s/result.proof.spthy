                                           <'CDDS-AECDHE-full-v4', $S_a.40, $A.38, $S_b.41, $B.39, %1, 
                                            sid.52, pka.49, pkb.50, X.43, DH_neutral, h(Hash1.42)>))), 
                         'CDDS-AECDHE-full-v4', $S_a.40, $A.38, $S_b.41, $B.39, %1, sid.52, 
                         pka.49, pkb.50, X.43, DH_neutral, h(Hash1.42)>,
                        pkb.50)
         z.3   = fst(sdec(beta.45,
                          kdf_data(DH_neutral,
                                   <'CDDS-AECDHE-full-v4', $S_a.40, $A.38, $S_b.41, $B.39, %1, sid.52, 
                                    pka.49, pkb.50, X.43, DH_neutral, h(Hash1.42)>)))
    
      4. $A    = $A.41
         $B    = $B.42
         $S_a  = $S_a.43
         $S_b  = $S_b.44
         Hash1 = Hash1.45
         X     = X.46
         Y     = z.58^inv(ie.50)
         beta  = beta.48
         ie    = ie.50
         pka   = pka.52
         pkb   = pkb.53
         sid   = sid.55
         z     = z.58
         z.1   = snd(snd(sdec(beta.48,
                              kdf_data(z.58,
                                       <'CDDS-AECDHE-full-v4', $S_a.43, $A.41, $S_b.44, $B.42, %1, sid.55, 
                                        pka.52, pkb.53, X.46, z.58^inv(ie.50), h(Hash1.45)>))))
         z.2   = verify(fst(snd(sdec(beta.48,
                                     kdf_data(z.58,
                                              <'CDDS-AECDHE-full-v4', $S_a.43, $A.41, $S_b.44, $B.42, %1, 
                                               sid.55, pka.52, pkb.53, X.46, z.58^inv(ie.50), h(Hash1.45)
                                              >)))),
                        <
                         fst(sdec(beta.48,
                                  kdf_data(z.58,
                                           <'CDDS-AECDHE-full-v4', $S_a.43, $A.41, $S_b.44, $B.42, %1, 
                                            sid.55, pka.52, pkb.53, X.46, z.58^inv(ie.50), h(Hash1.45)>))), 
                         'CDDS-AECDHE-full-v4', $S_a.43, $A.41, $S_b.44, $B.42, %1, sid.55, 
                         pka.52, pkb.53, X.46, z.58^inv(ie.50), h(Hash1.45)>,
                        pkb.53)
         z.3   = fst(sdec(beta.48,
                          kdf_data(z.58,
                                   <'CDDS-AECDHE-full-v4', $S_a.43, $A.41, $S_b.44, $B.42, %1, sid.55, 
                                    pka.52, pkb.53, X.46, z.58^inv(ie.50), h(Hash1.45)>)))
    
      5. $A    = $A.69
         $B    = $B.70
         $S_a  = $S_a.71
         $S_b  = $S_b.72
         Hash1 = Hash1.73
         X     = X.74
         Y     = z.86^x.136
         beta  = beta.76
         ie    = inv(x.136)
         pka   = pka.80
         pkb   = pkb.81
         sid   = sid.83
         z     = z.86
         z.1   = snd(snd(sdec(beta.76,
                              kdf_data(z.86,
                                       <'CDDS-AECDHE-full-v4', $S_a.71, $A.69, $S_b.72, $B.70, %1, sid.83, 
