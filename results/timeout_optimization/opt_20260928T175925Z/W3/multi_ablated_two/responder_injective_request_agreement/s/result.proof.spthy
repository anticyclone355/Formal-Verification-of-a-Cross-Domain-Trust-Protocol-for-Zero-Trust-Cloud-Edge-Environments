theory W3_repaired_Concurrent_Agreement begin

// Function signature and definition of the equational theory E

builtins: diffie-hellman, natural-numbers
functions: PDec/2, PEnc/3, fst/1, h/1, kdf_conf/2, kdf_data/2, pair/2,
           pk/1, ppk/1, sdec/2, senc/2, sign/2, snd/1, true/0, verify/3
equations:
    PDec(psk, PEnc(ppk(psk), k, r)) = k,
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true















restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction W3_OneSetup:
  "∀ #i #j. ((W3Init( ) @ #i) ∧ (W3Init( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

rule (modulo E) W3_Setup:
   [
   Fr( ~si ), Fr( ~pi ), Fr( ~sr ), Fr( ~pr ), Fr( ~da ), Fr( ~db ),
   Fr( ~si2 ), Fr( ~pi2 ), Fr( ~sr2 ), Fr( ~pr2 )
   ]
  --[ W3Init( ) ]->
   [
   !Subject( 'requester', 'domain_A', %1, ~si, ~pi, pk(~si), ppk(~pi) ),
   !Subject( 'owner', 'domain_B', %1, ~sr, ~pr, pk(~sr), ppk(~pr) ),
   !Domain( 'domain_A', %1, ~da, pk(~da) ),
   !Domain( 'domain_B', %1, ~db, pk(~db) ),
   !Policy( 'domain_A', 'domain_B', %1, 'requester', 'owner', '1' ),
   !W3Ready( 'requester', 'owner', 'domain_A', 'domain_B', %1 ),
   !Subject( 'requester_2', 'domain_A', %1, ~si2, ~pi2, pk(~si2), ppk(~pi2)
   ),
   !Subject( 'owner_2', 'domain_B', %1, ~sr2, ~pr2, pk(~sr2), ppk(~pr2) ),
   !Policy( 'domain_A', 'domain_B', %1, 'requester', 'owner_2', '1' ),
   !Policy( 'domain_A', 'domain_B', %1, 'requester_2', 'owner', '1' ),
   !Policy( 'domain_A', 'domain_B', %1, 'requester_2', 'owner_2', '1' ),
   !W3Ready( 'requester', 'owner_2', 'domain_A', 'domain_B', %1 ),
   !W3Ready( 'requester_2', 'owner', 'domain_A', 'domain_B', %1 ),
   !W3Ready( 'requester_2', 'owner_2', 'domain_A', 'domain_B', %1 ),
   Out( <pk(~si2), ppk(~pi2), %1, 'Subject Pk'> ),
   Out( <pk(~sr2), ppk(~pr2), %1, 'Subject Pk'> ),
   Out( <<pk(~si2), ppk(~pi2), %1>, sign(<pk(~si2), ppk(~pi2), %1>, ~da), 
         pk(~da), 'SubjectCert'>
   ),
   Out( <<pk(~sr2), ppk(~pr2), %1>, sign(<pk(~sr2), ppk(~pr2), %1>, ~db), 
         pk(~db), 'SubjectCert'>
   ),
   W3Budget( ), W3Budget( ), Out( <pk(~si), ppk(~pi), %1, 'Subject Pk'> ),
   Out( <pk(~sr), ppk(~pr), %1, 'Subject Pk'> ),
   Out( <<pk(~si), ppk(~pi), %1>, sign(<pk(~si), ppk(~pi), %1>, ~da), 
         pk(~da), 'SubjectCert'>
   ),
   Out( <<pk(~sr), ppk(~pr), %1>, sign(<pk(~sr), ppk(~pr), %1>, ~db), 
         pk(~db), 'SubjectCert'>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Subject_Access_Request[role=Authentication_and_Data_Sharing]:
   [
   !W3Ready( $S_a, $S_b, $A, $B, %1 ), W3Budget( )[+],
   !Subject( $S_a, $A, %1, pska, ppska, pka, ppka ),
   !Subject( $S_b, $B, %1, pskb, ppskb, pkb, ppkb ),
   !Domain( $A, %1, gskA, gpkA ), !Domain( $B, %1, gskB, gpkB ), Fr( ~sid ),
   Fr( ~ie ), In( <CertA, CertaSign, SignPk, 'SubjectCert'> )
   ]
  --[
  Eq( 'SubjectCert', 'SubjectCert' ), Eq( SignPk, gpkA ),
  Eq( verify(CertaSign, CertA, gpkA), true ), Eq( fst(CertA), pka ),
  Eq( fst(snd(CertA)), ppka ), Eq( snd(snd(CertA)), %1 ),
  AccessRequest( $S_a, $S_b, %1, $A, $B, pska, pskb, gskA ),
  W3Begin( ~sid, $S_a, $S_b, %1 ),
  RunningInitiatorRequest( $S_a, $S_b, $A, $B, %1, ~sid, 'g'^~ie,
                           h(<pka, pkb, %1, ~sid, 'g'^~ie>)
  ),
  RepairAccessRequest( $S_a, $S_b, $A, $B, %1, ~sid, 'g'^~ie )
  ]->
   [
   Out( <<<CertA, CertaSign, SignPk>, pkb, %1, ~sid, 'g'^~ie>, 
         sign(<<CertA, CertaSign, SignPk>, pkb, %1, ~sid, 'g'^~ie>, pska), pka, 
         'AccessR_a_fs'>
   ),
   Access_send( $S_a, $S_b, %1, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB,
                ppka
   ),
   St_Initiator_DH( $S_a, $S_b, $A, $B, %1, ~sid, ~ie, 'g'^~ie, pka, ppka,
                    pkb, 'clean'
   )
   ]

  /*
  rule (modulo AC) Subject_Access_Request[role=Authentication_and_Data_Sharing]:
     [
     !W3Ready( $S_a, $S_b, $A, $B, %1 ), W3Budget( )[+],
     !Subject( $S_a, $A, %1, pska, ppska, pka, ppka ),
     !Subject( $S_b, $B, %1, pskb, ppskb, pkb, ppkb ),
     !Domain( $A, %1, gskA, gpkA ), !Domain( $B, %1, gskB, gpkB ), Fr( ~sid ),
     Fr( ~ie ), In( <CertA, CertaSign, SignPk, 'SubjectCert'> )
     ]
    --[
    Eq( 'SubjectCert', 'SubjectCert' ), Eq( SignPk, gpkA ), Eq( z, true ),
    Eq( z.1, pka ), Eq( z.2, ppka ), Eq( z.3, %1 ),
    AccessRequest( $S_a, $S_b, %1, $A, $B, pska, pskb, gskA ),
    W3Begin( ~sid, $S_a, $S_b, %1 ),
    RunningInitiatorRequest( $S_a, $S_b, $A, $B, %1, ~sid, 'g'^~ie,
                             h(<pka, pkb, %1, ~sid, 'g'^~ie>)
    ),
    RepairAccessRequest( $S_a, $S_b, $A, $B, %1, ~sid, 'g'^~ie )
    ]->
     [
     Out( <<<CertA, CertaSign, SignPk>, pkb, %1, ~sid, 'g'^~ie>, 
           sign(<<CertA, CertaSign, SignPk>, pkb, %1, ~sid, 'g'^~ie>, pska), pka, 
           'AccessR_a_fs'>
     ),
     Access_send( $S_a, $S_b, %1, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB,
                  ppka
     ),
     St_Initiator_DH( $S_a, $S_b, $A, $B, %1, ~sid, ~ie, 'g'^~ie, pka, ppka,
                      pkb, 'clean'
     )
     ]
    variants (modulo AC)
    1. CertA = CertA.34
       CertaSign
             = CertaSign.35
       gpkA  = gpkA.37
       z     = verify(CertaSign.35, CertA.34, gpkA.37)
       z.1   = fst(CertA.34)
       z.2   = fst(snd(CertA.34))
       z.3   = snd(snd(CertA.34))
    
    2. CertA = CertA.190
       CertaSign
             = sign(CertA.190, x.372)
       gpkA  = pk(x.372)
       z     = true
       z.1   = fst(CertA.190)
       z.2   = fst(snd(CertA.190))
       z.3   = snd(snd(CertA.190))
    
    3. CertA = <z.71, z.72, z.73>
       CertaSign
             = CertaSign.52
       gpkA  = gpkA.54
       z     = verify(CertaSign.52, <z.71, z.72, z.73>, gpkA.54)
       z.1   = z.71
       z.2   = z.72
       z.3   = z.73
    
    4. CertA = <z.151, x.273>
       CertaSign
             = sign(<z.151, x.273>, x.274)
       gpkA  = pk(x.274)
       z     = true
       z.1   = z.151
       z.2   = fst(x.273)
       z.3   = snd(x.273)
    
    5. CertA = <z.152, z.153, z.154>
       CertaSign
             = sign(<z.152, z.153, z.154>, x.276)
       gpkA  = pk(x.276)
       z     = true
       z.1   = z.152
       z.2   = z.153
       z.3   = z.154
    
    6. CertA = <z.207, x.367>
       CertaSign
             = CertaSign.188
       gpkA  = gpkA.190
       z     = verify(CertaSign.188, <z.207, x.367>, gpkA.190)
       z.1   = z.207
       z.2   = fst(x.367)
       z.3   = snd(x.367)
  */

rule (modulo E) Domain_Access_Verification[role=Authentication_and_Data_Sharing]:
   [
   In( <AccessRa, AccesssSign, AccessPKa, 'AccessR_a_fs'> ),
   Access_send( $S_a, $S_b, %1, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB,
                ppka
   )[+],
   !Policy( $A, $B, %1, $S_a, $S_b, bit ),
   !Subject( $S_b, $B, %1, pskb, ppskb, pkb, ppkb )
   ]
  --[
  Eq( 'AccessR_a_fs', 'AccessR_a_fs' ), Eq( pka, AccessPKa ),
  Eq( verify(AccesssSign, AccessRa, pka), true ),
  Eq( fst(snd(AccessRa)), pkb ), Eq( fst(snd(snd(AccessRa))), %1 ),
  Eq( bit, '1' ), AccessGranted( $S_a, $S_b, %1, pka, pkb, bit ),
  RepairAccessGranted( $S_a, $S_b, $A, $B, %1,
                       fst(snd(snd(snd(AccessRa)))), snd(snd(snd(snd(AccessRa)))),
                       h(<pka, pkb, %1, fst(snd(snd(snd(AccessRa)))), 
                          snd(snd(snd(snd(AccessRa))))>)
  )
  ]->
   [
   Out( <
         h(<pka, pkb, %1, fst(snd(snd(snd(AccessRa)))), 
            snd(snd(snd(snd(AccessRa))))>), 
         sign(h(<pka, pkb, %1, fst(snd(snd(snd(AccessRa)))), 
                 snd(snd(snd(snd(AccessRa))))>),
              gskB), 
         pk(gskB), fst(snd(snd(snd(AccessRa)))), snd(snd(snd(snd(AccessRa)))), 
         'AccessCert_ab_fs'>
   ),
   AccessCert_send( $S_a, $S_b, %1, pka, pkb, pskb, ppka, $A, $B, gpkA, gpkB
   )
   ]

  /*
  rule (modulo AC) Domain_Access_Verification[role=Authentication_and_Data_Sharing]:
     [
     In( <AccessRa, AccesssSign, AccessPKa, 'AccessR_a_fs'> ),
     Access_send( $S_a, $S_b, %1, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB,
                  ppka
     )[+],
     !Policy( $A, $B, %1, $S_a, $S_b, bit ),
     !Subject( $S_b, $B, %1, pskb, ppskb, pkb, ppkb )
     ]
    --[
    Eq( 'AccessR_a_fs', 'AccessR_a_fs' ), Eq( pka, AccessPKa ),
    Eq( z.2, true ), Eq( z.3, pkb ), Eq( z.4, %1 ), Eq( bit, '1' ),
    AccessGranted( $S_a, $S_b, %1, pka, pkb, bit ),
    RepairAccessGranted( $S_a, $S_b, $A, $B, %1, z, z.1,
                         h(<pka, pkb, %1, z, z.1>)
    )
    ]->
     [
     Out( <h(<pka, pkb, %1, z, z.1>), sign(h(<pka, pkb, %1, z, z.1>), gskB), 
           pk(gskB), z, z.1, 'AccessCert_ab_fs'>
     ),
     AccessCert_send( $S_a, $S_b, %1, pka, pkb, pskb, ppka, $A, $B, gpkA, gpkB
     )
     ]
    variants (modulo AC)
     1. AccessRa
              = AccessRa.34
        AccesssSign
              = AccesssSign.35
        pka   = pka.41
        z     = fst(snd(snd(snd(AccessRa.34))))
        z.1   = snd(snd(snd(snd(AccessRa.34))))
        z.2   = verify(AccesssSign.35, AccessRa.34, pka.41)
        z.3   = fst(snd(AccessRa.34))
        z.4   = fst(snd(snd(AccessRa.34)))
    
     2. AccessRa
              = AccessRa.70
        AccesssSign
              = sign(AccessRa.70, x.133)
        pka   = pk(x.133)
        z     = fst(snd(snd(snd(AccessRa.70))))
        z.1   = snd(snd(snd(snd(AccessRa.70))))
        z.2   = true
        z.3   = fst(snd(AccessRa.70))
        z.4   = fst(snd(snd(AccessRa.70)))
    
     3. AccessRa
              = <x.29, x.30>
        AccesssSign
              = sign(<x.29, x.30>, x.31)
        pka   = pk(x.31)
        z     = fst(snd(snd(x.30)))
        z.1   = snd(snd(snd(x.30)))
        z.2   = true
        z.3   = fst(x.30)
        z.4   = fst(snd(x.30))
    
     4. AccessRa
              = <x.44, z.36, x.46>
        AccesssSign
              = sign(<x.44, z.36, x.46>, x.47)
        pka   = pk(x.47)
        z     = fst(snd(x.46))
        z.1   = snd(snd(x.46))
        z.2   = true
        z.3   = z.36
        z.4   = fst(x.46)
    
     5. AccessRa
              = <x.45, z.37, z.38, x.48>
        AccesssSign
              = sign(<x.45, z.37, z.38, x.48>, x.49)
        pka   = pk(x.49)
        z     = fst(x.48)
        z.1   = snd(x.48)
        z.2   = true
        z.3   = z.37
        z.4   = z.38
    
     6. AccessRa
              = <x.66, z.50, z.51, z.46, z.47>
        AccesssSign
              = sign(<x.66, z.50, z.51, z.46, z.47>, x.71)
        pka   = pk(x.71)
        z     = z.46
        z.1   = z.47
        z.2   = true
        z.3   = z.50
        z.4   = z.51
    
     7. AccessRa
              = <x.126, z.84, z.85, z.80, z.81>
        AccesssSign
              = AccesssSign.67
        pka   = pka.73
        z     = z.80
        z.1   = z.81
        z.2   = verify(AccesssSign.67, <x.126, z.84, z.85, z.80, z.81>, pka.73)
        z.3   = z.84
        z.4   = z.85
    
     8. AccessRa
              = <x.127, x.128>
        AccesssSign
              = AccesssSign.68
        pka   = pka.74
        z     = fst(snd(snd(x.128)))
        z.1   = snd(snd(snd(x.128)))
        z.2   = verify(AccesssSign.68, <x.127, x.128>, pka.74)
        z.3   = fst(x.128)
        z.4   = fst(snd(x.128))
    
     9. AccessRa
              = <x.128, z.86, x.130>
        AccesssSign
              = AccesssSign.69
        pka   = pka.75
        z     = fst(snd(x.130))
        z.1   = snd(snd(x.130))
        z.2   = verify(AccesssSign.69, <x.128, z.86, x.130>, pka.75)
        z.3   = z.86
        z.4   = fst(x.130)
    
    10. AccessRa
              = <x.129, z.87, z.88, x.132>
        AccesssSign
              = AccesssSign.70
        pka   = pka.76
        z     = fst(x.132)
        z.1   = snd(x.132)
        z.2   = verify(AccesssSign.70, <x.129, z.87, z.88, x.132>, pka.76)
        z.3   = z.87
        z.4   = z.88
  */

rule (modulo E) Object_Data_Encryption[role=Authentication_and_Data_Sharing]:
   [
   In( <Hash1, Hashsign, Hashpk, sid, X, 'AccessCert_ab_fs'> ),
   AccessCert_send( $S_a, $S_b, %1, pka, pkb, pskb, ppka, $A, $B, gpkA, gpkB
   )[+],
   !Subject( $S_a, $A, %1, pska, ppska, pka, ppka ),
   !Subject( $S_b, $B, %1, pskb, ppskb, pkb, ppkb ), Fr( ~data ), Fr( ~re )
   ]
  --[
  Eq( 'AccessCert_ab_fs', 'AccessCert_ab_fs' ), Eq( gpkB, Hashpk ),
  Eq( verify(Hashsign, Hash1, gpkB), true ),
  Eq( Hash1, h(<pka, pkb, %1, sid, X>) ),
  DataSent( $S_b, $S_a, %1, pskb, ppka, pka, ~data,
            kdf_data(X^~re,
                     <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                      'g'^~re, h(Hash1)>)
  ),
  RepairDataSent( $S_b, $S_a, $A, $B, %1, sid, ~data,
                  kdf_data(X^~re,
                           <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                            'g'^~re, h(Hash1)>),
                  <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                   'g'^~re, h(Hash1)>
  ),
  CommitResponderRequest( $S_a, $S_b, $A, $B, %1, sid, X, Hash1 ),
  W3DataSent( $S_a, $S_b, %1, sid, ~data,
              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
               'g'^~re, h(Hash1)>,
              senc(<~data, 
                    sign(<~data, 'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, 
                          pkb, X, 'g'^~re, h(Hash1)>,
                         pskb), 
                    pk(pskb)>,
                   kdf_data(X^~re,
                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                             'g'^~re, h(Hash1)>))
  ),
  RunningResponder( $S_b, $S_a, $A, $B, %1, sid, ~data,
                    kdf_data(X^~re,
                             <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                              'g'^~re, h(Hash1)>),
                    <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                     'g'^~re, h(Hash1)>
  ),
  Secret( ~data, %1 ),
  SessionKey( kdf_data(X^~re,
                       <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                        'g'^~re, h(Hash1)>),
              %1
  ),
  Honest( $S_a, %1 ), Honest( $S_b, %1 )
  ]->
   [
   Out( <sid, 'g'^~re, 
         senc(<~data, 
               sign(<~data, 'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, 
                     pkb, X, 'g'^~re, h(Hash1)>,
                    pskb), 
               pk(pskb)>,
              kdf_data(X^~re,
                       <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                        'g'^~re, h(Hash1)>)), 
         h(<'key-confirm', 
            kdf_conf(X^~re,
                     <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                      'g'^~re, h(Hash1)>), 
            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
             'g'^~re, h(Hash1)>, 
            h(senc(<~data, 
                    sign(<~data, 'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, 
                          pkb, X, 'g'^~re, h(Hash1)>,
                         pskb), 
                    pk(pskb)>,
                   kdf_data(X^~re,
                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                             'g'^~re, h(Hash1)>)))
           >), 
         Hash1, 'data_fs'>
   )
   ]

  /*
  rule (modulo AC) Object_Data_Encryption[role=Authentication_and_Data_Sharing]:
     [
     In( <Hash1, Hashsign, Hashpk, sid, X, 'AccessCert_ab_fs'> ),
     AccessCert_send( $S_a, $S_b, %1, pka, pkb, pskb, ppka, $A, $B, gpkA, gpkB
     )[+],
     !Subject( $S_a, $A, %1, pska, ppska, pka, ppka ),
     !Subject( $S_b, $B, %1, pskb, ppskb, pkb, ppkb ), Fr( ~data ), Fr( ~re )
     ]
    --[
    Eq( 'AccessCert_ab_fs', 'AccessCert_ab_fs' ), Eq( gpkB, Hashpk ),
    Eq( z.1, true ), Eq( Hash1, h(<pka, pkb, %1, sid, X>) ),
    DataSent( $S_b, $S_a, %1, pskb, ppka, pka, ~data,
              kdf_data(z,
                       <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                        'g'^~re, h(Hash1)>)
    ),
    RepairDataSent( $S_b, $S_a, $A, $B, %1, sid, ~data,
                    kdf_data(z,
                             <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                              'g'^~re, h(Hash1)>),
                    <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                     'g'^~re, h(Hash1)>
    ),
    CommitResponderRequest( $S_a, $S_b, $A, $B, %1, sid, X, Hash1 ),
    W3DataSent( $S_a, $S_b, %1, sid, ~data,
                <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                 'g'^~re, h(Hash1)>,
                senc(<~data, 
                      sign(<~data, 'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, 
                            pkb, X, 'g'^~re, h(Hash1)>,
                           pskb), 
                      pk(pskb)>,
                     kdf_data(z,
                              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                               'g'^~re, h(Hash1)>))
    ),
    RunningResponder( $S_b, $S_a, $A, $B, %1, sid, ~data,
                      kdf_data(z,
                               <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                                'g'^~re, h(Hash1)>),
                      <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                       'g'^~re, h(Hash1)>
    ),
    Secret( ~data, %1 ),
    SessionKey( kdf_data(z,
                         <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                          'g'^~re, h(Hash1)>),
                %1
    ),
    Honest( $S_a, %1 ), Honest( $S_b, %1 )
    ]->
     [
     Out( <sid, 'g'^~re, 
           senc(<~data, 
                 sign(<~data, 'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, 
                       pkb, X, 'g'^~re, h(Hash1)>,
                      pskb), 
                 pk(pskb)>,
                kdf_data(z,
                         <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                          'g'^~re, h(Hash1)>)), 
           h(<'key-confirm', 
              kdf_conf(z,
                       <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                        'g'^~re, h(Hash1)>), 
              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
               'g'^~re, h(Hash1)>, 
              h(senc(<~data, 
                      sign(<~data, 'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, 
                            pkb, X, 'g'^~re, h(Hash1)>,
                           pskb), 
                      pk(pskb)>,
                     kdf_data(z,
                              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                               'g'^~re, h(Hash1)>)))
             >), 
           Hash1, 'data_fs'>
     )
     ]
    variants (modulo AC)
     1. ~re   = ~re.36
        Hash1 = Hash1.37
        Hashsign
              = Hashsign.39
        X     = X.40
        gpkB  = gpkB.42
        z     = X.40^~re.36
        z.1   = verify(Hashsign.39, Hash1.37, gpkB.42)
    
     2. ~re   = ~re.49
        Hash1 = Hash1.50
        Hashsign
              = Hashsign.52
        X     = z.68^inv(~re.49)
        gpkB  = gpkB.55
        z     = z.68
        z.1   = verify(Hashsign.52, Hash1.50, gpkB.55)
    
     3. ~re   = ~re.205
        Hash1 = Hash1.206
        Hashsign
              = Hashsign.208
        X     = x.402^x.403
        gpkB  = gpkB.211
        z     = x.402^(~re.205*x.403)
        z.1   = verify(Hashsign.208, Hash1.206, gpkB.211)
    
     4. ~re   = ~re.206
        Hash1 = Hash1.207
        Hashsign
              = sign(Hash1.207, x.405)
        X     = X.210
        gpkB  = pk(x.405)
        z     = X.210^~re.206
        z.1   = true
    
     5. ~re   = ~re.207
        Hash1 = Hash1.208
        Hashsign
              = sign(Hash1.208, x.407)
        X     = z.226^inv(~re.207)
        gpkB  = pk(x.407)
        z     = z.226
        z.1   = true
    
     6. ~re   = ~re.208
        Hash1 = Hash1.209
        Hashsign
              = sign(Hash1.209, x.407)
        X     = x.408^x.409
        gpkB  = pk(x.407)
        z     = x.408^(~re.208*x.409)
        z.1   = true
    
     7. ~re   = ~re.209
        Hash1 = Hash1.210
        Hashsign
              = Hashsign.212
        X     = x.410^inv((~re.209*x.411))
        gpkB  = gpkB.215
        z     = x.410^inv(x.411)
        z.1   = verify(Hashsign.212, Hash1.210, gpkB.215)
    
     8. ~re   = ~re.209
        Hash1 = Hash1.210
        Hashsign
              = Hashsign.212
        X     = x.410^(x.411*inv(~re.209))
        gpkB  = gpkB.215
        z     = x.410^x.411
        z.1   = verify(Hashsign.212, Hash1.210, gpkB.215)
    
     9. ~re   = ~re.209
        Hash1 = Hash1.210
        Hashsign
              = sign(Hash1.210, x.409)
        X     = x.410^inv((~re.209*x.411))
        gpkB  = pk(x.409)
        z     = x.410^inv(x.411)
        z.1   = true
    
    10. ~re   = ~re.209
        Hash1 = Hash1.210
        Hashsign
              = sign(Hash1.210, x.409)
        X     = x.410^(x.411*inv(~re.209))
        gpkB  = pk(x.409)
        z     = x.410^x.411
        z.1   = true
    
    11. ~re   = ~re.210
        Hash1 = Hash1.211
        Hashsign
              = Hashsign.213
        X     = x.411^(x.412*inv((~re.210*x.413)))
        gpkB  = gpkB.216
        z     = x.411^(x.412*inv(x.413))
        z.1   = verify(Hashsign.213, Hash1.211, gpkB.216)
    
    12. ~re   = ~re.210
        Hash1 = Hash1.211
        Hashsign
              = sign(Hash1.211, x.410)
        X     = x.411^(x.412*inv((~re.210*x.413)))
        gpkB  = pk(x.410)
        z     = x.411^(x.412*inv(x.413))
        z.1   = true
    
    13. Hash1 = Hash1.35
        Hashsign
              = Hashsign.37
        X     = DH_neutral
        gpkB  = gpkB.40
        z     = DH_neutral
        z.1   = verify(Hashsign.37, Hash1.35, gpkB.40)
    
    14. Hash1 = Hash1.203
        Hashsign
              = sign(Hash1.203, x.398)
        X     = DH_neutral
        gpkB  = pk(x.398)
        z     = DH_neutral
        z.1   = true
  */

rule (modulo E) Subject_Data_Decryption[role=Authentication_and_Data_Sharing]:
   [
   In( <sid, Y, beta, keyConfirm, Hash1, 'data_fs'> ),
   St_Initiator_DH( $S_a, $S_b, $A, $B, %1, sid, ie, X, pka, ppka, pkb,
                    iExposure
   )[+]
   ]
  --[
  Eq( 'data_fs', 'data_fs' ),
  Eq( keyConfirm,
      h(<'key-confirm', 
         kdf_conf(Y^ie,
                  <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                   h(Hash1)>), 
         <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
          h(Hash1)>, 
         h(beta)>)
  ),
  Eq( snd(snd(sdec(beta,
                   kdf_data(Y^ie,
                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                             h(Hash1)>)))),
      pkb
  ),
  Eq( verify(fst(snd(sdec(beta,
                          kdf_data(Y^ie,
                                   <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                                    h(Hash1)>)))),
             <
              fst(sdec(beta,
                       kdf_data(Y^ie,
                                <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                                 h(Hash1)>))), 
              'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
              h(Hash1)>,
             pkb),
      true
  ),
  DataReceive( $S_b, $S_a, %1, Y, beta, ppka, pkb,
               kdf_data(Y^ie,
                        <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                         h(Hash1)>),
               fst(sdec(beta,
                        kdf_data(Y^ie,
                                 <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                                  h(Hash1)>)))
  ),
  RepairDataAccepted( $S_a, $S_b, $A, $B, %1, sid,
                      fst(sdec(beta,
                               kdf_data(Y^ie,
                                        <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                                         h(Hash1)>))),
                      kdf_data(Y^ie,
                               <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                                h(Hash1)>),
                      <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                       h(Hash1)>
  ),
  W3End( sid, $S_a, $S_b, %1 ),
  W3DataAccepted( $S_a, $S_b, %1, sid,
                  fst(sdec(beta,
                           kdf_data(Y^ie,
                                    <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                                     h(Hash1)>))),
                  <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                   h(Hash1)>,
                  beta
  ),
  CommitInitiator( $S_a, $S_b, $A, $B, %1, sid,
                   fst(sdec(beta,
                            kdf_data(Y^ie,
                                     <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                                      h(Hash1)>))),
                   kdf_data(Y^ie,
                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                             h(Hash1)>),
                   <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                    h(Hash1)>
  )
  ]->
   [ ]

  /*
  rule (modulo AC) Subject_Data_Decryption[role=Authentication_and_Data_Sharing]:
     [
     In( <sid, Y, beta, keyConfirm, Hash1, 'data_fs'> ),
     St_Initiator_DH( $S_a, $S_b, $A, $B, %1, sid, ie, X, pka, ppka, pkb,
                      iExposure
     )[+]
     ]
    --[
    Eq( 'data_fs', 'data_fs' ),
    Eq( keyConfirm,
        h(<'key-confirm', 
           kdf_conf(z,
                    <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                     h(Hash1)>), 
           <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
            h(Hash1)>, 
           h(beta)>)
    ),
    Eq( z.1, pkb ), Eq( z.2, true ),
    DataReceive( $S_b, $S_a, %1, Y, beta, ppka, pkb,
                 kdf_data(z,
                          <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                           h(Hash1)>),
                 z.3
    ),
    RepairDataAccepted( $S_a, $S_b, $A, $B, %1, sid, z.3,
                        kdf_data(z,
                                 <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                                  h(Hash1)>),
                        <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                         h(Hash1)>
    ),
    W3End( sid, $S_a, $S_b, %1 ),
    W3DataAccepted( $S_a, $S_b, %1, sid, z.3,
                    <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                     h(Hash1)>,
                    beta
    ),
    CommitInitiator( $S_a, $S_b, $A, $B, %1, sid, z.3,
                     kdf_data(z,
                              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                               h(Hash1)>),
                     <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                      h(Hash1)>
    )
    ]->
     [ ]
    variants (modulo AC)
      1. $A    = $A.38
         $B    = $B.39
