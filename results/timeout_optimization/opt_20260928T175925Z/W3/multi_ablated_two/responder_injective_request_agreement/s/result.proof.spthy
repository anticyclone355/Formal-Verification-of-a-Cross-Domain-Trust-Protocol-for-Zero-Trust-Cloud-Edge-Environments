         $S_b  = $S_b.41
         Hash1 = Hash1.42
         X     = X.43
         Y     = Y.44
         beta  = beta.45
         ie    = ie.47
         pka   = pka.49
         pkb   = pkb.50
         sid   = sid.52
         z     = Y.44^ie.47
         z.1   = snd(snd(sdec(beta.45,
                              kdf_data(Y.44^ie.47,
                                       <'CDDS-AECDHE-full-v4', $S_a.40, $A.38, $S_b.41, $B.39, %1, sid.52, 
                                        pka.49, pkb.50, X.43, Y.44, h(Hash1.42)>))))
         z.2   = verify(fst(snd(sdec(beta.45,
                                     kdf_data(Y.44^ie.47,
                                              <'CDDS-AECDHE-full-v4', $S_a.40, $A.38, $S_b.41, $B.39, %1, 
                                               sid.52, pka.49, pkb.50, X.43, Y.44, h(Hash1.42)>)))),
                        <
                         fst(sdec(beta.45,
                                  kdf_data(Y.44^ie.47,
                                           <'CDDS-AECDHE-full-v4', $S_a.40, $A.38, $S_b.41, $B.39, %1, 
                                            sid.52, pka.49, pkb.50, X.43, Y.44, h(Hash1.42)>))), 
                         'CDDS-AECDHE-full-v4', $S_a.40, $A.38, $S_b.41, $B.39, %1, sid.52, 
                         pka.49, pkb.50, X.43, Y.44, h(Hash1.42)>,
                        pkb.50)
         z.3   = fst(sdec(beta.45,
                          kdf_data(Y.44^ie.47,
                                   <'CDDS-AECDHE-full-v4', $S_a.40, $A.38, $S_b.41, $B.39, %1, sid.52, 
                                    pka.49, pkb.50, X.43, Y.44, h(Hash1.42)>)))
    
      2. $A    = $A.38
         $B    = $B.39
         $S_a  = $S_a.40
         $S_b  = $S_b.41
         Hash1 = Hash1.42
         X     = X.43
         Y     = Y.44
         beta  = beta.45
         ie    = one
         pka   = pka.49
         pkb   = pkb.50
         sid   = sid.52
         z     = Y.44
         z.1   = snd(snd(sdec(beta.45,
                              kdf_data(Y.44,
                                       <'CDDS-AECDHE-full-v4', $S_a.40, $A.38, $S_b.41, $B.39, %1, sid.52, 
