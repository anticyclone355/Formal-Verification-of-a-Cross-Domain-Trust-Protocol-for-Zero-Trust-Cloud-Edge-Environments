      3. $A    = $A.38
         $B    = $B.39
         $S_a  = $S_a.40
         $S_b  = $S_b.41
         Hash1 = Hash1.42
         X     = X.43
         Y     = DH_neutral
         beta  = beta.45
         pka   = pka.49
         pkb   = pkb.50
         sid   = sid.52
         z     = DH_neutral
         z.1   = snd(snd(sdec(beta.45,
                              kdf_data(DH_neutral,
                                       <'CDDS-AECDHE-full-v4', $S_a.40, $A.38, $S_b.41, $B.39, %1, sid.52, 
