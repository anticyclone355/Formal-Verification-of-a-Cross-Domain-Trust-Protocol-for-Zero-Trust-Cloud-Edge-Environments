lemma responder_injective_request_agreement:
  all-traces
  "∀ I R A B e sid X ctx #c.
    (CommitResponderRequest( I, R, A, B, e, sid, X, ctx ) @ #c) ⇒
    (∃ #r.
      ((RunningInitiatorRequest( I, R, A, B, e, sid, X, ctx ) @ #r) ∧
       (#r < #c)) ∧
      (∀ #c2.
        (CommitResponderRequest( I, R, A, B, e, sid, X, ctx ) @ #c2) ⇒
        (#c2 = #c)))"
/*
guarded formula characterizing all counter-examples:
"∃ I R A B e sid X ctx #c.
  (CommitResponderRequest( I, R, A, B, e, sid, X, ctx ) @ #c)
 ∧
  ∀ #r.
   (RunningInitiatorRequest( I, R, A, B, e, sid, X, ctx ) @ #r)
  ⇒
   ((¬(#r < #c)) ∨
    (∃ #c2.
      (CommitResponderRequest( I, R, A, B, e, sid, X, ctx ) @ #c2)
     ∧
      ¬(#c2 = #c)))"
*/
simplify
solve( AccessCert_send( $S_a, $S_b, %1, pka, pkb, pskb, ppka, $A, $B,
                        gpkA, pk(x)
       )[+] ▶₁ #c )
  case Domain_Access_Verification_case_1
  solve( !Subject( 'requester', 'domain_A', %1, pska, ppska, pk(~si),
                   ppk(~pi)
         ) ▶₂ #c )
    case W3_Setup
    solve( !Subject( 'owner', 'domain_B', %1, ~sr, ppskb, pk(~sr), ppkb
           ) ▶₃ #c )
      case W3_Setup
      solve( splitEqs(1) )
        case split_case_2
        solve( !KU( sign(h(<pk(~si), pk(~sr), %1, sid, X>), ~db) ) @ #vk.3 )
          case Domain_Access_Verification_case_1
          solve( !KU( sign(<x, pk(~sr), %1, sid, X>, ~si) ) @ #vk.15 )
            case Subject_Access_Request_case_1
            solve( (#c2 < #c)  ∥ (#c < #c2) )
              case case_1
              solve( AccessCert_send( 'requester', 'owner', %1, pk(~si), pk(~sr), pskb,
                                      ppka, 'domain_A', 'domain_B', gpkA, pk(x)
                     )[+] ▶₁ #c2 )
                case Domain_Access_Verification_case_2
                solve( !Subject( 'requester', 'domain_A', %1, pska, ppska, pk(~si),
                                 ppk(~pi)
                       ) ▶₂ #c2 )
                  case W3_Setup
                  solve( !Subject( 'owner', 'domain_B', %1, ~sr, ppskb, pk(~sr), ppkb
                         ) ▶₃ #c2 )
                    case W3_Setup
                    solve( splitEqs(5) )
                      case split_case_1
                      solve( !KU( sign(<x, pk(~sr), %1, z, z.1>, ~si) ) @ #vk.39 )
                        case Subject_Access_Request_case_1
                        solve( !KU( ~sid ) @ #vk.10 )
                          case Subject_Access_Request
                          solve( !KU( sign(<pk(~si), ppk(~pi), %1>, ~da) ) @ #vk.28 )
                            case W3_Setup
                            solve( !KU( h(<pk(~si), pk(~sr), %1, ~sid, 'g'^~ie>) ) @ #vk.10 )
                              case Domain_Access_Verification
                              solve( !KU( pk(~db) ) @ #vk.18 )
                                case Domain_Access_Verification
                                solve( !KU( pk(~si) ) @ #vk.24 )
                                  case W3_Setup_case_1
