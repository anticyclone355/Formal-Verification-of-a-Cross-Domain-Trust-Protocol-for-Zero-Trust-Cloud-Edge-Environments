lemma w1_r_key_disclosure_after_erasure_unreachable:
  all-traces
  "All I R e sid role k #erase #reveal.
     SessionErased(I,R,e,sid) @erase
   & W1SessionKeyReveal(role,sid,k) @reveal
   & #erase < #reveal
   ==> F"

lemma w1_r_ephemeral_disclosure_after_erasure_unreachable:
  all-traces
  "All I R e sid role #erase #reveal.
     SessionErased(I,R,e,sid) @erase
   & W1EphemeralReveal(role,sid) @reveal
   & #erase < #reveal
   ==> F"

lemma w1_r_kci_reachable:
  exists-trace
  "Ex I R e sid x k T #request #accept #compromise.
     W1Request(I,R,e,sid) @request
   & W1Accepted(I,R,e,sid,x,k,T) @accept
   & W1LtkReveal('identity',I,e) @compromise
   & #compromise < #request & #request < #accept
   & (All kind principal epoch #lt. W1LtkReveal(kind,principal,epoch) @lt & #lt < #accept ==> (kind = 'identity' & principal = I & epoch = e))
   & not (Ex role handle #ep. W1EphemeralReveal(role,handle) @ep & #ep < #accept)
   & not (Ex role handle secret #dk. W1SessionKeyReveal(role,handle,secret) @dk & #dk < #accept)"

lemma w1_r_kci_responder_origin:
  all-traces
  "All I R e sid x k T #request #accept #compromise.
     W1Request(I,R,e,sid) @request
   & W1Accepted(I,R,e,sid,x,k,T) @accept
   & W1LtkReveal('identity',I,e) @compromise
   & #compromise < #request & #request < #accept
   & (All kind principal epoch #lt. W1LtkReveal(kind,principal,epoch) @lt & #lt < #accept ==> (kind = 'identity' & principal = I & epoch = e))
   & not (Ex role handle #ep. W1EphemeralReveal(role,handle) @ep & #ep < #accept)
   & not (Ex role handle secret #dk. W1SessionKeyReveal(role,handle,secret) @dk & #dk < #accept)
   ==> (Ex A B #running. RunningResponder(R,I,A,B,e,sid,x,k,T) @running & #running < #accept)"

end
