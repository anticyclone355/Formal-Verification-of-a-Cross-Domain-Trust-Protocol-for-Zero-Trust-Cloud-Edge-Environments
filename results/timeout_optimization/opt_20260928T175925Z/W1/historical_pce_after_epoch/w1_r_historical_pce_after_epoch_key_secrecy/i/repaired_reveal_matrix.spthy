#ifdef AFTER_EPOCH

rule W1_Advance_Epoch:
  [ W1_Closed()[+]
  , !Domain('domain_A',%1,oldA,pk(oldA))
  , !Domain('domain_B',%1,oldB,pk(oldB))
  , Fr(~si2), Fr(~pi2), Fr(~sr2), Fr(~pr2), Fr(~da2), Fr(~db2) ]
--[ W1EpochAdvanced(%1,%1 %+ %1) ]->
[ !Subject('requester','domain_A',%1 %+ %1,~si2,~pi2,pk(~si2),ppk(~pi2))
  , !Subject('owner','domain_B',%1 %+ %1,~sr2,~pr2,pk(~sr2),ppk(~pr2))
  , !Domain('domain_A',%1 %+ %1,~da2,pk(~da2))
  , !Domain('domain_B',%1 %+ %1,~db2,pk(~db2))
  , W1_IdAvailable('requester',%1 %+ %1), W1_PceAvailable('requester',%1 %+ %1)
  , W1_IdAvailable('owner',%1 %+ %1), W1_PceAvailable('owner',%1 %+ %1)
  , W1_DomainAvailable('domain_A',%1 %+ %1), W1_DomainAvailable('domain_B',%1 %+ %1)
  , Out(<pk(~si2),ppk(~pi2),%1 %+ %1,'Subject Pk'>)
  , Out(<pk(~sr2),ppk(~pr2),%1 %+ %1,'Subject Pk'>)
  , Out(<<pk(~si2),ppk(~pi2),%1 %+ %1>,sign(<pk(~si2),ppk(~pi2),%1 %+ %1>,~da2),pk(~da2),'SubjectCert'>)
  , Out(<<pk(~sr2),ppk(~pr2),%1 %+ %1>,sign(<pk(~sr2),ppk(~pr2),%1 %+ %1>,~db2),pk(~db2),'SubjectCert'>)
  , Out(<pk(~da2),sign(pk(~da2),oldA),pk(oldA),'Update domain public key'>)
  , Out(<pk(~db2),sign(pk(~db2),oldB),pk(oldB),'Update domain public key'>)
  ]

#endif


lemma w1_r_baseline_reachable:
  exists-trace
  "Ex I R e sid x k T #send #accept #erase #check.
     W1Sent(I,R,e,sid,x,k,T) @send
   & W1Accepted(I,R,e,sid,x,k,T) @accept
   & #send < #accept
   & SessionErased(I,R,e,sid) @erase
   & #accept < #erase
   & #erase < #check
   & not (Ex kind principal epoch #lt. W1LtkReveal(kind,principal,epoch) @lt & #lt < #check)
   & not (Ex role handle secret #dk. W1SessionKeyReveal(role,handle,secret) @dk & #dk < #check)
   & not (Ex role handle #ep. W1EphemeralReveal(role,handle) @ep & #ep < #check)
   & W1Probe() @check"

lemma w1_r_baseline_plaintext_secrecy:
  all-traces
  "All I R e sid x k T #send #accept #erase #check.
     W1Sent(I,R,e,sid,x,k,T) @send
   & W1Accepted(I,R,e,sid,x,k,T) @accept
   & #send < #accept
   & SessionErased(I,R,e,sid) @erase
   & #accept < #erase
   & #erase < #check
   & not (Ex kind principal epoch #lt. W1LtkReveal(kind,principal,epoch) @lt & #lt < #check)
   & not (Ex role handle secret #dk. W1SessionKeyReveal(role,handle,secret) @dk & #dk < #check)
   & not (Ex role handle #ep. W1EphemeralReveal(role,handle) @ep & #ep < #check)
   & K(x) @check
   ==> F"

lemma w1_r_baseline_key_secrecy:
  all-traces
  "All I R e sid x k T #send #accept #erase #check.
     W1Sent(I,R,e,sid,x,k,T) @send
   & W1Accepted(I,R,e,sid,x,k,T) @accept
   & #send < #accept
   & SessionErased(I,R,e,sid) @erase
   & #accept < #erase
   & #erase < #check
   & not (Ex kind principal epoch #lt. W1LtkReveal(kind,principal,epoch) @lt & #lt < #check)
   & not (Ex role handle secret #dk. W1SessionKeyReveal(role,handle,secret) @dk & #dk < #check)
   & not (Ex role handle #ep. W1EphemeralReveal(role,handle) @ep & #ep < #check)
   & K(k) @check
   ==> F"

lemma w1_r_identity_only_reachable:
  exists-trace
  "Ex I R e sid x k T #send #accept #erase #check #rev0.
     W1Sent(I,R,e,sid,x,k,T) @send
   & W1Accepted(I,R,e,sid,x,k,T) @accept
   & #send < #accept
   & SessionErased(I,R,e,sid) @erase
   & #accept < #erase
   & #erase < #check
   & (All kind principal epoch #lt. W1LtkReveal(kind,principal,epoch) @lt & #lt < #check
       ==> (#erase < #lt & ((kind = 'identity' & principal = 'requester' & epoch = %1))))
   & W1LtkReveal('identity','requester',%1) @rev0 & #erase < #rev0 & #rev0 < #check
   & not (Ex role handle secret #dk. W1SessionKeyReveal(role,handle,secret) @dk & #dk < #check)
   & not (Ex role handle #ep. W1EphemeralReveal(role,handle) @ep & #ep < #check)
   & W1Probe() @check"

