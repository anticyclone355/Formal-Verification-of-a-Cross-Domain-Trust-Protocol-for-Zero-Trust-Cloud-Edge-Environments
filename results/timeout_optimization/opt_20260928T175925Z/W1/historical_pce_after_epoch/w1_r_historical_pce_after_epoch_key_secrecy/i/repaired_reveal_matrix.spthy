lemma w1_r_initiator_ephemeral_control_reachable:
  exists-trace
  "Ex I R e sid x k T #send #accept #erase #reveal #learn.
     W1Sent(I,R,e,sid,x,k,T) @send
   & W1Accepted(I,R,e,sid,x,k,T) @accept
   & SessionErased(I,R,e,sid) @erase
   & W1EphemeralReveal('initiator',sid) @reveal
   & K(x) @learn
   & #send < #accept & #accept < #erase & #reveal < #erase & #erase < #learn
   & not (Ex kind principal epoch #lt. W1LtkReveal(kind,principal,epoch) @lt)
   & not (Ex role handle secret #dk. W1SessionKeyReveal(role,handle,secret) @dk)
   & not (Ex #other. W1EphemeralReveal('responder',sid) @other)"

lemma w1_r_responder_ephemeral_control_reachable:
  exists-trace
  "Ex I R e sid x k T #send #accept #erase #reveal #learn.
     W1Sent(I,R,e,sid,x,k,T) @send
   & W1Accepted(I,R,e,sid,x,k,T) @accept
   & SessionErased(I,R,e,sid) @erase
   & W1EphemeralReveal('responder',sid) @reveal
   & K(x) @learn
   & #send < #accept & #accept < #erase & #reveal < #erase & #erase < #learn
   & not (Ex kind principal epoch #lt. W1LtkReveal(kind,principal,epoch) @lt)
   & not (Ex role handle secret #dk. W1SessionKeyReveal(role,handle,secret) @dk)
   & not (Ex #other. W1EphemeralReveal('initiator',sid) @other)"

