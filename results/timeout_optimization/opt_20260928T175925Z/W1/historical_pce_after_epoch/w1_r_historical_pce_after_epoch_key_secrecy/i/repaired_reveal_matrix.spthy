rule Close_Repair_Session_After_Erasure[role="Authentication_and_Data_Sharing"]:
[
    InitErased($S_a,$S_b,%1,sid)[+]
    , RespErased($S_a,$S_b,%1,sid)[+]
]
--[
    SessionErased($S_a,$S_b,%1,sid)
]->
[ W1_Closed() ]

rule Reveal_Initiator_Ephemeral_Pending_E0[role="adversary"]:
[
    St_Initiator_DH_E0($S_a,$S_b,$A,$B,%1,sid,ie,X,pka,ppka,pkb,'clean')[+]
]
--[
    RevealEphemeralI($S_a,$S_b,%1,sid,ie)
    , W1EphemeralReveal('initiator',sid)
]->
[
    St_Initiator_DH_E1($S_a,$S_b,$A,$B,%1,sid,ie,X,pka,ppka,pkb,'revealed')
    , Out(ie)
]

