#ifdef AFTER_EPOCH
lemma w1_r_historical_pce_after_epoch_reachable:
  exists-trace
  "Ex I R e sid x k T #send #accept #erase #check #advance #rev0.
     W1Sent(I,R,e,sid,x,k,T) @send
   & W1Accepted(I,R,e,sid,x,k,T) @accept
   & #send < #accept
   & SessionErased(I,R,e,sid) @erase
   & #accept < #erase
   & #erase < #check
   & W1EpochAdvanced(%1,%1 %+ %1) @advance
   & #erase < #advance
   & #advance < #check
   & (All kind principal epoch #lt. W1LtkReveal(kind,principal,epoch) @lt & #lt < #check
       ==> (#advance < #lt & ((kind = 'pce' & principal = 'requester' & epoch = %1))))
   & W1LtkReveal('pce','requester',%1) @rev0 & #advance < #rev0 & #rev0 < #check
   & not (Ex role handle secret #dk. W1SessionKeyReveal(role,handle,secret) @dk & #dk < #check)
   & not (Ex role handle #ep. W1EphemeralReveal(role,handle) @ep & #ep < #check)
   & W1Probe() @check"

