lemma w2_normal_confirmation_and_erasure:
  exists-trace
  "∃ I R A B e sid T beta kd kc tag #generate #accept #erase.
    ((((((((ConfirmationGenerated( I, R, A, B, e, sid, T, beta, kd, kc, tag
            ) @ #generate) ∧
           (ConfirmationAccepted( I, R, A, B, e, sid, T, beta, kd, kc, tag
            ) @ #accept)) ∧
          (SessionErased( I, R, e, sid ) @ #erase)) ∧
         (#generate < #accept)) ∧
        (#accept < #erase)) ∧
       (¬(∃ kind p epoch #lt. W2LtkReveal( kind, p, epoch ) @ #lt))) ∧
      (¬(∃ role handle #ep. W2EphemeralReveal( role, handle ) @ #ep))) ∧
     (¬(∃ role handle secret #dk.
         W2SessionKeyReveal( role, handle, secret ) @ #dk))) ∧
    (¬(∃ role p q epoch handle secret #ck.
        RevealConfirmationKey( role, p, q, epoch, handle, secret ) @ #ck))"
/*
guarded formula characterizing all satisfying traces:
"∃ I R A B e sid T beta kd kc tag #generate #accept #erase.
  (ConfirmationGenerated( I, R, A, B, e, sid, T, beta, kd, kc, tag
   ) @ #generate) ∧
  (ConfirmationAccepted( I, R, A, B, e, sid, T, beta, kd, kc, tag
   ) @ #accept) ∧
  (SessionErased( I, R, e, sid ) @ #erase)
 ∧
  (#generate < #accept) ∧
  (#accept < #erase) ∧
  (∀ kind p epoch #lt. (W2LtkReveal( kind, p, epoch ) @ #lt) ⇒ ⊥) ∧
  (∀ role handle #ep. (W2EphemeralReveal( role, handle ) @ #ep) ⇒ ⊥) ∧
  (∀ role handle secret #dk.
    (W2SessionKeyReveal( role, handle, secret ) @ #dk) ⇒ ⊥) ∧
  (∀ role p q epoch handle secret #ck.
    (RevealConfirmationKey( role, p, q, epoch, handle, secret ) @ #ck) ⇒ ⊥)"
*/
by sorry

lemma key_confirmation_origin:
  all-traces
  "∀ I R A B e sid T beta kd kc tag #accept.
    (((((ConfirmationAccepted( I, R, A, B, e, sid, T, beta, kd, kc, tag
         ) @ #accept) ∧
        (¬(∃ kind p epoch #lt.
            ((W2LtkReveal( kind, p, epoch ) @ #lt) ∧ (#lt < #accept)) ∧
            ((((kind = 'identity') ∧ ((p = I) ∨ (p = R))) ∧ (epoch = e)) ∨
             (((kind = 'domain') ∧ ((p = A) ∨ (p = B))) ∧ (epoch = e)))))) ∧
       (¬(∃ role #ep.
           (W2EphemeralReveal( role, sid ) @ #ep) ∧ (#ep < #accept)))) ∧
      (¬(∃ role secret #dk.
          (W2SessionKeyReveal( role, sid, secret ) @ #dk) ∧ (#dk < #accept)))) ∧
     (¬(∃ role secret #ck.
         (RevealConfirmationKey( role, I, R, e, sid, secret ) @ #ck) ∧
         (#ck < #accept)))) ⇒
    (∃ A0 B0 T0 beta0 kd0 #generate.
      (ConfirmationGenerated( I, R, A0, B0, e, sid, T0, beta0, kd0, kc, tag
       ) @ #generate) ∧
      (#generate < #accept))"
/*
guarded formula characterizing all counter-examples:
"∃ I R A B e sid T beta kd kc tag #accept.
  (ConfirmationAccepted( I, R, A, B, e, sid, T, beta, kd, kc, tag
   ) @ #accept)
 ∧
  (∀ kind p epoch #lt.
    (W2LtkReveal( kind, p, epoch ) @ #lt)
   ⇒
    ((¬(#lt < #accept)) ∨
     ((((¬(kind = 'identity')) ∨
        ((¬(p = I)) ∧ (¬(p = R))) ∨
        (¬(epoch = e)))) ∧
      (((¬(kind = 'domain')) ∨
        ((¬(p = A)) ∧ (¬(p = B))) ∨
        (¬(epoch = e))))))) ∧
  (∀ role #ep. (W2EphemeralReveal( role, sid ) @ #ep) ⇒ ¬(#ep < #accept)) ∧
  (∀ role secret #dk.
    (W2SessionKeyReveal( role, sid, secret ) @ #dk) ⇒ ¬(#dk < #accept)) ∧
  (∀ role secret #ck.
    (RevealConfirmationKey( role, I, R, e, sid, secret ) @ #ck)
   ⇒
    ¬(#ck < #accept)) ∧
  (∀ A0 B0 T0 beta0 kd0 #generate.
    (ConfirmationGenerated( I, R, A0, B0, e, sid, T0, beta0, kd0, kc, tag
     ) @ #generate)
   ⇒
    ¬(#generate < #accept))"
*/
by sorry

lemma key_confirmation_agreement:
  all-traces
  "∀ I R A B e sid T beta kd kc tag #accept.
    (((((ConfirmationAccepted( I, R, A, B, e, sid, T, beta, kd, kc, tag
         ) @ #accept) ∧
        (¬(∃ kind p epoch #lt.
            ((W2LtkReveal( kind, p, epoch ) @ #lt) ∧ (#lt < #accept)) ∧
            ((((kind = 'identity') ∧ ((p = I) ∨ (p = R))) ∧ (epoch = e)) ∨
             (((kind = 'domain') ∧ ((p = A) ∨ (p = B))) ∧ (epoch = e)))))) ∧
       (¬(∃ role #ep.
           (W2EphemeralReveal( role, sid ) @ #ep) ∧ (#ep < #accept)))) ∧
      (¬(∃ role secret #dk.
          (W2SessionKeyReveal( role, sid, secret ) @ #dk) ∧ (#dk < #accept)))) ∧
     (¬(∃ role secret #ck.
         (RevealConfirmationKey( role, I, R, e, sid, secret ) @ #ck) ∧
         (#ck < #accept)))) ⇒
    (∃ #generate.
      (ConfirmationGenerated( I, R, A, B, e, sid, T, beta, kd, kc, tag
       ) @ #generate) ∧
      (#generate < #accept))"
/*
guarded formula characterizing all counter-examples:
"∃ I R A B e sid T beta kd kc tag #accept.
  (ConfirmationAccepted( I, R, A, B, e, sid, T, beta, kd, kc, tag
   ) @ #accept)
 ∧
  (∀ kind p epoch #lt.
    (W2LtkReveal( kind, p, epoch ) @ #lt)
   ⇒
    ((¬(#lt < #accept)) ∨
     ((((¬(kind = 'identity')) ∨
        ((¬(p = I)) ∧ (¬(p = R))) ∨
        (¬(epoch = e)))) ∧
      (((¬(kind = 'domain')) ∨
        ((¬(p = A)) ∧ (¬(p = B))) ∨
        (¬(epoch = e))))))) ∧
  (∀ role #ep. (W2EphemeralReveal( role, sid ) @ #ep) ⇒ ¬(#ep < #accept)) ∧
  (∀ role secret #dk.
    (W2SessionKeyReveal( role, sid, secret ) @ #dk) ⇒ ¬(#dk < #accept)) ∧
  (∀ role secret #ck.
    (RevealConfirmationKey( role, I, R, e, sid, secret ) @ #ck)
   ⇒
    ¬(#ck < #accept)) ∧
  (∀ #generate.
    (ConfirmationGenerated( I, R, A, B, e, sid, T, beta, kd, kc, tag
     ) @ #generate)
   ⇒
    ¬(#generate < #accept))"
*/
simplify
solve( ConfirmationAccepted( I, R, A, B, e, sid, T, beta, kd, kc, tag
       ) @ #accept )
  case Subject_Data_Decryption_E0
  solve( St_Initiator_DH_E0( $S_a, $S_b, $A, $B, %1, sid, ie, X, pka, ppka,
                             pk(x), 'clean'
         )[+] ▶₁ #accept )
    case Subject_Access_Request
    solve( !KU( senc(<z, 
                      sign(<z, 'CDDS-AECDHE-full-v4', 'requester', 'domain_A', 'owner', 
                            'domain_B', %1, ~sid, pk(~si), pk(~sr), 'g'^~ie, Y, h(Hash1)>,
                           ~sr), 
                      pk(~sr)>,
                     kdf_data(z.1,
                              <'CDDS-AECDHE-full-v4', 'requester', 'domain_A', 'owner', 'domain_B', 
                               %1, ~sid, pk(~si), pk(~sr), 'g'^~ie, Y, h(Hash1)>))
           ) @ #vk.5 )
      case Object_Data_Encryption
      by contradiction /* from formulas */
    next
      case c_senc
      solve( !KU( sign(<z, 'CDDS-AECDHE-full-v4', 'requester', 'domain_A', 
                        'owner', 'domain_B', %1, ~sid, pk(~si), pk(~sr), 'g'^~ie, Y, h(Hash1)>,
                       ~sr)
             ) @ #vk.26 )
        case Object_Data_Encryption
        by contradiction /* from formulas */
      next
        case c_sign
        solve( !KU( ~sr ) @ #vk.34 )
          case Reveal_IdentityKey
          by contradiction /* from formulas */
        qed
      qed
    qed
  qed
next
  case Subject_Data_Decryption_E1
  solve( St_Initiator_DH_E1( $S_a, $S_b, $A, $B, %1, sid, ie, X, pka, ppka,
                             pk(x), 'revealed'
         )[+] ▶₁ #accept )
    case Reveal_Initiator_Ephemeral_Pending_E0
    by contradiction /* from formulas */
  qed
qed

lemma w2_responder_erases_before_acceptance:
  exists-trace
  "∃ I R A B e sid T beta kd kc tag #generate #local #accept #erase.
    ((((((((((ConfirmationGenerated( I, R, A, B, e, sid, T, beta, kd, kc, tag
              ) @ #generate) ∧
             (LocalErased( 'responder', I, R, e, sid ) @ #local)) ∧
            (ConfirmationAccepted( I, R, A, B, e, sid, T, beta, kd, kc, tag
             ) @ #accept)) ∧
           (SessionErased( I, R, e, sid ) @ #erase)) ∧
          (#generate < #local)) ∧
         (#local < #accept)) ∧
        (#accept < #erase)) ∧
       (¬(∃ kind p epoch #lt. W2LtkReveal( kind, p, epoch ) @ #lt))) ∧
      (¬(∃ role handle #ep. W2EphemeralReveal( role, handle ) @ #ep))) ∧
     (¬(∃ role handle secret #dk.
         W2SessionKeyReveal( role, handle, secret ) @ #dk))) ∧
    (¬(∃ role p q epoch handle secret #ck.
        RevealConfirmationKey( role, p, q, epoch, handle, secret ) @ #ck))"
/*
guarded formula characterizing all satisfying traces:
"∃ I R A B e sid T beta kd kc tag #generate #local #accept #erase.
  (ConfirmationGenerated( I, R, A, B, e, sid, T, beta, kd, kc, tag
   ) @ #generate) ∧
  (LocalErased( 'responder', I, R, e, sid ) @ #local) ∧
  (ConfirmationAccepted( I, R, A, B, e, sid, T, beta, kd, kc, tag
   ) @ #accept) ∧
  (SessionErased( I, R, e, sid ) @ #erase)
 ∧
  (#generate < #local) ∧
  (#local < #accept) ∧
  (#accept < #erase) ∧
  (∀ kind p epoch #lt. (W2LtkReveal( kind, p, epoch ) @ #lt) ⇒ ⊥) ∧
  (∀ role handle #ep. (W2EphemeralReveal( role, handle ) @ #ep) ⇒ ⊥) ∧
  (∀ role handle secret #dk.
    (W2SessionKeyReveal( role, handle, secret ) @ #dk) ⇒ ⊥) ∧
  (∀ role p q epoch handle secret #ck.
    (RevealConfirmationKey( role, p, q, epoch, handle, secret ) @ #ck) ⇒ ⊥)"
*/
by sorry

lemma ephemeral_state_lifetime:
  all-traces
  "∀ role I R e sid secret #use.
    (EphemeralUse( role, I, R, e, sid, secret ) @ #use) ⇒
    ((∃ #create.
       (EphemeralCreated( role, I, R, e, sid, secret ) @ #create) ∧
       ((#create < #use) ∨ (#create = #use))) ∧
     (¬(∃ #erase.
         (LocalErased( role, I, R, e, sid ) @ #erase) ∧ (#erase < #use))))"
/*
guarded formula characterizing all counter-examples:
"∃ role I R e sid secret #use.
  (EphemeralUse( role, I, R, e, sid, secret ) @ #use)
 ∧
  ((∀ #create.
     (EphemeralCreated( role, I, R, e, sid, secret ) @ #create)
    ⇒
     (¬(#create < #use)) ∧ (¬(#create = #use))) ∨
   (∃ #erase.
     (LocalErased( role, I, R, e, sid ) @ #erase) ∧ #erase < #use))"
*/
by sorry

