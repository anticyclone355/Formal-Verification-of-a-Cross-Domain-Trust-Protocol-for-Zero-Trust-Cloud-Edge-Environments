rule (modulo E) Subject_Data_Decryption_E1[role=Authentication_and_Data_Sharing]:
   [
   In( <sid, Y, beta, keyConfirm, Hash1, 'data_fs'> ),
   St_Initiator_DH_E1( $S_a, $S_b, $A, $B, %1, sid, ie, X, pka, ppka, pkb,
                       'revealed'
   )[+]
   ]
  --[
  W2StateUse( 'initiator', $S_a, $S_b, %1, sid, 'pending' ),
  EphemeralUse( 'initiator', $S_a, $S_b, %1, sid, ie ),
  DerivedKeyCreated( 'initiator', $S_a, $S_b, %1, sid, 'data',
                     kdf_data(Y^ie,
                              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                               h(Hash1)>)
  ),
  DerivedKeyCreated( 'initiator', $S_a, $S_b, %1, sid, 'confirmation',
                     kdf_conf(Y^ie,
                              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                               h(Hash1)>)
  ),
  DerivedKeyUse( 'initiator', $S_a, $S_b, %1, sid, 'data',
                 kdf_data(Y^ie,
                          <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                           h(Hash1)>)
  ),
  DerivedKeyUse( 'initiator', $S_a, $S_b, %1, sid, 'confirmation',
                 kdf_conf(Y^ie,
                          <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                           h(Hash1)>)
  ),
  ConfirmationAccepted( $S_a, $S_b, $A, $B, %1, sid,
                        <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                         h(Hash1)>,
                        beta,
                        kdf_data(Y^ie,
                                 <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                                  h(Hash1)>),
                        kdf_conf(Y^ie,
                                 <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                                  h(Hash1)>),
                        keyConfirm
  ),
  Eq( 'data_fs', 'data_fs' ),
  Eq( keyConfirm,
      h(<'key-confirm', 
         kdf_conf(Y^ie,
                  <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                   h(Hash1)>), 
         <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
          h(Hash1)>, 
         h(beta)>)
  ),
  Eq( snd(snd(sdec(beta,
                   kdf_data(Y^ie,
                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                             h(Hash1)>)))),
      pkb
  ),
  Eq( verify(fst(snd(sdec(beta,
                          kdf_data(Y^ie,
                                   <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                                    h(Hash1)>)))),
             <
              fst(sdec(beta,
                       kdf_data(Y^ie,
                                <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                                 h(Hash1)>))), 
              'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
              h(Hash1)>,
             pkb),
      true
  ),
  DataReceive( $S_b, $S_a, %1, Y, beta, ppka, pkb,
               kdf_data(Y^ie,
                        <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                         h(Hash1)>),
               fst(sdec(beta,
                        kdf_data(Y^ie,
                                 <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                                  h(Hash1)>)))
  ),
  RepairDataAccepted( $S_a, $S_b, $A, $B, %1, sid,
                      fst(sdec(beta,
                               kdf_data(Y^ie,
                                        <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                                         h(Hash1)>))),
                      kdf_data(Y^ie,
                               <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                                h(Hash1)>),
                      <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                       h(Hash1)>
  ),
  W2Accepted( $S_a, $S_b, %1, sid,
              fst(sdec(beta,
                       kdf_data(Y^ie,
                                <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                                 h(Hash1)>))),
              kdf_data(Y^ie,
                       <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                        h(Hash1)>),
              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
               h(Hash1)>
  ),
  CommitInitiator( $S_a, $S_b, $A, $B, %1, sid,
                   fst(sdec(beta,
                            kdf_data(Y^ie,
                                     <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                                      h(Hash1)>))),
                   kdf_data(Y^ie,
                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                             h(Hash1)>),
                   <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                    h(Hash1)>
  )
  ]->
   [
   !Plaintext( fst(sdec(beta,
                        kdf_data(Y^ie,
                                 <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                                  h(Hash1)>)))
   ),
   St_Initiator_PreErase_E1_K0_C0( $S_a, $S_b, $A, $B, %1, sid, ie,
                                   kdf_data(Y^ie,
                                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                                             Y, h(Hash1)>),
                                   kdf_conf(Y^ie,
                                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                                             Y, h(Hash1)>),
                                   fst(sdec(beta,
                                            kdf_data(Y^ie,
                                                     <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, 
                                                      pka, pkb, X, Y, h(Hash1)>))),
                                   <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                                    h(Hash1)>,
                                   'revealed'
   )
   ]

  /*
