rule (modulo E) Initiator_Erase_Ephemeral_E0_K0_C0[role=Authentication_and_Data_Sharing]:
   [
   St_Initiator_PreErase_E0_K0_C0( $S_a, $S_b, $A, $B, %1, sid, ie, k, kc,
                                   msg, transcript, 'clean'
   )[+]
   ]
  --[
  W2StateUse( 'initiator', $S_a, $S_b, %1, sid, 'preerase' ),
  EphemeralUse( 'initiator', $S_a, $S_b, %1, sid, ie ),
  DerivedKeyUse( 'initiator', $S_a, $S_b, %1, sid, 'data', k ),
  DerivedKeyUse( 'initiator', $S_a, $S_b, %1, sid, 'confirmation', kc ),
  LocalErased( 'initiator', $S_a, $S_b, %1, sid ),
  SecretsErased( 'initiator', $S_a, $S_b, %1, sid, ie, k, kc ),
  InitiatorErased( $S_a, $S_b, $A, $B, %1, sid )
  ]->
   [ InitErased( $S_a, $S_b, %1, sid ) ]

  /* has exactly the trivial AC variant */

