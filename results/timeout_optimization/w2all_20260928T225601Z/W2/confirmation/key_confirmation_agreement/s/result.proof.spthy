theory W2_AECDHE_State_Lifecycle begin

// Function signature and definition of the equational theory E

builtins: diffie-hellman, natural-numbers
functions: PDec/2, PEnc/3, fst/1, h/1, kdf_conf/2, kdf_data/2, pair/2,
           pk/1, ppk/1, sdec/2, senc/2, sign/2, snd/1, true/0, verify/3
equations:
    PDec(psk, PEnc(ppk(psk), k, r)) = k,
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true















restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction W2_OneSetup:
  "∀ #i #j. ((W2Init( ) @ #i) ∧ (W2Init( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

rule (modulo E) W2_Setup:
   [ Fr( ~si ), Fr( ~pi ), Fr( ~sr ), Fr( ~pr ), Fr( ~da ), Fr( ~db ) ]
  --[ W2Init( ) ]->
   [
   !Subject( 'requester', 'domain_A', %1, ~si, ~pi, pk(~si), ppk(~pi) ),
   !Subject( 'owner', 'domain_B', %1, ~sr, ~pr, pk(~sr), ppk(~pr) ),
   !Domain( 'domain_A', %1, ~da, pk(~da) ),
   !Domain( 'domain_B', %1, ~db, pk(~db) ),
   !Policy( 'domain_A', 'domain_B', %1, 'requester', 'owner', '1' ),
   W2_RequestReady( 'requester', 'owner', 'domain_A', 'domain_B', %1 ),
   W2_IdAvailable( 'requester', %1 ), W2_PceAvailable( 'requester', %1 ),
   W2_IdAvailable( 'owner', %1 ), W2_PceAvailable( 'owner', %1 ),
   W2_DomainAvailable( 'domain_A', %1 ),
   W2_DomainAvailable( 'domain_B', %1 ), W2_ProbeReady( ),
   Out( <pk(~si), ppk(~pi), %1, 'Subject Pk'> ),
   Out( <pk(~sr), ppk(~pr), %1, 'Subject Pk'> ),
   Out( <<pk(~si), ppk(~pi), %1>, sign(<pk(~si), ppk(~pi), %1>, ~da), 
         pk(~da), 'SubjectCert'>
   ),
   Out( <<pk(~sr), ppk(~pr), %1>, sign(<pk(~sr), ppk(~pr), %1>, ~db), 
         pk(~db), 'SubjectCert'>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) W2_Probe:
   [ W2_ProbeReady( ) ] --[ W2Probe( ) ]-> [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_IdentityKey:
   [ !Subject( $S, $D, %1, sk, psk, pkS, ppkS ), W2_IdAvailable( $S, %1 ) ]
  --[ Reveal_IdentityKey( $S, %1 ), W2LtkReveal( 'identity', $S, %1 ) ]->
   [ Out( sk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_PCEKey:
   [ !Subject( $S, $D, %1, sk, psk, pkS, ppkS ), W2_PceAvailable( $S, %1 ) ]
  --[ Reveal_PCEKey( $S, %1 ), W2LtkReveal( 'pce', $S, %1 ) ]->
   [ Out( psk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_DomainKey:
   [ !Domain( $D, %1, sk, pkD ), W2_DomainAvailable( $D, %1 ) ]
  --[ Reveal_Domain( $D, %1 ), W2LtkReveal( 'domain', $D, %1 ) ]->
   [ Out( sk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Subject_Access_Request[role=Authentication_and_Data_Sharing]:
   [
   W2_RequestReady( $S_a, $S_b, $A, $B, %1 ),
   !Subject( $S_a, $A, %1, pska, ppska, pka, ppka ),
   !Subject( $S_b, $B, %1, pskb, ppskb, pkb, ppkb ),
   !Domain( $A, %1, gskA, gpkA ), !Domain( $B, %1, gskB, gpkB ), Fr( ~sid ),
   Fr( ~ie ), In( <CertA, CertaSign, SignPk, 'SubjectCert'> )
   ]
  --[
  EphemeralCreated( 'initiator', $S_a, $S_b, %1, ~sid, ~ie ),
  Eq( 'SubjectCert', 'SubjectCert' ), Eq( SignPk, gpkA ),
  Eq( verify(CertaSign, CertA, gpkA), true ), Eq( fst(CertA), pka ),
  Eq( fst(snd(CertA)), ppka ), Eq( snd(snd(CertA)), %1 ),
  AccessRequest( $S_a, $S_b, %1, $A, $B, pska, pskb, gskA ),
  RepairAccessRequest( $S_a, $S_b, $A, $B, %1, ~sid, 'g'^~ie ),
  W2Request( $S_a, $S_b, %1, ~sid )
  ]->
   [
   Out( <<<CertA, CertaSign, SignPk>, pkb, %1, ~sid, 'g'^~ie>, 
         sign(<<CertA, CertaSign, SignPk>, pkb, %1, ~sid, 'g'^~ie>, pska), pka, 
         'AccessR_a_fs'>
   ),
   Access_send( $S_a, $S_b, %1, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB,
                ppka
   ),
   St_Initiator_DH_E0( $S_a, $S_b, $A, $B, %1, ~sid, ~ie, 'g'^~ie, pka,
                       ppka, pkb, 'clean'
   )
   ]

  /*
  rule (modulo AC) Subject_Access_Request[role=Authentication_and_Data_Sharing]:
     [
     W2_RequestReady( $S_a, $S_b, $A, $B, %1 ),
     !Subject( $S_a, $A, %1, pska, ppska, pka, ppka ),
     !Subject( $S_b, $B, %1, pskb, ppskb, pkb, ppkb ),
     !Domain( $A, %1, gskA, gpkA ), !Domain( $B, %1, gskB, gpkB ), Fr( ~sid ),
     Fr( ~ie ), In( <CertA, CertaSign, SignPk, 'SubjectCert'> )
     ]
    --[
    EphemeralCreated( 'initiator', $S_a, $S_b, %1, ~sid, ~ie ),
    Eq( 'SubjectCert', 'SubjectCert' ), Eq( SignPk, gpkA ), Eq( z, true ),
    Eq( z.1, pka ), Eq( z.2, ppka ), Eq( z.3, %1 ),
    AccessRequest( $S_a, $S_b, %1, $A, $B, pska, pskb, gskA ),
    RepairAccessRequest( $S_a, $S_b, $A, $B, %1, ~sid, 'g'^~ie ),
    W2Request( $S_a, $S_b, %1, ~sid )
    ]->
     [
     Out( <<<CertA, CertaSign, SignPk>, pkb, %1, ~sid, 'g'^~ie>, 
           sign(<<CertA, CertaSign, SignPk>, pkb, %1, ~sid, 'g'^~ie>, pska), pka, 
           'AccessR_a_fs'>
     ),
     Access_send( $S_a, $S_b, %1, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB,
                  ppka
     ),
     St_Initiator_DH_E0( $S_a, $S_b, $A, $B, %1, ~sid, ~ie, 'g'^~ie, pka,
                         ppka, pkb, 'clean'
     )
     ]
    variants (modulo AC)
    1. CertA = CertA.35
       CertaSign
             = CertaSign.36
       gpkA  = gpkA.38
       z     = verify(CertaSign.36, CertA.35, gpkA.38)
       z.1   = fst(CertA.35)
       z.2   = fst(snd(CertA.35))
       z.3   = snd(snd(CertA.35))
    
    2. CertA = CertA.222
       CertaSign
             = sign(CertA.222, x.436)
       gpkA  = pk(x.436)
       z     = true
       z.1   = fst(CertA.222)
       z.2   = fst(snd(CertA.222))
       z.3   = snd(snd(CertA.222))
    
    3. CertA = <z.74, z.75, z.76>
       CertaSign
             = CertaSign.54
       gpkA  = gpkA.56
       z     = verify(CertaSign.54, <z.74, z.75, z.76>, gpkA.56)
       z.1   = z.74
       z.2   = z.75
       z.3   = z.76
    
    4. CertA = <z.160, x.290>
       CertaSign
             = sign(<z.160, x.290>, x.291)
       gpkA  = pk(x.291)
       z     = true
       z.1   = z.160
       z.2   = fst(x.290)
       z.3   = snd(x.290)
    
    5. CertA = <z.161, z.162, z.163>
       CertaSign
             = sign(<z.161, z.162, z.163>, x.293)
       gpkA  = pk(x.293)
       z     = true
       z.1   = z.161
       z.2   = z.162
       z.3   = z.163
    
    6. CertA = <z.239, x.429>
       CertaSign
             = CertaSign.219
       gpkA  = gpkA.221
       z     = verify(CertaSign.219, <z.239, x.429>, gpkA.221)
       z.1   = z.239
       z.2   = fst(x.429)
       z.3   = snd(x.429)
  */

rule (modulo E) Domain_Access_Verification[role=Authentication_and_Data_Sharing]:
   [
   In( <AccessRa, AccesssSign, AccessPKa, 'AccessR_a_fs'> ),
   Access_send( $S_a, $S_b, %1, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB,
                ppka
   )[+],
   !Policy( $A, $B, %1, $S_a, $S_b, bit ),
   !Subject( $S_b, $B, %1, pskb, ppskb, pkb, ppkb )
   ]
  --[
  Eq( 'AccessR_a_fs', 'AccessR_a_fs' ), Eq( pka, AccessPKa ),
  Eq( verify(AccesssSign, AccessRa, pka), true ),
  Eq( fst(snd(AccessRa)), pkb ), Eq( fst(snd(snd(AccessRa))), %1 ),
  Eq( bit, '1' ), AccessGranted( $S_a, $S_b, %1, pka, pkb, bit ),
  RepairAccessGranted( $S_a, $S_b, $A, $B, %1,
                       fst(snd(snd(snd(AccessRa)))), snd(snd(snd(snd(AccessRa)))),
                       h(<pka, pkb, %1, fst(snd(snd(snd(AccessRa)))), 
                          snd(snd(snd(snd(AccessRa))))>)
  )
  ]->
   [
   Out( <
         h(<pka, pkb, %1, fst(snd(snd(snd(AccessRa)))), 
            snd(snd(snd(snd(AccessRa))))>), 
         sign(h(<pka, pkb, %1, fst(snd(snd(snd(AccessRa)))), 
                 snd(snd(snd(snd(AccessRa))))>),
              gskB), 
         pk(gskB), fst(snd(snd(snd(AccessRa)))), snd(snd(snd(snd(AccessRa)))), 
         'AccessCert_ab_fs'>
   ),
   AccessCert_send( $S_a, $S_b, %1, pka, pkb, pskb, ppka, $A, $B, gpkA, gpkB
   )
   ]

  /*
  rule (modulo AC) Domain_Access_Verification[role=Authentication_and_Data_Sharing]:
     [
     In( <AccessRa, AccesssSign, AccessPKa, 'AccessR_a_fs'> ),
     Access_send( $S_a, $S_b, %1, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB,
                  ppka
     )[+],
     !Policy( $A, $B, %1, $S_a, $S_b, bit ),
     !Subject( $S_b, $B, %1, pskb, ppskb, pkb, ppkb )
     ]
    --[
    Eq( 'AccessR_a_fs', 'AccessR_a_fs' ), Eq( pka, AccessPKa ),
    Eq( z.2, true ), Eq( z.3, pkb ), Eq( z.4, %1 ), Eq( bit, '1' ),
    AccessGranted( $S_a, $S_b, %1, pka, pkb, bit ),
    RepairAccessGranted( $S_a, $S_b, $A, $B, %1, z, z.1,
                         h(<pka, pkb, %1, z, z.1>)
    )
    ]->
     [
     Out( <h(<pka, pkb, %1, z, z.1>), sign(h(<pka, pkb, %1, z, z.1>), gskB), 
           pk(gskB), z, z.1, 'AccessCert_ab_fs'>
     ),
     AccessCert_send( $S_a, $S_b, %1, pka, pkb, pskb, ppka, $A, $B, gpkA, gpkB
     )
     ]
    variants (modulo AC)
     1. AccessRa
              = AccessRa.34
        AccesssSign
              = AccesssSign.35
        pka   = pka.41
        z     = fst(snd(snd(snd(AccessRa.34))))
        z.1   = snd(snd(snd(snd(AccessRa.34))))
        z.2   = verify(AccesssSign.35, AccessRa.34, pka.41)
        z.3   = fst(snd(AccessRa.34))
        z.4   = fst(snd(snd(AccessRa.34)))
    
     2. AccessRa
              = AccessRa.70
        AccesssSign
              = sign(AccessRa.70, x.133)
        pka   = pk(x.133)
        z     = fst(snd(snd(snd(AccessRa.70))))
        z.1   = snd(snd(snd(snd(AccessRa.70))))
        z.2   = true
        z.3   = fst(snd(AccessRa.70))
        z.4   = fst(snd(snd(AccessRa.70)))
    
     3. AccessRa
              = <x.29, x.30>
        AccesssSign
              = sign(<x.29, x.30>, x.31)
        pka   = pk(x.31)
        z     = fst(snd(snd(x.30)))
        z.1   = snd(snd(snd(x.30)))
        z.2   = true
        z.3   = fst(x.30)
        z.4   = fst(snd(x.30))
    
     4. AccessRa
              = <x.44, z.36, x.46>
        AccesssSign
              = sign(<x.44, z.36, x.46>, x.47)
        pka   = pk(x.47)
        z     = fst(snd(x.46))
        z.1   = snd(snd(x.46))
        z.2   = true
        z.3   = z.36
        z.4   = fst(x.46)
    
     5. AccessRa
              = <x.45, z.37, z.38, x.48>
        AccesssSign
              = sign(<x.45, z.37, z.38, x.48>, x.49)
        pka   = pk(x.49)
        z     = fst(x.48)
        z.1   = snd(x.48)
        z.2   = true
        z.3   = z.37
        z.4   = z.38
    
     6. AccessRa
              = <x.66, z.50, z.51, z.46, z.47>
        AccesssSign
              = sign(<x.66, z.50, z.51, z.46, z.47>, x.71)
        pka   = pk(x.71)
        z     = z.46
        z.1   = z.47
        z.2   = true
        z.3   = z.50
        z.4   = z.51
    
     7. AccessRa
              = <x.126, z.84, z.85, z.80, z.81>
        AccesssSign
              = AccesssSign.67
        pka   = pka.73
        z     = z.80
        z.1   = z.81
        z.2   = verify(AccesssSign.67, <x.126, z.84, z.85, z.80, z.81>, pka.73)
        z.3   = z.84
        z.4   = z.85
    
     8. AccessRa
              = <x.127, x.128>
        AccesssSign
              = AccesssSign.68
        pka   = pka.74
        z     = fst(snd(snd(x.128)))
        z.1   = snd(snd(snd(x.128)))
        z.2   = verify(AccesssSign.68, <x.127, x.128>, pka.74)
        z.3   = fst(x.128)
        z.4   = fst(snd(x.128))
    
     9. AccessRa
              = <x.128, z.86, x.130>
        AccesssSign
              = AccesssSign.69
        pka   = pka.75
        z     = fst(snd(x.130))
        z.1   = snd(snd(x.130))
        z.2   = verify(AccesssSign.69, <x.128, z.86, x.130>, pka.75)
        z.3   = z.86
        z.4   = fst(x.130)
    
    10. AccessRa
              = <x.129, z.87, z.88, x.132>
        AccesssSign
              = AccesssSign.70
        pka   = pka.76
        z     = fst(x.132)
        z.1   = snd(x.132)
        z.2   = verify(AccesssSign.70, <x.129, z.87, z.88, x.132>, pka.76)
        z.3   = z.87
        z.4   = z.88
  */

rule (modulo E) Object_Data_Encryption[role=Authentication_and_Data_Sharing]:
   [
   In( <Hash1, Hashsign, Hashpk, sid, X, 'AccessCert_ab_fs'> ),
   AccessCert_send( $S_a, $S_b, %1, pka, pkb, pskb, ppka, $A, $B, gpkA, gpkB
   )[+],
   !Subject( $S_a, $A, %1, pska, ppska, pka, ppka ),
   !Subject( $S_b, $B, %1, pskb, ppskb, pkb, ppkb ), Fr( ~msg ), Fr( ~re )
   ]
  --[
  EphemeralCreated( 'responder', $S_a, $S_b, %1, sid, ~re ),
  EphemeralUse( 'responder', $S_a, $S_b, %1, sid, ~re ),
  DerivedKeyCreated( 'responder', $S_a, $S_b, %1, sid, 'data',
                     kdf_data(X^~re,
                              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                               'g'^~re, h(Hash1)>)
  ),
  DerivedKeyCreated( 'responder', $S_a, $S_b, %1, sid, 'confirmation',
                     kdf_conf(X^~re,
                              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                               'g'^~re, h(Hash1)>)
  ),
  DerivedKeyUse( 'responder', $S_a, $S_b, %1, sid, 'data',
                 kdf_data(X^~re,
                          <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                           'g'^~re, h(Hash1)>)
  ),
  DerivedKeyUse( 'responder', $S_a, $S_b, %1, sid, 'confirmation',
                 kdf_conf(X^~re,
                          <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                           'g'^~re, h(Hash1)>)
  ),
  ConfirmationGenerated( $S_a, $S_b, $A, $B, %1, sid,
                         <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                          'g'^~re, h(Hash1)>,
                         senc(<~msg, 
                               sign(<~msg, 'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, 
                                     pkb, X, 'g'^~re, h(Hash1)>,
                                    pskb), 
                               pk(pskb)>,
                              kdf_data(X^~re,
                                       <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                                        'g'^~re, h(Hash1)>)),
                         kdf_data(X^~re,
                                  <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                                   'g'^~re, h(Hash1)>),
                         kdf_conf(X^~re,
                                  <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                                   'g'^~re, h(Hash1)>),
                         h(<'key-confirm', 
                            kdf_conf(X^~re,
                                     <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                                      'g'^~re, h(Hash1)>), 
                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                             'g'^~re, h(Hash1)>, 
                            h(senc(<~msg, 
                                    sign(<~msg, 'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, 
                                          pkb, X, 'g'^~re, h(Hash1)>,
                                         pskb), 
                                    pk(pskb)>,
                                   kdf_data(X^~re,
                                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                                             'g'^~re, h(Hash1)>)))
                           >)
  ),
  Eq( 'AccessCert_ab_fs', 'AccessCert_ab_fs' ), Eq( gpkB, Hashpk ),
  Eq( verify(Hashsign, Hash1, gpkB), true ),
  Eq( Hash1, h(<pka, pkb, %1, sid, X>) ),
  DataSent( $S_b, $S_a, %1, pskb, ppka, pka, ~msg,
            kdf_data(X^~re,
                     <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                      'g'^~re, h(Hash1)>)
  ),
  RepairDataSent( $S_b, $S_a, $A, $B, %1, sid, ~msg,
                  kdf_data(X^~re,
                           <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                            'g'^~re, h(Hash1)>),
                  <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                   'g'^~re, h(Hash1)>
  ),
  W2Sent( $S_a, $S_b, %1, sid, ~msg,
          kdf_data(X^~re,
                   <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                    'g'^~re, h(Hash1)>),
          <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
           'g'^~re, h(Hash1)>
  ),
  RunningResponder( $S_b, $S_a, $A, $B, %1, sid, ~msg,
                    kdf_data(X^~re,
                             <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                              'g'^~re, h(Hash1)>),
                    <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                     'g'^~re, h(Hash1)>
  ),
  Secret( ~msg, %1 ),
  SessionKey( kdf_data(X^~re,
                       <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                        'g'^~re, h(Hash1)>),
              %1
  ),
  Honest( $S_a, %1 ), Honest( $S_b, %1 )
  ]->
   [
   Out( <sid, 'g'^~re, 
         senc(<~msg, 
               sign(<~msg, 'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, 
                     pkb, X, 'g'^~re, h(Hash1)>,
                    pskb), 
               pk(pskb)>,
              kdf_data(X^~re,
                       <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                        'g'^~re, h(Hash1)>)), 
         h(<'key-confirm', 
            kdf_conf(X^~re,
                     <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                      'g'^~re, h(Hash1)>), 
            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
             'g'^~re, h(Hash1)>, 
            h(senc(<~msg, 
                    sign(<~msg, 'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, 
                          pkb, X, 'g'^~re, h(Hash1)>,
                         pskb), 
                    pk(pskb)>,
                   kdf_data(X^~re,
                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                             'g'^~re, h(Hash1)>)))
           >), 
         Hash1, 'data_fs'>
   ),
   St_Responder_PreErase_E0_K0_C0( $S_a, $S_b, $A, $B, %1, sid, ~re,
                                   kdf_data(X^~re,
                                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                                             'g'^~re, h(Hash1)>),
                                   kdf_conf(X^~re,
                                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                                             'g'^~re, h(Hash1)>),
                                   ~msg,
                                   <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                                    'g'^~re, h(Hash1)>,
                                   'clean'
   )
   ]

  /*
  rule (modulo AC) Object_Data_Encryption[role=Authentication_and_Data_Sharing]:
     [
     In( <Hash1, Hashsign, Hashpk, sid, X, 'AccessCert_ab_fs'> ),
     AccessCert_send( $S_a, $S_b, %1, pka, pkb, pskb, ppka, $A, $B, gpkA, gpkB
     )[+],
     !Subject( $S_a, $A, %1, pska, ppska, pka, ppka ),
     !Subject( $S_b, $B, %1, pskb, ppskb, pkb, ppkb ), Fr( ~msg ), Fr( ~re )
     ]
    --[
    EphemeralCreated( 'responder', $S_a, $S_b, %1, sid, ~re ),
    EphemeralUse( 'responder', $S_a, $S_b, %1, sid, ~re ),
    DerivedKeyCreated( 'responder', $S_a, $S_b, %1, sid, 'data',
                       kdf_data(z,
                                <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                                 'g'^~re, h(Hash1)>)
    ),
    DerivedKeyCreated( 'responder', $S_a, $S_b, %1, sid, 'confirmation',
                       kdf_conf(z,
                                <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                                 'g'^~re, h(Hash1)>)
    ),
    DerivedKeyUse( 'responder', $S_a, $S_b, %1, sid, 'data',
                   kdf_data(z,
                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                             'g'^~re, h(Hash1)>)
    ),
    DerivedKeyUse( 'responder', $S_a, $S_b, %1, sid, 'confirmation',
                   kdf_conf(z,
                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                             'g'^~re, h(Hash1)>)
    ),
    ConfirmationGenerated( $S_a, $S_b, $A, $B, %1, sid,
                           <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                            'g'^~re, h(Hash1)>,
                           senc(<~msg, 
                                 sign(<~msg, 'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, 
                                       pkb, X, 'g'^~re, h(Hash1)>,
                                      pskb), 
                                 pk(pskb)>,
                                kdf_data(z,
                                         <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                                          'g'^~re, h(Hash1)>)),
                           kdf_data(z,
                                    <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                                     'g'^~re, h(Hash1)>),
                           kdf_conf(z,
                                    <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                                     'g'^~re, h(Hash1)>),
                           h(<'key-confirm', 
                              kdf_conf(z,
                                       <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                                        'g'^~re, h(Hash1)>), 
                              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                               'g'^~re, h(Hash1)>, 
                              h(senc(<~msg, 
                                      sign(<~msg, 'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, 
                                            pkb, X, 'g'^~re, h(Hash1)>,
                                           pskb), 
                                      pk(pskb)>,
                                     kdf_data(z,
                                              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, 
                                               X, 'g'^~re, h(Hash1)>)))
                             >)
    ),
    Eq( 'AccessCert_ab_fs', 'AccessCert_ab_fs' ), Eq( gpkB, Hashpk ),
    Eq( z.1, true ), Eq( Hash1, h(<pka, pkb, %1, sid, X>) ),
    DataSent( $S_b, $S_a, %1, pskb, ppka, pka, ~msg,
              kdf_data(z,
                       <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                        'g'^~re, h(Hash1)>)
    ),
    RepairDataSent( $S_b, $S_a, $A, $B, %1, sid, ~msg,
                    kdf_data(z,
                             <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                              'g'^~re, h(Hash1)>),
                    <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                     'g'^~re, h(Hash1)>
    ),
    W2Sent( $S_a, $S_b, %1, sid, ~msg,
            kdf_data(z,
                     <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                      'g'^~re, h(Hash1)>),
            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
             'g'^~re, h(Hash1)>
    ),
    RunningResponder( $S_b, $S_a, $A, $B, %1, sid, ~msg,
                      kdf_data(z,
                               <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                                'g'^~re, h(Hash1)>),
                      <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                       'g'^~re, h(Hash1)>
    ),
    Secret( ~msg, %1 ),
    SessionKey( kdf_data(z,
                         <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                          'g'^~re, h(Hash1)>),
                %1
    ),
    Honest( $S_a, %1 ), Honest( $S_b, %1 )
    ]->
     [
     Out( <sid, 'g'^~re, 
           senc(<~msg, 
                 sign(<~msg, 'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, 
                       pkb, X, 'g'^~re, h(Hash1)>,
                      pskb), 
                 pk(pskb)>,
                kdf_data(z,
                         <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                          'g'^~re, h(Hash1)>)), 
           h(<'key-confirm', 
              kdf_conf(z,
                       <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                        'g'^~re, h(Hash1)>), 
              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
               'g'^~re, h(Hash1)>, 
              h(senc(<~msg, 
                      sign(<~msg, 'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, 
                            pkb, X, 'g'^~re, h(Hash1)>,
                           pskb), 
                      pk(pskb)>,
                     kdf_data(z,
                              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                               'g'^~re, h(Hash1)>)))
             >), 
           Hash1, 'data_fs'>
     ),
     St_Responder_PreErase_E0_K0_C0( $S_a, $S_b, $A, $B, %1, sid, ~re,
                                     kdf_data(z,
                                              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, 
                                               X, 'g'^~re, h(Hash1)>),
                                     kdf_conf(z,
                                              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, 
                                               X, 'g'^~re, h(Hash1)>),
                                     ~msg,
                                     <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                                      'g'^~re, h(Hash1)>,
                                     'clean'
     )
     ]
    variants (modulo AC)
     1. ~re   = ~re.40
        Hash1 = Hash1.41
        Hashsign
              = Hashsign.43
        X     = X.44
        gpkB  = gpkB.46
        z     = X.44^~re.40
        z.1   = verify(Hashsign.43, Hash1.41, gpkB.46)
    
     2. ~re   = ~re.53
        Hash1 = Hash1.54
        Hashsign
              = Hashsign.56
        X     = z.72^inv(~re.53)
        gpkB  = gpkB.59
        z     = z.72
        z.1   = verify(Hashsign.56, Hash1.54, gpkB.59)
    
     3. ~re   = ~re.349
        Hash1 = Hash1.350
        Hashsign
              = Hashsign.352
        X     = x.690^x.691
        gpkB  = gpkB.355
        z     = x.690^(~re.349*x.691)
        z.1   = verify(Hashsign.352, Hash1.350, gpkB.355)
    
     4. ~re   = ~re.350
        Hash1 = Hash1.351
        Hashsign
              = sign(Hash1.351, x.693)
        X     = X.354
        gpkB  = pk(x.693)
        z     = X.354^~re.350
        z.1   = true
    
     5. ~re   = ~re.351
        Hash1 = Hash1.352
        Hashsign
              = sign(Hash1.352, x.695)
        X     = z.370^inv(~re.351)
        gpkB  = pk(x.695)
        z     = z.370
        z.1   = true
    
     6. ~re   = ~re.352
        Hash1 = Hash1.353
        Hashsign
              = sign(Hash1.353, x.695)
        X     = x.696^x.697
        gpkB  = pk(x.695)
        z     = x.696^(~re.352*x.697)
        z.1   = true
    
     7. ~re   = ~re.353
        Hash1 = Hash1.354
        Hashsign
              = Hashsign.356
        X     = x.698^inv((~re.353*x.699))
        gpkB  = gpkB.359
        z     = x.698^inv(x.699)
        z.1   = verify(Hashsign.356, Hash1.354, gpkB.359)
    
     8. ~re   = ~re.353
        Hash1 = Hash1.354
        Hashsign
              = Hashsign.356
        X     = x.698^(x.699*inv(~re.353))
        gpkB  = gpkB.359
        z     = x.698^x.699
        z.1   = verify(Hashsign.356, Hash1.354, gpkB.359)
    
     9. ~re   = ~re.353
        Hash1 = Hash1.354
        Hashsign
              = sign(Hash1.354, x.697)
        X     = x.698^inv((~re.353*x.699))
        gpkB  = pk(x.697)
        z     = x.698^inv(x.699)
        z.1   = true
    
    10. ~re   = ~re.353
        Hash1 = Hash1.354
        Hashsign
              = sign(Hash1.354, x.697)
        X     = x.698^(x.699*inv(~re.353))
        gpkB  = pk(x.697)
        z     = x.698^x.699
        z.1   = true
    
    11. ~re   = ~re.354
        Hash1 = Hash1.355
        Hashsign
              = Hashsign.357
        X     = x.699^(x.700*inv((~re.354*x.701)))
        gpkB  = gpkB.360
        z     = x.699^(x.700*inv(x.701))
        z.1   = verify(Hashsign.357, Hash1.355, gpkB.360)
    
    12. ~re   = ~re.354
        Hash1 = Hash1.355
        Hashsign
              = sign(Hash1.355, x.698)
        X     = x.699^(x.700*inv((~re.354*x.701)))
        gpkB  = pk(x.698)
        z     = x.699^(x.700*inv(x.701))
        z.1   = true
    
    13. Hash1 = Hash1.39
        Hashsign
              = Hashsign.41
        X     = DH_neutral
        gpkB  = gpkB.44
        z     = DH_neutral
        z.1   = verify(Hashsign.41, Hash1.39, gpkB.44)
    
    14. Hash1 = Hash1.343
        Hashsign
              = sign(Hash1.343, x.678)
        X     = DH_neutral
        gpkB  = pk(x.678)
        z     = DH_neutral
        z.1   = true
  */

rule (modulo E) Subject_Data_Decryption_E0[role=Authentication_and_Data_Sharing]:
   [
   In( <sid, Y, beta, keyConfirm, Hash1, 'data_fs'> ),
   St_Initiator_DH_E0( $S_a, $S_b, $A, $B, %1, sid, ie, X, pka, ppka, pkb,
                       'clean'
   )[+]
   ]
  --[
  W2StateUse( 'initiator', $S_a, $S_b, %1, sid, 'pending' ),
  EphemeralUse( 'initiator', $S_a, $S_b, %1, sid, ie ),
  DerivedKeyCreated( 'initiator', $S_a, $S_b, %1, sid, 'data',
                     kdf_data(Y^ie,
                              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                               h(Hash1)>)
  ),
  DerivedKeyCreated( 'initiator', $S_a, $S_b, %1, sid, 'confirmation',
                     kdf_conf(Y^ie,
                              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                               h(Hash1)>)
  ),
  DerivedKeyUse( 'initiator', $S_a, $S_b, %1, sid, 'data',
                 kdf_data(Y^ie,
                          <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                           h(Hash1)>)
  ),
  DerivedKeyUse( 'initiator', $S_a, $S_b, %1, sid, 'confirmation',
                 kdf_conf(Y^ie,
                          <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                           h(Hash1)>)
  ),
  ConfirmationAccepted( $S_a, $S_b, $A, $B, %1, sid,
                        <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                         h(Hash1)>,
                        beta,
                        kdf_data(Y^ie,
                                 <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                                  h(Hash1)>),
                        kdf_conf(Y^ie,
                                 <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                                  h(Hash1)>),
                        keyConfirm
  ),
  Eq( 'data_fs', 'data_fs' ),
  Eq( keyConfirm,
      h(<'key-confirm', 
         kdf_conf(Y^ie,
                  <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                   h(Hash1)>), 
         <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
          h(Hash1)>, 
         h(beta)>)
  ),
  Eq( snd(snd(sdec(beta,
                   kdf_data(Y^ie,
                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                             h(Hash1)>)))),
      pkb
  ),
  Eq( verify(fst(snd(sdec(beta,
                          kdf_data(Y^ie,
                                   <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                                    h(Hash1)>)))),
             <
              fst(sdec(beta,
                       kdf_data(Y^ie,
                                <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                                 h(Hash1)>))), 
              'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
              h(Hash1)>,
             pkb),
      true
  ),
  DataReceive( $S_b, $S_a, %1, Y, beta, ppka, pkb,
               kdf_data(Y^ie,
                        <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                         h(Hash1)>),
               fst(sdec(beta,
                        kdf_data(Y^ie,
                                 <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                                  h(Hash1)>)))
  ),
  RepairDataAccepted( $S_a, $S_b, $A, $B, %1, sid,
                      fst(sdec(beta,
                               kdf_data(Y^ie,
                                        <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                                         h(Hash1)>))),
                      kdf_data(Y^ie,
                               <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                                h(Hash1)>),
                      <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                       h(Hash1)>
  ),
  W2Accepted( $S_a, $S_b, %1, sid,
              fst(sdec(beta,
                       kdf_data(Y^ie,
                                <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                                 h(Hash1)>))),
              kdf_data(Y^ie,
                       <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                        h(Hash1)>),
              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
               h(Hash1)>
  ),
  CommitInitiator( $S_a, $S_b, $A, $B, %1, sid,
                   fst(sdec(beta,
                            kdf_data(Y^ie,
                                     <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                                      h(Hash1)>))),
                   kdf_data(Y^ie,
                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                             h(Hash1)>),
                   <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                    h(Hash1)>
  )
  ]->
   [
   !Plaintext( fst(sdec(beta,
                        kdf_data(Y^ie,
                                 <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                                  h(Hash1)>)))
   ),
   St_Initiator_PreErase_E0_K0_C0( $S_a, $S_b, $A, $B, %1, sid, ie,
                                   kdf_data(Y^ie,
                                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                                             Y, h(Hash1)>),
                                   kdf_conf(Y^ie,
                                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, 
                                             Y, h(Hash1)>),
                                   fst(sdec(beta,
                                            kdf_data(Y^ie,
                                                     <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, 
                                                      pka, pkb, X, Y, h(Hash1)>))),
                                   <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                                    h(Hash1)>,
                                   'clean'
   )
   ]

  /*
  rule (modulo AC) Subject_Data_Decryption_E0[role=Authentication_and_Data_Sharing]:
     [
     In( <sid, Y, beta, keyConfirm, Hash1, 'data_fs'> ),
     St_Initiator_DH_E0( $S_a, $S_b, $A, $B, %1, sid, ie, X, pka, ppka, pkb,
                         'clean'
     )[+]
     ]
    --[
    W2StateUse( 'initiator', $S_a, $S_b, %1, sid, 'pending' ),
    EphemeralUse( 'initiator', $S_a, $S_b, %1, sid, ie ),
    DerivedKeyCreated( 'initiator', $S_a, $S_b, %1, sid, 'data',
                       kdf_data(z.1,
                                <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                                 h(Hash1)>)
    ),
    DerivedKeyCreated( 'initiator', $S_a, $S_b, %1, sid, 'confirmation',
                       kdf_conf(z.1,
                                <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %1, sid, pka, pkb, X, Y, 
                                 h(Hash1)>)
    ),
