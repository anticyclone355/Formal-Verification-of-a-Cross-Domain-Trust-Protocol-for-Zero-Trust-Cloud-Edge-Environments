         z.2   = verify(fst(snd(sdec(beta.49,
                                     kdf_data(Y.48,
                                              <'CDDS-AECDHE-full-v4', $S_a.44, $A.42, $S_b.45, $B.43, %n.58, 
                                               sid.57, pka.54, pkb.55, X.47, Y.48, h(Hash1.46)>)))),
                        <
                         fst(sdec(beta.49,
                                  kdf_data(Y.48,
                                           <'CDDS-AECDHE-full-v4', $S_a.44, $A.42, $S_b.45, $B.43, %n.58, 
