lemma replay_acceptance_exclusion:
  all-traces
  "∀ I R A B e sid x1 x2 k1 k2 T1 T2 #c1 #c2.
    ((CommitInitiator( I, R, A, B, e, sid, x1, k1, T1 ) @ #c1) ∧
     (CommitInitiator( I, R, A, B, e, sid, x2, k2, T2 ) @ #c2)) ⇒
    (#c1 = #c2)"
/*
guarded formula characterizing all counter-examples:
"∃ I R A B e sid x1 x2 k1 k2 T1 T2 #c1 #c2.
  (CommitInitiator( I, R, A, B, e, sid, x1, k1, T1 ) @ #c1) ∧
  (CommitInitiator( I, R, A, B, e, sid, x2, k2, T2 ) @ #c2)
 ∧
  ¬(#c1 = #c2)"
*/
by sorry

