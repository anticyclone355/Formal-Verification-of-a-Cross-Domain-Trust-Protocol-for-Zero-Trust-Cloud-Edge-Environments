lemma reachable_two_distinct_contexts:
  exists-trace
  "∃ q1 q2 I1 I2 R1 R2 e #b1 #b2 #c1 #c2.
    (((((((((W3Begin( q1, I1, R1, e ) @ #b1) ∧
            (W3Begin( q2, I2, R2, e ) @ #b2)) ∧
           (W3End( q1, I1, R1, e ) @ #c1)) ∧
          (W3End( q2, I2, R2, e ) @ #c2)) ∧
         (¬(q1 = q2))) ∧
        ((¬(I1 = I2)) ∨ (¬(R1 = R2)))) ∧
       (#b1 < #b2)) ∧
      (#b2 < #c1)) ∧
     (#b2 < #c2)) ∧
    (¬(#c1 = #c2))"
/*
guarded formula characterizing all satisfying traces:
"∃ q1 q2 I1 I2 R1 R2 e #b1 #b2 #c1 #c2.
  (W3Begin( q1, I1, R1, e ) @ #b1) ∧
  (W3Begin( q2, I2, R2, e ) @ #b2) ∧
  (W3End( q1, I1, R1, e ) @ #c1) ∧
  (W3End( q2, I2, R2, e ) @ #c2)
 ∧
  (¬(q1 = q2)) ∧
  (((¬(I1 = I2)) ∨ (¬(R1 = R2)))) ∧
  (#b1 < #b2) ∧
  (#b2 < #c1) ∧
  (#b2 < #c2) ∧
  (¬(#c1 = #c2))"
*/
by sorry

lemma unknown_key_share_exclusion:
  all-traces
  "∀ I R A B e sid x k T I2 R2 A2 B2 e2 sid2 x2 T2 #c #s.
    ((CommitInitiator( I, R, A, B, e, sid, x, k, T ) @ #c) ∧
     (RunningResponder( R2, I2, A2, B2, e2, sid2, x2, k, T2 ) @ #s)) ⇒
    ((((((I = I2) ∧ (R = R2)) ∧ (A = A2)) ∧ (B = B2)) ∧ (e = e2)) ∧
     (sid = sid2))"
/*
guarded formula characterizing all counter-examples:
