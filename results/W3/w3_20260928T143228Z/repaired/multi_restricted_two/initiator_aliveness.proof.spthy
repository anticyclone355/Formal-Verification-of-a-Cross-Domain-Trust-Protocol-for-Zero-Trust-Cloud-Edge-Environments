theory W3_repaired_Concurrent_Agreement begin

// Function signature and definition of the equational theory E

builtins: diffie-hellman, natural-numbers
functions: PDec/2, PEnc/3, fst/1, h/1, kdf_conf/2, kdf_data/2, pair/2,
           pk/1, ppk/1, sdec/2, senc/2, sign/2, snd/1, true/0, verify/3
equations:
    PDec(psk, PEnc(ppk(psk), k, r)) = k,
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true















restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction W3_OneSetup:
  "∀ #i #j. ((W3Init( ) @ #i) ∧ (W3Init( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction unique_AccessRequest:
  "∀ S_a S_b n A B pska pskb gskA #i #j.
    ((AccessRequest( S_a, S_b, n, A, B, pska, pskb, gskA ) @ #i) ∧
     (AccessRequest( S_a, S_b, n, A, B, pska, pskb, gskA ) @ #j)) ⇒
    (#i = #j)"
  // safety formula

restriction unique_AccessGranted:
  "∀ S_a S_b n pka pkb bit #i #j.
    ((AccessGranted( S_a, S_b, n, pka, pkb, bit ) @ #i) ∧
     (AccessGranted( S_a, S_b, n, pka, pkb, bit ) @ #j)) ⇒
    (#i = #j)"
  // safety formula

restriction unique_Datasend:
  "∀ S_a S_b n1 n2 pskb ppka pka x k #i #j.
    (((DataSent( S_b, S_a, n1, pskb, ppka, pka, x, k ) @ #i) ∧
      (DataSent( S_b, S_a, n2, pskb, ppka, pka, x, k ) @ #j)) ∧
     (n1 = n2)) ⇒
    (#i = #j)"
  // safety formula

restriction unique_DataReceive:
  "∀ S_a S_b n1 n2 alpha beta pska pkb k x #i #j.
    (((DataReceive( S_b, S_a, n1, alpha, beta, pska, pkb, k, x ) @ #i) ∧
      (DataReceive( S_b, S_a, n2, alpha, beta, pska, pkb, k, x ) @ #j)) ∧
     (n1 = n2)) ⇒
    (#i = #j)"
  // safety formula

rule (modulo E) W3_Setup:
   [
   Fr( ~si ), Fr( ~pi ), Fr( ~sr ), Fr( ~pr ), Fr( ~da ), Fr( ~db ),
   Fr( ~si2 ), Fr( ~pi2 ), Fr( ~sr2 ), Fr( ~pr2 )
   ]
  --[ W3Init( ) ]->
   [
   !Subject( 'requester', 'domain_A', %1, ~si, ~pi, pk(~si), ppk(~pi) ),
   !Subject( 'owner', 'domain_B', %1, ~sr, ~pr, pk(~sr), ppk(~pr) ),
   !Domain( 'domain_A', %1, ~da, pk(~da) ),
   !Domain( 'domain_B', %1, ~db, pk(~db) ),
   !Policy( 'domain_A', 'domain_B', %1, 'requester', 'owner', '1' ),
   !W3Ready( 'requester', 'owner', 'domain_A', 'domain_B', %1 ),
   !Subject( 'requester_2', 'domain_A', %1, ~si2, ~pi2, pk(~si2), ppk(~pi2)
   ),
   !Subject( 'owner_2', 'domain_B', %1, ~sr2, ~pr2, pk(~sr2), ppk(~pr2) ),
   !Policy( 'domain_A', 'domain_B', %1, 'requester', 'owner_2', '1' ),
   !Policy( 'domain_A', 'domain_B', %1, 'requester_2', 'owner', '1' ),
   !Policy( 'domain_A', 'domain_B', %1, 'requester_2', 'owner_2', '1' ),
   !W3Ready( 'requester', 'owner_2', 'domain_A', 'domain_B', %1 ),
   !W3Ready( 'requester_2', 'owner', 'domain_A', 'domain_B', %1 ),
   !W3Ready( 'requester_2', 'owner_2', 'domain_A', 'domain_B', %1 ),
   Out( <pk(~si2), ppk(~pi2), %1, 'Subject Pk'> ),
   Out( <pk(~sr2), ppk(~pr2), %1, 'Subject Pk'> ),
   Out( <<pk(~si2), ppk(~pi2), %1>, sign(<pk(~si2), ppk(~pi2), %1>, ~da), 
         pk(~da), 'SubjectCert'>
   ),
   Out( <<pk(~sr2), ppk(~pr2), %1>, sign(<pk(~sr2), ppk(~pr2), %1>, ~db), 
         pk(~db), 'SubjectCert'>
   ),
   W3Budget( ), W3Budget( ), Out( <pk(~si), ppk(~pi), %1, 'Subject Pk'> ),
   Out( <pk(~sr), ppk(~pr), %1, 'Subject Pk'> ),
   Out( <<pk(~si), ppk(~pi), %1>, sign(<pk(~si), ppk(~pi), %1>, ~da), 
         pk(~da), 'SubjectCert'>
   ),
   Out( <<pk(~sr), ppk(~pr), %1>, sign(<pk(~sr), ppk(~pr), %1>, ~db), 
         pk(~db), 'SubjectCert'>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Subject_Access_Request[role=Authentication_and_Data_Sharing]:
   [
   !W3Ready( $S_a, $S_b, $A, $B, %n ), W3Budget( ),
   !Subject( $S_a, $A, %n, pska, ppska, pka, ppka ),
   !Subject( $S_b, $B, %n, pskb, ppskb, pkb, ppkb ),
   !Domain( $A, %n, gskA, gpkA ), !Domain( $B, %n, gskB, gpkB ), Fr( ~sid ),
   Fr( ~ie ), In( <CertA, CertaSign, SignPk, field> )
   ]
  --[
  Eq( field, 'SubjectCert' ), Eq( SignPk, gpkA ),
  Eq( verify(CertaSign, CertA, gpkA), true ), Eq( fst(CertA), pka ),
  Eq( fst(snd(CertA)), ppka ), Eq( snd(snd(CertA)), %n ),
  AccessRequest( $S_a, $S_b, %n, $A, $B, pska, pskb, gskA ),
  W3Begin( ~sid, $S_a, $S_b, %n ),
  RunningInitiatorRequest( $S_a, $S_b, $A, $B, %n, ~sid, 'g'^~ie,
                           h(<pka, pkb, %n, ~sid, 'g'^~ie>)
  ),
  RepairAccessRequest( $S_a, $S_b, $A, $B, %n, ~sid, 'g'^~ie )
  ]->
   [
   Out( <<<CertA, CertaSign, SignPk>, pkb, %n, ~sid, 'g'^~ie>, 
         sign(<<CertA, CertaSign, SignPk>, pkb, %n, ~sid, 'g'^~ie>, pska), pka, 
         'AccessR_a_fs'>
   ),
   Access_send( $S_a, $S_b, %n, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB,
                ppka
   ),
   St_Initiator_DH( $S_a, $S_b, $A, $B, %n, ~sid, ~ie, 'g'^~ie, pka, ppka,
                    pkb, 'clean'
   )
   ]

  /*
  rule (modulo AC) Subject_Access_Request[role=Authentication_and_Data_Sharing]:
     [
     !W3Ready( $S_a, $S_b, $A, $B, %n ), W3Budget( ),
     !Subject( $S_a, $A, %n, pska, ppska, pka, ppka ),
     !Subject( $S_b, $B, %n, pskb, ppskb, pkb, ppkb ),
     !Domain( $A, %n, gskA, gpkA ), !Domain( $B, %n, gskB, gpkB ), Fr( ~sid ),
     Fr( ~ie ), In( <CertA, CertaSign, SignPk, field> )
     ]
    --[
    Eq( field, 'SubjectCert' ), Eq( SignPk, gpkA ), Eq( z, true ),
    Eq( z.1, pka ), Eq( z.2, ppka ), Eq( z.3, %n ),
    AccessRequest( $S_a, $S_b, %n, $A, $B, pska, pskb, gskA ),
    W3Begin( ~sid, $S_a, $S_b, %n ),
    RunningInitiatorRequest( $S_a, $S_b, $A, $B, %n, ~sid, 'g'^~ie,
                             h(<pka, pkb, %n, ~sid, 'g'^~ie>)
    ),
    RepairAccessRequest( $S_a, $S_b, $A, $B, %n, ~sid, 'g'^~ie )
    ]->
     [
     Out( <<<CertA, CertaSign, SignPk>, pkb, %n, ~sid, 'g'^~ie>, 
           sign(<<CertA, CertaSign, SignPk>, pkb, %n, ~sid, 'g'^~ie>, pska), pka, 
           'AccessR_a_fs'>
     ),
     Access_send( $S_a, $S_b, %n, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB,
                  ppka
     ),
     St_Initiator_DH( $S_a, $S_b, $A, $B, %n, ~sid, ~ie, 'g'^~ie, pka, ppka,
                      pkb, 'clean'
     )
     ]
    variants (modulo AC)
    1. CertA = CertA.37
       CertaSign
             = CertaSign.38
       gpkA  = gpkA.41
       z     = verify(CertaSign.38, CertA.37, gpkA.41)
       z.1   = fst(CertA.37)
       z.2   = fst(snd(CertA.37))
       z.3   = snd(snd(CertA.37))
    
    2. CertA = CertA.204
       CertaSign
             = sign(CertA.204, x.400)
       gpkA  = pk(x.400)
       z     = true
       z.1   = fst(CertA.204)
       z.2   = fst(snd(CertA.204))
       z.3   = snd(snd(CertA.204))
    
    3. CertA = <z.77, z.78, z.79>
       CertaSign
             = CertaSign.56
       gpkA  = gpkA.59
       z     = verify(CertaSign.56, <z.77, z.78, z.79>, gpkA.59)
       z.1   = z.77
       z.2   = z.78
       z.3   = z.79
    
    4. CertA = <z.161, x.291>
       CertaSign
             = sign(<z.161, x.291>, x.292)
       gpkA  = pk(x.292)
       z     = true
       z.1   = z.161
       z.2   = fst(x.291)
       z.3   = snd(x.291)
    
    5. CertA = <z.162, z.163, z.164>
       CertaSign
             = sign(<z.162, z.163, z.164>, x.294)
       gpkA  = pk(x.294)
       z     = true
       z.1   = z.162
       z.2   = z.163
       z.3   = z.164
    
    6. CertA = <z.223, x.395>
       CertaSign
             = CertaSign.202
       gpkA  = gpkA.205
       z     = verify(CertaSign.202, <z.223, x.395>, gpkA.205)
       z.1   = z.223
       z.2   = fst(x.395)
       z.3   = snd(x.395)
  */

rule (modulo E) Domain_Access_Verification[role=Authentication_and_Data_Sharing]:
   [
   In( <AccessRa, AccesssSign, AccessPKa, field> ),
   Access_send( $S_a, $S_b, %n, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB,
                ppka
   ),
   !Policy( $A, $B, %n, $S_a, $S_b, bit ),
   !Subject( $S_b, $B, %n, pskb, ppskb, pkb, ppkb )
   ]
  --[
  Eq( field, 'AccessR_a_fs' ), Eq( pka, AccessPKa ),
  Eq( verify(AccesssSign, AccessRa, pka), true ),
  Eq( fst(snd(AccessRa)), pkb ), Eq( fst(snd(snd(AccessRa))), %n ),
  Eq( bit, '1' ), AccessGranted( $S_a, $S_b, %n, pka, pkb, bit ),
  RepairAccessGranted( $S_a, $S_b, $A, $B, %n,
                       fst(snd(snd(snd(AccessRa)))), snd(snd(snd(snd(AccessRa)))),
                       h(<pka, pkb, %n, fst(snd(snd(snd(AccessRa)))), 
                          snd(snd(snd(snd(AccessRa))))>)
  )
  ]->
   [
   Out( <
         h(<pka, pkb, %n, fst(snd(snd(snd(AccessRa)))), 
            snd(snd(snd(snd(AccessRa))))>), 
         sign(h(<pka, pkb, %n, fst(snd(snd(snd(AccessRa)))), 
                 snd(snd(snd(snd(AccessRa))))>),
              gskB), 
         pk(gskB), fst(snd(snd(snd(AccessRa)))), snd(snd(snd(snd(AccessRa)))), 
         'AccessCert_ab_fs'>
   ),
   AccessCert_send( $S_a, $S_b, %n, pka, pkb, pskb, ppka, $A, $B, gpkA, gpkB
   )
   ]

  /*
  rule (modulo AC) Domain_Access_Verification[role=Authentication_and_Data_Sharing]:
     [
     In( <AccessRa, AccesssSign, AccessPKa, field> ),
     Access_send( $S_a, $S_b, %n, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB,
                  ppka
     ),
     !Policy( $A, $B, %n, $S_a, $S_b, bit ),
     !Subject( $S_b, $B, %n, pskb, ppskb, pkb, ppkb )
     ]
    --[
    Eq( field, 'AccessR_a_fs' ), Eq( pka, AccessPKa ), Eq( z.2, true ),
    Eq( z.3, pkb ), Eq( z.4, %n ), Eq( bit, '1' ),
    AccessGranted( $S_a, $S_b, %n, pka, pkb, bit ),
    RepairAccessGranted( $S_a, $S_b, $A, $B, %n, z, z.1,
                         h(<pka, pkb, %n, z, z.1>)
    )
    ]->
     [
     Out( <h(<pka, pkb, %n, z, z.1>), sign(h(<pka, pkb, %n, z, z.1>), gskB), 
           pk(gskB), z, z.1, 'AccessCert_ab_fs'>
     ),
     AccessCert_send( $S_a, $S_b, %n, pka, pkb, pskb, ppka, $A, $B, gpkA, gpkB
     )
     ]
    variants (modulo AC)
     1. AccessRa
              = AccessRa.37
        AccesssSign
              = AccesssSign.38
        pka   = pka.45
        z     = fst(snd(snd(snd(AccessRa.37))))
        z.1   = snd(snd(snd(snd(AccessRa.37))))
        z.2   = verify(AccesssSign.38, AccessRa.37, pka.45)
        z.3   = fst(snd(AccessRa.37))
        z.4   = fst(snd(snd(AccessRa.37)))
    
     2. AccessRa
              = AccessRa.76
        AccesssSign
              = sign(AccessRa.76, x.145)
        pka   = pk(x.145)
        z     = fst(snd(snd(snd(AccessRa.76))))
        z.1   = snd(snd(snd(snd(AccessRa.76))))
        z.2   = true
        z.3   = fst(snd(AccessRa.76))
        z.4   = fst(snd(snd(AccessRa.76)))
    
     3. AccessRa
              = <x.31, x.32>
        AccesssSign
              = sign(<x.31, x.32>, x.33)
        pka   = pk(x.33)
        z     = fst(snd(snd(x.32)))
        z.1   = snd(snd(snd(x.32)))
        z.2   = true
        z.3   = fst(x.32)
        z.4   = fst(snd(x.32))
    
     4. AccessRa
              = <x.46, z.38, x.48>
        AccesssSign
              = sign(<x.46, z.38, x.48>, x.49)
        pka   = pk(x.49)
        z     = fst(snd(x.48))
        z.1   = snd(snd(x.48))
        z.2   = true
        z.3   = z.38
        z.4   = fst(x.48)
    
     5. AccessRa
              = <x.47, z.39, z.40, x.50>
        AccesssSign
              = sign(<x.47, z.39, z.40, x.50>, x.51)
        pka   = pk(x.51)
        z     = fst(x.50)
        z.1   = snd(x.50)
        z.2   = true
        z.3   = z.39
        z.4   = z.40
    
     6. AccessRa
              = <x.73, z.55, z.56, z.50, z.51>
        AccesssSign
              = sign(<x.73, z.55, z.56, z.50, z.51>, x.78)
        pka   = pk(x.78)
        z     = z.50
        z.1   = z.51
        z.2   = true
        z.3   = z.55
        z.4   = z.56
    
     7. AccessRa
              = <x.138, z.92, z.93, z.87, z.88>
        AccesssSign
              = AccesssSign.73
        pka   = pka.80
        z     = z.87
        z.1   = z.88
        z.2   = verify(AccesssSign.73, <x.138, z.92, z.93, z.87, z.88>, pka.80)
        z.3   = z.92
        z.4   = z.93
    
     8. AccessRa
              = <x.139, x.140>
        AccesssSign
              = AccesssSign.74
        pka   = pka.81
        z     = fst(snd(snd(x.140)))
        z.1   = snd(snd(snd(x.140)))
        z.2   = verify(AccesssSign.74, <x.139, x.140>, pka.81)
        z.3   = fst(x.140)
        z.4   = fst(snd(x.140))
    
     9. AccessRa
              = <x.140, z.94, x.142>
        AccesssSign
              = AccesssSign.75
        pka   = pka.82
        z     = fst(snd(x.142))
        z.1   = snd(snd(x.142))
        z.2   = verify(AccesssSign.75, <x.140, z.94, x.142>, pka.82)
        z.3   = z.94
        z.4   = fst(x.142)
    
    10. AccessRa
              = <x.141, z.95, z.96, x.144>
        AccesssSign
              = AccesssSign.76
        pka   = pka.83
        z     = fst(x.144)
        z.1   = snd(x.144)
        z.2   = verify(AccesssSign.76, <x.141, z.95, z.96, x.144>, pka.83)
        z.3   = z.95
        z.4   = z.96
  */

rule (modulo E) Object_Data_Encryption[role=Authentication_and_Data_Sharing]:
   [
   In( <Hash1, Hashsign, Hashpk, sid, X, field> ),
   AccessCert_send( $S_a, $S_b, %n, pka, pkb, pskb, ppka, $A, $B, gpkA, gpkB
   ),
   !Subject( $S_a, $A, %n, pska, ppska, pka, ppka ),
   !Subject( $S_b, $B, %n, pskb, ppskb, pkb, ppkb ), Fr( ~data ), Fr( ~re )
   ]
  --[
  Eq( field, 'AccessCert_ab_fs' ), Eq( gpkB, Hashpk ),
  Eq( verify(Hashsign, Hash1, gpkB), true ),
  Eq( Hash1, h(<pka, pkb, %n, sid, X>) ),
  DataSent( $S_b, $S_a, %n, pskb, ppka, pka, ~data,
            kdf_data(X^~re,
                     <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                      'g'^~re, h(Hash1)>)
  ),
  RepairDataSent( $S_b, $S_a, $A, $B, %n, sid, ~data,
                  kdf_data(X^~re,
                           <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                            'g'^~re, h(Hash1)>),
                  <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                   'g'^~re, h(Hash1)>
  ),
  CommitResponderRequest( $S_a, $S_b, $A, $B, %n, sid, X, Hash1 ),
  W3DataSent( $S_a, $S_b, %n, sid, ~data,
              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
               'g'^~re, h(Hash1)>,
              senc(<~data, 
                    sign(<~data, 'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, 
                          pkb, X, 'g'^~re, h(Hash1)>,
                         pskb), 
                    pk(pskb)>,
                   kdf_data(X^~re,
                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                             'g'^~re, h(Hash1)>))
  ),
  RunningResponder( $S_b, $S_a, $A, $B, %n, sid, ~data,
                    kdf_data(X^~re,
                             <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                              'g'^~re, h(Hash1)>),
                    <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                     'g'^~re, h(Hash1)>
  ),
  Secret( ~data, %n ),
  SessionKey( kdf_data(X^~re,
                       <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                        'g'^~re, h(Hash1)>),
              %n
  ),
  Honest( $S_a, %n ), Honest( $S_b, %n )
  ]->
   [
   Out( <sid, 'g'^~re, 
         senc(<~data, 
               sign(<~data, 'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, 
                     pkb, X, 'g'^~re, h(Hash1)>,
                    pskb), 
               pk(pskb)>,
              kdf_data(X^~re,
                       <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                        'g'^~re, h(Hash1)>)), 
         h(<'key-confirm', 
            kdf_conf(X^~re,
                     <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                      'g'^~re, h(Hash1)>), 
            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
             'g'^~re, h(Hash1)>, 
            h(senc(<~data, 
                    sign(<~data, 'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, 
                          pkb, X, 'g'^~re, h(Hash1)>,
                         pskb), 
                    pk(pskb)>,
                   kdf_data(X^~re,
                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                             'g'^~re, h(Hash1)>)))
           >), 
         Hash1, 'data_fs'>
   )
   ]

  /*
  rule (modulo AC) Object_Data_Encryption[role=Authentication_and_Data_Sharing]:
     [
     In( <Hash1, Hashsign, Hashpk, sid, X, field> ),
     AccessCert_send( $S_a, $S_b, %n, pka, pkb, pskb, ppka, $A, $B, gpkA, gpkB
     ),
     !Subject( $S_a, $A, %n, pska, ppska, pka, ppka ),
     !Subject( $S_b, $B, %n, pskb, ppskb, pkb, ppkb ), Fr( ~data ), Fr( ~re )
     ]
    --[
    Eq( field, 'AccessCert_ab_fs' ), Eq( gpkB, Hashpk ), Eq( z.1, true ),
    Eq( Hash1, h(<pka, pkb, %n, sid, X>) ),
    DataSent( $S_b, $S_a, %n, pskb, ppka, pka, ~data,
              kdf_data(z,
                       <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                        'g'^~re, h(Hash1)>)
    ),
    RepairDataSent( $S_b, $S_a, $A, $B, %n, sid, ~data,
                    kdf_data(z,
                             <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                              'g'^~re, h(Hash1)>),
                    <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                     'g'^~re, h(Hash1)>
    ),
    CommitResponderRequest( $S_a, $S_b, $A, $B, %n, sid, X, Hash1 ),
    W3DataSent( $S_a, $S_b, %n, sid, ~data,
                <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                 'g'^~re, h(Hash1)>,
                senc(<~data, 
                      sign(<~data, 'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, 
                            pkb, X, 'g'^~re, h(Hash1)>,
                           pskb), 
                      pk(pskb)>,
                     kdf_data(z,
                              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                               'g'^~re, h(Hash1)>))
    ),
    RunningResponder( $S_b, $S_a, $A, $B, %n, sid, ~data,
                      kdf_data(z,
                               <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                                'g'^~re, h(Hash1)>),
                      <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                       'g'^~re, h(Hash1)>
    ),
    Secret( ~data, %n ),
    SessionKey( kdf_data(z,
                         <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                          'g'^~re, h(Hash1)>),
                %n
    ),
    Honest( $S_a, %n ), Honest( $S_b, %n )
    ]->
     [
     Out( <sid, 'g'^~re, 
           senc(<~data, 
                 sign(<~data, 'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, 
                       pkb, X, 'g'^~re, h(Hash1)>,
                      pskb), 
                 pk(pskb)>,
                kdf_data(z,
                         <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                          'g'^~re, h(Hash1)>)), 
           h(<'key-confirm', 
              kdf_conf(z,
                       <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                        'g'^~re, h(Hash1)>), 
              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
               'g'^~re, h(Hash1)>, 
              h(senc(<~data, 
                      sign(<~data, 'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, 
                            pkb, X, 'g'^~re, h(Hash1)>,
                           pskb), 
                      pk(pskb)>,
                     kdf_data(z,
                              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                               'g'^~re, h(Hash1)>)))
             >), 
           Hash1, 'data_fs'>
     )
     ]
    variants (modulo AC)
     1. ~re   = ~re.39
        Hash1 = Hash1.40
        Hashsign
              = Hashsign.42
        X     = X.43
        gpkB  = gpkB.46
        z     = X.43^~re.39
        z.1   = verify(Hashsign.42, Hash1.40, gpkB.46)
    
     2. ~re   = ~re.52
        Hash1 = Hash1.53
        Hashsign
              = Hashsign.55
        X     = z.72^inv(~re.52)
        gpkB  = gpkB.59
        z     = z.72
        z.1   = verify(Hashsign.55, Hash1.53, gpkB.59)
    
     3. ~re   = ~re.221
        Hash1 = Hash1.222
        Hashsign
              = Hashsign.224
        X     = x.434^x.435
        gpkB  = gpkB.228
        z     = x.434^(~re.221*x.435)
        z.1   = verify(Hashsign.224, Hash1.222, gpkB.228)
    
     4. ~re   = ~re.222
        Hash1 = Hash1.223
        Hashsign
              = sign(Hash1.223, x.437)
        X     = X.226
        gpkB  = pk(x.437)
        z     = X.226^~re.222
        z.1   = true
    
     5. ~re   = ~re.223
        Hash1 = Hash1.224
        Hashsign
              = sign(Hash1.224, x.439)
        X     = z.243^inv(~re.223)
        gpkB  = pk(x.439)
        z     = z.243
        z.1   = true
    
     6. ~re   = ~re.224
        Hash1 = Hash1.225
        Hashsign
              = sign(Hash1.225, x.439)
        X     = x.440^x.441
        gpkB  = pk(x.439)
        z     = x.440^(~re.224*x.441)
        z.1   = true
    
     7. ~re   = ~re.225
        Hash1 = Hash1.226
        Hashsign
              = Hashsign.228
        X     = x.442^inv((~re.225*x.443))
        gpkB  = gpkB.232
        z     = x.442^inv(x.443)
        z.1   = verify(Hashsign.228, Hash1.226, gpkB.232)
    
     8. ~re   = ~re.225
        Hash1 = Hash1.226
        Hashsign
              = Hashsign.228
        X     = x.442^(x.443*inv(~re.225))
        gpkB  = gpkB.232
        z     = x.442^x.443
        z.1   = verify(Hashsign.228, Hash1.226, gpkB.232)
    
     9. ~re   = ~re.225
        Hash1 = Hash1.226
        Hashsign
              = sign(Hash1.226, x.441)
        X     = x.442^inv((~re.225*x.443))
        gpkB  = pk(x.441)
        z     = x.442^inv(x.443)
        z.1   = true
    
    10. ~re   = ~re.225
        Hash1 = Hash1.226
        Hashsign
              = sign(Hash1.226, x.441)
        X     = x.442^(x.443*inv(~re.225))
        gpkB  = pk(x.441)
        z     = x.442^x.443
        z.1   = true
    
    11. ~re   = ~re.226
        Hash1 = Hash1.227
        Hashsign
              = Hashsign.229
        X     = x.443^(x.444*inv((~re.226*x.445)))
        gpkB  = gpkB.233
        z     = x.443^(x.444*inv(x.445))
        z.1   = verify(Hashsign.229, Hash1.227, gpkB.233)
    
    12. ~re   = ~re.226
        Hash1 = Hash1.227
        Hashsign
              = sign(Hash1.227, x.442)
        X     = x.443^(x.444*inv((~re.226*x.445)))
        gpkB  = pk(x.442)
        z     = x.443^(x.444*inv(x.445))
        z.1   = true
    
    13. Hash1 = Hash1.38
        Hashsign
              = Hashsign.40
        X     = DH_neutral
        gpkB  = gpkB.44
        z     = DH_neutral
        z.1   = verify(Hashsign.40, Hash1.38, gpkB.44)
    
    14. Hash1 = Hash1.219
        Hashsign
              = sign(Hash1.219, x.430)
        X     = DH_neutral
        gpkB  = pk(x.430)
        z     = DH_neutral
        z.1   = true
  */

rule (modulo E) Subject_Data_Decryption[role=Authentication_and_Data_Sharing]:
   [
   In( <sid, Y, beta, keyConfirm, Hash1, field> ),
   St_Initiator_DH( $S_a, $S_b, $A, $B, %n, sid, ie, X, pka, ppka, pkb,
                    iExposure
   )
   ]
  --[
  Eq( field, 'data_fs' ),
  Eq( keyConfirm,
      h(<'key-confirm', 
         kdf_conf(Y^ie,
                  <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                   h(Hash1)>), 
         <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
          h(Hash1)>, 
         h(beta)>)
  ),
  Eq( snd(snd(sdec(beta,
                   kdf_data(Y^ie,
                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                             h(Hash1)>)))),
      pkb
  ),
  Eq( verify(fst(snd(sdec(beta,
                          kdf_data(Y^ie,
                                   <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                                    h(Hash1)>)))),
             <
              fst(sdec(beta,
                       kdf_data(Y^ie,
                                <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                                 h(Hash1)>))), 
              'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
              h(Hash1)>,
             pkb),
      true
  ),
  DataReceive( $S_b, $S_a, %n, Y, beta, ppka, pkb,
               kdf_data(Y^ie,
                        <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                         h(Hash1)>),
               fst(sdec(beta,
                        kdf_data(Y^ie,
                                 <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                                  h(Hash1)>)))
  ),
  RepairDataAccepted( $S_a, $S_b, $A, $B, %n, sid,
                      fst(sdec(beta,
                               kdf_data(Y^ie,
                                        <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                                         h(Hash1)>))),
                      kdf_data(Y^ie,
                               <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                                h(Hash1)>),
                      <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                       h(Hash1)>
  ),
  W3End( sid, $S_a, $S_b, %n ),
  W3DataAccepted( $S_a, $S_b, %n, sid,
                  fst(sdec(beta,
                           kdf_data(Y^ie,
                                    <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                                     h(Hash1)>))),
                  <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                   h(Hash1)>,
                  beta
  ),
  CommitInitiator( $S_a, $S_b, $A, $B, %n, sid,
                   fst(sdec(beta,
                            kdf_data(Y^ie,
                                     <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                                      h(Hash1)>))),
                   kdf_data(Y^ie,
                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                             h(Hash1)>),
                   <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                    h(Hash1)>
  )
  ]->
   [ ]

  /*
  rule (modulo AC) Subject_Data_Decryption[role=Authentication_and_Data_Sharing]:
     [
     In( <sid, Y, beta, keyConfirm, Hash1, field> ),
     St_Initiator_DH( $S_a, $S_b, $A, $B, %n, sid, ie, X, pka, ppka, pkb,
                      iExposure
     )
     ]
    --[
    Eq( field, 'data_fs' ),
    Eq( keyConfirm,
        h(<'key-confirm', 
           kdf_conf(z,
                    <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                     h(Hash1)>), 
           <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
            h(Hash1)>, 
           h(beta)>)
    ),
    Eq( z.1, pkb ), Eq( z.2, true ),
    DataReceive( $S_b, $S_a, %n, Y, beta, ppka, pkb,
                 kdf_data(z,
                          <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                           h(Hash1)>),
                 z.3
    ),
    RepairDataAccepted( $S_a, $S_b, $A, $B, %n, sid, z.3,
                        kdf_data(z,
                                 <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                                  h(Hash1)>),
                        <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                         h(Hash1)>
    ),
    W3End( sid, $S_a, $S_b, %n ),
    W3DataAccepted( $S_a, $S_b, %n, sid, z.3,
                    <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                     h(Hash1)>,
                    beta
    ),
    CommitInitiator( $S_a, $S_b, $A, $B, %n, sid, z.3,
                     kdf_data(z,
                              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                               h(Hash1)>),
                     <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                      h(Hash1)>
    )
    ]->
     [ ]
    variants (modulo AC)
      1. $A    = $A.42
         $B    = $B.43
         $S_a  = $S_a.44
         $S_b  = $S_b.45
         Hash1 = Hash1.46
         X     = X.47
         Y     = Y.48
         beta  = beta.49
         ie    = ie.52
         pka   = pka.54
         pkb   = pkb.55
         sid   = sid.57
         z     = Y.48^ie.52
         %n    = %n.58
         z.1   = snd(snd(sdec(beta.49,
                              kdf_data(Y.48^ie.52,
                                       <'CDDS-AECDHE-full-v4', $S_a.44, $A.42, $S_b.45, $B.43, %n.58, sid.57, 
                                        pka.54, pkb.55, X.47, Y.48, h(Hash1.46)>))))
         z.2   = verify(fst(snd(sdec(beta.49,
                                     kdf_data(Y.48^ie.52,
                                              <'CDDS-AECDHE-full-v4', $S_a.44, $A.42, $S_b.45, $B.43, %n.58, 
                                               sid.57, pka.54, pkb.55, X.47, Y.48, h(Hash1.46)>)))),
                        <
                         fst(sdec(beta.49,
                                  kdf_data(Y.48^ie.52,
                                           <'CDDS-AECDHE-full-v4', $S_a.44, $A.42, $S_b.45, $B.43, %n.58, 
                                            sid.57, pka.54, pkb.55, X.47, Y.48, h(Hash1.46)>))), 
                         'CDDS-AECDHE-full-v4', $S_a.44, $A.42, $S_b.45, $B.43, %n.58, sid.57, 
                         pka.54, pkb.55, X.47, Y.48, h(Hash1.46)>,
                        pkb.55)
         z.3   = fst(sdec(beta.49,
                          kdf_data(Y.48^ie.52,
                                   <'CDDS-AECDHE-full-v4', $S_a.44, $A.42, $S_b.45, $B.43, %n.58, sid.57, 
                                    pka.54, pkb.55, X.47, Y.48, h(Hash1.46)>)))
    
      2. $A    = $A.42
         $B    = $B.43
         $S_a  = $S_a.44
         $S_b  = $S_b.45
         Hash1 = Hash1.46
         X     = X.47
         Y     = Y.48
         beta  = beta.49
         ie    = one
         pka   = pka.54
         pkb   = pkb.55
         sid   = sid.57
         z     = Y.48
         %n    = %n.58
         z.1   = snd(snd(sdec(beta.49,
                              kdf_data(Y.48,
                                       <'CDDS-AECDHE-full-v4', $S_a.44, $A.42, $S_b.45, $B.43, %n.58, sid.57, 
