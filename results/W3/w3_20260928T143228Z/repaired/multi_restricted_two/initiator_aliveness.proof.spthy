lemma reachable_session:
  exists-trace
  "∃ q I R e #b #c.
    ((W3Begin( q, I, R, e ) @ #b) ∧ (W3End( q, I, R, e ) @ #c)) ∧ (#b < #c)"
/*
guarded formula characterizing all satisfying traces:
"∃ q I R e #b #c.
  (W3Begin( q, I, R, e ) @ #b) ∧ (W3End( q, I, R, e ) @ #c) ∧ #b < #c"
*/
by sorry

lemma reachable_two_concurrent_sessions:
  exists-trace
  "∃ q1 q2 I R e #b1 #b2 #c1 #c2.
    ((((((((W3Begin( q1, I, R, e ) @ #b1) ∧ (W3Begin( q2, I, R, e ) @ #b2)) ∧
          (W3End( q1, I, R, e ) @ #c1)) ∧
         (W3End( q2, I, R, e ) @ #c2)) ∧
        (¬(q1 = q2))) ∧
       (#b1 < #b2)) ∧
      (#b2 < #c1)) ∧
     (#b2 < #c2)) ∧
    (¬(#c1 = #c2))"
/*
guarded formula characterizing all satisfying traces:
"∃ q1 q2 I R e #b1 #b2 #c1 #c2.
  (W3Begin( q1, I, R, e ) @ #b1) ∧
  (W3Begin( q2, I, R, e ) @ #b2) ∧
  (W3End( q1, I, R, e ) @ #c1) ∧
  (W3End( q2, I, R, e ) @ #c2)
 ∧
  (¬(q1 = q2)) ∧ (#b1 < #b2) ∧ (#b2 < #c1) ∧ (#b2 < #c2) ∧ (¬(#c1 = #c2))"
*/
by sorry

lemma initiator_aliveness:
  all-traces
  "∀ I R A B e sid x k T #c.
    (CommitInitiator( I, R, A, B, e, sid, x, k, T ) @ #c) ⇒
    (∃ I2 A2 B2 e2 sid2 x2 k2 T2 #r.
      (RunningResponder( R, I2, A2, B2, e2, sid2, x2, k2, T2 ) @ #r) ∧
      (#r < #c))"
/*
guarded formula characterizing all counter-examples:
"∃ I R A B e sid x k T #c.
  (CommitInitiator( I, R, A, B, e, sid, x, k, T ) @ #c)
 ∧
  ∀ I2 A2 B2 e2 sid2 x2 k2 T2 #r.
   (RunningResponder( R, I2, A2, B2, e2, sid2, x2, k2, T2 ) @ #r)
  ⇒
   ¬(#r < #c)"
*/
simplify
solve( St_Initiator_DH( $S_a, $S_b, $A, $B, %n, sid, ie, X, pka, ppka,
                        pk(x.1), iExposure
       ) ▶₁ #c )
  case Subject_Access_Request_case_1
  solve( !KU( senc(<x, 
                    sign(<x, 'CDDS-AECDHE-full-v4', 'requester', 'domain_A', 'owner', 
                          'domain_B', %1, ~sid, pk(~si), pk(~sr), 'g'^~ie, Y, h(Hash1)>,
                         ~sr), 
                    pk(~sr)>,
                   kdf_data(z,
                            <'CDDS-AECDHE-full-v4', 'requester', 'domain_A', 'owner', 'domain_B', 
                             %1, ~sid, pk(~si), pk(~sr), 'g'^~ie, Y, h(Hash1)>))
         ) @ #vk.5 )
    case Object_Data_Encryption
    by contradiction /* from formulas */
  next
    case c_senc
    solve( !KU( kdf_data(z,
                         <'CDDS-AECDHE-full-v4', 'requester', 'domain_A', 'owner', 'domain_B', 
                          %1, ~sid, pk(~si), pk(~sr), 'g'^~ie, Y, h(Hash1)>)
           ) @ #vk.23 )
      case c_kdf_data
      solve( !KU( sign(<x, 'CDDS-AECDHE-full-v4', 'requester', 'domain_A', 
                        'owner', 'domain_B', %1, ~sid, pk(~si), pk(~sr), 'g'^~ie, Y, h(Hash1)>,
                       ~sr)
             ) @ #vk.30 )
        case Object_Data_Encryption
        by contradiction /* from formulas */
      next
        case c_sign
        by solve( !KU( ~sr ) @ #vk.48 )
      qed
    qed
  qed
next
  case Subject_Access_Request_case_2
