                         'CDDS-AECDHE-full-v4', $S_a.44, $A.42, $S_b.45, $B.43, %n.58, sid.57, 
                         pka.54, pkb.55, X.47, Y.48, h(Hash1.46)>,
                        pkb.55)
         z.3   = fst(sdec(beta.49,
                          kdf_data(Y.48,
                                   <'CDDS-AECDHE-full-v4', $S_a.44, $A.42, $S_b.45, $B.43, %n.58, sid.57, 
                                    pka.54, pkb.55, X.47, Y.48, h(Hash1.46)>)))
    
      3. $A    = $A.42
         $B    = $B.43
         $S_a  = $S_a.44
         $S_b  = $S_b.45
         Hash1 = Hash1.46
         X     = X.47
         Y     = DH_neutral
         beta  = beta.49
         pka   = pka.54
         pkb   = pkb.55
         sid   = sid.57
         z     = DH_neutral
         %n    = %n.58
         z.1   = snd(snd(sdec(beta.49,
                              kdf_data(DH_neutral,
                                       <'CDDS-AECDHE-full-v4', $S_a.44, $A.42, $S_b.45, $B.43, %n.58, sid.57, 
