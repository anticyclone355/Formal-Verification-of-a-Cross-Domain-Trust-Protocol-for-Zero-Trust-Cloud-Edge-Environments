                                           <'CDDS-AECDHE-full-v4', $S_a.44, $A.42, $S_b.45, $B.43, %n.58, 
                                            sid.57, pka.54, pkb.55, X.47, DH_neutral, h(Hash1.46)>))), 
                         'CDDS-AECDHE-full-v4', $S_a.44, $A.42, $S_b.45, $B.43, %n.58, sid.57, 
                         pka.54, pkb.55, X.47, DH_neutral, h(Hash1.46)>,
                        pkb.55)
         z.3   = fst(sdec(beta.49,
                          kdf_data(DH_neutral,
                                   <'CDDS-AECDHE-full-v4', $S_a.44, $A.42, $S_b.45, $B.43, %n.58, sid.57, 
                                    pka.54, pkb.55, X.47, DH_neutral, h(Hash1.46)>)))
    
      4. $A    = $A.45
         $B    = $B.46
         $S_a  = $S_a.47
         $S_b  = $S_b.48
         Hash1 = Hash1.49
         X     = X.50
         Y     = z.64^inv(ie.55)
         beta  = beta.52
         ie    = ie.55
         pka   = pka.57
         pkb   = pkb.58
         sid   = sid.60
         z     = z.64
         %n    = %n.61
         z.1   = snd(snd(sdec(beta.52,
                              kdf_data(z.64,
                                       <'CDDS-AECDHE-full-v4', $S_a.47, $A.45, $S_b.48, $B.46, %n.61, sid.60, 
                                        pka.57, pkb.58, X.50, z.64^inv(ie.55), h(Hash1.49)>))))
         z.2   = verify(fst(snd(sdec(beta.52,
                                     kdf_data(z.64,
                                              <'CDDS-AECDHE-full-v4', $S_a.47, $A.45, $S_b.48, $B.46, %n.61, 
                                               sid.60, pka.57, pkb.58, X.50, z.64^inv(ie.55), h(Hash1.49)
                                              >)))),
                        <
                         fst(sdec(beta.52,
                                  kdf_data(z.64,
                                           <'CDDS-AECDHE-full-v4', $S_a.47, $A.45, $S_b.48, $B.46, %n.61, 
                                            sid.60, pka.57, pkb.58, X.50, z.64^inv(ie.55), h(Hash1.49)>))), 
                         'CDDS-AECDHE-full-v4', $S_a.47, $A.45, $S_b.48, $B.46, %n.61, sid.60, 
                         pka.57, pkb.58, X.50, z.64^inv(ie.55), h(Hash1.49)>,
                        pkb.58)
         z.3   = fst(sdec(beta.52,
                          kdf_data(z.64,
                                   <'CDDS-AECDHE-full-v4', $S_a.47, $A.45, $S_b.48, $B.46, %n.61, sid.60, 
                                    pka.57, pkb.58, X.50, z.64^inv(ie.55), h(Hash1.49)>)))
    
      5. $A    = $A.75
         $B    = $B.76
         $S_a  = $S_a.77
         $S_b  = $S_b.78
         Hash1 = Hash1.79
         X     = X.80
         Y     = z.94^x.148
         beta  = beta.82
         ie    = inv(x.148)
         pka   = pka.87
         pkb   = pkb.88
         sid   = sid.90
         z     = z.94
         %n    = %n.91
