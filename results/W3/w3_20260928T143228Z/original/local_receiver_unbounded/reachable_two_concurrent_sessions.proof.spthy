theory W3_original_Concurrent_Agreement begin

// Function signature and definition of the equational theory E

builtins: natural-numbers
functions: PDec/2, PEnc/3, fst/1, h/1, pair/2, pk/1, ppk/1, sdec/2,
           senc/2, sign/2, snd/1, true/0, verify/3
equations:
    PDec(psk, PEnc(ppk(psk), k, r)) = k,
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true













restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction W3_OneSetup:
  "∀ #i #j. ((W3Init( ) @ #i) ∧ (W3Init( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

rule (modulo E) W3_Setup:
   [ Fr( ~si ), Fr( ~pi ), Fr( ~sr ), Fr( ~pr ), Fr( ~da ), Fr( ~db ) ]
  --[ W3Init( ) ]->
   [
   !Subject( 'requester', 'domain_A', %1, ~si, ~pi, pk(~si), ppk(~pi) ),
   !Subject( 'owner', 'domain_B', %1, ~sr, ~pr, pk(~sr), ppk(~pr) ),
   !Domain( 'domain_A', %1, ~da, pk(~da) ),
   !Domain( 'domain_B', %1, ~db, pk(~db) ),
   !Policy( 'domain_A', 'domain_B', %1, 'requester', 'owner', '1' ),
   !W3Ready( 'requester', 'owner', 'domain_A', 'domain_B', %1 ),
   W3Budget( ), W3Budget( ), Out( <pk(~si), ppk(~pi), %1, 'Subject Pk'> ),
   Out( <pk(~sr), ppk(~pr), %1, 'Subject Pk'> ),
   Out( <<pk(~si), ppk(~pi), %1>, sign(<pk(~si), ppk(~pi), %1>, ~da), 
         pk(~da), 'SubjectCert'>
   ),
   Out( <<pk(~sr), ppk(~pr), %1>, sign(<pk(~sr), ppk(~pr), %1>, ~db), 
         pk(~db), 'SubjectCert'>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Subject_Access_Request[role=Authentication_and_Data_Sharing]:
   [
   !W3Ready( $S_a, $S_b, $A, $B, %n ), Fr( ~rid ),
   !Subject( $S_a, $A, %n, pska, ppska, pka, ppka ),
   !Subject( $S_b, $B, %n, pskb, ppskb, pkb, ppkb ),
   !Domain( $A, %n, gskA, gpkA ), !Domain( $B, %n, gskB, gpkB ),
   In( <CertA, CertaSign, SignPk, field> )
   ]
  --[
  Eq( field, 'SubjectCert' ), Eq( SignPk, gpkA ),
  Eq( verify(CertaSign, CertA, gpkA), true ), Eq( fst(CertA), pka ),
  Eq( fst(snd(CertA)), ppka ), Eq( snd(snd(CertA)), %n ),
  W3Begin( ~rid, $S_a, $S_b, %n ),
  AccessRequest( $S_a, $S_b, %n, $A, $B, pska, pskb, gskA )
  ]->
   [
   Out( <<<CertA, CertaSign, SignPk>, pkb, %n>, 
         sign(<<CertA, CertaSign, SignPk>, pkb, %n>, pska), pka, 'AccessR_a'>
   ),
   St_LocalReceiver( $S_a, $S_b, %n, ppska, pkb, ~rid ),
   Access_send( $S_a, $S_b, %n, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB,
                ppka, ~rid
   )
   ]

  /*
  rule (modulo AC) Subject_Access_Request[role=Authentication_and_Data_Sharing]:
     [
     !W3Ready( $S_a, $S_b, $A, $B, %n ), Fr( ~rid ),
     !Subject( $S_a, $A, %n, pska, ppska, pka, ppka ),
     !Subject( $S_b, $B, %n, pskb, ppskb, pkb, ppkb ),
     !Domain( $A, %n, gskA, gpkA ), !Domain( $B, %n, gskB, gpkB ),
     In( <CertA, CertaSign, SignPk, field> )
     ]
    --[
    Eq( field, 'SubjectCert' ), Eq( SignPk, gpkA ), Eq( z, true ),
    Eq( z.1, pka ), Eq( z.2, ppka ), Eq( z.3, %n ),
    W3Begin( ~rid, $S_a, $S_b, %n ),
    AccessRequest( $S_a, $S_b, %n, $A, $B, pska, pskb, gskA )
    ]->
     [
     Out( <<<CertA, CertaSign, SignPk>, pkb, %n>, 
           sign(<<CertA, CertaSign, SignPk>, pkb, %n>, pska), pka, 'AccessR_a'>
     ),
     St_LocalReceiver( $S_a, $S_b, %n, ppska, pkb, ~rid ),
     Access_send( $S_a, $S_b, %n, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB,
                  ppka, ~rid
     )
     ]
    variants (modulo AC)
    1. CertA = CertA.34
       CertaSign
             = CertaSign.35
       gpkA  = gpkA.38
       z     = verify(CertaSign.35, CertA.34, gpkA.38)
       z.1   = fst(CertA.34)
       z.2   = fst(snd(CertA.34))
       z.3   = snd(snd(CertA.34))
    
    2. CertA = CertA.54
       CertaSign
             = sign(CertA.54, x.101)
       gpkA  = pk(x.101)
       z     = true
       z.1   = fst(CertA.54)
       z.2   = fst(snd(CertA.54))
       z.3   = snd(snd(CertA.54))
    
    3. CertA = <z.35, x.42>
       CertaSign
             = sign(<z.35, x.42>, x.43)
       gpkA  = pk(x.43)
       z     = true
       z.1   = z.35
       z.2   = fst(x.42)
       z.3   = snd(x.42)
    
    4. CertA = <z.36, z.37, z.38>
       CertaSign
             = sign(<z.36, z.37, z.38>, x.45)
       gpkA  = pk(x.45)
       z     = true
       z.1   = z.36
       z.2   = z.37
       z.3   = z.38
    
    5. CertA = <z.70, z.71, z.72>
       CertaSign
             = CertaSign.51
       gpkA  = gpkA.54
       z     = verify(CertaSign.51, <z.70, z.71, z.72>, gpkA.54)
       z.1   = z.70
       z.2   = z.71
       z.3   = z.72
    
    6. CertA = <z.72, x.98>
       CertaSign
             = CertaSign.53
       gpkA  = gpkA.56
       z     = verify(CertaSign.53, <z.72, x.98>, gpkA.56)
       z.1   = z.72
       z.2   = fst(x.98)
       z.3   = snd(x.98)
  */

rule (modulo E) Domain_Access_Verification[role=Authentication_and_Data_Sharing]:
   [
   In( <AccessRa, AccesssSign, AccessPKa, field> ),
   Access_send( $S_a, $S_b, %n, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB,
                ppka, rid
   ),
   !Policy( $A, $B, %n, $S_a, $S_b, bit ),
   !Subject( $S_b, $B, %n, pskb, ppskb, pkb, ppkb )
   ]
  --[
  Eq( field, 'AccessR_a' ), Eq( pka, AccessPKa ),
  Eq( verify(AccesssSign, AccessRa, pka), true ),
  Eq( fst(snd(AccessRa)), pkb ), Eq( snd(snd(AccessRa)), %n ),
  Eq( bit, '1' ), AccessGranted( $S_a, $S_b, %n, pka, pkb, bit )
  ]->
   [
   Out( <h(<pka, pkb, %n>), sign(h(<pka, pkb, %n>), gskB), pk(gskB), 
         'AccessCert_ab'>
   ),
   AccessCert_send( $S_a, $S_b, %n, pka, pkb, pskb, ppka, $A, $B, gpkA,
                    gpkB, rid
   )
   ]

  /*
  rule (modulo AC) Domain_Access_Verification[role=Authentication_and_Data_Sharing]:
     [
     In( <AccessRa, AccesssSign, AccessPKa, field> ),
     Access_send( $S_a, $S_b, %n, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB,
                  ppka, rid
     ),
     !Policy( $A, $B, %n, $S_a, $S_b, bit ),
     !Subject( $S_b, $B, %n, pskb, ppskb, pkb, ppkb )
     ]
    --[
    Eq( field, 'AccessR_a' ), Eq( pka, AccessPKa ), Eq( z, true ),
    Eq( z.1, pkb ), Eq( z.2, %n ), Eq( bit, '1' ),
    AccessGranted( $S_a, $S_b, %n, pka, pkb, bit )
    ]->
     [
     Out( <h(<pka, pkb, %n>), sign(h(<pka, pkb, %n>), gskB), pk(gskB), 
           'AccessCert_ab'>
     ),
     AccessCert_send( $S_a, $S_b, %n, pka, pkb, pskb, ppka, $A, $B, gpkA,
                      gpkB, rid
     )
     ]
    variants (modulo AC)
    1. AccessRa
             = AccessRa.36
       AccesssSign
             = AccesssSign.37
       pka   = pka.44
       z     = verify(AccesssSign.37, AccessRa.36, pka.44)
       z.1   = fst(snd(AccessRa.36))
       z.2   = snd(snd(AccessRa.36))
    
    2. AccessRa
             = AccessRa.73
       AccesssSign
             = sign(AccessRa.73, x.139)
       pka   = pk(x.139)
       z     = true
       z.1   = fst(snd(AccessRa.73))
       z.2   = snd(snd(AccessRa.73))
    
    3. AccessRa
             = <x.30, x.31>
       AccesssSign
             = sign(<x.30, x.31>, x.32)
       pka   = pk(x.32)
       z     = true
       z.1   = fst(x.31)
       z.2   = snd(x.31)
    
    4. AccessRa
             = <x.45, z.37, z.38>
       AccesssSign
             = sign(<x.45, z.37, z.38>, x.48)
       pka   = pk(x.48)
       z     = true
       z.1   = z.37
       z.2   = z.38
    
    5. AccessRa
             = <x.132, z.88, z.89>
       AccesssSign
             = AccesssSign.70
       pka   = pka.77
       z     = verify(AccesssSign.70, <x.132, z.88, z.89>, pka.77)
       z.1   = z.88
       z.2   = z.89
    
    6. AccessRa
             = <x.133, x.134>
       AccesssSign
             = AccesssSign.71
       pka   = pka.78
       z     = verify(AccesssSign.71, <x.133, x.134>, pka.78)
       z.1   = fst(x.134)
       z.2   = snd(x.134)
  */

rule (modulo E) Object_Data_Encryption[role=Authentication_and_Data_Sharing]:
   [
   In( <Hash1, Hashsign, Hashpk, field> ),
   AccessCert_send( $S_a, $S_b, %n, pka, pkb, pskb, ppka, $A, $B, gpkA,
                    gpkB, rid
   ),
   !Subject( $S_a, $A, %n, pska, ppska, pka, ppka ),
   !Subject( $S_b, $B, %n, pskb, ppskb, pkb, ppkb ), Fr( ~x ), Fr( ~k ),
   Fr( ~v )
   ]
  --[
  Eq( field, 'AccessCert_ab' ), Eq( gpkB, Hashpk ),
  Eq( verify(Hashsign, Hash1, gpkB), true ),
  Eq( Hash1, h(<pka, pkb, %n>) ), W3Running( $S_a, $S_b, %n, ~x, ~k ),
  W3DataSent( $S_a, $S_b, %n, ~x, PEnc(ppka, ~k, ~v),
              senc(<~x, sign(~x, pskb), pk(pskb)>, ~k)
  ),
  DataSent( $S_b, $S_a, %n, pskb, ppka, pka, ~x, ~k ), Secret( ~x, %n ),
  SessionKey( ~k, %n ), Honest( $S_a, %n ), Honest( $S_b, %n )
  ]->
   [
   Out( <PEnc(ppka, ~k, ~v), senc(<~x, sign(~x, pskb), pk(pskb)>, ~k), 
         'data'>
   )
   ]

  /*
  rule (modulo AC) Object_Data_Encryption[role=Authentication_and_Data_Sharing]:
     [
     In( <Hash1, Hashsign, Hashpk, field> ),
     AccessCert_send( $S_a, $S_b, %n, pka, pkb, pskb, ppka, $A, $B, gpkA,
                      gpkB, rid
     ),
     !Subject( $S_a, $A, %n, pska, ppska, pka, ppka ),
     !Subject( $S_b, $B, %n, pskb, ppskb, pkb, ppkb ), Fr( ~x ), Fr( ~k ),
     Fr( ~v )
     ]
    --[
    Eq( field, 'AccessCert_ab' ), Eq( gpkB, Hashpk ), Eq( z, true ),
    Eq( Hash1, h(<pka, pkb, %n>) ), W3Running( $S_a, $S_b, %n, ~x, ~k ),
    W3DataSent( $S_a, $S_b, %n, ~x, PEnc(ppka, ~k, ~v),
                senc(<~x, sign(~x, pskb), pk(pskb)>, ~k)
    ),
    DataSent( $S_b, $S_a, %n, pskb, ppka, pka, ~x, ~k ), Secret( ~x, %n ),
    SessionKey( ~k, %n ), Honest( $S_a, %n ), Honest( $S_b, %n )
    ]->
     [
     Out( <PEnc(ppka, ~k, ~v), senc(<~x, sign(~x, pskb), pk(pskb)>, ~k), 
           'data'>
     )
     ]
    variants (modulo AC)
    1. Hash1 = Hash1.33
       Hashsign
             = Hashsign.35
       gpkB  = gpkB.38
       z     = verify(Hashsign.35, Hash1.33, gpkB.38)
    
    2. Hash1 = Hash1.49
       Hashsign
             = sign(Hash1.49, x.89)
       gpkB  = pk(x.89)
       z     = true
  */

rule (modulo E) Subject_Data_Decryption[role=Authentication_and_Data_Sharing]:
   [
   In( <alpha, beta, field> ),
   St_LocalReceiver( $S_a, $S_b, %n, ppska, pkb, rid )
   ]
  --[
  Eq( field, 'data' ), Eq( snd(snd(sdec(beta, PDec(ppska, alpha)))), pkb ),
  Eq( verify(fst(snd(sdec(beta, PDec(ppska, alpha)))),
             fst(sdec(beta, PDec(ppska, alpha))), pkb),
      true
  ),
  W3End( rid, $S_a, $S_b, %n ),
  W3Commit( $S_a, $S_b, %n, fst(sdec(beta, PDec(ppska, alpha))),
            PDec(ppska, alpha)
  ),
  W3DataAccepted( $S_a, $S_b, %n, fst(sdec(beta, PDec(ppska, alpha))),
                  alpha, beta
  ),
  DataReceive( $S_b, $S_a, %n, alpha, beta, ppska, pkb, PDec(ppska, alpha),
               fst(sdec(beta, PDec(ppska, alpha)))
  )
  ]->
   [ ]

  /*
  rule (modulo AC) Subject_Data_Decryption[role=Authentication_and_Data_Sharing]:
     [
     In( <alpha, beta, field> ),
     St_LocalReceiver( $S_a, $S_b, %n, ppska, pkb, rid )
     ]
    --[
    Eq( field, 'data' ), Eq( z, pkb ), Eq( z.1, true ),
    W3End( rid, $S_a, $S_b, %n ), W3Commit( $S_a, $S_b, %n, z.2, z.3 ),
    W3DataAccepted( $S_a, $S_b, %n, z.2, alpha, beta ),
    DataReceive( $S_b, $S_a, %n, alpha, beta, ppska, pkb, z.3, z.2 )
    ]->
     [ ]
    variants (modulo AC)
     1. alpha = alpha.16
        beta  = beta.17
        pkb   = pkb.19
        ppska = ppska.20
        z     = snd(snd(sdec(beta.17, PDec(ppska.20, alpha.16))))
        z.1   = verify(fst(snd(sdec(beta.17, PDec(ppska.20, alpha.16)))),
                       fst(sdec(beta.17, PDec(ppska.20, alpha.16))), pkb.19)
        z.2   = fst(sdec(beta.17, PDec(ppska.20, alpha.16)))
        z.3   = PDec(ppska.20, alpha.16)
    
     2. alpha = alpha.19
        beta  = senc(x.32, PDec(ppska.23, alpha.19))
        pkb   = pkb.22
        ppska = ppska.23
        z     = snd(snd(x.32))
        z.1   = verify(fst(snd(x.32)), fst(x.32), pkb.22)
        z.2   = fst(x.32)
        z.3   = PDec(ppska.23, alpha.19)
    
     3. alpha = alpha.20
        beta  = senc(<z.30, x.34>, PDec(ppska.24, alpha.20))
        pkb   = pkb.23
        ppska = ppska.24
        z     = snd(x.34)
        z.1   = verify(fst(x.34), z.30, pkb.23)
        z.2   = z.30
        z.3   = PDec(ppska.24, alpha.20)
    
     4. alpha = alpha.20
        beta  = senc(<z.30, sign(z.30, x.34), z.28>, PDec(ppska.24, alpha.20))
        pkb   = pk(x.34)
        ppska = ppska.24
        z     = z.28
        z.1   = true
        z.2   = z.30
        z.3   = PDec(ppska.24, alpha.20)
    
     5. alpha = alpha.21
        beta  = senc(<z.31, x.35, z.29>, PDec(ppska.25, alpha.21))
        pkb   = pkb.24
        ppska = ppska.25
        z     = z.29
        z.1   = verify(x.35, z.31, pkb.24)
        z.2   = z.31
        z.3   = PDec(ppska.25, alpha.21)
    
     6. alpha = PEnc(ppk(ppska.21), z.28, x.31)
        beta  = senc(x.32, z.28)
        pkb   = pkb.20
        ppska = ppska.21
        z     = snd(snd(x.32))
        z.1   = verify(fst(snd(x.32)), fst(x.32), pkb.20)
        z.2   = fst(x.32)
        z.3   = z.28
    
     7. alpha = PEnc(ppk(ppska.21), z.28, x.31)
        beta  = senc(<z.27, sign(z.27, x.33), z.25>, z.28)
        pkb   = pk(x.33)
        ppska = ppska.21
        z     = z.25
        z.1   = true
        z.2   = z.27
        z.3   = z.28
    
     8. alpha = PEnc(ppk(ppska.22), z.29, x.32)
        beta  = beta.19
        pkb   = pkb.21
        ppska = ppska.22
        z     = snd(snd(sdec(beta.19, z.29)))
        z.1   = verify(fst(snd(sdec(beta.19, z.29))), fst(sdec(beta.19, z.29)),
                       pkb.21)
        z.2   = fst(sdec(beta.19, z.29))
        z.3   = z.29
    
     9. alpha = PEnc(ppk(ppska.22), z.29, x.32)
        beta  = senc(<z.28, x.34>, z.29)
        pkb   = pkb.21
        ppska = ppska.22
        z     = snd(x.34)
        z.1   = verify(fst(x.34), z.28, pkb.21)
        z.2   = z.28
        z.3   = z.29
    
    10. alpha = PEnc(ppk(ppska.23), z.30, x.33)
        beta  = senc(<z.29, x.35, z.27>, z.30)
        pkb   = pkb.22
        ppska = ppska.23
        z     = z.27
        z.1   = verify(x.35, z.29, pkb.22)
        z.2   = z.29
        z.3   = z.30
  */

lemma reachable_session:
  exists-trace
  "∃ q I R e #b #c.
    ((W3Begin( q, I, R, e ) @ #b) ∧ (W3End( q, I, R, e ) @ #c)) ∧ (#b < #c)"
/*
guarded formula characterizing all satisfying traces:
"∃ q I R e #b #c.
  (W3Begin( q, I, R, e ) @ #b) ∧ (W3End( q, I, R, e ) @ #c) ∧ #b < #c"
*/
by sorry

lemma reachable_two_concurrent_sessions:
  exists-trace
  "∃ q1 q2 I R e #b1 #b2 #c1 #c2.
    ((((((((W3Begin( q1, I, R, e ) @ #b1) ∧ (W3Begin( q2, I, R, e ) @ #b2)) ∧
          (W3End( q1, I, R, e ) @ #c1)) ∧
         (W3End( q2, I, R, e ) @ #c2)) ∧
        (¬(q1 = q2))) ∧
       (#b1 < #b2)) ∧
      (#b2 < #c1)) ∧
     (#b2 < #c2)) ∧
    (¬(#c1 = #c2))"
/*
guarded formula characterizing all satisfying traces:
"∃ q1 q2 I R e #b1 #b2 #c1 #c2.
  (W3Begin( q1, I, R, e ) @ #b1) ∧
  (W3Begin( q2, I, R, e ) @ #b2) ∧
  (W3End( q1, I, R, e ) @ #c1) ∧
  (W3End( q2, I, R, e ) @ #c2)
 ∧
  (¬(q1 = q2)) ∧ (#b1 < #b2) ∧ (#b2 < #c1) ∧ (#b2 < #c2) ∧ (¬(#c1 = #c2))"
*/
simplify
solve( (#c1 < #c2)  ∥ (#c2 < #c1) )
  case case_1
  solve( !W3Ready( $S_a, $S_b, $A, $B, %n ) ▶₀ #b1 )
    case W3_Setup
    solve( !Subject( 'requester', 'domain_A', %1, pska, ppska, pka, ppka
           ) ▶₂ #b1 )
      case W3_Setup
      solve( !Subject( 'owner', 'domain_B', %1, pskb, ppskb, pkb, ppkb
             ) ▶₃ #b1 )
        case W3_Setup
        solve( !Domain( 'domain_A', %1, gskA, pk(x) ) ▶₄ #b1 )
          case W3_Setup
          solve( !Domain( 'domain_B', %1, gskB, gpkB ) ▶₅ #b1 )
            case W3_Setup
            solve( !W3Ready( 'requester', 'owner', $A, $B, %1 ) ▶₀ #b2 )
              case W3_Setup
              solve( !Subject( 'requester', 'domain_A', %1, pska, ppska, pka, ppka
                     ) ▶₂ #b2 )
                case W3_Setup
                solve( !Subject( 'owner', 'domain_B', %1, pskb, ppskb, pkb, ppkb
                       ) ▶₃ #b2 )
                  case W3_Setup
                  solve( !Domain( 'domain_A', %1, gskA, pk(x) ) ▶₄ #b2 )
                    case W3_Setup
                    solve( !Domain( 'domain_B', %1, gskB, gpkB ) ▶₅ #b2 )
                      case W3_Setup
                      solve( St_LocalReceiver( 'requester', 'owner', %1, ppska, pk(x), ~rid
                             ) ▶₁ #c1 )
                        case Subject_Access_Request
                        solve( St_LocalReceiver( 'requester', 'owner', %1, ppska, pk(x), ~rid.1
                               ) ▶₁ #c2 )
                          case Subject_Access_Request
                          solve( splitEqs(2) )
                            case split_case_2
                            solve( splitEqs(3) )
                              case split_case_2
                              solve( !KU( senc(<z.1, sign(z.1, ~sr), pk(~sr)>, z) ) @ #vk.10 )
                                case Object_Data_Encryption
