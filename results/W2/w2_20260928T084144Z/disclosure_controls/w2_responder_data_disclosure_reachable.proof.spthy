lemma w2_pending_ephemeral_disclosure_reachable:
  exists-trace
  "∃ I R e sid #request #reveal #accept x k T.
    ((((((W2Request( I, R, e, sid ) @ #request) ∧
         (W2EphemeralReveal( 'initiator', sid ) @ #reveal)) ∧
        (W2StateUse( 'initiator', I, R, e, sid, 'pending' ) @ #reveal)) ∧
       (W2Accepted( I, R, e, sid, x, k, T ) @ #accept)) ∧
      (#request < #reveal)) ∧
     (#reveal < #accept)) ∧
    (¬(∃ kind p epoch #lt. W2LtkReveal( kind, p, epoch ) @ #lt))"
/*
guarded formula characterizing all satisfying traces:
"∃ I R e sid #request #reveal #accept x k T.
  (W2Request( I, R, e, sid ) @ #request) ∧
  (W2EphemeralReveal( 'initiator', sid ) @ #reveal) ∧
  (W2StateUse( 'initiator', I, R, e, sid, 'pending' ) @ #reveal) ∧
  (W2Accepted( I, R, e, sid, x, k, T ) @ #accept)
 ∧
  (#request < #reveal) ∧
  (#reveal < #accept) ∧
  (∀ kind p epoch #lt. (W2LtkReveal( kind, p, epoch ) @ #lt) ⇒ ⊥)"
*/
by sorry

lemma w2_initiator_independent_oracles_forward:
  exists-trace
  "∃ I R e sid kd kc #ep #data #conf #erase.
    ((((((((W2EphemeralReveal( 'initiator', sid ) @ #ep) ∧
           (W2SessionKeyReveal( 'initiator', sid, kd ) @ #data)) ∧
          (RevealConfirmationKey( 'initiator', I, R, e, sid, kc ) @ #conf)) ∧
         (LocalErased( 'initiator', I, R, e, sid ) @ #erase)) ∧
        (#ep < #data)) ∧
       (#data < #conf)) ∧
      (#ep < #erase)) ∧
     (#data < #erase)) ∧
    (#conf < #erase)"
/*
guarded formula characterizing all satisfying traces:
"∃ I R e sid kd kc #ep #data #conf #erase.
  (W2EphemeralReveal( 'initiator', sid ) @ #ep) ∧
  (W2SessionKeyReveal( 'initiator', sid, kd ) @ #data) ∧
  (RevealConfirmationKey( 'initiator', I, R, e, sid, kc ) @ #conf) ∧
  (LocalErased( 'initiator', I, R, e, sid ) @ #erase)
 ∧
  (#ep < #data) ∧
  (#data < #conf) ∧
  (#ep < #erase) ∧
  (#data < #erase) ∧
  (#conf < #erase)"
*/
by sorry

