lemma w2_initiator_ephemeral_disclosure_reachable:
  exists-trace
  "∃ I R A B e sid T beta kd kc tag x #send #accept #reveal #local #erase
     #learn.
    ((((((((((((((W2Sent( I, R, e, sid, x, kd, T ) @ #send) ∧
                 (ConfirmationAccepted( I, R, A, B, e, sid, T, beta, kd, kc, tag
                  ) @ #accept)) ∧
                (W2EphemeralReveal( 'initiator', sid ) @ #reveal)) ∧
               (LocalErased( 'initiator', I, R, e, sid ) @ #local)) ∧
              (SessionErased( I, R, e, sid ) @ #erase)) ∧
             (K( x ) @ #learn)) ∧
            (#send < #accept)) ∧
           (#accept < #erase)) ∧
          (#reveal < #local)) ∧
         (#local < #erase)) ∧
        (#erase < #learn)) ∧
       (¬(∃ kind p epoch #lt. W2LtkReveal( kind, p, epoch ) @ #lt))) ∧
      (¬(∃ #ep. W2EphemeralReveal( 'responder', sid ) @ #ep))) ∧
     (¬(∃ r handle secret #dk.
         W2SessionKeyReveal( r, handle, secret ) @ #dk))) ∧
    (¬(∃ r p q epoch handle secret #ck.
        RevealConfirmationKey( r, p, q, epoch, handle, secret ) @ #ck))"
/*
guarded formula characterizing all satisfying traces:
"∃ I R A B e sid T beta kd kc tag x #send #accept #reveal #local #erase
   #learn.
  (W2Sent( I, R, e, sid, x, kd, T ) @ #send) ∧
  (ConfirmationAccepted( I, R, A, B, e, sid, T, beta, kd, kc, tag
   ) @ #accept) ∧
  (W2EphemeralReveal( 'initiator', sid ) @ #reveal) ∧
  (LocalErased( 'initiator', I, R, e, sid ) @ #local) ∧
  (SessionErased( I, R, e, sid ) @ #erase) ∧
  (K( x ) @ #learn)
 ∧
  (#send < #accept) ∧
  (#accept < #erase) ∧
  (#reveal < #local) ∧
  (#local < #erase) ∧
  (#erase < #learn) ∧
  (∀ kind p epoch #lt. (W2LtkReveal( kind, p, epoch ) @ #lt) ⇒ ⊥) ∧
  (∀ #ep. (W2EphemeralReveal( 'responder', sid ) @ #ep) ⇒ ⊥) ∧
  (∀ r handle secret #dk.
    (W2SessionKeyReveal( r, handle, secret ) @ #dk) ⇒ ⊥) ∧
  (∀ r p q epoch handle secret #ck.
    (RevealConfirmationKey( r, p, q, epoch, handle, secret ) @ #ck) ⇒ ⊥)"
*/
by sorry

