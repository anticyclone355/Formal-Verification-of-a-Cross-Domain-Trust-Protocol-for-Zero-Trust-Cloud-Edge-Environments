lemma w2_responder_data_disclosure_reachable:
  exists-trace
  "∃ I R A B e sid T beta kd kc tag x #send #accept #reveal #local #erase
     #learn.
    ((((((((((((((W2Sent( I, R, e, sid, x, kd, T ) @ #send) ∧
                 (ConfirmationAccepted( I, R, A, B, e, sid, T, beta, kd, kc, tag
                  ) @ #accept)) ∧
                (W2SessionKeyReveal( 'responder', sid, kd ) @ #reveal)) ∧
               (LocalErased( 'responder', I, R, e, sid ) @ #local)) ∧
              (SessionErased( I, R, e, sid ) @ #erase)) ∧
             (K( x ) @ #learn)) ∧
            (#send < #accept)) ∧
           (#accept < #erase)) ∧
          (#reveal < #local)) ∧
         (#local < #erase)) ∧
        (#erase < #learn)) ∧
       (¬(∃ kind p epoch #lt. W2LtkReveal( kind, p, epoch ) @ #lt))) ∧
      (¬(∃ r handle #ep. W2EphemeralReveal( r, handle ) @ #ep))) ∧
     (¬(∃ secret #dk.
         W2SessionKeyReveal( 'initiator', sid, secret ) @ #dk))) ∧
    (¬(∃ r p q epoch handle secret #ck.
        RevealConfirmationKey( r, p, q, epoch, handle, secret ) @ #ck))"
/*
guarded formula characterizing all satisfying traces:
"∃ I R A B e sid T beta kd kc tag x #send #accept #reveal #local #erase
   #learn.
  (W2Sent( I, R, e, sid, x, kd, T ) @ #send) ∧
  (ConfirmationAccepted( I, R, A, B, e, sid, T, beta, kd, kc, tag
   ) @ #accept) ∧
  (W2SessionKeyReveal( 'responder', sid, kd ) @ #reveal) ∧
  (LocalErased( 'responder', I, R, e, sid ) @ #local) ∧
  (SessionErased( I, R, e, sid ) @ #erase) ∧
  (K( x ) @ #learn)
 ∧
  (#send < #accept) ∧
  (#accept < #erase) ∧
  (#reveal < #local) ∧
  (#local < #erase) ∧
  (#erase < #learn) ∧
  (∀ kind p epoch #lt. (W2LtkReveal( kind, p, epoch ) @ #lt) ⇒ ⊥) ∧
  (∀ r handle #ep. (W2EphemeralReveal( r, handle ) @ #ep) ⇒ ⊥) ∧
  (∀ secret #dk.
    (W2SessionKeyReveal( 'initiator', sid, secret ) @ #dk) ⇒ ⊥) ∧
  (∀ r p q epoch handle secret #ck.
    (RevealConfirmationKey( r, p, q, epoch, handle, secret ) @ #ck) ⇒ ⊥)"
*/
simplify
solve( AccessCert_send( $S_a, $S_b, %n, pka, pk(x), pskb, ppka, $A, $B,
                        gpkA, pk(x.1)
       ) ▶₁ #send )
  case Domain_Access_Verification
  solve( !Subject( 'requester', 'domain_A', %1, pska, ppska, pk(~si),
                   ppk(~pi)
         ) ▶₂ #send )
    case W2_Setup
    solve( !Subject( 'owner', 'domain_B', %1, ~sr, ppskb, pk(~sr), ppkb
           ) ▶₃ #send )
      case W2_Setup
      solve( St_Initiator_DH( 'requester', 'owner', 'domain_A', 'domain_B', %1,
                              sid, ie, X, pk(~si), ppka, pk(~sr), iExposure
             ) ▶₁ #accept )
        case Subject_Access_Request
        solve( InitErased( 'requester', 'owner', %1, ~sid ) ▶₀ #erase )
          case Initiator_Erase_Ephemeral_case_1
          solve( RespErased( 'requester', 'owner', %1, ~sid ) ▶₁ #erase )
            case Responder_Erase_Ephemeral_case_5
            solve( W2SessionKeyReveal( 'responder', ~sid,
                                       kdf_data('g'^(~ie*~re),
                                                <'CDDS-AECDHE-full-v4', 'requester', 'domain_A', 'owner', 
                                                 'domain_B', %1, ~sid, pk(~si), pk(~sr), 'g'^~ie, 'g'^~re, 
                                                 h(h(<pk(~si), pk(~sr), %1, ~sid, 'g'^~ie>))>)
                   ) @ #reveal )
              case Reveal_Responder_SessionKey
              solve( W2_KeyRevealAvailable( 'responder', ~sid ) ▶₁ #reveal )
                case Object_Data_Encryption
                solve( LocalErased( 'responder', 'requester', 'owner', %1, ~sid
                       ) @ #local )
                  case Responder_Erase_Ephemeral
                  solve( St_Responder_PreErase( 'requester', 'owner', $A, $B, %1, ~sid,
                                                re.1, k, kc, msg.1, transcript, rExposure
                         ) ▶₀ #local )
                    case Reveal_Responder_SessionKey
                    solve( !KU( ~msg ) @ #vk.20 )
                      case Object_Data_Encryption
                      solve( splitEqs(3) )
                        case split_case_2
                        solve( !KU( sign(h(<pk(~si), pk(~sr), %1, ~sid, 'g'^~ie>), ~db)
                               ) @ #vk.9 )
                          case Domain_Access_Verification
                          solve( !KU( sign(<x, pk(~sr), %1, ~sid, 'g'^~ie>, ~si) ) @ #vk.25 )
                            case Subject_Access_Request
                            solve( !KU( senc(<z, 
                                              sign(<z, 'CDDS-AECDHE-full-v4', 'requester', 'domain_A', 
                                                    'owner', 'domain_B', %1, ~sid, pk(~si), pk(~sr), 'g'^~ie, 
                                                    'g'^~re, h(h(<pk(~si), pk(~sr), %1, ~sid, 'g'^~ie>))>,
                                                   ~sr), 
                                              pk(~sr)>,
                                             kdf_data('g'^(~ie*~re),
                                                      <'CDDS-AECDHE-full-v4', 'requester', 'domain_A', 
                                                       'owner', 'domain_B', %1, ~sid, pk(~si), pk(~sr), 
                                                       'g'^~ie, 'g'^~re, 
                                                       h(h(<pk(~si), pk(~sr), %1, ~sid, 'g'^~ie>))>))
                                   ) @ #vk.21 )
                              case Object_Data_Encryption
                              solve( St_Responder_PreErase( 'requester', 'owner', $A, $B, %1, ~sid,
                                                            re.1,
                                                            kdf_data('g'^(~ie*~re),
                                                                     <'CDDS-AECDHE-full-v4', 'requester', 
                                                                      'domain_A', 'owner', 'domain_B', %1, 
                                                                      ~sid, pk(~si), pk(~sr), 'g'^~ie, 
                                                                      'g'^~re, 
                                                                      h(h(<pk(~si), pk(~sr), %1, ~sid, 'g'^~ie
                                                                          >))
                                                                     >),
                                                            kc, msg.1, T, exposure
                                     ) ▶₀ #reveal )
                                case Object_Data_Encryption
                                solve( !KU( ~sid ) @ #vk.17 )
                                  case Subject_Access_Request
                                  solve( !KU( sign(<pk(~si), ppk(~pi), %1>, ~da) ) @ #vk.38 )
                                    case W2_Setup
                                    solve( !KU( h(<pk(~si), pk(~sr), %1, ~sid, 'g'^~ie>) ) @ #vk.15 )
                                      case Domain_Access_Verification
                                      solve( !KU( pk(~db) ) @ #vk.25 )
                                        case Domain_Access_Verification
                                        solve( !KU( 'g'^~re ) @ #vk.30 )
                                          case Object_Data_Encryption
                                          solve( !KU( h(<'key-confirm', 
                                                         kdf_conf('g'^(~ie*~re),
                                                                  <'CDDS-AECDHE-full-v4', 'requester', 
                                                                   'domain_A', 'owner', 'domain_B', %1, ~sid, 
                                                                   pk(~si), pk(~sr), 'g'^~ie, 'g'^~re, 
                                                                   h(h(<pk(~si), pk(~sr), %1, ~sid, 'g'^~ie>))
                                                                  >), 
                                                         <'CDDS-AECDHE-full-v4', 'requester', 'domain_A', 
                                                          'owner', 'domain_B', %1, ~sid, pk(~si), pk(~sr), 
                                                          'g'^~ie, 'g'^~re, 
                                                          h(h(<pk(~si), pk(~sr), %1, ~sid, 'g'^~ie>))>, 
                                                         h(senc(<~msg, 
                                                                 sign(<~msg, 'CDDS-AECDHE-full-v4', 
                                                                       'requester', 'domain_A', 'owner', 
                                                                       'domain_B', %1, ~sid, pk(~si), 
                                                                       pk(~sr), 'g'^~ie, 'g'^~re, 
                                                                       h(h(<pk(~si), pk(~sr), %1, ~sid, 
                                                                            'g'^~ie>))
                                                                      >,
                                                                      ~sr), 
                                                                 pk(~sr)>,
                                                                kdf_data('g'^(~ie*~re),
                                                                         <'CDDS-AECDHE-full-v4', 'requester', 
                                                                          'domain_A', 'owner', 'domain_B', 
                                                                          %1, ~sid, pk(~si), pk(~sr), 
                                                                          'g'^~ie, 'g'^~re, 
                                                                          h(h(<pk(~si), pk(~sr), %1, ~sid, 
                                                                               'g'^~ie>))
                                                                         >)))
                                                        >)
                                                 ) @ #vk.31 )
                                            case Object_Data_Encryption
                                            solve( !KU( pk(~si) ) @ #vk.34 )
                                              case W2_Setup_case_1
                                              solve( !KU( pk(~sr) ) @ #vk.37 )
                                                case Subject_Access_Request
                                                solve( !KU( pk(~da) ) @ #vk.41 )
                                                  case W2_Setup
                                                  solve( !KU( ppk(~pi) ) @ #vk.43 )
                                                    case W2_Setup_case_1
                                                    solve( !KU( 'g'^~ie ) @ #vk.37 )
                                                      case Subject_Access_Request
                                                      solve( !KU( kdf_data('g'^(~ie*~re),
                                                                           <'CDDS-AECDHE-full-v4', 
                                                                            'requester', 'domain_A', 'owner', 
                                                                            'domain_B', %1, ~sid, pk(~si), 
                                                                            pk(~sr), 'g'^~ie, 'g'^~re, 
                                                                            h(h(<pk(~si), pk(~sr), %1, ~sid, 
                                                                                 'g'^~ie>))
                                                                           >)
                                                             ) @ #vk.44 )
                                                        case Reveal_Responder_SessionKey
                                                        solve( (#vl.5, 0) ~~> (#vk.15, 0) )
                                                          case kdf_data
                                                          SOLVED // trace found
                                                        qed
                                                      qed
                                                    qed
                                                  qed
                                                qed
                                              qed
                                            qed
                                          qed
                                        qed
                                      qed
                                    qed
                                  qed
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

