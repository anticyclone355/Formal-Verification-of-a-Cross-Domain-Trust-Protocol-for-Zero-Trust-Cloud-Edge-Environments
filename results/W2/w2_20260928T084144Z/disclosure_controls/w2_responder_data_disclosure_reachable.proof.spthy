theory W2_AECDHE_State_Lifecycle begin

// Function signature and definition of the equational theory E

builtins: diffie-hellman, natural-numbers
functions: PDec/2, PEnc/3, fst/1, h/1, kdf_conf/2, kdf_data/2, pair/2,
           pk/1, ppk/1, sdec/2, senc/2, sign/2, snd/1, true/0, verify/3
equations:
    PDec(psk, PEnc(ppk(psk), k, r)) = k,
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true















restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction W2_OneSetup:
  "∀ #i #j. ((W2Init( ) @ #i) ∧ (W2Init( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

rule (modulo E) W2_Setup:
   [ Fr( ~si ), Fr( ~pi ), Fr( ~sr ), Fr( ~pr ), Fr( ~da ), Fr( ~db ) ]
  --[ W2Init( ) ]->
   [
   !Subject( 'requester', 'domain_A', %1, ~si, ~pi, pk(~si), ppk(~pi) ),
   !Subject( 'owner', 'domain_B', %1, ~sr, ~pr, pk(~sr), ppk(~pr) ),
   !Domain( 'domain_A', %1, ~da, pk(~da) ),
   !Domain( 'domain_B', %1, ~db, pk(~db) ),
   !Policy( 'domain_A', 'domain_B', %1, 'requester', 'owner', '1' ),
   W2_RequestReady( 'requester', 'owner', 'domain_A', 'domain_B', %1 ),
   W2_IdAvailable( 'requester', %1 ), W2_PceAvailable( 'requester', %1 ),
   W2_IdAvailable( 'owner', %1 ), W2_PceAvailable( 'owner', %1 ),
   W2_DomainAvailable( 'domain_A', %1 ),
   W2_DomainAvailable( 'domain_B', %1 ), W2_ProbeReady( ),
   Out( <pk(~si), ppk(~pi), %1, 'Subject Pk'> ),
   Out( <pk(~sr), ppk(~pr), %1, 'Subject Pk'> ),
   Out( <<pk(~si), ppk(~pi), %1>, sign(<pk(~si), ppk(~pi), %1>, ~da), 
         pk(~da), 'SubjectCert'>
   ),
   Out( <<pk(~sr), ppk(~pr), %1>, sign(<pk(~sr), ppk(~pr), %1>, ~db), 
         pk(~db), 'SubjectCert'>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) W2_Probe:
   [ W2_ProbeReady( ) ] --[ W2Probe( ) ]-> [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_IdentityKey:
   [ !Subject( $S, $D, %n, sk, psk, pkS, ppkS ), W2_IdAvailable( $S, %n ) ]
  --[ Reveal_IdentityKey( $S, %n ), W2LtkReveal( 'identity', $S, %n ) ]->
   [ Out( sk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_PCEKey:
   [ !Subject( $S, $D, %n, sk, psk, pkS, ppkS ), W2_PceAvailable( $S, %n ) ]
  --[ Reveal_PCEKey( $S, %n ), W2LtkReveal( 'pce', $S, %n ) ]->
   [ Out( psk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_DomainKey:
   [ !Domain( $D, %n, sk, pkD ), W2_DomainAvailable( $D, %n ) ]
  --[ Reveal_Domain( $D, %n ), W2LtkReveal( 'domain', $D, %n ) ]->
   [ Out( sk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Subject_Access_Request[role=Authentication_and_Data_Sharing]:
   [
   W2_RequestReady( $S_a, $S_b, $A, $B, %n ),
   !Subject( $S_a, $A, %n, pska, ppska, pka, ppka ),
   !Subject( $S_b, $B, %n, pskb, ppskb, pkb, ppkb ),
   !Domain( $A, %n, gskA, gpkA ), !Domain( $B, %n, gskB, gpkB ), Fr( ~sid ),
   Fr( ~ie ), In( <CertA, CertaSign, SignPk, field> )
   ]
  --[
  EphemeralCreated( 'initiator', $S_a, $S_b, %n, ~sid, ~ie ),
  Eq( field, 'SubjectCert' ), Eq( SignPk, gpkA ),
  Eq( verify(CertaSign, CertA, gpkA), true ), Eq( fst(CertA), pka ),
  Eq( fst(snd(CertA)), ppka ), Eq( snd(snd(CertA)), %n ),
  AccessRequest( $S_a, $S_b, %n, $A, $B, pska, pskb, gskA ),
  RepairAccessRequest( $S_a, $S_b, $A, $B, %n, ~sid, 'g'^~ie ),
  W2Request( $S_a, $S_b, %n, ~sid )
  ]->
   [
   Out( <<<CertA, CertaSign, SignPk>, pkb, %n, ~sid, 'g'^~ie>, 
         sign(<<CertA, CertaSign, SignPk>, pkb, %n, ~sid, 'g'^~ie>, pska), pka, 
         'AccessR_a_fs'>
   ),
   Access_send( $S_a, $S_b, %n, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB,
                ppka
   ),
   St_Initiator_DH( $S_a, $S_b, $A, $B, %n, ~sid, ~ie, 'g'^~ie, pka, ppka,
                    pkb, 'clean'
   )
   ]

  /*
  rule (modulo AC) Subject_Access_Request[role=Authentication_and_Data_Sharing]:
     [
     W2_RequestReady( $S_a, $S_b, $A, $B, %n ),
     !Subject( $S_a, $A, %n, pska, ppska, pka, ppka ),
     !Subject( $S_b, $B, %n, pskb, ppskb, pkb, ppkb ),
     !Domain( $A, %n, gskA, gpkA ), !Domain( $B, %n, gskB, gpkB ), Fr( ~sid ),
     Fr( ~ie ), In( <CertA, CertaSign, SignPk, field> )
     ]
    --[
    EphemeralCreated( 'initiator', $S_a, $S_b, %n, ~sid, ~ie ),
    Eq( field, 'SubjectCert' ), Eq( SignPk, gpkA ), Eq( z, true ),
    Eq( z.1, pka ), Eq( z.2, ppka ), Eq( z.3, %n ),
    AccessRequest( $S_a, $S_b, %n, $A, $B, pska, pskb, gskA ),
    RepairAccessRequest( $S_a, $S_b, $A, $B, %n, ~sid, 'g'^~ie ),
    W2Request( $S_a, $S_b, %n, ~sid )
    ]->
     [
     Out( <<<CertA, CertaSign, SignPk>, pkb, %n, ~sid, 'g'^~ie>, 
           sign(<<CertA, CertaSign, SignPk>, pkb, %n, ~sid, 'g'^~ie>, pska), pka, 
           'AccessR_a_fs'>
     ),
     Access_send( $S_a, $S_b, %n, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB,
                  ppka
     ),
     St_Initiator_DH( $S_a, $S_b, $A, $B, %n, ~sid, ~ie, 'g'^~ie, pka, ppka,
                      pkb, 'clean'
     )
     ]
    variants (modulo AC)
    1. CertA = CertA.38
       CertaSign
             = CertaSign.39
       gpkA  = gpkA.42
       z     = verify(CertaSign.39, CertA.38, gpkA.42)
       z.1   = fst(CertA.38)
       z.2   = fst(snd(CertA.38))
       z.3   = snd(snd(CertA.38))
    
    2. CertA = CertA.238
       CertaSign
             = sign(CertA.238, x.468)
       gpkA  = pk(x.468)
       z     = true
       z.1   = fst(CertA.238)
       z.2   = fst(snd(CertA.238))
       z.3   = snd(snd(CertA.238))
    
    3. CertA = <z.80, z.81, z.82>
       CertaSign
             = CertaSign.58
       gpkA  = gpkA.61
       z     = verify(CertaSign.58, <z.80, z.81, z.82>, gpkA.61)
       z.1   = z.80
       z.2   = z.81
       z.3   = z.82
    
    4. CertA = <z.170, x.308>
       CertaSign
             = sign(<z.170, x.308>, x.309)
       gpkA  = pk(x.309)
       z     = true
       z.1   = z.170
       z.2   = fst(x.308)
       z.3   = snd(x.308)
    
    5. CertA = <z.171, z.172, z.173>
       CertaSign
             = sign(<z.171, z.172, z.173>, x.311)
       gpkA  = pk(x.311)
       z     = true
       z.1   = z.171
       z.2   = z.172
       z.3   = z.173
    
    6. CertA = <z.257, x.461>
       CertaSign
             = CertaSign.235
       gpkA  = gpkA.238
       z     = verify(CertaSign.235, <z.257, x.461>, gpkA.238)
       z.1   = z.257
       z.2   = fst(x.461)
       z.3   = snd(x.461)
  */

rule (modulo E) Domain_Access_Verification[role=Authentication_and_Data_Sharing]:
   [
   In( <AccessRa, AccesssSign, AccessPKa, field> ),
   Access_send( $S_a, $S_b, %n, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB,
                ppka
   ),
   !Policy( $A, $B, %n, $S_a, $S_b, bit ),
   !Subject( $S_b, $B, %n, pskb, ppskb, pkb, ppkb )
   ]
  --[
  Eq( field, 'AccessR_a_fs' ), Eq( pka, AccessPKa ),
  Eq( verify(AccesssSign, AccessRa, pka), true ),
  Eq( fst(snd(AccessRa)), pkb ), Eq( fst(snd(snd(AccessRa))), %n ),
  Eq( bit, '1' ), AccessGranted( $S_a, $S_b, %n, pka, pkb, bit ),
  RepairAccessGranted( $S_a, $S_b, $A, $B, %n,
                       fst(snd(snd(snd(AccessRa)))), snd(snd(snd(snd(AccessRa)))),
                       h(<pka, pkb, %n, fst(snd(snd(snd(AccessRa)))), 
                          snd(snd(snd(snd(AccessRa))))>)
  )
  ]->
   [
   Out( <
         h(<pka, pkb, %n, fst(snd(snd(snd(AccessRa)))), 
            snd(snd(snd(snd(AccessRa))))>), 
         sign(h(<pka, pkb, %n, fst(snd(snd(snd(AccessRa)))), 
                 snd(snd(snd(snd(AccessRa))))>),
              gskB), 
         pk(gskB), fst(snd(snd(snd(AccessRa)))), snd(snd(snd(snd(AccessRa)))), 
         'AccessCert_ab_fs'>
   ),
   AccessCert_send( $S_a, $S_b, %n, pka, pkb, pskb, ppka, $A, $B, gpkA, gpkB
   )
   ]

  /*
  rule (modulo AC) Domain_Access_Verification[role=Authentication_and_Data_Sharing]:
     [
     In( <AccessRa, AccesssSign, AccessPKa, field> ),
     Access_send( $S_a, $S_b, %n, pka, pkb, $A, $B, gskA, gskB, gpkA, gpkB,
                  ppka
     ),
     !Policy( $A, $B, %n, $S_a, $S_b, bit ),
     !Subject( $S_b, $B, %n, pskb, ppskb, pkb, ppkb )
     ]
    --[
    Eq( field, 'AccessR_a_fs' ), Eq( pka, AccessPKa ), Eq( z.2, true ),
    Eq( z.3, pkb ), Eq( z.4, %n ), Eq( bit, '1' ),
    AccessGranted( $S_a, $S_b, %n, pka, pkb, bit ),
    RepairAccessGranted( $S_a, $S_b, $A, $B, %n, z, z.1,
                         h(<pka, pkb, %n, z, z.1>)
    )
    ]->
     [
     Out( <h(<pka, pkb, %n, z, z.1>), sign(h(<pka, pkb, %n, z, z.1>), gskB), 
           pk(gskB), z, z.1, 'AccessCert_ab_fs'>
     ),
     AccessCert_send( $S_a, $S_b, %n, pka, pkb, pskb, ppka, $A, $B, gpkA, gpkB
     )
     ]
    variants (modulo AC)
     1. AccessRa
              = AccessRa.37
        AccesssSign
              = AccesssSign.38
        pka   = pka.45
        z     = fst(snd(snd(snd(AccessRa.37))))
        z.1   = snd(snd(snd(snd(AccessRa.37))))
        z.2   = verify(AccesssSign.38, AccessRa.37, pka.45)
        z.3   = fst(snd(AccessRa.37))
        z.4   = fst(snd(snd(AccessRa.37)))
    
     2. AccessRa
              = AccessRa.76
        AccesssSign
              = sign(AccessRa.76, x.145)
        pka   = pk(x.145)
        z     = fst(snd(snd(snd(AccessRa.76))))
        z.1   = snd(snd(snd(snd(AccessRa.76))))
        z.2   = true
        z.3   = fst(snd(AccessRa.76))
        z.4   = fst(snd(snd(AccessRa.76)))
    
     3. AccessRa
              = <x.31, x.32>
        AccesssSign
              = sign(<x.31, x.32>, x.33)
        pka   = pk(x.33)
        z     = fst(snd(snd(x.32)))
        z.1   = snd(snd(snd(x.32)))
        z.2   = true
        z.3   = fst(x.32)
        z.4   = fst(snd(x.32))
    
     4. AccessRa
              = <x.46, z.38, x.48>
        AccesssSign
              = sign(<x.46, z.38, x.48>, x.49)
        pka   = pk(x.49)
        z     = fst(snd(x.48))
        z.1   = snd(snd(x.48))
        z.2   = true
        z.3   = z.38
        z.4   = fst(x.48)
    
     5. AccessRa
              = <x.47, z.39, z.40, x.50>
        AccesssSign
              = sign(<x.47, z.39, z.40, x.50>, x.51)
        pka   = pk(x.51)
        z     = fst(x.50)
        z.1   = snd(x.50)
        z.2   = true
        z.3   = z.39
        z.4   = z.40
    
     6. AccessRa
              = <x.73, z.55, z.56, z.50, z.51>
        AccesssSign
              = sign(<x.73, z.55, z.56, z.50, z.51>, x.78)
        pka   = pk(x.78)
        z     = z.50
        z.1   = z.51
        z.2   = true
        z.3   = z.55
        z.4   = z.56
    
     7. AccessRa
              = <x.138, z.92, z.93, z.87, z.88>
        AccesssSign
              = AccesssSign.73
        pka   = pka.80
        z     = z.87
        z.1   = z.88
        z.2   = verify(AccesssSign.73, <x.138, z.92, z.93, z.87, z.88>, pka.80)
        z.3   = z.92
        z.4   = z.93
    
     8. AccessRa
              = <x.139, x.140>
        AccesssSign
              = AccesssSign.74
        pka   = pka.81
        z     = fst(snd(snd(x.140)))
        z.1   = snd(snd(snd(x.140)))
        z.2   = verify(AccesssSign.74, <x.139, x.140>, pka.81)
        z.3   = fst(x.140)
        z.4   = fst(snd(x.140))
    
     9. AccessRa
              = <x.140, z.94, x.142>
        AccesssSign
              = AccesssSign.75
        pka   = pka.82
        z     = fst(snd(x.142))
        z.1   = snd(snd(x.142))
        z.2   = verify(AccesssSign.75, <x.140, z.94, x.142>, pka.82)
        z.3   = z.94
        z.4   = fst(x.142)
    
    10. AccessRa
              = <x.141, z.95, z.96, x.144>
        AccesssSign
              = AccesssSign.76
        pka   = pka.83
        z     = fst(x.144)
        z.1   = snd(x.144)
        z.2   = verify(AccesssSign.76, <x.141, z.95, z.96, x.144>, pka.83)
        z.3   = z.95
        z.4   = z.96
  */

rule (modulo E) Object_Data_Encryption[role=Authentication_and_Data_Sharing]:
   [
   In( <Hash1, Hashsign, Hashpk, sid, X, field> ),
   AccessCert_send( $S_a, $S_b, %n, pka, pkb, pskb, ppka, $A, $B, gpkA, gpkB
   ),
   !Subject( $S_a, $A, %n, pska, ppska, pka, ppka ),
   !Subject( $S_b, $B, %n, pskb, ppskb, pkb, ppkb ), Fr( ~msg ), Fr( ~re )
   ]
  --[
  EphemeralCreated( 'responder', $S_a, $S_b, %n, sid, ~re ),
  EphemeralUse( 'responder', $S_a, $S_b, %n, sid, ~re ),
  DerivedKeyCreated( 'responder', $S_a, $S_b, %n, sid, 'data',
                     kdf_data(X^~re,
                              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                               'g'^~re, h(Hash1)>)
  ),
  DerivedKeyCreated( 'responder', $S_a, $S_b, %n, sid, 'confirmation',
                     kdf_conf(X^~re,
                              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                               'g'^~re, h(Hash1)>)
  ),
  DerivedKeyUse( 'responder', $S_a, $S_b, %n, sid, 'data',
                 kdf_data(X^~re,
                          <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                           'g'^~re, h(Hash1)>)
  ),
  DerivedKeyUse( 'responder', $S_a, $S_b, %n, sid, 'confirmation',
                 kdf_conf(X^~re,
                          <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                           'g'^~re, h(Hash1)>)
  ),
  ConfirmationGenerated( $S_a, $S_b, $A, $B, %n, sid,
                         <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                          'g'^~re, h(Hash1)>,
                         senc(<~msg, 
                               sign(<~msg, 'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, 
                                     pkb, X, 'g'^~re, h(Hash1)>,
                                    pskb), 
                               pk(pskb)>,
                              kdf_data(X^~re,
                                       <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                                        'g'^~re, h(Hash1)>)),
                         kdf_data(X^~re,
                                  <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                                   'g'^~re, h(Hash1)>),
                         kdf_conf(X^~re,
                                  <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                                   'g'^~re, h(Hash1)>),
                         h(<'key-confirm', 
                            kdf_conf(X^~re,
                                     <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                                      'g'^~re, h(Hash1)>), 
                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                             'g'^~re, h(Hash1)>, 
                            h(senc(<~msg, 
                                    sign(<~msg, 'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, 
                                          pkb, X, 'g'^~re, h(Hash1)>,
                                         pskb), 
                                    pk(pskb)>,
                                   kdf_data(X^~re,
                                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                                             'g'^~re, h(Hash1)>)))
                           >)
  ),
  Eq( field, 'AccessCert_ab_fs' ), Eq( gpkB, Hashpk ),
  Eq( verify(Hashsign, Hash1, gpkB), true ),
  Eq( Hash1, h(<pka, pkb, %n, sid, X>) ),
  DataSent( $S_b, $S_a, %n, pskb, ppka, pka, ~msg,
            kdf_data(X^~re,
                     <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                      'g'^~re, h(Hash1)>)
  ),
  RepairDataSent( $S_b, $S_a, $A, $B, %n, sid, ~msg,
                  kdf_data(X^~re,
                           <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                            'g'^~re, h(Hash1)>),
                  <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                   'g'^~re, h(Hash1)>
  ),
  W2Sent( $S_a, $S_b, %n, sid, ~msg,
          kdf_data(X^~re,
                   <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                    'g'^~re, h(Hash1)>),
          <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
           'g'^~re, h(Hash1)>
  ),
  RunningResponder( $S_b, $S_a, $A, $B, %n, sid, ~msg,
                    kdf_data(X^~re,
                             <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                              'g'^~re, h(Hash1)>),
                    <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                     'g'^~re, h(Hash1)>
  ),
  Secret( ~msg, %n ),
  SessionKey( kdf_data(X^~re,
                       <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                        'g'^~re, h(Hash1)>),
              %n
  ),
  Honest( $S_a, %n ), Honest( $S_b, %n )
  ]->
   [
   Out( <sid, 'g'^~re, 
         senc(<~msg, 
               sign(<~msg, 'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, 
                     pkb, X, 'g'^~re, h(Hash1)>,
                    pskb), 
               pk(pskb)>,
              kdf_data(X^~re,
                       <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                        'g'^~re, h(Hash1)>)), 
         h(<'key-confirm', 
            kdf_conf(X^~re,
                     <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                      'g'^~re, h(Hash1)>), 
            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
             'g'^~re, h(Hash1)>, 
            h(senc(<~msg, 
                    sign(<~msg, 'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, 
                          pkb, X, 'g'^~re, h(Hash1)>,
                         pskb), 
                    pk(pskb)>,
                   kdf_data(X^~re,
                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                             'g'^~re, h(Hash1)>)))
           >), 
         Hash1, 'data_fs'>
   ),
   St_Responder_PreErase( $S_a, $S_b, $A, $B, %n, sid, ~re,
                          kdf_data(X^~re,
                                   <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                                    'g'^~re, h(Hash1)>),
                          kdf_conf(X^~re,
                                   <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                                    'g'^~re, h(Hash1)>),
                          ~msg,
                          <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                           'g'^~re, h(Hash1)>,
                          'clean'
   ),
   W2_KeyRevealAvailable( 'responder', sid ),
   W2_ConfRevealAvailable( 'responder', sid )
   ]

  /*
  rule (modulo AC) Object_Data_Encryption[role=Authentication_and_Data_Sharing]:
     [
     In( <Hash1, Hashsign, Hashpk, sid, X, field> ),
     AccessCert_send( $S_a, $S_b, %n, pka, pkb, pskb, ppka, $A, $B, gpkA, gpkB
     ),
     !Subject( $S_a, $A, %n, pska, ppska, pka, ppka ),
     !Subject( $S_b, $B, %n, pskb, ppskb, pkb, ppkb ), Fr( ~msg ), Fr( ~re )
     ]
    --[
    EphemeralCreated( 'responder', $S_a, $S_b, %n, sid, ~re ),
    EphemeralUse( 'responder', $S_a, $S_b, %n, sid, ~re ),
    DerivedKeyCreated( 'responder', $S_a, $S_b, %n, sid, 'data',
                       kdf_data(z,
                                <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                                 'g'^~re, h(Hash1)>)
    ),
    DerivedKeyCreated( 'responder', $S_a, $S_b, %n, sid, 'confirmation',
                       kdf_conf(z,
                                <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                                 'g'^~re, h(Hash1)>)
    ),
    DerivedKeyUse( 'responder', $S_a, $S_b, %n, sid, 'data',
                   kdf_data(z,
                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                             'g'^~re, h(Hash1)>)
    ),
    DerivedKeyUse( 'responder', $S_a, $S_b, %n, sid, 'confirmation',
                   kdf_conf(z,
                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                             'g'^~re, h(Hash1)>)
    ),
    ConfirmationGenerated( $S_a, $S_b, $A, $B, %n, sid,
                           <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                            'g'^~re, h(Hash1)>,
                           senc(<~msg, 
                                 sign(<~msg, 'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, 
                                       pkb, X, 'g'^~re, h(Hash1)>,
                                      pskb), 
                                 pk(pskb)>,
                                kdf_data(z,
                                         <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                                          'g'^~re, h(Hash1)>)),
                           kdf_data(z,
                                    <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                                     'g'^~re, h(Hash1)>),
                           kdf_conf(z,
                                    <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                                     'g'^~re, h(Hash1)>),
                           h(<'key-confirm', 
                              kdf_conf(z,
                                       <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                                        'g'^~re, h(Hash1)>), 
                              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                               'g'^~re, h(Hash1)>, 
                              h(senc(<~msg, 
                                      sign(<~msg, 'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, 
                                            pkb, X, 'g'^~re, h(Hash1)>,
                                           pskb), 
                                      pk(pskb)>,
                                     kdf_data(z,
                                              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, 
                                               X, 'g'^~re, h(Hash1)>)))
                             >)
    ),
    Eq( field, 'AccessCert_ab_fs' ), Eq( gpkB, Hashpk ), Eq( z.1, true ),
    Eq( Hash1, h(<pka, pkb, %n, sid, X>) ),
    DataSent( $S_b, $S_a, %n, pskb, ppka, pka, ~msg,
              kdf_data(z,
                       <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                        'g'^~re, h(Hash1)>)
    ),
    RepairDataSent( $S_b, $S_a, $A, $B, %n, sid, ~msg,
                    kdf_data(z,
                             <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                              'g'^~re, h(Hash1)>),
                    <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                     'g'^~re, h(Hash1)>
    ),
    W2Sent( $S_a, $S_b, %n, sid, ~msg,
            kdf_data(z,
                     <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                      'g'^~re, h(Hash1)>),
            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
             'g'^~re, h(Hash1)>
    ),
    RunningResponder( $S_b, $S_a, $A, $B, %n, sid, ~msg,
                      kdf_data(z,
                               <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                                'g'^~re, h(Hash1)>),
                      <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                       'g'^~re, h(Hash1)>
    ),
    Secret( ~msg, %n ),
    SessionKey( kdf_data(z,
                         <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                          'g'^~re, h(Hash1)>),
                %n
    ),
    Honest( $S_a, %n ), Honest( $S_b, %n )
    ]->
     [
     Out( <sid, 'g'^~re, 
           senc(<~msg, 
                 sign(<~msg, 'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, 
                       pkb, X, 'g'^~re, h(Hash1)>,
                      pskb), 
                 pk(pskb)>,
                kdf_data(z,
                         <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                          'g'^~re, h(Hash1)>)), 
           h(<'key-confirm', 
              kdf_conf(z,
                       <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                        'g'^~re, h(Hash1)>), 
              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
               'g'^~re, h(Hash1)>, 
              h(senc(<~msg, 
                      sign(<~msg, 'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, 
                            pkb, X, 'g'^~re, h(Hash1)>,
                           pskb), 
                      pk(pskb)>,
                     kdf_data(z,
                              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                               'g'^~re, h(Hash1)>)))
             >), 
           Hash1, 'data_fs'>
     ),
     St_Responder_PreErase( $S_a, $S_b, $A, $B, %n, sid, ~re,
                            kdf_data(z,
                                     <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                                      'g'^~re, h(Hash1)>),
                            kdf_conf(z,
                                     <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                                      'g'^~re, h(Hash1)>),
                            ~msg,
                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                             'g'^~re, h(Hash1)>,
                            'clean'
     ),
     W2_KeyRevealAvailable( 'responder', sid ),
     W2_ConfRevealAvailable( 'responder', sid )
     ]
    variants (modulo AC)
     1. ~re   = ~re.43
        Hash1 = Hash1.44
        Hashsign
              = Hashsign.46
        X     = X.47
        gpkB  = gpkB.50
        z     = X.47^~re.43
        z.1   = verify(Hashsign.46, Hash1.44, gpkB.50)
    
     2. ~re   = ~re.56
        Hash1 = Hash1.57
        Hashsign
              = Hashsign.59
        X     = z.76^inv(~re.56)
        gpkB  = gpkB.63
        z     = z.76
        z.1   = verify(Hashsign.59, Hash1.57, gpkB.63)
    
     3. ~re   = ~re.373
        Hash1 = Hash1.374
        Hashsign
              = Hashsign.376
        X     = x.738^x.739
        gpkB  = gpkB.380
        z     = x.738^(~re.373*x.739)
        z.1   = verify(Hashsign.376, Hash1.374, gpkB.380)
    
     4. ~re   = ~re.374
        Hash1 = Hash1.375
        Hashsign
              = sign(Hash1.375, x.741)
        X     = X.378
        gpkB  = pk(x.741)
        z     = X.378^~re.374
        z.1   = true
    
     5. ~re   = ~re.375
        Hash1 = Hash1.376
        Hashsign
              = sign(Hash1.376, x.743)
        X     = z.395^inv(~re.375)
        gpkB  = pk(x.743)
        z     = z.395
        z.1   = true
    
     6. ~re   = ~re.376
        Hash1 = Hash1.377
        Hashsign
              = sign(Hash1.377, x.743)
        X     = x.744^x.745
        gpkB  = pk(x.743)
        z     = x.744^(~re.376*x.745)
        z.1   = true
    
     7. ~re   = ~re.377
        Hash1 = Hash1.378
        Hashsign
              = Hashsign.380
        X     = x.746^inv((~re.377*x.747))
        gpkB  = gpkB.384
        z     = x.746^inv(x.747)
        z.1   = verify(Hashsign.380, Hash1.378, gpkB.384)
    
     8. ~re   = ~re.377
        Hash1 = Hash1.378
        Hashsign
              = Hashsign.380
        X     = x.746^(x.747*inv(~re.377))
        gpkB  = gpkB.384
        z     = x.746^x.747
        z.1   = verify(Hashsign.380, Hash1.378, gpkB.384)
    
     9. ~re   = ~re.377
        Hash1 = Hash1.378
        Hashsign
              = sign(Hash1.378, x.745)
        X     = x.746^inv((~re.377*x.747))
        gpkB  = pk(x.745)
        z     = x.746^inv(x.747)
        z.1   = true
    
    10. ~re   = ~re.377
        Hash1 = Hash1.378
        Hashsign
              = sign(Hash1.378, x.745)
        X     = x.746^(x.747*inv(~re.377))
        gpkB  = pk(x.745)
        z     = x.746^x.747
        z.1   = true
    
    11. ~re   = ~re.378
        Hash1 = Hash1.379
        Hashsign
              = Hashsign.381
        X     = x.747^(x.748*inv((~re.378*x.749)))
        gpkB  = gpkB.385
        z     = x.747^(x.748*inv(x.749))
        z.1   = verify(Hashsign.381, Hash1.379, gpkB.385)
    
    12. ~re   = ~re.378
        Hash1 = Hash1.379
        Hashsign
              = sign(Hash1.379, x.746)
        X     = x.747^(x.748*inv((~re.378*x.749)))
        gpkB  = pk(x.746)
        z     = x.747^(x.748*inv(x.749))
        z.1   = true
    
    13. Hash1 = Hash1.42
        Hashsign
              = Hashsign.44
        X     = DH_neutral
        gpkB  = gpkB.48
        z     = DH_neutral
        z.1   = verify(Hashsign.44, Hash1.42, gpkB.48)
    
    14. Hash1 = Hash1.367
        Hashsign
              = sign(Hash1.367, x.726)
        X     = DH_neutral
        gpkB  = pk(x.726)
        z     = DH_neutral
        z.1   = true
  */

rule (modulo E) Subject_Data_Decryption[role=Authentication_and_Data_Sharing]:
   [
   In( <sid, Y, beta, keyConfirm, Hash1, field> ),
   St_Initiator_DH( $S_a, $S_b, $A, $B, %n, sid, ie, X, pka, ppka, pkb,
                    iExposure
   )
   ]
  --[
  W2StateUse( 'initiator', $S_a, $S_b, %n, sid, 'pending' ),
  EphemeralUse( 'initiator', $S_a, $S_b, %n, sid, ie ),
  DerivedKeyCreated( 'initiator', $S_a, $S_b, %n, sid, 'data',
                     kdf_data(Y^ie,
                              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                               h(Hash1)>)
  ),
  DerivedKeyCreated( 'initiator', $S_a, $S_b, %n, sid, 'confirmation',
                     kdf_conf(Y^ie,
                              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                               h(Hash1)>)
  ),
  DerivedKeyUse( 'initiator', $S_a, $S_b, %n, sid, 'data',
                 kdf_data(Y^ie,
                          <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                           h(Hash1)>)
  ),
  DerivedKeyUse( 'initiator', $S_a, $S_b, %n, sid, 'confirmation',
                 kdf_conf(Y^ie,
                          <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                           h(Hash1)>)
  ),
  ConfirmationAccepted( $S_a, $S_b, $A, $B, %n, sid,
                        <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                         h(Hash1)>,
                        beta,
                        kdf_data(Y^ie,
                                 <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                                  h(Hash1)>),
                        kdf_conf(Y^ie,
                                 <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                                  h(Hash1)>),
                        keyConfirm
  ),
  Eq( field, 'data_fs' ),
  Eq( keyConfirm,
      h(<'key-confirm', 
         kdf_conf(Y^ie,
                  <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                   h(Hash1)>), 
         <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
          h(Hash1)>, 
         h(beta)>)
  ),
  Eq( snd(snd(sdec(beta,
                   kdf_data(Y^ie,
                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                             h(Hash1)>)))),
      pkb
  ),
  Eq( verify(fst(snd(sdec(beta,
                          kdf_data(Y^ie,
                                   <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                                    h(Hash1)>)))),
             <
              fst(sdec(beta,
                       kdf_data(Y^ie,
                                <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                                 h(Hash1)>))), 
              'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
              h(Hash1)>,
             pkb),
      true
  ),
  DataReceive( $S_b, $S_a, %n, Y, beta, ppka, pkb,
               kdf_data(Y^ie,
                        <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                         h(Hash1)>),
               fst(sdec(beta,
                        kdf_data(Y^ie,
                                 <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                                  h(Hash1)>)))
  ),
  RepairDataAccepted( $S_a, $S_b, $A, $B, %n, sid,
                      fst(sdec(beta,
                               kdf_data(Y^ie,
                                        <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                                         h(Hash1)>))),
                      kdf_data(Y^ie,
                               <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                                h(Hash1)>),
                      <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                       h(Hash1)>
  ),
  W2Accepted( $S_a, $S_b, %n, sid,
              fst(sdec(beta,
                       kdf_data(Y^ie,
                                <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                                 h(Hash1)>))),
              kdf_data(Y^ie,
                       <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                        h(Hash1)>),
              <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
               h(Hash1)>
  ),
  CommitInitiator( $S_a, $S_b, $A, $B, %n, sid,
                   fst(sdec(beta,
                            kdf_data(Y^ie,
                                     <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                                      h(Hash1)>))),
                   kdf_data(Y^ie,
                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                             h(Hash1)>),
                   <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                    h(Hash1)>
  )
  ]->
   [
   !Plaintext( fst(sdec(beta,
                        kdf_data(Y^ie,
                                 <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                                  h(Hash1)>)))
   ),
   St_Initiator_PreErase( $S_a, $S_b, $A, $B, %n, sid, ie,
                          kdf_data(Y^ie,
                                   <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                                    h(Hash1)>),
                          kdf_conf(Y^ie,
                                   <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                                    h(Hash1)>),
                          fst(sdec(beta,
                                   kdf_data(Y^ie,
                                            <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, 
                                             Y, h(Hash1)>))),
                          <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                           h(Hash1)>,
                          iExposure
   ),
   W2_KeyRevealAvailable( 'initiator', sid ),
   W2_ConfRevealAvailable( 'initiator', sid )
   ]

  /*
  rule (modulo AC) Subject_Data_Decryption[role=Authentication_and_Data_Sharing]:
     [
     In( <sid, Y, beta, keyConfirm, Hash1, field> ),
     St_Initiator_DH( $S_a, $S_b, $A, $B, %n, sid, ie, X, pka, ppka, pkb,
                      iExposure
     )
     ]
    --[
    W2StateUse( 'initiator', $S_a, $S_b, %n, sid, 'pending' ),
    EphemeralUse( 'initiator', $S_a, $S_b, %n, sid, ie ),
    DerivedKeyCreated( 'initiator', $S_a, $S_b, %n, sid, 'data',
                       kdf_data(z.1,
                                <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                                 h(Hash1)>)
    ),
    DerivedKeyCreated( 'initiator', $S_a, $S_b, %n, sid, 'confirmation',
                       kdf_conf(z.1,
                                <'CDDS-AECDHE-full-v4', $S_a, $A, $S_b, $B, %n, sid, pka, pkb, X, Y, 
                                 h(Hash1)>)
    ),
    DerivedKeyUse( 'initiator', $S_a, $S_b, %n, sid, 'data',
