          (RevealConfirmationKey( 'initiator', I, R, e, sid, kc ) @ #conf)) ∧
         (LocalErased( 'initiator', I, R, e, sid ) @ #erase)) ∧
        (#conf < #data)) ∧
       (#data < #ep)) ∧
      (#ep < #erase)) ∧
     (#data < #erase)) ∧
    (#conf < #erase)"
