lemma ephemeral_state_lifetime:
  all-traces
  "∀ role I R e sid secret #use.
    (EphemeralUse( role, I, R, e, sid, secret ) @ #use) ⇒
    ((∃ #create.
       (EphemeralCreated( role, I, R, e, sid, secret ) @ #create) ∧
       ((#create < #use) ∨ (#create = #use))) ∧
     (¬(∃ #erase.
         (LocalErased( role, I, R, e, sid ) @ #erase) ∧ (#erase < #use))))"
/*
guarded formula characterizing all counter-examples:
"∃ role I R e sid secret #use.
  (EphemeralUse( role, I, R, e, sid, secret ) @ #use)
 ∧
  ((∀ #create.
     (EphemeralCreated( role, I, R, e, sid, secret ) @ #create)
    ⇒
     (¬(#create < #use)) ∧ (¬(#create = #use))) ∨
   (∃ #erase.
     (LocalErased( role, I, R, e, sid ) @ #erase) ∧ #erase < #use))"
*/
by sorry

