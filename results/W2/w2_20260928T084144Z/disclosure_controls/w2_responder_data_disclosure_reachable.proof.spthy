/*
guarded formula characterizing all satisfying traces:
"∃ I R A B e sid T beta kd kc tag x #send #accept #reveal #local #erase
   #learn.
  (W2Sent( I, R, e, sid, x, kd, T ) @ #send) ∧
  (ConfirmationAccepted( I, R, A, B, e, sid, T, beta, kd, kc, tag
   ) @ #accept) ∧
  (W2SessionKeyReveal( 'initiator', sid, kd ) @ #reveal) ∧
  (LocalErased( 'initiator', I, R, e, sid ) @ #local) ∧
  (SessionErased( I, R, e, sid ) @ #erase) ∧
  (K( x ) @ #learn)
 ∧
  (#send < #accept) ∧
  (#accept < #erase) ∧
  (#reveal < #local) ∧
  (#local < #erase) ∧
  (#erase < #learn) ∧
  (∀ kind p epoch #lt. (W2LtkReveal( kind, p, epoch ) @ #lt) ⇒ ⊥) ∧
  (∀ r handle #ep. (W2EphemeralReveal( r, handle ) @ #ep) ⇒ ⊥) ∧
  (∀ secret #dk.
    (W2SessionKeyReveal( 'responder', sid, secret ) @ #dk) ⇒ ⊥) ∧
  (∀ r p q epoch handle secret #ck.
    (RevealConfirmationKey( r, p, q, epoch, handle, secret ) @ #ck) ⇒ ⊥)"
*/
by sorry

lemma w2_initiator_confirmation_disclosure_reachable:
  exists-trace
  "∃ I R A B e sid T beta kd kc tag x #send #accept #reveal #local #erase
     #learn.
    ((((((((((((((W2Sent( I, R, e, sid, x, kd, T ) @ #send) ∧
                 (ConfirmationAccepted( I, R, A, B, e, sid, T, beta, kd, kc, tag
                  ) @ #accept)) ∧
                (RevealConfirmationKey( 'initiator', I, R, e, sid, kc ) @ #reveal)) ∧
               (LocalErased( 'initiator', I, R, e, sid ) @ #local)) ∧
              (SessionErased( I, R, e, sid ) @ #erase)) ∧
             (K( kc ) @ #learn)) ∧
            (#send < #accept)) ∧
           (#accept < #erase)) ∧
          (#reveal < #local)) ∧
         (#local < #erase)) ∧
        (#erase < #learn)) ∧
       (¬(∃ kind p epoch #lt. W2LtkReveal( kind, p, epoch ) @ #lt))) ∧
      (¬(∃ r handle #ep. W2EphemeralReveal( r, handle ) @ #ep))) ∧
     (¬(∃ r handle secret #dk.
         W2SessionKeyReveal( r, handle, secret ) @ #dk))) ∧
    (¬(∃ secret #ck.
        RevealConfirmationKey( 'responder', I, R, e, sid, secret ) @ #ck))"
/*
guarded formula characterizing all satisfying traces:
"∃ I R A B e sid T beta kd kc tag x #send #accept #reveal #local #erase
   #learn.
  (W2Sent( I, R, e, sid, x, kd, T ) @ #send) ∧
  (ConfirmationAccepted( I, R, A, B, e, sid, T, beta, kd, kc, tag
   ) @ #accept) ∧
  (RevealConfirmationKey( 'initiator', I, R, e, sid, kc ) @ #reveal) ∧
  (LocalErased( 'initiator', I, R, e, sid ) @ #local) ∧
  (SessionErased( I, R, e, sid ) @ #erase) ∧
  (K( kc ) @ #learn)
 ∧
  (#send < #accept) ∧
  (#accept < #erase) ∧
  (#reveal < #local) ∧
  (#local < #erase) ∧
  (#erase < #learn) ∧
  (∀ kind p epoch #lt. (W2LtkReveal( kind, p, epoch ) @ #lt) ⇒ ⊥) ∧
  (∀ r handle #ep. (W2EphemeralReveal( r, handle ) @ #ep) ⇒ ⊥) ∧
  (∀ r handle secret #dk.
    (W2SessionKeyReveal( r, handle, secret ) @ #dk) ⇒ ⊥) ∧
  (∀ secret #ck.
    (RevealConfirmationKey( 'responder', I, R, e, sid, secret ) @ #ck) ⇒ ⊥)"
*/
by sorry

lemma w2_responder_ephemeral_disclosure_reachable:
  exists-trace
  "∃ I R A B e sid T beta kd kc tag x #send #accept #reveal #local #erase
     #learn.
    ((((((((((((((W2Sent( I, R, e, sid, x, kd, T ) @ #send) ∧
                 (ConfirmationAccepted( I, R, A, B, e, sid, T, beta, kd, kc, tag
                  ) @ #accept)) ∧
                (W2EphemeralReveal( 'responder', sid ) @ #reveal)) ∧
               (LocalErased( 'responder', I, R, e, sid ) @ #local)) ∧
              (SessionErased( I, R, e, sid ) @ #erase)) ∧
             (K( x ) @ #learn)) ∧
            (#send < #accept)) ∧
           (#accept < #erase)) ∧
          (#reveal < #local)) ∧
         (#local < #erase)) ∧
        (#erase < #learn)) ∧
       (¬(∃ kind p epoch #lt. W2LtkReveal( kind, p, epoch ) @ #lt))) ∧
      (¬(∃ #ep. W2EphemeralReveal( 'initiator', sid ) @ #ep))) ∧
     (¬(∃ r handle secret #dk.
         W2SessionKeyReveal( r, handle, secret ) @ #dk))) ∧
    (¬(∃ r p q epoch handle secret #ck.
        RevealConfirmationKey( r, p, q, epoch, handle, secret ) @ #ck))"
