rule (modulo E) Initiator_Erase_Ephemeral[role=Authentication_and_Data_Sharing]:
   [
   St_Initiator_PreErase( $S_a, $S_b, $A, $B, %n, sid, ie, k, kc, msg,
                          transcript, iExposure
   )
   ]
  --[
  W2StateUse( 'initiator', $S_a, $S_b, %n, sid, 'preerase' ),
  EphemeralUse( 'initiator', $S_a, $S_b, %n, sid, ie ),
  DerivedKeyUse( 'initiator', $S_a, $S_b, %n, sid, 'data', k ),
  DerivedKeyUse( 'initiator', $S_a, $S_b, %n, sid, 'confirmation', kc ),
  LocalErased( 'initiator', $S_a, $S_b, %n, sid ),
  SecretsErased( 'initiator', $S_a, $S_b, %n, sid, ie, k, kc ),
  InitiatorErased( $S_a, $S_b, $A, $B, %n, sid )
  ]->
   [ InitErased( $S_a, $S_b, %n, sid ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Responder_Erase_Ephemeral[role=Authentication_and_Data_Sharing]:
   [
   St_Responder_PreErase( $S_a, $S_b, $A, $B, %n, sid, re, k, kc, msg,
                          transcript, rExposure
   )
   ]
  --[
  W2StateUse( 'responder', $S_a, $S_b, %n, sid, 'preerase' ),
  EphemeralUse( 'responder', $S_a, $S_b, %n, sid, re ),
  DerivedKeyUse( 'responder', $S_a, $S_b, %n, sid, 'data', k ),
  DerivedKeyUse( 'responder', $S_a, $S_b, %n, sid, 'confirmation', kc ),
  LocalErased( 'responder', $S_a, $S_b, %n, sid ),
  SecretsErased( 'responder', $S_a, $S_b, %n, sid, re, k, kc ),
  ResponderErased( $S_a, $S_b, $A, $B, %n, sid )
  ]->
   [ RespErased( $S_a, $S_b, %n, sid ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Close_Repair_Session_After_Erasure[role=Authentication_and_Data_Sharing]:
   [ InitErased( $S_a, $S_b, %n, sid ), RespErased( $S_a, $S_b, %n, sid ) ]
  --[ SessionErased( $S_a, $S_b, %n, sid ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_Initiator_Ephemeral_Pending[role=adversary]:
   [
   St_Initiator_DH( $S_a, $S_b, $A, $B, %n, sid, ie, X, pka, ppka, pkb,
                    'clean'
   )
   ]
  --[
  W2StateUse( 'initiator', $S_a, $S_b, %n, sid, 'pending' ),
  EphemeralUse( 'initiator', $S_a, $S_b, %n, sid, ie ),
  RevealEphemeralI( $S_a, $S_b, %n, sid, ie ),
  W2EphemeralReveal( 'initiator', sid )
  ]->
   [
   St_Initiator_DH( $S_a, $S_b, $A, $B, %n, sid, ie, X, pka, ppka, pkb,
                    'revealed'
   ),
   Out( ie )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_Initiator_Ephemeral_Accepted[role=adversary]:
   [
   St_Initiator_PreErase( $S_a, $S_b, $A, $B, %n, sid, ie, k, kc, msg,
                          transcript, 'clean'
   )
   ]
  --[
  W2StateUse( 'initiator', $S_a, $S_b, %n, sid, 'preerase' ),
  EphemeralUse( 'initiator', $S_a, $S_b, %n, sid, ie ),
  DerivedKeyUse( 'initiator', $S_a, $S_b, %n, sid, 'data', k ),
  DerivedKeyUse( 'initiator', $S_a, $S_b, %n, sid, 'confirmation', kc ),
  RevealEphemeralI( $S_a, $S_b, %n, sid, ie ),
  W2EphemeralReveal( 'initiator', sid )
  ]->
   [
   St_Initiator_PreErase( $S_a, $S_b, $A, $B, %n, sid, ie, k, kc, msg,
                          transcript, 'revealed'
   ),
   Out( ie )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_Responder_Ephemeral[role=adversary]:
   [
   St_Responder_PreErase( $S_a, $S_b, $A, $B, %n, sid, re, k, kc, msg,
                          transcript, 'clean'
   )
   ]
  --[
  W2StateUse( 'responder', $S_a, $S_b, %n, sid, 'preerase' ),
  EphemeralUse( 'responder', $S_a, $S_b, %n, sid, re ),
  DerivedKeyUse( 'responder', $S_a, $S_b, %n, sid, 'data', k ),
  DerivedKeyUse( 'responder', $S_a, $S_b, %n, sid, 'confirmation', kc ),
  RevealEphemeralR( $S_a, $S_b, %n, sid, re ),
  W2EphemeralReveal( 'responder', sid )
  ]->
   [
   St_Responder_PreErase( $S_a, $S_b, $A, $B, %n, sid, re, k, kc, msg,
                          transcript, 'revealed'
   ),
   Out( re )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_Initiator_SessionKey:
   [
   St_Initiator_PreErase( $I, $R, $A, $B, %n, sid, ie, k, kc, msg, T,
                          exposure
   ),
   W2_KeyRevealAvailable( 'initiator', sid )
   ]
  --[
  W2StateUse( 'initiator', $I, $R, %n, sid, 'preerase' ),
  EphemeralUse( 'initiator', $I, $R, %n, sid, ie ),
  DerivedKeyUse( 'initiator', $I, $R, %n, sid, 'data', k ),
  DerivedKeyUse( 'initiator', $I, $R, %n, sid, 'confirmation', kc ),
  W2SessionKeyReveal( 'initiator', sid, k )
  ]->
   [
   St_Initiator_PreErase( $I, $R, $A, $B, %n, sid, ie, k, kc, msg, T,
                          exposure
   ),
   Out( k )
   ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_Responder_SessionKey:
   [
   St_Responder_PreErase( $I, $R, $A, $B, %n, sid, re, k, kc, msg, T,
                          exposure
   ),
   W2_KeyRevealAvailable( 'responder', sid )
   ]
  --[
  W2StateUse( 'responder', $I, $R, %n, sid, 'preerase' ),
  EphemeralUse( 'responder', $I, $R, %n, sid, re ),
  DerivedKeyUse( 'responder', $I, $R, %n, sid, 'data', k ),
  DerivedKeyUse( 'responder', $I, $R, %n, sid, 'confirmation', kc ),
  W2SessionKeyReveal( 'responder', sid, k )
  ]->
   [
   St_Responder_PreErase( $I, $R, $A, $B, %n, sid, re, k, kc, msg, T,
                          exposure
   ),
   Out( k )
   ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_Initiator_ConfirmationKey:
   [
   St_Initiator_PreErase( $I, $R, $A, $B, %n, sid, ep, k, kc, msg, T,
                          exposure
   ),
   W2_ConfRevealAvailable( 'initiator', sid )
   ]
  --[
  RevealConfirmationKey( 'initiator', $I, $R, %n, sid, kc ),
  W2StateUse( 'initiator', $I, $R, %n, sid, 'preerase' ),
  EphemeralUse( 'initiator', $I, $R, %n, sid, ep ),
  DerivedKeyUse( 'initiator', $I, $R, %n, sid, 'data', k ),
  DerivedKeyUse( 'initiator', $I, $R, %n, sid, 'confirmation', kc )
  ]->
   [
   St_Initiator_PreErase( $I, $R, $A, $B, %n, sid, ep, k, kc, msg, T,
                          exposure
   ),
   Out( kc )
   ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_Responder_ConfirmationKey:
   [
   St_Responder_PreErase( $I, $R, $A, $B, %n, sid, ep, k, kc, msg, T,
                          exposure
   ),
   W2_ConfRevealAvailable( 'responder', sid )
   ]
  --[
  RevealConfirmationKey( 'responder', $I, $R, %n, sid, kc ),
  W2StateUse( 'responder', $I, $R, %n, sid, 'preerase' ),
  EphemeralUse( 'responder', $I, $R, %n, sid, ep ),
  DerivedKeyUse( 'responder', $I, $R, %n, sid, 'data', k ),
  DerivedKeyUse( 'responder', $I, $R, %n, sid, 'confirmation', kc )
  ]->
   [
   St_Responder_PreErase( $I, $R, $A, $B, %n, sid, ep, k, kc, msg, T,
                          exposure
   ),
   Out( kc )
   ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

lemma w2_normal_confirmation_and_erasure:
  exists-trace
  "∃ I R A B e sid T beta kd kc tag #generate #accept #erase.
    ((((((((ConfirmationGenerated( I, R, A, B, e, sid, T, beta, kd, kc, tag
            ) @ #generate) ∧
           (ConfirmationAccepted( I, R, A, B, e, sid, T, beta, kd, kc, tag
            ) @ #accept)) ∧
          (SessionErased( I, R, e, sid ) @ #erase)) ∧
         (#generate < #accept)) ∧
        (#accept < #erase)) ∧
       (¬(∃ kind p epoch #lt. W2LtkReveal( kind, p, epoch ) @ #lt))) ∧
      (¬(∃ role handle #ep. W2EphemeralReveal( role, handle ) @ #ep))) ∧
     (¬(∃ role handle secret #dk.
         W2SessionKeyReveal( role, handle, secret ) @ #dk))) ∧
    (¬(∃ role p q epoch handle secret #ck.
        RevealConfirmationKey( role, p, q, epoch, handle, secret ) @ #ck))"
/*
guarded formula characterizing all satisfying traces:
"∃ I R A B e sid T beta kd kc tag #generate #accept #erase.
  (ConfirmationGenerated( I, R, A, B, e, sid, T, beta, kd, kc, tag
   ) @ #generate) ∧
  (ConfirmationAccepted( I, R, A, B, e, sid, T, beta, kd, kc, tag
   ) @ #accept) ∧
  (SessionErased( I, R, e, sid ) @ #erase)
 ∧
  (#generate < #accept) ∧
  (#accept < #erase) ∧
  (∀ kind p epoch #lt. (W2LtkReveal( kind, p, epoch ) @ #lt) ⇒ ⊥) ∧
  (∀ role handle #ep. (W2EphemeralReveal( role, handle ) @ #ep) ⇒ ⊥) ∧
  (∀ role handle secret #dk.
    (W2SessionKeyReveal( role, handle, secret ) @ #dk) ⇒ ⊥) ∧
  (∀ role p q epoch handle secret #ck.
    (RevealConfirmationKey( role, p, q, epoch, handle, secret ) @ #ck) ⇒ ⊥)"
*/
by sorry

lemma key_confirmation_origin:
  all-traces
  "∀ I R A B e sid T beta kd kc tag #accept.
    (((((ConfirmationAccepted( I, R, A, B, e, sid, T, beta, kd, kc, tag
         ) @ #accept) ∧
        (¬(∃ kind p epoch #lt.
            ((W2LtkReveal( kind, p, epoch ) @ #lt) ∧ (#lt < #accept)) ∧
            ((((kind = 'identity') ∧ ((p = I) ∨ (p = R))) ∧ (epoch = e)) ∨
             (((kind = 'domain') ∧ ((p = A) ∨ (p = B))) ∧ (epoch = e)))))) ∧
       (¬(∃ role #ep.
           (W2EphemeralReveal( role, sid ) @ #ep) ∧ (#ep < #accept)))) ∧
      (¬(∃ role secret #dk.
          (W2SessionKeyReveal( role, sid, secret ) @ #dk) ∧ (#dk < #accept)))) ∧
     (¬(∃ role secret #ck.
         (RevealConfirmationKey( role, I, R, e, sid, secret ) @ #ck) ∧
         (#ck < #accept)))) ⇒
    (∃ A0 B0 T0 beta0 kd0 #generate.
      (ConfirmationGenerated( I, R, A0, B0, e, sid, T0, beta0, kd0, kc, tag
       ) @ #generate) ∧
      (#generate < #accept))"
/*
guarded formula characterizing all counter-examples:
"∃ I R A B e sid T beta kd kc tag #accept.
  (ConfirmationAccepted( I, R, A, B, e, sid, T, beta, kd, kc, tag
   ) @ #accept)
 ∧
  (∀ kind p epoch #lt.
    (W2LtkReveal( kind, p, epoch ) @ #lt)
   ⇒
    ((¬(#lt < #accept)) ∨
     ((((¬(kind = 'identity')) ∨
        ((¬(p = I)) ∧ (¬(p = R))) ∨
        (¬(epoch = e)))) ∧
      (((¬(kind = 'domain')) ∨
        ((¬(p = A)) ∧ (¬(p = B))) ∨
        (¬(epoch = e))))))) ∧
  (∀ role #ep. (W2EphemeralReveal( role, sid ) @ #ep) ⇒ ¬(#ep < #accept)) ∧
  (∀ role secret #dk.
    (W2SessionKeyReveal( role, sid, secret ) @ #dk) ⇒ ¬(#dk < #accept)) ∧
  (∀ role secret #ck.
    (RevealConfirmationKey( role, I, R, e, sid, secret ) @ #ck)
   ⇒
    ¬(#ck < #accept)) ∧
  (∀ A0 B0 T0 beta0 kd0 #generate.
    (ConfirmationGenerated( I, R, A0, B0, e, sid, T0, beta0, kd0, kc, tag
     ) @ #generate)
   ⇒
    ¬(#generate < #accept))"
*/
by sorry

